            <variable name="xMonValid">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="482dbc92-3c4f-47f9-b2f0-024f33b1d6c0"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Status-Quelle gueltig (PLATZHALTER FALSE -&gt; HMI zeigt 'Quelle fehlt'; TRUE setzen sobald Quelle verbunden)</xhtml>
              </documentation>
            </variable>
            <variable name="aWeekDays">
              <type>
                <derived name="T_WeekMask"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" monitorEnabled="true" uuid="758d3d14-2304-46f7-bfc1-0e3df2a8be35"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entpackte Wochentag-Freigabe (aus Bellows.Zeitplan.bWeekMask) fuer fbTimer.bMtDays</xhtml>
              </documentation>
            </variable>
            <variable name="fbManualTime">
              <type>
                <derived name="FB_MANUAL_TIME"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="e137b2ae-a1d6-414f-a49b-54290175917b"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Modus 2 Feste startzeit und Selektierte Beete</xhtml>
              </documentation>
            </variable>
            <variable name="fbSequence">
              <type>
                <array>
                  <dimension lower="0" upper="5"/>
                  <baseType>
                    <derived name="FB_MANUAL_SEQUENCE"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="d5ce5048-833f-4719-9db2-3a472abd4826"/>
                </data>
              </addData>
            </variable>
            <variable name="fbBlinkMan">
              <type>
                <derived name="FB_BLINK"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" monitorEnabled="true" uuid="49f7b22f-90b7-4b73-9cc4-7ecf5feb3153"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blink-Generator fuer die Anforderung-/Warte-Anzeige im Handbetrieb (Mode 1): per-Mode 5s/5s (tBlFlash/tBlPause in PLC_PRG gesetzt). Angefordertes, noch nicht freigegebenes Beet blinkt -&gt; Feld-Taster-Feedback.</xhtml>
              </documentation>
            </variable>
            <variable name="rHz">
              <type>
                <REAL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" monitorEnabled="true" uuid="23897c00-ad26-4ee8-abcc-3037ae8ebd8c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blinkfrequenz [Hz], begrenzt auf 0.01..10</xhtml>
              </documentation>
            </variable>
            <variable name="tBlinkHalb">
              <type>
                <TIME/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" monitorEnabled="true" uuid="50c9fd96-56c1-4ceb-a143-06ad583aa0fc"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">halbe Blinkperiode = 500 ms / rHz</xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   PLC_PRG  —  Hauptprogramm Ackersteuerung (SoLaWi-Acker Bewaesserung)
   ----------------------------------------------------------------------------
   Betriebsart-Decode -&gt; CASE-Dispatch erzeugt die Ventil-ANFORDERUNGEN (axReq)
   je Modus -&gt; globaler Arbiter (max. uMaxVentile, Status-Graph mit Warterang)
   -&gt; Ausgabe: physische Ventile = GRANT, Status-LEDs spiegeln Grant bzw. blinken
   (angefordert/wartend) -&gt; Geraeteueberwachung.
   GRANT-AWARE: der Arbiter ist die Wahrheit ueber &quot;Ventil offen&quot;; die Mode-FBs
   bekommen ihren Grant-Slice (Vorzyklus) und melden Anforderung vs. offen.
   Modi: 0=AUS/sicher · 1=Manuell · 2=One-Shot · 3=wiederkehrend · 4=Auto.
   ============================================================================ *)

(* --- 1) Betriebsart-Wahl: One-Hot aus HMI-GVL &quot;Betrieb&quot;. *)
uModeCnt := 0;
IF Bellows.Betrieb.xManuell       THEN uModeCnt := uModeCnt + 1; END_IF;
IF Bellows.Betrieb.xOneShot       THEN uModeCnt := uModeCnt + 1; END_IF;
IF Bellows.Betrieb.xWiederkehrend THEN uModeCnt := uModeCnt + 1; END_IF;
IF Bellows.Betrieb.xAuto          THEN uModeCnt := uModeCnt + 1; END_IF;
IF uModeCnt &lt;&gt; 1 THEN uMode := 0;
ELSIF Bellows.Betrieb.xManuell       THEN uMode := 1;
ELSIF Bellows.Betrieb.xOneShot       THEN uMode := 2;
ELSIF Bellows.Betrieb.xWiederkehrend THEN uMode := 3;
ELSE uMode := 4; END_IF;

Bellows.Betrieb.uModeActive := uMode;

(* --- 2) Modus-Dispatch -&gt; Ventil-Anforderungen axReq. Default sicher FALSE. *)
FOR iPlc := 0 TO 23 DO
    axReq[iPlc] := FALSE;
END_FOR;

CASE uMode OF
    0:  (* AUS / sicher: Manuell disablen (Grant-Slice bleibt fuer Status). One-Shot-
           FBs nicht aufgerufen -&gt; Instanz-Zustand friert ein. *)
        fbManual[0](xEnable := FALSE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[0..3]);
        fbManual[1](xEnable := FALSE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[4..7]);
        fbManual[2](xEnable := FALSE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[8..11]);
        fbManual[3](xEnable := FALSE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[12..15]);
        fbManual[4](xEnable := FALSE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[16..19]);
        fbManual[5](xEnable := FALSE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[20..23]);
        fbManualTime(xMtEnable := FALSE, xMtRecurring := FALSE, bMtDays := Bellows.Zeitplan.bWeekMask);

    1:  (* Manuell: Taster (Anvil ODER Bellows) -&gt; fbManual JK-Toggle -&gt; Anforderung.
           Grant-aware: aGranted-Slice rein, bManValves = Anforderung raus. *)
        bButtons.0 := Anvil.Pfirsich.xT_1 OR Bellows.Pfirsich.xT_1;
        bButtons.1 := Anvil.Pfirsich.xT_2 OR Bellows.Pfirsich.xT_2;
        bButtons.2 := Anvil.Pfirsich.xT_3 OR Bellows.Pfirsich.xT_3;
        bButtons.3 := Anvil.Pfirsich.xT_4 OR Bellows.Pfirsich.xT_4;
        fbManual[0](xEnable := TRUE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[0..3]);
        axReq[0] := fbManual[0].bManValves.0; axReq[1] := fbManual[0].bManValves.1;
        axReq[2] := fbManual[0].bManValves.2; axReq[3] := fbManual[0].bManValves.3;

        bButtons.0 := Anvil.Stachelbeere.xT_1 OR Bellows.Stachelbeere.xT_1;
        bButtons.1 := Anvil.Stachelbeere.xT_2 OR Bellows.Stachelbeere.xT_2;
        bButtons.2 := Anvil.Stachelbeere.xT_3 OR Bellows.Stachelbeere.xT_3;
        bButtons.3 := Anvil.Stachelbeere.xT_4 OR Bellows.Stachelbeere.xT_4;
        fbManual[1](xEnable := TRUE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[4..7]);
        axReq[4] := fbManual[1].bManValves.0; axReq[5] := fbManual[1].bManValves.1;
        axReq[6] := fbManual[1].bManValves.2; axReq[7] := fbManual[1].bManValves.3;

        bButtons.0 := Anvil.Maulbeere.xT_1 OR Bellows.Maulbeere.xT_1;
        bButtons.1 := Anvil.Maulbeere.xT_2 OR Bellows.Maulbeere.xT_2;
        bButtons.2 := Anvil.Maulbeere.xT_3 OR Bellows.Maulbeere.xT_3;
        bButtons.3 := Anvil.Maulbeere.xT_4 OR Bellows.Maulbeere.xT_4;
        fbManual[2](xEnable := TRUE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[8..11]);
        axReq[8] := fbManual[2].bManValves.0; axReq[9] := fbManual[2].bManValves.1;
        axReq[10] := fbManual[2].bManValves.2; axReq[11] := fbManual[2].bManValves.3;

        bButtons.0 := Anvil.Felsenbirne.xT_1 OR Bellows.Felsenbirne.xT_1;
        bButtons.1 := Anvil.Felsenbirne.xT_2 OR Bellows.Felsenbirne.xT_2;
        bButtons.2 := Anvil.Felsenbirne.xT_3 OR Bellows.Felsenbirne.xT_3;
        bButtons.3 := Anvil.Felsenbirne.xT_4 OR Bellows.Felsenbirne.xT_4;
        fbManual[3](xEnable := TRUE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[12..15]);
        axReq[12] := fbManual[3].bManValves.0; axReq[13] := fbManual[3].bManValves.1;
        axReq[14] := fbManual[3].bManValves.2; axReq[15] := fbManual[3].bManValves.3;

        bButtons.0 := Anvil.Maibeere.xT_1 OR Bellows.Maibeere.xT_1;
        bButtons.1 := Anvil.Maibeere.xT_2 OR Bellows.Maibeere.xT_2;
        bButtons.2 := Anvil.Maibeere.xT_3 OR Bellows.Maibeere.xT_3;
        bButtons.3 := Anvil.Maibeere.xT_4 OR Bellows.Maibeere.xT_4;
        fbManual[4](xEnable := TRUE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[16..19]);
        axReq[16] := fbManual[4].bManValves.0; axReq[17] := fbManual[4].bManValves.1;
        axReq[18] := fbManual[4].bManValves.2; axReq[19] := fbManual[4].bManValves.3;

        bButtons.0 := Anvil.Johannisbeere.xT_1 OR Bellows.Johannisbeere.xT_1;
        bButtons.1 := Anvil.Johannisbeere.xT_2 OR Bellows.Johannisbeere.xT_2;
        bButtons.2 := Anvil.Johannisbeere.xT_3 OR Bellows.Johannisbeere.xT_3;
        bButtons.3 := Anvil.Johannisbeere.xT_4 OR Bellows.Johannisbeere.xT_4;
        fbManual[5](xEnable := TRUE, IN_Buttons := bButtons, tDebounce := tDebounce, aGranted := axGrant[20..23]);
        axReq[20] := fbManual[5].bManValves.0; axReq[21] := fbManual[5].bManValves.1;
        axReq[22] := fbManual[5].bManValves.2; axReq[23] := fbManual[5].bManValves.3;

    2:  (* One-Shot: 6x FB_MANUAL_SEQUENCE auf aValveJobs-Slices (ST_BedCfg).
           Anforderung = xSelected AND tDuration&gt;0 AND NOT fertig; Dauer-TON laedt am
           Arbiter-Grant, Restzeit = atMsRemaining -&gt; Bellows.Schrittkette.atRemaining. *)
        bButtons.0 := Anvil.Pfirsich.xT_1 OR Bellows.Schrittkette.axSelToggle[1];
        bButtons.1 := Anvil.Pfirsich.xT_2 OR Bellows.Schrittkette.axSelToggle[2];
        bButtons.2 := Anvil.Pfirsich.xT_3 OR Bellows.Schrittkette.axSelToggle[3];
        bButtons.3 := Anvil.Pfirsich.xT_4 OR Bellows.Schrittkette.axSelToggle[4];
        fbSequence[0](xMsEnable := TRUE, bMsButtons := bButtons, tMsDeb := tDebounce,
                      aBeds := Bellows.Zeitplan.aValveJobs[1..4], aGranted := axGrant[0..3]);
        axReq[0] := fbSequence[0].bMsValves.0; axReq[1] := fbSequence[0].bMsValves.1;
        axReq[2] := fbSequence[0].bMsValves.2; axReq[3] := fbSequence[0].bMsValves.3;
        Bellows.Schrittkette.atRemaining[1] := fbSequence[0].atMsRemaining[0];
        Bellows.Schrittkette.atRemaining[2] := fbSequence[0].atMsRemaining[1];
        Bellows.Schrittkette.atRemaining[3] := fbSequence[0].atMsRemaining[2];
        Bellows.Schrittkette.atRemaining[4] := fbSequence[0].atMsRemaining[3];

        bButtons.0 := Anvil.Stachelbeere.xT_1 OR Bellows.Schrittkette.axSelToggle[5];
        bButtons.1 := Anvil.Stachelbeere.xT_2 OR Bellows.Schrittkette.axSelToggle[6];
        bButtons.2 := Anvil.Stachelbeere.xT_3 OR Bellows.Schrittkette.axSelToggle[7];
        bButtons.3 := Anvil.Stachelbeere.xT_4 OR Bellows.Schrittkette.axSelToggle[8];
        fbSequence[1](xMsEnable := TRUE, bMsButtons := bButtons, tMsDeb := tDebounce,
                      aBeds := Bellows.Zeitplan.aValveJobs[5..8], aGranted := axGrant[4..7]);
        axReq[4] := fbSequence[1].bMsValves.0; axReq[5] := fbSequence[1].bMsValves.1;
        axReq[6] := fbSequence[1].bMsValves.2; axReq[7] := fbSequence[1].bMsValves.3;
        Bellows.Schrittkette.atRemaining[5] := fbSequence[1].atMsRemaining[0];
        Bellows.Schrittkette.atRemaining[6] := fbSequence[1].atMsRemaining[1];
        Bellows.Schrittkette.atRemaining[7] := fbSequence[1].atMsRemaining[2];
        Bellows.Schrittkette.atRemaining[8] := fbSequence[1].atMsRemaining[3];

        bButtons.0 := Anvil.Maulbeere.xT_1 OR Bellows.Schrittkette.axSelToggle[9];
        bButtons.1 := Anvil.Maulbeere.xT_2 OR Bellows.Schrittkette.axSelToggle[10];
        bButtons.2 := Anvil.Maulbeere.xT_3 OR Bellows.Schrittkette.axSelToggle[11];
        bButtons.3 := Anvil.Maulbeere.xT_4 OR Bellows.Schrittkette.axSelToggle[12];
        fbSequence[2](xMsEnable := TRUE, bMsButtons := bButtons, tMsDeb := tDebounce,
                      aBeds := Bellows.Zeitplan.aValveJobs[9..12], aGranted := axGrant[8..11]);
        axReq[8] := fbSequence[2].bMsValves.0; axReq[9] := fbSequence[2].bMsValves.1;
        axReq[10] := fbSequence[2].bMsValves.2; axReq[11] := fbSequence[2].bMsValves.3;
        Bellows.Schrittkette.atRemaining[9] := fbSequence[2].atMsRemaining[0];
        Bellows.Schrittkette.atRemaining[10] := fbSequence[2].atMsRemaining[1];
        Bellows.Schrittkette.atRemaining[11] := fbSequence[2].atMsRemaining[2];
        Bellows.Schrittkette.atRemaining[12] := fbSequence[2].atMsRemaining[3];

        bButtons.0 := Anvil.Felsenbirne.xT_1 OR Bellows.Schrittkette.axSelToggle[13];
        bButtons.1 := Anvil.Felsenbirne.xT_2 OR Bellows.Schrittkette.axSelToggle[14];
        bButtons.2 := Anvil.Felsenbirne.xT_3 OR Bellows.Schrittkette.axSelToggle[15];
        bButtons.3 := Anvil.Felsenbirne.xT_4 OR Bellows.Schrittkette.axSelToggle[16];
        fbSequence[3](xMsEnable := TRUE, bMsButtons := bButtons, tMsDeb := tDebounce,
                      aBeds := Bellows.Zeitplan.aValveJobs[13..16], aGranted := axGrant[12..15]);
        axReq[12] := fbSequence[3].bMsValves.0; axReq[13] := fbSequence[3].bMsValves.1;
        axReq[14] := fbSequence[3].bMsValves.2; axReq[15] := fbSequence[3].bMsValves.3;
        Bellows.Schrittkette.atRemaining[13] := fbSequence[3].atMsRemaining[0];
        Bellows.Schrittkette.atRemaining[14] := fbSequence[3].atMsRemaining[1];
        Bellows.Schrittkette.atRemaining[15] := fbSequence[3].atMsRemaining[2];
        Bellows.Schrittkette.atRemaining[16] := fbSequence[3].atMsRemaining[3];

        bButtons.0 := Anvil.Maibeere.xT_1 OR Bellows.Schrittkette.axSelToggle[17];
        bButtons.1 := Anvil.Maibeere.xT_2 OR Bellows.Schrittkette.axSelToggle[18];
        bButtons.2 := Anvil.Maibeere.xT_3 OR Bellows.Schrittkette.axSelToggle[19];
        bButtons.3 := Anvil.Maibeere.xT_4 OR Bellows.Schrittkette.axSelToggle[20];
        fbSequence[4](xMsEnable := TRUE, bMsButtons := bButtons, tMsDeb := tDebounce,
                      aBeds := Bellows.Zeitplan.aValveJobs[17..20], aGranted := axGrant[16..19]);
        axReq[16] := fbSequence[4].bMsValves.0; axReq[17] := fbSequence[4].bMsValves.1;
        axReq[18] := fbSequence[4].bMsValves.2; axReq[19] := fbSequence[4].bMsValves.3;
        Bellows.Schrittkette.atRemaining[17] := fbSequence[4].atMsRemaining[0];
        Bellows.Schrittkette.atRemaining[18] := fbSequence[4].atMsRemaining[1];
        Bellows.Schrittkette.atRemaining[19] := fbSequence[4].atMsRemaining[2];
        Bellows.Schrittkette.atRemaining[20] := fbSequence[4].atMsRemaining[3];

        bButtons.0 := Anvil.Johannisbeere.xT_1 OR Bellows.Schrittkette.axSelToggle[21];
        bButtons.1 := Anvil.Johannisbeere.xT_2 OR Bellows.Schrittkette.axSelToggle[22];
        bButtons.2 := Anvil.Johannisbeere.xT_3 OR Bellows.Schrittkette.axSelToggle[23];
        bButtons.3 := Anvil.Johannisbeere.xT_4 OR Bellows.Schrittkette.axSelToggle[24];
        fbSequence[5](xMsEnable := TRUE, bMsButtons := bButtons, tMsDeb := tDebounce,
                      aBeds := Bellows.Zeitplan.aValveJobs[21..24], aGranted := axGrant[20..23]);
        axReq[20] := fbSequence[5].bMsValves.0; axReq[21] := fbSequence[5].bMsValves.1;
        axReq[22] := fbSequence[5].bMsValves.2; axReq[23] := fbSequence[5].bMsValves.3;
        Bellows.Schrittkette.atRemaining[21] := fbSequence[5].atMsRemaining[0];
        Bellows.Schrittkette.atRemaining[22] := fbSequence[5].atMsRemaining[1];
        Bellows.Schrittkette.atRemaining[23] := fbSequence[5].atMsRemaining[2];
        Bellows.Schrittkette.atRemaining[24] := fbSequence[5].atMsRemaining[3];

    3:  (* Zeit-Scheduler wiederkehrend (Wochentag-gated). Altes 24er-Array (Umbau folgt). *)
        FOR iPlc := 0 TO 23 DO
            fbManualTime.axMtGranted[iPlc + 1] := axGrant[iPlc];
        END_FOR;
        fbManualTime(xMtEnable := TRUE, xMtRecurring := TRUE, bMtDays := Bellows.Zeitplan.bWeekMask);
        FOR iPlc := 0 TO 23 DO
            axReq[iPlc] := fbManualTime.axMtRequest[iPlc + 1];
        END_FOR;
END_CASE;

(* --- 3) Arbiter: max. uMaxVentile Freigaben + Warterang (Status-Graph). --- *)
fbArbiter(i_axReq := axReq);
axGrant := fbArbiter.o_axGrant;

(* Warterang je Ventil -&gt; HMI (0=offen/inaktiv, 1=naechstes, 2..=Position). *)
FOR iPlc := 0 TO 23 DO
    Bellows.Schrittkette.auQueue[iPlc + 1] := fbArbiter.o_auQueue[iPlc];
END_FOR;

(* Blink-Generator wartende Ventile: Takt aus der Betriebseinstellung Bellows.Betrieb.rBlinkHz [Hz],
   persistent, per HMI stellbar; 0.1 Hz = 5 s an / 5 s aus. Begrenzt auf 0.01..10 Hz,
   aktiv in Mode 1 (Manuell), 2 (One-Shot) und 3 (wiederkehrend). *)
rHz := Bellows.Betrieb.rBlinkHz;
IF rHz &lt; 0.01 THEN rHz := 0.1;  END_IF;
IF rHz &gt; 10.0 THEN rHz := 10.0; END_IF;
tBlinkHalb := DINT_TO_TIME(REAL_TO_DINT(500.0 / rHz));
fbBlinkMan(xBlEnable := (uMode &gt;= 1) AND (uMode &lt;= 3), tBlFlash := tBlinkHalb, tBlPause := tBlinkHalb);

(* --- 4) Ausgabe: Ventile (xV_1..4) = GRANT. Status-LEDs (xV_5..8) spiegeln Grant
   (in Mode 1..3 unten ueberblendet mit Blink). IO8R: xV_5..8 = xV_1..4. *)
Anvil.Pfirsich.xV_1 := axGrant[0]; Anvil.Pfirsich.xV_5 := axGrant[0];
Anvil.Pfirsich.xV_2 := axGrant[1]; Anvil.Pfirsich.xV_6 := axGrant[1];
Anvil.Pfirsich.xV_3 := axGrant[2]; Anvil.Pfirsich.xV_7 := axGrant[2];
Anvil.Pfirsich.xV_4 := axGrant[3]; Anvil.Pfirsich.xV_8 := axGrant[3];

Anvil.Stachelbeere.xV_1 := axGrant[4]; Anvil.Stachelbeere.xV_5 := axGrant[4];
Anvil.Stachelbeere.xV_2 := axGrant[5]; Anvil.Stachelbeere.xV_6 := axGrant[5];
Anvil.Stachelbeere.xV_3 := axGrant[6]; Anvil.Stachelbeere.xV_7 := axGrant[6];
Anvil.Stachelbeere.xV_4 := axGrant[7]; Anvil.Stachelbeere.xV_8 := axGrant[7];

Anvil.Maulbeere.xV_1 := axGrant[8];  Anvil.Maulbeere.xV_5 := axGrant[8];
Anvil.Maulbeere.xV_2 := axGrant[9];  Anvil.Maulbeere.xV_6 := axGrant[9];
Anvil.Maulbeere.xV_3 := axGrant[10]; Anvil.Maulbeere.xV_7 := axGrant[10];
Anvil.Maulbeere.xV_4 := axGrant[11]; Anvil.Maulbeere.xV_8 := axGrant[11];

Anvil.Felsenbirne.xV_1 := axGrant[12]; Anvil.Felsenbirne.xV_5 := axGrant[12];
Anvil.Felsenbirne.xV_2 := axGrant[13]; Anvil.Felsenbirne.xV_6 := axGrant[13];
Anvil.Felsenbirne.xV_3 := axGrant[14]; Anvil.Felsenbirne.xV_7 := axGrant[14];
Anvil.Felsenbirne.xV_4 := axGrant[15]; Anvil.Felsenbirne.xV_8 := axGrant[15];

Anvil.Johannisbeere.xV_1 := axGrant[20]; Anvil.Johannisbeere.xV_5 := axGrant[20];
Anvil.Johannisbeere.xV_2 := axGrant[21]; Anvil.Johannisbeere.xV_6 := axGrant[21];
Anvil.Johannisbeere.xV_3 := axGrant[22]; Anvil.Johannisbeere.xV_7 := axGrant[22];
Anvil.Johannisbeere.xV_4 := axGrant[23]; Anvil.Johannisbeere.xV_8 := axGrant[23];

Anvil.Maibeere.xV_1 := axGrant[16];
Anvil.Maibeere.xV_2 := axGrant[17];
Anvil.Maibeere.xV_3 := axGrant[18];
Anvil.Maibeere.xV_4 := axGrant[19];
Anvil.Maibeere.xV_5 := axGrant[16] OR axGrant[17] OR axGrant[18] OR axGrant[19];

(* --- 4b) Anzeige wartender Ventile (Mode 1..3): Status-LEDs (xV_5..8) = GRANT (offen) ODER
   angefordert-aber-nicht-offen -&gt; Blink im Takt rBlinkHz (fbBlinkMan). Gilt fuer die Taster-
   Anforderung (Manuell), angewaehlte Beete (One-Shot) und faellige Jobs (wiederkehrend).
   Die Ventile xV_1..4 folgen NUR dem Grant. *)
IF (uMode &gt;= 1) AND (uMode &lt;= 3) THEN
    Anvil.Pfirsich.xV_5 := axGrant[0] OR (axReq[0] AND NOT axGrant[0] AND fbBlinkMan.xBlQ);
    Anvil.Pfirsich.xV_6 := axGrant[1] OR (axReq[1] AND NOT axGrant[1] AND fbBlinkMan.xBlQ);
    Anvil.Pfirsich.xV_7 := axGrant[2] OR (axReq[2] AND NOT axGrant[2] AND fbBlinkMan.xBlQ);
    Anvil.Pfirsich.xV_8 := axGrant[3] OR (axReq[3] AND NOT axGrant[3] AND fbBlinkMan.xBlQ);

    Anvil.Stachelbeere.xV_5 := axGrant[4] OR (axReq[4] AND NOT axGrant[4] AND fbBlinkMan.xBlQ);
    Anvil.Stachelbeere.xV_6 := axGrant[5] OR (axReq[5] AND NOT axGrant[5] AND fbBlinkMan.xBlQ);
    Anvil.Stachelbeere.xV_7 := axGrant[6] OR (axReq[6] AND NOT axGrant[6] AND fbBlinkMan.xBlQ);
    Anvil.Stachelbeere.xV_8 := axGrant[7] OR (axReq[7] AND NOT axGrant[7] AND fbBlinkMan.xBlQ);

    Anvil.Maulbeere.xV_5 := axGrant[8]  OR (axReq[8]  AND NOT axGrant[8]  AND fbBlinkMan.xBlQ);
    Anvil.Maulbeere.xV_6 := axGrant[9]  OR (axReq[9]  AND NOT axGrant[9]  AND fbBlinkMan.xBlQ);
    Anvil.Maulbeere.xV_7 := axGrant[10] OR (axReq[10] AND NOT axGrant[10] AND fbBlinkMan.xBlQ);
    Anvil.Maulbeere.xV_8 := axGrant[11] OR (axReq[11] AND NOT axGrant[11] AND fbBlinkMan.xBlQ);

    Anvil.Felsenbirne.xV_5 := axGrant[12] OR (axReq[12] AND NOT axGrant[12] AND fbBlinkMan.xBlQ);
    Anvil.Felsenbirne.xV_6 := axGrant[13] OR (axReq[13] AND NOT axGrant[13] AND fbBlinkMan.xBlQ);
    Anvil.Felsenbirne.xV_7 := axGrant[14] OR (axReq[14] AND NOT axGrant[14] AND fbBlinkMan.xBlQ);
    Anvil.Felsenbirne.xV_8 := axGrant[15] OR (axReq[15] AND NOT axGrant[15] AND fbBlinkMan.xBlQ);

    Anvil.Johannisbeere.xV_5 := axGrant[20] OR (axReq[20] AND NOT axGrant[20] AND fbBlinkMan.xBlQ);
    Anvil.Johannisbeere.xV_6 := axGrant[21] OR (axReq[21] AND NOT axGrant[21] AND fbBlinkMan.xBlQ);
    Anvil.Johannisbeere.xV_7 := axGrant[22] OR (axReq[22] AND NOT axGrant[22] AND fbBlinkMan.xBlQ);
    Anvil.Johannisbeere.xV_8 := axGrant[23] OR (axReq[23] AND NOT axGrant[23] AND fbBlinkMan.xBlQ);

    Anvil.Maibeere.xV_5 := (axGrant[16] OR axGrant[17] OR axGrant[18] OR axGrant[19])
        OR (((axReq[16] AND NOT axGrant[16]) OR (axReq[17] AND NOT axGrant[17])
             OR (axReq[18] AND NOT axGrant[18]) OR (axReq[19] AND NOT axGrant[19])) AND fbBlinkMan.xBlQ);
END_IF;

(* --- 9) Geraete-/Modulueberwachung -&gt; HMI (Bellows.Diag). --- *)
xMonValid := TRUE;
axDevOnline[0] := Anvil.Pfirsich.Status.xOnline;
axDevOnline[1] := Anvil.Stachelbeere.Status.xOnline;
axDevOnline[2] := Anvil.Maulbeere.Status.xOnline;
axDevOnline[3] := Anvil.Felsenbirne.Status.xOnline;
axDevOnline[4] := Anvil.Maibeere.Status.xOnline;
axDevOnline[5] := Anvil.Johannisbeere.Status.xOnline;
axDevOnline[6] := Anvil.Schaltschrank.Status.xOnline;
fbBusMon(xBmValid := xMonValid, axBmOnline := axDevOnline);
Bellows.Diag.auDevState  := fbBusMon.auBmState;
Bellows.Diag.xAllOk      := fbBusMon.xBmAllOk;
Bellows.Diag.iFaultCount := fbBusMon.iBmFaultCount;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># PLC_PRG — Hauptprogramm Ackersteuerung

Zyklischer Ablauf: **1** Betriebsart→`uMode` · **2** Blink-Generator · **3** Grant-Feedback (Vorzyklus) + Zeit-Scheduler · **4** Manuell je Zone (Taster→JK-Toggle) · **5** 24 Ventil-Anforderungen sammeln (Manuell ODER Scheduler) · **6** 2-Ventil-Arbiter (max. 2) · **7** Freigaben→physische Ventile `xV_1..4` · **8** Programm-Anzeige `xV_5..8` · **9** Geräteüberwachung→`Bellows.Diag.*`.

**⚠️ TEMPORÄR (kein UR20 verbaut):** Der Wahlschalter sitzt auf `Anvil.Schaltschrank.DI_0..3` (UR20-Koppler). Da der UR20 derzeit **nicht verbaut** ist, sind diese DI nicht lesbar → die Betriebsart ist **fest auf Phase 1 (Manuell)** verdrahtet (`uMode := 1`). Der ursprüngliche One-Hot-Decode (DI_0=P1 / DI_1=P2 / DI_2=P3 / DI_3=P4, genau ein Bit aktiv, sonst sicher=0) ist im Body **auskommentiert erhalten** und ist zu **reaktivieren, sobald der UR20 verbaut** ist.

**Hinweis Überwachung:** Schaltschrank (Monitor-Index 6, UR20) meldet derzeit *offline*, da nicht verbaut.</xhtml>
        </documentation>
      </pou>
      <pou name="FC_GetKcValue" pouType="function">
        <interface>
          <returnType>
            <REAL/>
          </returnType>
          <localVars>
            <variable name="iDays_to_mid">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="dccde25e-4914-409d-ae58-ca57af4b5319"/>
                </data>
              </addData>
            </variable>
            <variable name="iDays_to_end">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="fc5dc62a-2ad5-481b-966a-5d1e6128c697"/>
                </data>
              </addData>
            </variable>
            <variable name="rFrac">
              <type>
                <REAL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="70391770-cf2c-4fed-97f0-bc9edcaf8260"/>
                </data>
              </addData>
            </variable>
          </localVars>
          <inputVars>
            <variable name="stKcCurve">
              <type>
                <derived name="ST_KcCurve"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="c5dbfd29-17e1-40b9-8d5b-c75412e34188"/>
                </data>
              </addData>
            </variable>
            <variable name="iDay_crop">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850053" createdMs="1788127850053" modifiedMs="1788127850053" uuid="b46d0cfa-18a8-4457-b09c-66d1bddf5155"/>
                </data>
              </addData>
            </variable>
          </inputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FC_GetKcValue  —  FAO-56 Kc-Pflanzenkoeffizient (Phase-4-Modell)
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau
   Datum   : 2026-06-05
   ----------------------------------------------------------------------------
   Zweck   : Liefert den Pflanzenkoeffizienten Kc fuer den Kultur-Tag iDay_crop
             aus der Kurve stKcCurve (FAO-56): Initial konstant; Development
             linear kc_initial-&gt;kc_mid; Mid-Season konstant kc_mid; Late linear
             kc_mid-&gt;kc_end; danach 0. Wasserbedarf ETc = ET0 * Kc.
   ============================================================================ *)

iDays_to_mid := stKcCurve.days_initial + stKcCurve.days_dev;
iDays_to_end := iDays_to_mid + stKcCurve.days_mid + stKcCurve.days_late;

IF iDay_crop &lt;= stKcCurve.days_initial THEN
    FC_GetKcValue := stKcCurve.kc_initial;

ELSIF iDay_crop &lt;= stKcCurve.days_initial + stKcCurve.days_dev THEN
    rFrac := REAL(iDay_crop - stKcCurve.days_initial) / REAL(stKcCurve.days_dev);
    FC_GetKcValue := stKcCurve.kc_initial + rFrac * (stKcCurve.kc_mid - stKcCurve.kc_initial);

ELSIF iDay_crop &lt;= iDays_to_mid + stKcCurve.days_mid THEN
    FC_GetKcValue := stKcCurve.kc_mid;

ELSIF iDay_crop &lt;= iDays_to_end THEN
    rFrac := REAL(iDay_crop - (iDays_to_mid + stKcCurve.days_mid)) / REAL(stKcCurve.days_late);
    FC_GetKcValue := stKcCurve.kc_mid + rFrac * (stKcCurve.kc_end - stKcCurve.kc_mid);

ELSE
    FC_GetKcValue := 0.0;
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FC_GetKcValue — FAO-56 Kc-Pflanzenkoeffizient (Phase-4-Modell)

Liefert den Pflanzenkoeffizienten Kc für den Kultur-Tag `iDay_crop` aus der Kurve `ST_KcCurve` (FAO-56): Initial konstant → Development linear `kc_initial→kc_mid` → Mid-Season konstant → Late linear `kc_mid→kc_end` → danach 0. Wasserbedarf **ETc = ET0 × Kc**. **Phase 4 zurückgestellt** — ET0-/Sensorik-Hardware (geplant per LoRaWAN) fehlt; Referenzmodell = Geisenheimer Steuerung (GSEHEN).</xhtml>
        </documentation>
      </pou>
