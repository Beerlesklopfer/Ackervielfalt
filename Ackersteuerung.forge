        <FddSegment name="MODBUS_NORD" id="1308afa0-5cf1-4e6a-a79c-f3d54bcf51fe" enabled="true" interface="end0" protocol="modbustcp">
          <FddSetting key="port" value="502"/>
          <FddSetting key="timeout_ms" value="2000"/>
          <FddDevice id="7ea5920d-f3d6-4a30-8eae-cbb2b215f22e" anvilGroup="Johannisbeere" catalogRef="Amsamotion/ETH-MODBUS-IO8R-A" displayOrder="5" hostname="Johannisbeere" ipAddress="192.168.24.24">
