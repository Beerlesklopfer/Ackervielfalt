            </variable>
            <variable name="aMtTon">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <derived name="TON"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="a31fd10a-6b41-4c7d-aeec-061e1694136f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bewaesserungs-Timer je Job; IN gated am Arbiter-Grant</xhtml>
              </documentation>
            </variable>
            <variable name="uMtNowMin">
              <type>
                <UINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="6d4f30f1-8c77-4a27-8c1d-74686e9af733"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Aktuelle Minute seit Mitternacht (UTC)</xhtml>
              </documentation>
            </variable>
            <variable name="uMtJobStartMin">
              <type>
                <UINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="1c58c020-abc4-411d-8b33-0663bb261dd9"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Startminute des aktuellen Jobs (Scratch)</xhtml>
              </documentation>
            </variable>
            <variable name="iMt">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="5f4e079d-6a40-47e4-833e-1c706d0ad258"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Schleifenindex 1..24</xhtml>
              </documentation>
            </variable>
            <variable name="uMtPrevDay">
              <type>
                <USINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="66e502b7-83f7-4b95-8124-582729bff97a"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Vorheriger tm_mday fuer Tageswechsel-Erkennung (P3 re-arm)</xhtml>
              </documentation>
            </variable>
            <variable name="uMtDayIdx">
              <type>
                <USINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="4fe43515-3ff8-4e37-9d1e-b5b6106bffd3"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Mo-basierter Wochentag-Index 0..6 (aus dtNow.tm_wday) zum Indizieren von bMtDays</xhtml>
              </documentation>
            </variable>
            <variable name="xMtDayOk">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="cdbfec71-d68f-41bf-8c11-6707c776175b"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Heutiger Wochentag in bMtDays freigegeben (konstanter Bit-Zugriff aus uMtDayIdx)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="axMtGranted">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="667343d4-83d8-417d-8289-41d69bd3e971"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Arbiter-Freigabe je Ventil; gated den Job-Timer -&gt; Job wird nie ausgelassen</xhtml>
              </documentation>
            </variable>
            <variable name="xMtEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="2a337fe3-1495-4420-9978-03ea7916d750"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Master-Enable der aktiven Zeit-Phase (P2/P3); FALSE = Reset aller Jobs</xhtml>
              </documentation>
            </variable>
            <variable name="xMtRecurring">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="0b2182f7-ba2f-420a-83ce-fcbe83ff9105"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">FALSE=One-Shot (P2, je Job 1x); TRUE=taeglich wiederkehrend (P3, re-arm bei Tageswechsel)</xhtml>
              </documentation>
            </variable>
            <variable name="bMtDays">
              <type>
                <BYTE/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="a2337b93-c9e3-43c3-af37-e9eb31d695a8"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Wochentag-Freigabe Mo..So (Index 0..6); gated wiederkehrende Jobs (P3)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="axMtRequest">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="32014efe-e18d-4679-9bd5-af6680270cde"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ventil-Anforderung an den Arbiter (Job faellig)</xhtml>
              </documentation>
            </variable>
            <variable name="axMtActive">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="dd414e00-6990-4100-926a-bd617d0a2439"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ventil bewaessert tatsaechlich (= angefordert UND Arbiter-Freigabe)</xhtml>
              </documentation>
            </variable>
            <variable name="xMtAllDone">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="fb4d0589-ed60-43ce-a668-3afbd14e6a62"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Alle aktiven Jobs abgearbeitet (heute)</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_MANUAL_TIME  —  Ventil-Job-Scheduler (Phase 2 One-Shot / Phase 3 wiederkehrend)
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-06-05 (Wochentag-Gate 2026-06-12)
   ----------------------------------------------------------------------------
   Zweck   : Arbeitet die zentrale Ventil-Job-Liste Bellows.Zeitplan.aValveJobs
             (ARRAY[1..24] OF ST_BedCfg) ab. Jeder Job j steuert Ventil j
             (Slot = Ventil; xSelected aktiviert den Job) und hat eine eigene
             Startzeit (uStartHour:uStartMin, UTC) und Dauer (tDuration).
             Erreicht die Uhr die Startzeit, wird das Ventil angefordert
             (axMtRequest). Der Bewaesserungs-Timer laeuft NUR, wenn der
             2-Ventil-Arbiter das Ventil tatsaechlich freigibt (axMtGranted) -&gt;
             ein faelliger Job WARTET hoechstens (max. 2 parallel), wird NIE
             ausgelassen. xMtRecurring=FALSE =&gt; je Job 1x (P2); TRUE =&gt; taeglich
             erneut (P3, re-arm bei Tageswechsel).
             WOCHENTAG-GATE (P3): bei wiederkehrend wird ein Job nur faellig,
             wenn der heutige Wochentag in bMtDays (BYTE-Bitmaske Bit0=Mo..Bit6=So)
             freigegeben ist. One-Shot (P2) ignoriert das Gate.
   HINWEIS : KEIN RETURN — der cxx-Transpiler kennt RETURN noch nicht. Der
             Disable-Reset laeuft daher als IF/ELSE-Zweig (kein early-exit).
   ============================================================================ *)

(* --- Zeitquelle: dtNow aktualisieren --- *)
fbMtTime();
uMtNowMin := USINT_TO_UINT(fbMtTime.dtNow.tm_hour) * 60 + USINT_TO_UINT(fbMtTime.dtNow.tm_min);

(* --- Wochentag-Index Mo=0..So=6 aus tm_wday (struct tm: So=0) --- *)
uMtDayIdx := ULINT_TO_USINT((USINT_TO_ULINT(fbMtTime.dtNow.tm_wday) + 6) MOD 7);

(* --- heutiger Wochentag in bMtDays freigegeben? Konstanter Bit-Zugriff --- *)
CASE uMtDayIdx OF
    0: xMtDayOk := bMtDays.0;
    1: xMtDayOk := bMtDays.1;
    2: xMtDayOk := bMtDays.2;
    3: xMtDayOk := bMtDays.3;
    4: xMtDayOk := bMtDays.4;
    5: xMtDayOk := bMtDays.5;
    6: xMtDayOk := bMtDays.6;
ELSE
    xMtDayOk := FALSE;
END_CASE;

IF NOT xMtEnable THEN
    (* Reset: alle Jobs idle, keine Anforderung *)
    FOR iMt := 1 TO 24 DO
        aMtState[iMt]    := 0;
        axMtRequest[iMt] := FALSE;
        axMtActive[iMt]  := FALSE;
        aMtTon[iMt](IN := FALSE, PT := T#1S);
    END_FOR;
    uMtPrevDay := fbMtTime.dtNow.tm_mday;
    xMtAllDone := FALSE;
ELSE
    (* --- Tageswechsel: bei wiederkehrend (P3) alle Jobs re-armen --- *)
    IF fbMtTime.dtNow.tm_mday &lt;&gt; uMtPrevDay THEN
        IF xMtRecurring THEN
            FOR iMt := 1 TO 24 DO
                aMtState[iMt] := 0;
            END_FOR;
        END_IF;
        uMtPrevDay := fbMtTime.dtNow.tm_mday;
    END_IF;

    (* --- Pro Job: Faelligkeit, Anforderung, Timer (gated am Arbiter-Grant) --- *)
    FOR iMt := 1 TO 24 DO
        IF (Bellows.Zeitplan.aValveJobs[iMt].xSelected)
           AND (Bellows.Zeitplan.aValveJobs[iMt].tDuration &gt; T#0S) THEN

            uMtJobStartMin := USINT_TO_UINT(Bellows.Zeitplan.aValveJobs[iMt].uStartHour) * 60
                              + BYTE_TO_UINT(Bellows.Zeitplan.aValveJobs[iMt].uStartMin);

            (* IDLE/armed -&gt; pending: Startzeit erreicht UND (bei wiederkehrend)
               heutiger Wochentag freigegeben. One-Shot ignoriert das Wochentag-Gate. *)
            IF aMtState[iMt] = 0 THEN
                IF (uMtNowMin &gt;= uMtJobStartMin)
                   AND ((NOT xMtRecurring) OR xMtDayOk) THEN
                    aMtState[iMt] := 1;
                END_IF;
            END_IF;

            IF aMtState[iMt] = 1 THEN
                (* faellig: anfordern; Timer NUR bei Arbiter-Freigabe -&gt; nie ausgelassen *)
                axMtRequest[iMt] := TRUE;
                axMtActive[iMt]  := axMtGranted[iMt];
                aMtTon[iMt](IN := axMtGranted[iMt], PT := Bellows.Zeitplan.aValveJobs[iMt].tDuration);
                IF aMtTon[iMt].Q THEN
                    aMtState[iMt]    := 2;
                    axMtRequest[iMt] := FALSE;
                    axMtActive[iMt]  := FALSE;
                    aMtTon[iMt](IN := FALSE, PT := T#1S);
                END_IF;
            ELSE
                (* idle oder done: keine Anforderung *)
                axMtRequest[iMt] := FALSE;
                axMtActive[iMt]  := FALSE;
            END_IF;
        ELSE
            (* inaktiver Job (nicht selektiert oder Dauer 0) *)
            aMtState[iMt]    := 2;
            axMtRequest[iMt] := FALSE;
            axMtActive[iMt]  := FALSE;
        END_IF;
    END_FOR;

    (* --- AllDone: kein Job mehr armed/pending --- *)
    xMtAllDone := TRUE;
    FOR iMt := 1 TO 24 DO
        IF aMtState[iMt] &lt; 2 THEN
            xMtAllDone := FALSE;
        END_IF;
    END_FOR;
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_MANUAL_TIME — Ventil-Job-Scheduler (Phase 2 / Phase 3)

Arbeitet die zentrale Job-Liste `Bellows.Zeitplan.aValveJobs : ARRAY[1..24] OF ST_BedCfg` ab. Jeder Job steuert **ein Ventil** (`uValveIdx`, 0=inaktiv) mit **eigener Startzeit** (`uStartHour:uStartMin`, UTC) und **Dauer** (`tDuration`). Bei Erreichen der Startzeit Anforderung (`axMtRequest`); der Dauer-Timer läuft **nur bei Arbiter-Freigabe** (`axMtGranted`) → ein Job wartet höchstens, wird **nie ausgelassen**. `xMtRecurring`=FALSE → One-Shot (P2, je Job 1×); TRUE → täglich wiederkehrend (P3, re-arm bei Tageswechsel). Zeitquelle: interne `FB_WEEKLY_TIMER`-Instanz (`dtNow`).</xhtml>
        </documentation>
      </pou>
      <pou name="FB_DEVICE_MONITOR" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="tonDmFault">
              <type>
                <derived name="TON"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="5c411c59-1508-4831-9f45-b336f9f4001e"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprell-Timer Offline</xhtml>
              </documentation>
            </variable>
            <variable name="tonDmRecover">
              <type>
                <derived name="TON"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="03b7d9ea-568b-42c5-bc49-5b59bbde8fb6"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprell-Timer Wiederkehr (stabil online)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xStatusValid">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="edf3a43a-26c0-4e13-8d5f-fdd7f5558de4"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Status-Quelle liefert Daten; FALSE = Quelle fehlt -&gt; Zustand Unbekannt</xhtml>
              </documentation>
            </variable>
            <variable name="xOnline">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="18205581-6175-442d-ae3f-528c41d144c5"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Geraet antwortet (Modbus-Transaktion ok); nur gueltig bei xStatusValid</xhtml>
              </documentation>
            </variable>
            <variable name="tDmFault">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#3S"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="85bfa546-5213-46fe-83c4-6771232c14bb"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprellung: Dauer ohne Antwort bis OFFLINE</xhtml>
              </documentation>
            </variable>
            <variable name="tDmRecover">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#2S"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="5854fc34-0642-4f3e-af16-492adcd8c371"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Dauer stabil online bis wieder ONLINE</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="uDmState">
              <type>
                <USINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="97763c00-282a-4044-9f67-23b559136580"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zustand: 0=Unbekannt, 1=Online, 2=Gestoert, 3=Offline</xhtml>
              </documentation>
            </variable>
            <variable name="sDmStatus">
              <type>
                <string/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="b8ff3185-ed62-4ec3-9cf7-265ac467672f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Klartext-Status fuer die HMI</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_DEVICE_MONITOR  —  Geraete-/Modulueberwachung mit Zustandsgraph + Klartext
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-06-06
   ----------------------------------------------------------------------------
   Zweck   : Ueberwacht den Comm-Status EINES Modbus-Geraets (bzw. Moduls) und
             liefert einen entprellten Zustand + einen KLARTEXT-STRING fuer die
             HMI (die rohen Status-Bits werden nicht an die HMI durchgereicht).
             Eingang xOnline kommt aus dem Runtime-Comm-Status (sobald verfuegbar);
             xStatusValid=FALSE =&gt; Quelle fehlt =&gt; Zustand Unbekannt.

   Zustandsgraph (uDmState):
     0 Unbekannt --(Quelle gueltig)--&gt; Online (xOnline) | Offline (sonst)
     1 Online    --(kurzer Aussetzer)--&gt; Gestoert
                 --(Offline laenger als tDmFault)--&gt; Offline
     2 Gestoert  --(stabil online tDmRecover)--&gt; Online
                 --(Offline laenger als tDmFault)--&gt; Offline
     3 Offline   --(stabil online tDmRecover)--&gt; Online
   HINWEIS : KEIN RETURN — der cxx-Transpiler kennt RETURN noch nicht. Der
             &quot;Quelle fehlt&quot;-Zweig laeuft daher als IF/ELSE (kein early-exit).
   ============================================================================ *)

(* --- Ohne gueltige Quelle: Unbekannt, Timer ruhen --- *)
IF NOT xStatusValid THEN
    uDmState  := 0;
    sDmStatus := 'Status-Quelle fehlt';
    tonDmFault(IN := FALSE, PT := tDmFault);
    tonDmRecover(IN := FALSE, PT := tDmRecover);
ELSE
    (* --- Entprell-Timer --- *)
    tonDmFault(IN := NOT xOnline, PT := tDmFault);
    tonDmRecover(IN := xOnline, PT := tDmRecover);

    (* --- Zustandsgraph --- *)
    IF uDmState = 0 THEN
        IF xOnline THEN uDmState := 1; ELSE uDmState := 3; END_IF;
    ELSIF NOT xOnline THEN
        IF tonDmFault.Q THEN
            uDmState := 3;                 (* dauerhaft weg -&gt; Offline *)
        ELSIF uDmState = 1 THEN
            uDmState := 2;                 (* kurzer Aussetzer -&gt; Gestoert *)
        END_IF;
    ELSE
        IF tonDmRecover.Q THEN
            uDmState := 1;                 (* stabil zurueck -&gt; Online *)
        END_IF;
    END_IF;

    (* --- Klartext fuer die HMI --- *)
    IF    uDmState = 1 THEN sDmStatus := 'Online';
    ELSIF uDmState = 2 THEN sDmStatus := 'Gestoert';
    ELSIF uDmState = 3 THEN sDmStatus := 'Keine Verbindung';
    ELSE                    sDmStatus := 'Unbekannt';
    END_IF;
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_DEVICE_MONITOR — Geräte-/Modul-Zustandsgraph + Klartext

Überwacht den Comm-Status EINES Geräts/Moduls. Zustandsgraph `uDmState`: **0 Unbekannt → 1 Online → 2 Gestört → 3 Offline** (entprellt über `tDmFault`/`tDmRecover`). Eingänge `xStatusValid` (Quelle liefert Daten) + `xOnline` (Gerät antwortet). Ausgabe: `uDmState` + **Klartext-STRING** `sDmStatus` (`Online`/`Gestört`/`Keine Verbindung`/`Unbekannt`/`Status-Quelle fehlt`). **Quellen-agnostisch** — passt auf Modbus-Comm-Status UND LoRaWAN-Uplink-Liveness.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_BUS_MONITOR" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="afbBmMon">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <derived name="FB_DEVICE_MONITOR"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="9377c429-e810-4c1d-90e3-b642055f11ed"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Pro-Geraet-Zustandsgraph-Instanzen</xhtml>
              </documentation>
            </variable>
            <variable name="iBm">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="93c0a81b-45d8-4f9b-bb22-de8df98f04a9"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Schleifenindex 0..6</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xBmValid">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="92c9aa03-1d38-4b6b-b76e-64991d9e03a5"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Status-Quelle (Dev-Monitor / LoRaWAN-Netzserver) liefert Daten</xhtml>
              </documentation>
            </variable>
            <variable name="axBmOnline">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="86281eca-5b51-4399-bb5e-370bdff22859"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Online je Geraet: 0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne 4=Maibeere 5=Johannisbeere 6=Schaltschrank</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="asBmStatus">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <string/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="67a74903-ffc8-4cee-98cb-1edffc163f44"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Klartext-Status je Geraet (fuer HMI)</xhtml>
              </documentation>
            </variable>
            <variable name="auBmState">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <USINT/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="9720bacb-1f38-43b0-a26e-40d3b1e064da"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zustand je Geraet (0=Unbekannt 1=Online 2=Gestoert 3=Offline)</xhtml>
              </documentation>
            </variable>
            <variable name="xBmAllOk">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="3445eacf-5770-472e-b892-d3d0b4b9c73f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = alle Geraete online</xhtml>
              </documentation>
            </variable>
            <variable name="iBmFaultCount">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="52387c70-cb19-4ba6-bcbf-fcaee362a979"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Anzahl Geraete nicht online (Gestoert/Offline/Unbekannt)</xhtml>
              </documentation>
            </variable>
            <variable name="sBmSummary">
              <type>
                <string/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="c86f8d9d-ea37-4144-a583-a1065d7b78af"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sammel-Klartext fuer die HMI</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_BUS_MONITOR  —  Aggregierte Geraete-/Modulueberwachung fuer die HMI
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-06-06
   ----------------------------------------------------------------------------
   Zweck   : Fuehrt je ueberwachtem Geraet eine FB_DEVICE_MONITOR-Instanz
             (Zustandsgraph + Klartext) und buendelt die Ergebnisse fuer die
             HMI: Klartext je Geraet (asBmStatus), Zustand je Geraet (auBmState),
             Sammel-OK (xBmAllOk), Fehlerzahl (iBmFaultCount) und eine
             Sammelmeldung (sBmSummary).
             Quelle der Online-Bits (axBmOnline) liefert die Runtime-Monitor-
             Schicht (Dev) bzw. der LoRaWAN-Netzserver (Uplink-Liveness). Bis
             dahin xBmValid=FALSE -&gt; alle Geraete 'Status-Quelle fehlt'.
             Geraete-Index: 0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne
             4=Maibeere 5=Johannisbeere 6=Schaltschrank.
   ============================================================================ *)

xBmAllOk      := TRUE;
iBmFaultCount := 0;

FOR iBm := 0 TO 6 DO
    afbBmMon[iBm](xStatusValid := xBmValid, xOnline := axBmOnline[iBm]);
    auBmState[iBm]  := afbBmMon[iBm].uDmState;
    asBmStatus[iBm] := afbBmMon[iBm].sDmStatus;
    IF afbBmMon[iBm].uDmState &lt;&gt; 1 THEN          (* alles ausser Online = Stoerung *)
        xBmAllOk      := FALSE;
        iBmFaultCount := iBmFaultCount + 1;
    END_IF;
END_FOR;

(* --- Sammelmeldung (Klartext) fuer die HMI --- *)
IF NOT xBmValid THEN
    sBmSummary := 'Ueberwachung: Status-Quelle fehlt';
ELSIF xBmAllOk THEN
    sBmSummary := 'Alle Geraete online';
ELSE
    sBmSummary := 'Stoerung: Geraet(e) nicht online';
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_BUS_MONITOR — Aggregierte Geräteüberwachung für die HMI

Führt je Gerät eine `FB_DEVICE_MONITOR`-Instanz (7 Geräte) und bündelt: Zustand (`auBmState`) + Klartext (`asBmStatus`) je Gerät, Sammel-OK (`xBmAllOk`), Fehlerzahl (`iBmFaultCount`), Sammel-Klartext (`sBmSummary`). Eingänge: `xBmValid` + `axBmOnline[0..6]` (0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne 4=Maibeere 5=Johannisbeere 6=Schaltschrank), gespeist aus `Anvil.&lt;grp&gt;.Status.xOnline`. In PLC_PRG §9 → `Bellows.Diag.*` (HMI rendert Klartext aus dem Zustandscode).</xhtml>
        </documentation>
      </pou>
      <pou name="Diag" pouType="program">
        <interface>
          <globalVars>
            <variable name="asDevStatus" address="%MD1">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <string/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385094" addressLocked="true" bellowsRead="true" createdMs="1780699384752" modifiedMs="1780699385094" monitorEnabled="true" uuid="27af31e6-0d91-46ca-9575-49a98d7142da"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Klartext-Status je Geraet fuer HMI (0=Pfirsich..5=Johannisbeere,6=Schaltschrank)</xhtml>
              </documentation>
            </variable>
            <variable name="auDevState" address="%MD2">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <USINT/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385094" addressLocked="true" bellowsRead="true" createdMs="1780699384904" modifiedMs="1780699385094" monitorEnabled="true" uuid="d202e036-1091-496d-ac27-a308540bcfb0"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zustand je Geraet fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)</xhtml>
              </documentation>
            </variable>
            <variable name="sSummary" address="%MD3">
              <type>
                <string/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385578" addressLocked="true" bellowsRead="true" createdMs="1780699385368" modifiedMs="1780699385578" monitorEnabled="true" uuid="92611cc2-fd70-434b-928e-0cedd9e6d0a7"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sammel-Klartext der Geraeteueberwachung fuer HMI</xhtml>
              </documentation>
            </variable>
            <variable name="xAllOk" address="%MX0.0">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385993" addressLocked="true" bellowsRead="true" createdMs="1780699385783" modifiedMs="1780699385993" monitorEnabled="true" uuid="a0a5abb3-f8d4-45d0-a22e-19449e994651"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = alle Geraete online (HMI-Sammelanzeige)</xhtml>
              </documentation>
            </variable>
            <variable name="iFaultCount" address="%MW0">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699386657" addressLocked="true" bellowsRead="true" createdMs="1780699386467" modifiedMs="1780699386657" monitorEnabled="true" uuid="1010277f-c23d-4dca-83a1-cb1014b4f3d5"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Anzahl Geraete nicht online (HMI)</xhtml>
              </documentation>
            </variable>
          </globalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe Diag: Geraeteueberwachung fuer die HMI. auDevState[0..6] Zustand je Geraet (0 Unbekannt, 1 Online, 2 Gestoert, 3 Keine Verbindung), asDevStatus und sSummary als Klartext, xAllOk und iFaultCount als Sammelmeldung. Index 0 Pfirsich, 1 Stachelbeere, 2 Maulbeere, 3 Felsenbirne, 4 Maibeere, 5 Johannisbeere, 6 Schaltschrank.</xhtml>
        </documentation>
      </pou>
      <pou name="Betrieb" pouType="program">
        <interface>
          <globalVars>
            <variable name="xManuell" address="%MX0.1">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782499931954" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1780835523502" label="Handbetrieb" modifiedMs="1782499931954" monitorEnabled="true" persistent="true" uuid="d75f0f54-ddf5-4dc0-812f-62990b32886d"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Betriebsart Manuell (uMode 1): Taster am Beet oder HMI schalten das Ventil um, der Arbiter gibt frei; wartende Ventile blinken im Takt rBlinkHz. Genau eine der vier Betriebsarten darf gesetzt sein, sonst gilt Aus (uMode 0, alle Ventile zu). Von der HMI gesetzt, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="xOneShot" address="%MX0.2">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782499933237" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1780835558147" label="Einmal-Lauf" modifiedMs="1782499933237" monitorEnabled="true" persistent="true" uuid="1f17e1d0-fb06-4a53-bfdc-228ee869811a"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Betriebsart One-Shot (uMode 2): die in aValveJobs angewaehlten Beete laufen je einmal ihre Dauer; die Dauer zaehlt erst ab der Arbiter-Freigabe, kein Beet wird uebersprungen. Angewaehlte, noch wartende Beete blinken. Genau eine Betriebsart, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="xWiederkehrend" address="%MX0.3">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782499934557" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1780835567548" label="Wiederkehrend" modifiedMs="1782499934557" monitorEnabled="true" persistent="true" uuid="cfe844dc-bee2-4d44-9809-3aa46258ad2c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Betriebsart wiederkehrend (uMode 3): jedes angewaehlte Beet startet an den Wochentagen aus Zeitplan.bWeekMask zu seiner Startzeit aus aValveJobs und laeuft seine Dauer. Genau eine Betriebsart, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="xAuto" address="%MX0.4">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782499930176" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1780835581325" force="true" label="Automatik" modifiedMs="1782499930176" monitorEnabled="true" persistent="true" uuid="202e3cb0-7d6b-45ca-a049-a33cd4272454"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Betriebsart Auto (uMode 4, Bedarf nach Kc/ET0): zurueckgestellt, weil Wetter- und Bodensensorik fehlen. Gewaehlt oeffnet sie kein Ventil. Genau eine Betriebsart, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="uModeActive" address="%MB0">
              <type>
                <USINT/>
              </type>
              <initialValue>
                <simpleValue value="0"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1781336329254" addressLocked="true" bellowsRead="true" createdMs="1781216915539" modifiedMs="1781336329254" monitorEnabled="true" persistent="true" uuid="4ccabb88-05f2-49d5-8cfd-ff62205058d1"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bestätigte Betriebsart (Spiegel von PLC_PRG.uMode One-Hot-Decode): 0=invalid/sicher, 1=Manuell, 2=One-Shot, 3=wiederkehrend, 4=Auto. Read-only Feedback an HMI (Bellows/Betrieb).</xhtml>
              </documentation>
            </variable>
            <variable name="uMaxVentile" address="%MB2">
              <type>
                <USINT/>
              </type>
              <initialValue>
                <simpleValue value="24"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1785368375714" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1781477239426" label="Max. offene Ventile" modifiedMs="1785368375714" monitorEnabled="true" persistent="true" uuid="db1f89d9-48fc-4b39-9300-fbca38abea4c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Hoechstzahl gleichzeitig offener Ventile (Wasserdruck, Pumpenleistung). FB_VALVE_ARBITER begrenzt auf 1..24; weitere Anforderungen warten in Index-Reihenfolge, der Warterang steht in Schrittkette.auQueue. Startwert 24. Von der HMI gesetzt, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="rBlinkHz">
              <type>
                <REAL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" bellowsRead="true" bellowsWrite="true" label="Blinkfrequenz wartende Ventile [Hz]" monitorEnabled="true" persistent="true" setting="true" uuid="98ec68a7-c512-45a9-b244-73866f0676c2"/>
                </data>
              </addData>
              <initialValue>
                <simpleValue value="0.1"/>
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blinkfrequenz der Status-LEDs wartender Ventile in den Betriebsarten Manuell, One-Shot und wiederkehrend, in Hz: angefordert, aber vom Arbiter noch nicht freigegeben. PLC_PRG begrenzt auf 0.01..10 Hz, ein Wert unter 0.01 gilt als 0.1. Startwert 0.1 Hz = 5 s an / 5 s aus. Von der HMI gesetzt, persistent.</xhtml>
              </documentation>
            </variable>
          </globalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe Betrieb: Betriebsartwahl xManuell, xOneShot, xWiederkehrend, xAuto (genau eine gesetzt, sonst Aus), die bestaetigte Betriebsart uModeActive (0 Aus, 1 Manuell, 2 One-Shot, 3 wiederkehrend, 4 Auto) und die Einstellwerte uMaxVentile und rBlinkHz. Wahl und Einstellwerte sind persistent.</xhtml>
        </documentation>
      </pou>
      <pou name="HmiCmd" pouType="program">
        <interface/>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe HmiCmd: derzeit ohne Variablen.</xhtml>
        </documentation>
      </pou>
      <pou name="Schrittkette" pouType="program">
        <interface>
          <globalVars>
            <variable name="xStart" address="%MX0.5">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1781480919950" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1781480906406" modifiedMs="1781480919950" monitorEnabled="true" uuid="5962be06-9e5b-4788-9906-1c4645d52739"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Startimpuls One-Shot-Schrittkette (Puls via Handshake). Steigende Flanke armt die selektierten Beete.</xhtml>
              </documentation>
            </variable>
            <variable name="xStop" address="%MX0.6">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782427653719" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782423575765" modifiedMs="1782427653719" monitorEnabled="true" uuid="49cafa8c-6799-4231-aed8-a425c581f63b"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Stop One-Shot-Schrittkette (Puls via Handshake). Bricht den laufenden Lauf ab: alle Ventile zu, Schritte -&gt; idle; neuer Start noetig.</xhtml>
              </documentation>
            </variable>
            <variable name="xPause" address="%MX0.7">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782427660027" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782423631920" modifiedMs="1782427660027" monitorEnabled="true" uuid="ea732196-d683-414e-85a8-f434a039d95f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Pause One-Shot-Schrittkette (Halten/Toggle via Handshake). Pause: Ventile zu + Restzeit-Timer eingefroren; erneut = fortsetzen (Ventile wieder auf).</xhtml>
              </documentation>
            </variable>
            <variable name="xQuit" address="%MX1.0">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782427657942" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782423654011" modifiedMs="1782427657942" monitorEnabled="true" uuid="af5c4667-15b9-41f1-83c1-1c64cc4e5429"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Quittieren One-Shot-Schrittkette (Puls via Handshake). Loescht den Fertig-/Stoerungs-Status (xSeqAllDone) nach einem Lauf.</xhtml>
              </documentation>
            </variable>
            <variable name="axSelToggle" address="%MD6">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782429299638" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782429286940" modifiedMs="1782429299638" monitorEnabled="true" uuid="29d9785c-2b11-42b3-9c8b-a73a1e4b09b1"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Anwahl-Puls je Beet (momentan, schreibbar). FB_MANUAL toggelt daraus axSelected. Ersetzt das Schreiben auf den nicht-schreibbaren Anvil-Taster xT.</xhtml>
              </documentation>
            </variable>
            <variable name="atRemaining" address="%MD7">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <TIME/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782514283409" addressLocked="true" bellowsRead="true" createdMs="1782514124980" modifiedMs="1782514283409" monitorEnabled="true" uuid="5a0e6a98-8fd8-41af-bec9-7d3947c2c688"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Live-Restzeit je Ventil (1..24) = tDuration - TON.ET aus FB_MANUAL_SEQUENCE, von PLC_PRG (Mode 2) geschrieben. NICHT-retained (jeden Zyklus neu berechnet). HMI-Countdown der One-Shot-Bewaesserung; tDuration bleibt der Preset.</xhtml>
              </documentation>
            </variable>
            <variable name="auQueue" address="%MD8">
              <type>
                <array>
                  <dimension lower="1" upper="24"/>
                  <baseType>
                    <USINT/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782518088665" addressLocked="true" bellowsRead="true" createdMs="1782518088473" modifiedMs="1782518088665" monitorEnabled="true" uuid="9be6d5cf-0536-42d6-952c-269db6866ef6"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Warterang je Ventil (1..24) aus FB_VALVE_ARBITER: 0=offen/inaktiv, 1=als naechstes dran, 2..=Warteposition (Index-Prioritaet). Non-retained, von PLC_PRG geschrieben. HMI zeigt wartenden Beeten ihren Platz in der Schlange.</xhtml>
              </documentation>
            </variable>
          </globalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe Schrittkette: Anwahl-Puls je Beet fuer One-Shot (axSelToggle), Restzeit je Ventil (atRemaining) und Warterang aus dem Arbiter (auQueue, 0 = offen oder inaktiv, 1 = als naechstes). Die Befehle xStart, xStop, xPause und xQuit sind angelegt, werden vom Programm aber noch nicht ausgewertet.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_MANUAL_SEQUENCE" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="fbMsJk">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <derived name="JK_FF"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="cb398e0c-5b84-47c6-ba1e-1fcc25d5f24b"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Anwahl-Flipflop je Beet (ARRAY[0..3]). J=K=TRUE -&gt; jeder entprellte Tastendruck toggelt; RESET := NOT xMsEnable. Q wird nach aBeds[i].xSelected gespiegelt (= aValveJobs[N].xSelected, das das HMI fuer Anwahl/Blink liest).</xhtml>
              </documentation>
            </variable>
            <variable name="aMsTon">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <derived name="TON"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="4201056c-a0b1-4cb7-987d-addd7fbbf5d4"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Dauer-TON je Beet: IN am Arbiter-Grant geladen, PT=tDuration (Preset); ET = Laufzeit, Q = fertig</xhtml>
              </documentation>
            </variable>
            <variable name="aMsDone">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="b25556d2-58b7-4787-be0e-2ff93f454bd1"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Fertig-Latch je Beet: gesetzt bei TON.Q, rueckgesetzt bei Abwahl (NOT xSelected)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="bMsButtons">
              <type>
                <BYTE/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="69a6ac53-a1e3-40ef-b45e-eaf21e2a752c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprellte Taster-Eingaenge der Zone, Bit0..3 = die 4 Beete/Ventile. Jede steigende Flanke toggelt die Anwahl des zugehoerigen Beets (ueber fbMsJk -&gt; aBeds[i].xSelected). Quelle in PLC_PRG: Anvil-HW-Taster ODER HMI-Anwahl-Puls (Bellows.Schrittkette.axSelToggle).</xhtml>
              </documentation>
            </variable>
            <variable name="xMsEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="6b66fed4-dee1-439b-aee9-478e3060226e"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Master-Enable der One-Shot-Zone. FALSE setzt alle Anwahl-Flipflops zurueck (RESET der JK_FFs) -&gt; Anwahl faellt, kein Ventil. Wird in PLC_PRG nur im One-Shot-Modus (uMode=2) auf TRUE gerufen; in anderen Modi nicht aufgerufen -&gt; Instanz-Zustand friert ein.</xhtml>
              </documentation>
            </variable>
            <variable name="tMsDeb">
              <type>
                <TIME/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="7c926c67-9e95-44dd-8a82-765c46fc7963"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprellzeit der Taster (an JK_FF.tDebounce). Ein Tastendruck zaehlt erst nach stabiler Anliegezeit &gt; tMsDeb als gueltige Flanke.</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="bMsValves">
              <type>
                <BYTE/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="997404a5-c9f2-4f4e-afb3-cd097b964519"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ventil-Anforderung an den Arbiter, Bit0..3 = die 4 Ventile der Zone. Bit gesetzt = Beet angewaehlt (xSelected) UND Restdauer tDuration &gt; 0. Geht in PLC_PRG in axReq und damit in den 2-Ventil-Arbiter.</xhtml>
              </documentation>
            </variable>
            <variable name="atMsRemaining">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <TIME/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="7caf9a02-91bb-4f10-b303-967601d5f997"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Current value je Ventil = Restzeit = tDuration - TON.ET (idle=voller Preset, fertig=0); fuers HMI</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <inOutVars>
            <variable name="aGranted">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="89d5ac95-490e-4fc6-826a-8be8ff8833b3"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Arbiter-Freigabe-Slice der Zone (VAR_IN_OUT, ARRAY[0..3]). Gated den 1s-Tick (aMsTick TON): ein Beet zaehlt seine tDuration NUR runter, waehrend echte Freigabe anliegt -&gt; Staffelung (max. uMaxVentile gleichzeitig), kein Beet wird ausgelassen.</xhtml>
              </documentation>
            </variable>
            <variable name="aBeds">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <derived name="ST_BedCfg"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="3a3ce829-5b14-4439-b3a3-2c8f4f0c08e4"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">ST_BedCfg-Slice der Zone (VAR_IN_OUT) = aValveJobs[z*4+1..z*4+4]: Auswahl xSelected + Dauer/Countdown tDuration (in-place).</xhtml>
              </documentation>
            </variable>
          </inOutVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fbMsJk[0](xButton := bMsButtons.0, tDebounce := tMsDeb, J := TRUE, K := TRUE, RESET := NOT xMsEnable);
fbMsJk[1](xButton := bMsButtons.1, tDebounce := tMsDeb, J := TRUE, K := TRUE, RESET := NOT xMsEnable);
fbMsJk[2](xButton := bMsButtons.2, tDebounce := tMsDeb, J := TRUE, K := TRUE, RESET := NOT xMsEnable);
fbMsJk[3](xButton := bMsButtons.3, tDebounce := tMsDeb, J := TRUE, K := TRUE, RESET := NOT xMsEnable);

aBeds[0].xSelected := fbMsJk[0].Q;
aBeds[1].xSelected := fbMsJk[1].Q;
aBeds[2].xSelected := fbMsJk[2].Q;
aBeds[3].xSelected := fbMsJk[3].Q;

(* --- 2) Anforderung + Dauer-TON (laedt mit Grant, tDuration bleibt Preset) --- *)
(* Beet 0 *)
IF NOT aBeds[0].xSelected THEN aMsDone[0] := FALSE; END_IF;
bMsValves.0 := xMsEnable AND aBeds[0].xSelected AND (aBeds[0].tDuration &gt; T#0S) AND NOT aMsDone[0];
aMsTon[0](IN := bMsValves.0 AND aGranted[0], PT := aBeds[0].tDuration);
IF aMsTon[0].Q THEN aMsDone[0] := TRUE; END_IF;
IF aMsDone[0] THEN atMsRemaining[0] := T#0S;
ELSE atMsRemaining[0] := aBeds[0].tDuration - aMsTon[0].ET; END_IF;
(* Beet 1 *)
IF NOT aBeds[1].xSelected THEN aMsDone[1] := FALSE; END_IF;
bMsValves.1 := xMsEnable AND aBeds[1].xSelected AND (aBeds[1].tDuration &gt; T#0S) AND NOT aMsDone[1];
aMsTon[1](IN := bMsValves.1 AND aGranted[1], PT := aBeds[1].tDuration);
IF aMsTon[1].Q THEN aMsDone[1] := TRUE; END_IF;
IF aMsDone[1] THEN atMsRemaining[1] := T#0S;
ELSE atMsRemaining[1] := aBeds[1].tDuration - aMsTon[1].ET; END_IF;
(* Beet 2 *)
IF NOT aBeds[2].xSelected THEN aMsDone[2] := FALSE; END_IF;
bMsValves.2 := xMsEnable AND aBeds[2].xSelected AND (aBeds[2].tDuration &gt; T#0S) AND NOT aMsDone[2];
aMsTon[2](IN := bMsValves.2 AND aGranted[2], PT := aBeds[2].tDuration);
IF aMsTon[2].Q THEN aMsDone[2] := TRUE; END_IF;
IF aMsDone[2] THEN atMsRemaining[2] := T#0S;
ELSE atMsRemaining[2] := aBeds[2].tDuration - aMsTon[2].ET; END_IF;
(* Beet 3 *)
IF NOT aBeds[3].xSelected THEN aMsDone[3] := FALSE; END_IF;
bMsValves.3 := xMsEnable AND aBeds[3].xSelected AND (aBeds[3].tDuration &gt; T#0S) AND NOT aMsDone[3];
aMsTon[3](IN := bMsValves.3 AND aGranted[3], PT := aBeds[3].tDuration);
IF aMsTon[3].Q THEN aMsDone[3] := TRUE; END_IF;
IF aMsDone[3] THEN atMsRemaining[3] := T#0S;
ELSE atMsRemaining[3] := aBeds[3].tDuration - aMsTon[3].ET; END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_MANUAL_SEQUENCE — One-Shot je Zone (4 Ventile), auf ST_BedCfg-Slice

One-Shot-Bewässerung **einer Zone** (4 Beete/Ventile). Auswahl und PRESET leben pro Beet im `VAR_IN_OUT`-Slice `aBeds` (= `Bellows.Zeitplan.aValveJobs[z*4+1..z*4+4]`).

- **Anwahl:** je Taster (`bMsButtons.0..3`) toggelt ein `JK_FF` (`fbMsJk`, J=K=TRUE) → `aBeds[i].xSelected`. `RESET := NOT xMsEnable`. Das HMI liest `xSelected` für Anwahl/Blink.
- **Anforderung:** `bMsValves.i := xSelected AND tDuration&gt;0 AND NOT fertig` → in PLC_PRG nach `axReq` → 2-Ventil-Arbiter.
- **Dauer (TON + ET):** `tDuration` ist **Preset und bleibt erhalten**. Der Dauer-`TON` lädt/startet **erst mit der Arbiter-Freigabe** (`IN := angefordert AND aGranted`): vor Grant `ET=0` (Restzeit = voller Preset, wartet), bei Grant zählt `ET` hoch (Grant hält nicht-verdrängend → ununterbrochen). Bei `ET=tDuration` → `Q` → fertig (Latch), Anforderung fällt, Arbiter rückt nach.
- **Current value:** `atMsRemaining[i] := tDuration − ET` (Restzeit fürs HMI; idle = voller Preset, fertig = 0). **Kein** In-Place-Dekrement von `tDuration` mehr.

Instanziiert als `ARRAY[0..5] OF FB_MANUAL_SEQUENCE` (6 Zonen) in PLC_PRG, Modus 2 (One-Shot).</xhtml>
        </documentation>
      </pou>
      <pou name="FB_MANUAL" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="fbJk">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <derived name="JK_FF"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="4ceda8a8-ee43-469a-821a-17553a28d66f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">4 JK-Flipflops, je Taster ein Ventil-Toggle (J=K=TRUE)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="cb031d9d-6fb9-4e15-800d-53c2bbed0c3b"/>
                </data>
              </addData>
            </variable>
            <variable name="IN_Buttons">
              <type>
                <BYTE/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="ed3c3256-76f5-4994-864f-b1a5ca82d04f"/>
                </data>
              </addData>
            </variable>
            <variable name="tDebounce">
              <type>
                <TIME/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="d97d5286-0c73-4433-9881-ab912371a91e"/>
                </data>
              </addData>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="bManValves">
              <type>
                <BYTE/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="55854fb6-b14d-4155-b7f8-552bcdb68fe8"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ventil-ANFORDERUNG Bit0..3 (JK-Toggle-Zustand) -&gt; Arbiter (axReq)</xhtml>
              </documentation>
            </variable>
            <variable name="bManOpen">
              <type>
                <BYTE/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="6bd0104b-e8bd-4018-9b62-6fe0746e38f7"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ventil WIRKLICH OFFEN Bit0..3 = Arbiter-Grant (HMI: offen vs. angefordert/wartend)</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <inOutVars>
            <variable name="aGranted">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="39899725-a777-41b8-b5b6-0ccbdb129260"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Globale Arbiter-Freigabe der Zone (Status-Graph): welches Ventil WIRKLICH offen ist</xhtml>
              </documentation>
            </variable>
          </inOutVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fbJk[0](xButton := IN_Buttons.0, tDebounce := tDebounce, J := TRUE, K := TRUE, RESET := NOT xEnable);
fbJk[1](xButton := IN_Buttons.1, tDebounce := tDebounce, J := TRUE, K := TRUE, RESET := NOT xEnable);
fbJk[2](xButton := IN_Buttons.2, tDebounce := tDebounce, J := TRUE, K := TRUE, RESET := NOT xEnable);
fbJk[3](xButton := IN_Buttons.3, tDebounce := tDebounce, J := TRUE, K := TRUE, RESET := NOT xEnable);

bManValves.0 := fbJk[0].Q;
bManValves.1 := fbJk[1].Q;
bManValves.2 := fbJk[2].Q;
bManValves.3 := fbJk[3].Q;

(* --- Status = globale Arbiter-Freigabe (was wirklich offen ist) --- *)
bManOpen.0 := aGranted[0];
bManOpen.1 := aGranted[1];
bManOpen.2 := aGranted[2];
bManOpen.3 := aGranted[3];</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_MANUAL — Handbetrieb je Zone (4 Ventile), grant-aware

Handbetrieb pro Beetkomplex/Zone. Je Taster (`IN_Buttons.0..3`, entprellt) **toggelt** ein `JK_FF` (J=K=TRUE) die **Anforderung** des zugehörigen Ventils. `RESET := NOT xEnable` → beim Verlassen fallen alle Latches. Instanziiert als `ARRAY[0..5] OF FB_MANUAL` (6 Zonen), Modus 1.

## Arbiter als Status-Graph (zentral, nicht mehr manuell-lokal)

Der globale 2-Ventil-Interlock (`FB_VALVE_ARBITER`, max. `uMaxVentile`, **non-preemptiv**) war ursprünglich aus dem Handbetrieb heraus gedacht, ist jetzt aber **globaler Koordinator** über alle Modi. Damit ist die **Wahrheit über „Ventil wirklich offen&quot; der Grant**, nicht die Anforderung. FB_MANUAL ist daher **grant-aware**:

- **`bManValves` (Output)** = Ventil-**ANFORDERUNG** Bit0..3 (JK-Toggle-Zustand) → `axReq` → Arbiter.
- **`aGranted` (VAR_IN_OUT)** = Grant-Slice der Zone aus dem Arbiter (Vorzyklus-Feedback).
- **`bManOpen` (Output)** = Ventil **WIRKLICH OFFEN** Bit0..3 = `aGranted` → das HMI/die Anzeige unterscheidet **angefordert/wartend** von **offen**.

## Bedien-Anzeige je Beet

| Zustand | Anzeige |
|---|---|
| angewählt **+ Grant** (offen) | **dauerhaft an** |
| angewählt, **kein Grant** (angefordert/wartend) | **Blink 5 s an / 5 s aus** + **Warterang** (Platz in der Schlange) |
| nicht angewählt | aus |

**Warterang:** Der Arbiter priorisiert nach Index-Reihenfolge. Beete jenseits von `uMaxVentile` bekommen ihren **Platz in der Warteschlange** angezeigt (1 = als nächstes dran) → der Bediener sieht, welches Beet als nächstes öffnet.

**Feld-Feedback:** Der 5s/5s-Blink macht zugleich die **Feld-Taster erkennbar** — drückt jemand am Acker `Anvil.*.xT_n`, blinkt sein Beet sofort → sichtbare Bestätigung, dass der Druck erkannt wurde und das Beet in der Schlange steht, auch wenn es (noch) zu ist. Blink-Quelle: separate `FB_BLINK`-Instanz mit `tBlFlash := T#5S`, `tBlPause := T#5S`.

&gt; HINWEIS: lokaler Index 0..3 = die 4 Ventile/Beete der Zone. Reset aller Latches bei `xEnable=FALSE`.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_VALVE_ARBITER" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="iArbIdx">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="3dc35aec-09e1-400a-949b-e7f5fd4ebf55"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Schleifenindex 0..23</xhtml>
              </documentation>
            </variable>
            <variable name="iArbGranted">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="fe77f327-32c5-4a86-962f-dd57f34e73ab"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zähler aktuell freigegebener Ventile (Limit 2)</xhtml>
              </documentation>
            </variable>
            <variable name="nMax">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="736f8c8e-a726-4931-96e2-690f35e3312b"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Physisch geclampter Max-Wert [1..24] aus i_uMaxValves.</xhtml>
              </documentation>
            </variable>
            <variable name="nRank">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="1ae19217-8267-4ca0-a825-5b5e0b91e4d3"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Laufender Warterang fuer die angeforderten-aber-nicht-freigegebenen Ventile</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="i_axReq">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="0ce90fc9-a84a-4022-88cc-2c1844d92486"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ventil-Anforderungen (24 = 6 Zonen x 4 Ventile; Index z*4+v)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="o_axGrant">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="66525f56-091a-4c92-a591-744a95afc003"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Freigegebene Ventile (max. 2 TRUE; laufende halten, neue bei freiem Slot)</xhtml>
              </documentation>
            </variable>
            <variable name="o_auQueue">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <USINT/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" uuid="505d308b-a65b-40cc-a851-ff53cadbc084"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Warterang je Ventil: 0=offen/inaktiv, 1=als naechstes, 2..=Warteposition</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">nMax := USINT_TO_INT(Bellows.Betrieb.uMaxVentile);
IF nMax &lt; 1  THEN nMax := 1;  END_IF;
IF nMax &gt; 24 THEN nMax := 24; END_IF;

(* 1) Laufende Freigaben halten (max nMax), Rest freigeben *)
iArbGranted := 0;
FOR iArbIdx := 0 TO 23 DO
    IF o_axGrant[iArbIdx] AND i_axReq[iArbIdx] AND (iArbGranted &lt; nMax) THEN
        o_axGrant[iArbIdx] := TRUE;
        iArbGranted := iArbGranted + 1;
    ELSE
        o_axGrant[iArbIdx] := FALSE;
    END_IF;
END_FOR;

(* 2) Neue Anforderungen aufnehmen, bis Limit nMax erreicht *)
FOR iArbIdx := 0 TO 23 DO
    IF i_axReq[iArbIdx] AND NOT o_axGrant[iArbIdx] AND (iArbGranted &lt; nMax) THEN
        o_axGrant[iArbIdx] := TRUE;
        iArbGranted := iArbGranted + 1;
    END_IF;
END_FOR;

(* 3) Warterang: angefordert-aber-nicht-freigegeben in Index-Reihenfolge
   durchnummerieren (1 = als naechstes dran). Offen/inaktiv = 0. *)
nRank := 0;
FOR iArbIdx := 0 TO 23 DO
    IF i_axReq[iArbIdx] AND NOT o_axGrant[iArbIdx] THEN
        nRank := nRank + 1;
        o_auQueue[iArbIdx] := INT_TO_USINT(nRank);
    ELSE
        o_auQueue[iArbIdx] := 0;
    END_IF;
END_FOR;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">============================================================================
   FB_VALVE_ARBITER  —  Globaler 2-Ventil-Interlock + Warteschlangen-Status
   ----------------------------------------------------------------------------
   Anlagenbedingt nie mehr als uMaxVentile Ventile gleichzeitig offen. Nimmt die
   24 Anforderungen i_axReq (Index z*4+v) und gibt hoechstens nMax frei
   (o_axGrant). Policy: laufende Freigaben HALTEN (solange angefordert), neue nur
   bei freiem Slot, Prioritaet = Index-Reihenfolge, KEINE Verdraengung. Greift
   ueber ALLE Phasen (Manuell + Zeit).
   STATUS-GRAPH: o_auQueue gibt je Ventil den Warterang aus —
     0 = offen (granted) ODER nicht angefordert,
     1 = als naechstes dran, 2,3,... = Warteposition (Index-Reihenfolge).
   So sieht der Bediener, welches Beet als naechstes oeffnet (auch das Feld-
   Taster-Feedback haengt daran).
   ============================================================================

0) Sicherer Sollwert: physisch geclampt [1..24] (24 = Ventilzahl, 6 Zonen x 4).
   Die HMI legt Bellows.Betrieb.uMaxVentile fest (persistent, HMI-writable); die
   ST garantiert nur die physische Grenze.</xhtml>
        </documentation>
      </pou>
      <pou name="BusMonitor" pouType="program">
        <interface>
          <localVars>
            <variable name="mon">
              <type>
                <derived name="FB_BUS_MONITOR"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="2a517f29-94fb-48a9-94cb-cf92e4595127"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Aggregierte Geraeteueberwachung</xhtml>
              </documentation>
            </variable>
            <variable name="axOnline">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="fa5df993-7132-49b1-a90e-96fb518a0abb"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Online-Bits je Geraet, Index wie in FB_BUS_MONITOR</xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   BusMonitor  -  Runtime-Comm-Status  -&gt;  FB_BUS_MONITOR  -&gt;  Bellows/Hearth
   ----------------------------------------------------------------------------
   Drei Glieder, von denen bis heute nur das mittlere existierte:

   1. QUELLE  Der cxx-Codegen materialisiert je Anvil-Geraetegruppe eine
              read-only Status-Sub-Struct unter Anvil.&lt;grp&gt;.Status , gefuellt
              im Input-Scan VOR der POU-Ausfuehrung - pro Zyklus ein
              konsistentes Abbild. Vertrag:
              documentation/architecture/device-status-interface.md

   2. LOGIK   FB_BUS_MONITOR fuehrt je Geraet eine FB_DEVICE_MONITOR-Instanz
              (Zustandsgraph, Entprellung, Klartext) und buendelt sie. Steht
              seit 2026-06-06, lief aber mit xBmValid=FALSE leer, weil
              axBmOnline keinen Lieferanten hatte.

   3. SENKE   Der Deskriptor kennt nur POOL-Variablen mit bellowsRead. Was in
              der FB-Instanz bleibt, sieht Hearth nie. Die Bellows.Diag-
              Variablen sind dafuer angelegt und tragen die Flagge bereits -
              es fehlten nur die fuenf Zuweisungen unten.

   Index-Zuordnung wie in FB_BUS_MONITOR dokumentiert:
     0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne
     4=Maibeere 5=Johannisbeere 6=Schaltschrank

   ACHTUNG: Die Zuordnung ist HANDGEPFLEGT und an ARRAY[0..6] gebunden. Ein
   achtes Geraet bliebe unueberwacht, ein geloeschtes verschoebe alle
   folgenden Indizes - die HMI meldete dann das falsche Geraet. Der
   Automatismus, der das aus der Bus-Topologie ableitet, ist offen.
   ============================================================================ *)

(* --- 1. Quelle einlesen --- *)
axOnline[0] := Anvil.Pfirsich.Status.xOnline;
axOnline[1] := Anvil.Stachelbeere.Status.xOnline;
axOnline[2] := Anvil.Maulbeere.Status.xOnline;
axOnline[3] := Anvil.Felsenbirne.Status.xOnline;
axOnline[4] := Anvil.Maibeere.Status.xOnline;
axOnline[5] := Anvil.Johannisbeere.Status.xOnline;
axOnline[6] := Anvil.Schaltschrank.Status.xOnline;

(* --- 2. Auswerten --- *)
mon(xBmValid := TRUE, axBmOnline := axOnline);

(* --- 3. Nach Bellows durchreichen, damit Hearth es sieht --- *)
Bellows.Diag.auDevState  := mon.auBmState;
Bellows.Diag.asDevStatus := mon.asBmStatus;
Bellows.Diag.xAllOk      := mon.xBmAllOk;
Bellows.Diag.iFaultCount := mon.iBmFaultCount;
Bellows.Diag.sSummary    := mon.sBmSummary;
</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">Programm in taskDiag (200 ms): liest je Geraet den Online-Status aus Anvil.&lt;Geraet&gt;.Status, wertet ihn mit FB_BUS_MONITOR aus (Zustandsgraph mit Entprellung je Geraet) und schreibt das Ergebnis nach Bellows.Diag, damit die HMI es anzeigt. Die Geraete-Indizes sind handgepflegt (0 Pfirsich bis 6 Schaltschrank); ein neues Geraet muss hier und in FB_BUS_MONITOR nachgetragen werden.</xhtml>
        </documentation>
      </pou>
    </pous>
  </types>
