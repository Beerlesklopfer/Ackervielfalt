                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127858657" addressLocked="true" createdMs="1778955277252" modifiedMs="1788127858657" uuid="536ea49f-d995-4b78-b878-0d83d76d74f9"/>
