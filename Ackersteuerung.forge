            <variable name="uWtDayIdx">
              <type>
                <USINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="c3134de9-8844-4f49-b688-6a6cfdb62bdf"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Mo-basierter Wochentag-Index 0..6 (aus tm_wday) zum Indizieren von bWtDays</xhtml>
              </documentation>
            </variable>
            <variable name="bWtDays">
              <type>
                <derived name="T_WeekMask"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="6c434a33-3ae7-4622-9f6b-5327b299b6a9"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Wochentag-Freigabe Mo..So (Index 0..6); ohne Init = alle FALSE, von HMI/Config zu setzen</xhtml>
              </documentation>
            </variable>
          </localVars>
          <outputVars>
            <variable name="dtNow">
              <type>
                <derived name="ST_DateTime"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="7bfb8bda-20ae-49bb-91e5-9ef642593364"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Dekomponierte aktuelle UTC-Zeit (unsere DateTime-DUT); auch als Output nutzbar</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_WEEKLY_TIMER  —  Wochenplan-Zeitschaltuhr
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau
   Datum   : 2026-06-05
   ----------------------------------------------------------------------------
   Zweck   : Zerlegt die UNIX-Zeit (FB_SYS_TIME -&gt; SYS_TIME_T) in unsere
             DateTime-DUT dtNow (an C struct tm angelehnt) und schaltet xWtQ
             TRUE, wenn der aktuelle Wochentag in bWtDays (T_WeekMask, Mo..So)
             freigegeben ist UND die UTC-Uhrzeit im Fenster [Start, End) liegt
             (mitternachts-uebergreifend). dtNow ist Output + wiederverwendbar.
   ============================================================================ *)

fbWtSysTime();

uWtSecsTotal := fbWtSysTime.current.time_ns / 1000000000;   (* UNIX-Sekunden *)
uWtDays1970  := uWtSecsTotal / 86400;
uWtSecsInDay := uWtSecsTotal MOD 86400;

(* --- Uhrzeit in dtNow --- *)
dtNow.tm_hour := ULINT_TO_USINT(uWtSecsInDay / 3600);
dtNow.tm_min  := ULINT_TO_USINT((uWtSecsInDay / 60) MOD 60);
dtNow.tm_sec  := ULINT_TO_USINT(uWtSecsInDay MOD 60);

(* --- Wochentag (struct tm: 0=Sonntag); 1970-01-01 war Donnerstag (=4) --- *)
dtNow.tm_wday := ULINT_TO_USINT((uWtDays1970 + 4) MOD 7);

(* --- Civil-Date (Hinnant): Tage-seit-1970 -&gt; Jahr/Monat/Tag --- *)
uWtSecsTotal := uWtDays1970 + 719468;                 (* z (Reuse als Scratch) *)
udEra := uWtSecsTotal / 146097;
udDoe := uWtSecsTotal - udEra * 146097;
udYoe := (udDoe - udDoe/1460 + udDoe/36524 - udDoe/146096) / 365;
udDoy := udDoe - (365*udYoe + udYoe/4 - udYoe/100);
udMp  := (5*udDoy + 2) / 153;
dtNow.tm_mday := ULINT_TO_USINT(udDoy - (153*udMp + 2)/5 + 1);
IF udMp &lt; 10 THEN
    dtNow.tm_mon := ULINT_TO_USINT(udMp + 2);         (* mp 0..9 (Maerz-basiert) -&gt; struct tm 0-basiert 2..11 *)
ELSE
    dtNow.tm_mon := ULINT_TO_USINT(udMp - 10);        (* mp 10..11 -&gt; Jan/Feb -&gt; 0..1 *)
END_IF;
uWtWeekday := udYoe + udEra * 400;                    (* Jahr (Reuse uWtWeekday als Scratch) *)
IF udMp &gt;= 10 THEN
    uWtWeekday := uWtWeekday + 1;                     (* Jan/Feb gehoeren ins Folgejahr *)
END_IF;
dtNow.tm_year := USINT_TO_INT(ULINT_TO_USINT(uWtWeekday - 1900));   (* Jahre seit 1900 *)
dtNow.tm_yday := 0;                                   (* nicht berechnet (fuer Wochenplan nicht noetig) *)

(* --- Wochentag-Index Mo=0..So=6 aus tm_wday(So=0) --- *)
uWtDayIdx := ULINT_TO_USINT((USINT_TO_ULINT(dtNow.tm_wday) + 6) MOD 7);

(* --- Zeitfenster --- *)
uWtNowMin   := USINT_TO_ULINT(dtNow.tm_hour) * 60 + USINT_TO_ULINT(dtNow.tm_min);
uWtStartMin := USINT_TO_ULINT(uWtStartH) * 60 + BYTE_TO_ULINT(uWtStartM);
uWtEndMin   := USINT_TO_ULINT(uWtEndH)   * 60 + BYTE_TO_ULINT(uWtEndM);

IF bWtDays[uWtDayIdx] THEN
    IF uWtStartMin &lt;= uWtEndMin THEN
        xWtQ := (uWtNowMin &gt;= uWtStartMin) AND (uWtNowMin &lt; uWtEndMin);
    ELSE
        xWtQ := (uWtNowMin &gt;= uWtStartMin) OR (uWtNowMin &lt; uWtEndMin);
    END_IF;
ELSE
    xWtQ := FALSE;
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_WEEKLY_TIMER — Zeitbasis / Wochenplan

Liest die UNIX-Echtzeit über `FB_SYS_TIME`, zerlegt sie per **Hinnant-Civil-Date** in die DUT `ST_DateTime` (`dtNow`, struct-tm-Stil, UTC) und bildet ein Wochenplan-Fenster: `xWtQ`=TRUE wenn Wochentag in `bWtDays` (`T_WeekMask`, Mo..So) freigegeben UND Uhrzeit im Fenster `[Start,End)` (mitternachtsübergreifend). `dtNow` ist Output + wird von `FB_MANUAL_TIME` für den Startzeit-Vergleich je Job genutzt.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_BLINK" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="tonBlOn">
              <type>
                <derived name="TON"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="d24f6f46-b28c-4455-bf8d-a27df950e55c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Timer für Flash-Dauer (tBlFlash)</xhtml>
              </documentation>
            </variable>
            <variable name="tonBlOff">
              <type>
                <derived name="TON"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="5ba42b14-1669-49a2-b307-9ed0f6abfb7a"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Timer für Pausen-Dauer (tBlPause)</xhtml>
              </documentation>
            </variable>
            <variable name="xWasEnabled">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="0032971f-b20c-4997-91ed-328b73ea534c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Flankenspeicher xBlEnable: bei steigender Flanke startet die Anzeige mit einem Flash (sofortige Rueckmeldung)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xBlEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="418b9e73-f734-430c-8328-9369e3b565ed"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blinken aktiv; FALSE = xBlQ dauerhaft FALSE (z. B. Handbetrieb)</xhtml>
              </documentation>
            </variable>
            <variable name="tBlFlash">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#1S"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="20f4a3ea-dd3a-4bc9-8f5f-8f90351524fc"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Kurzer Flash (Ein-Dauer); relais-schonend: 1 s Flash bei 10 s Periode (1 s ein / 9 s aus)</xhtml>
              </documentation>
            </variable>
            <variable name="tBlPause">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#9S"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="fabe5064-bcd6-45e4-9a96-2da3171aee75"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Laengere Pause (Aus-Dauer); relais-schonend: 9 s Pause bei 10 s Periode (1 s ein / 9 s aus)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="xBlQ">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="267ebec1-1cc2-42ff-a3f3-a262e5a9c1b9"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blink-Ausgang: kurzer Flash, längere Pause; FALSE bei NOT xBlEnable</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Disable: Ausgang sofort aus, Flankenspeicher zuruecksetzen. *)
IF NOT xBlEnable THEN
    xBlQ := FALSE;
    xWasEnabled := FALSE;
ELSIF NOT xWasEnabled THEN
    (* Steigende Flanke von Enable: mit einem Flash STARTEN -&gt; sofortige
       Rueckmeldung, kein Warten auf die erste Pause. Relais-schonend 1s/9s. *)
    xBlQ := TRUE;
    xWasEnabled := TRUE;
END_IF;

(* Zwei TON bilden den asymmetrischen Oszillator:
     - waehrend Flash (xBlQ=TRUE)  laeuft tonBlOn  (PT=tBlFlash)
     - waehrend Pause (xBlQ=FALSE) laeuft tonBlOff (PT=tBlPause) *)
tonBlOn (IN := xBlEnable AND xBlQ,     PT := tBlFlash);
tonBlOff(IN := xBlEnable AND NOT xBlQ, PT := tBlPause);

IF xBlEnable THEN
    IF xBlQ AND tonBlOn.Q THEN
        xBlQ := FALSE;          (* Flash zu Ende -&gt; Pause beginnt *)
    ELSIF (NOT xBlQ) AND tonBlOff.Q THEN
        xBlQ := TRUE;           (* Pause zu Ende -&gt; Flash beginnt *)
    END_IF;
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_BLINK — Blink-/Flash-Generator (Programm-Anzeige)

Asymmetrisches Blinksignal aus zwei TON: kurzer Flash (`tBlFlash`) + längere Pause (`tBlPause`); `xBlQ` ist Phasen-Bit + Ausgang. `xBlEnable=FALSE` hält `xBlQ` dauerhaft FALSE (Handbetrieb blinkt nicht). In PLC_PRG mit `T#1S`/`T#29S` (**Periode 30 s**) für die Programm-Anzeige `xV_6..8` parametriert. Review-Hinweis: bei Enable startet die Pause zuerst (erster Flash nach `tBlPause`); `PT=0` ungeguardet.</xhtml>
        </documentation>
      </pou>
