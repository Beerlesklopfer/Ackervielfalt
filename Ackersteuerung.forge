    <data name="https://forgeiec.io/v2/fdd" handleUnknown="preserve">
      <DeviceLibrary xmlns="https://forgeiec.io/v2/fdd">
        <Vendor name="Amsamotion">
          <DeviceDescription xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="a7e8a748-dfe2-4fe7-a7e8-a99dc719fe32" catalogRef="Amsamotion/ETH-MODBUS-IO8R-A" version="1.0" xsi:schemaLocation="https://forgeiec.io/v2/fdd forgeiec-v2-fdd.xsd">
            <DeviceIdentity>
              <VendorName>Amsamotion</VendorName>
              <ProductName>ETH-MODBUS-IO8R-A</ProductName>
              <ProductId>ETH-MODBUS-IO8R-A</ProductId>
              <Description>8DI 8DO(Relay) 6AI 2AO Modbus TCP/RTU mixed IO module, Ethernet + RS485, opto-isolated inputs (DC 24V), relay outputs (2A/point), 12-bit analog (3x 0-10V + 3x 0-20mA AI, 2x AO)</Description>
              <DeviceFamily>IO Module</DeviceFamily>
              <Series>ETH-Modbus</Series>
            </DeviceIdentity>
            <CommProfiles>
              <CommProfile protocol="modbustcp">
                <DefaultSlaveId>1</DefaultSlaveId>
                <DefaultPort>502</DefaultPort>
                <ByteOrder>big-endian</ByteOrder>
                <WordOrder>big-endian</WordOrder>
              </CommProfile>
              <CommProfile protocol="modbusrtu">
                <DefaultSlaveId>1</DefaultSlaveId>
                <DefaultPort>0</DefaultPort>
                <ByteOrder>big-endian</ByteOrder>
                <WordOrder>big-endian</WordOrder>
              </CommProfile>
            </CommProfiles>
            <Modules>
              <Module name="Digital Inputs" id="digital_inputs">
                <PoolVariable name="I0_0" id="di_1" description="Digital input channel 1 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="0" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_1" id="di_2" description="Digital input channel 2 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="1" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_2" id="di_3" description="Digital input channel 3 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="2" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_3" id="di_4" description="Digital input channel 4 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="3" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_4" id="di_5" description="Digital input channel 5 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="4" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_5" id="di_6" description="Digital input channel 6 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="5" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_6" id="di_7" description="Digital input channel 7 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="6" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
                <PoolVariable name="I0_7" id="di_8" description="Digital input channel 8 (24V DC, opto-isolated)" direction="in" function="DI" iecType="BOOL">
                  <BusMapping address="7" count="1" functionCode="2" registerType="discrete"/>
                </PoolVariable>
              </Module>
              <Module name="Relay Outputs" id="relay_outputs">
                <PoolVariable name="Q0_0" id="do_1" description="Relay output channel 1 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="0" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_1" id="do_2" description="Relay output channel 2 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="1" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_2" id="do_3" description="Relay output channel 3 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="2" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_3" id="do_4" description="Relay output channel 4 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="3" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_4" id="do_5" description="Relay output channel 5 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="4" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_5" id="do_6" description="Relay output channel 6 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="5" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_6" id="do_7" description="Relay output channel 7 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="6" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
                <PoolVariable name="Q0_7" id="do_8" description="Relay output channel 8 (max 2A)" direction="out" function="DO" iecType="BOOL">
                  <BusMapping address="7" count="1" functionCode="5" registerType="coil"/>
                </PoolVariable>
              </Module>
              <!-- Relay readback removed: coil status is implicitly read by the bridge -->
              <Module name="Analog Inputs (Voltage)" id="analog_inputs_voltage">
                <PoolVariable name="V1" id="ai_v1" description="Analog input channel 1 (0-10V, 12-bit)" direction="in" function="AI" iecType="UINT">
                  <BusMapping address="0" count="1" functionCode="4" registerType="input"/>
                  <Scaling factor="0.002442" offset="0.0" unit="V"/>
                </PoolVariable>
                <PoolVariable name="V2" id="ai_v2" description="Analog input channel 2 (0-10V, 12-bit)" direction="in" function="AI" iecType="UINT">
                  <BusMapping address="1" count="1" functionCode="4" registerType="input"/>
                  <Scaling factor="0.002442" offset="0.0" unit="V"/>
                </PoolVariable>
                <PoolVariable name="V3" id="ai_v3" description="Analog input channel 3 (0-10V, 12-bit)" direction="in" function="AI" iecType="UINT">
                  <BusMapping address="2" count="1" functionCode="4" registerType="input"/>
                  <Scaling factor="0.002442" offset="0.0" unit="V"/>
                </PoolVariable>
              </Module>
              <Module name="Analog Inputs (Current)" id="analog_inputs_current">
                <PoolVariable name="I1" id="ai_c1" description="Analog input channel 4 (0-20mA, 12-bit)" direction="in" function="AI" iecType="UINT">
                  <BusMapping address="3" count="1" functionCode="4" registerType="input"/>
                  <Scaling factor="0.004884" offset="0.0" unit="mA"/>
                </PoolVariable>
                <PoolVariable name="I2" id="ai_c2" description="Analog input channel 5 (0-20mA, 12-bit)" direction="in" function="AI" iecType="UINT">
                  <BusMapping address="4" count="1" functionCode="4" registerType="input"/>
                  <Scaling factor="0.004884" offset="0.0" unit="mA"/>
                </PoolVariable>
                <PoolVariable name="I3" id="ai_c3" description="Analog input channel 6 (0-20mA, 12-bit)" direction="in" function="AI" iecType="UINT">
                  <BusMapping address="5" count="1" functionCode="4" registerType="input"/>
                  <Scaling factor="0.004884" offset="0.0" unit="mA"/>
                </PoolVariable>
              </Module>
              <Module name="Analog Outputs" id="analog_outputs">
                <PoolVariable name="AO1" id="ao_1" description="Analog output channel 1 (0-10V / 0-20mA, 12-bit)" direction="out" function="AO" iecType="UINT">
                  <BusMapping address="6" count="1" functionCode="6" registerType="holding"/>
                  <Scaling factor="0.002442" offset="0.0" unit="V"/>
                </PoolVariable>
                <PoolVariable name="AO2" id="ao_2" description="Analog output channel 2 (0-10V / 0-20mA, 12-bit)" direction="out" function="AO" iecType="UINT">
                  <BusMapping address="7" count="1" functionCode="6" registerType="holding"/>
                  <Scaling factor="0.002442" offset="0.0" unit="V"/>
                </PoolVariable>
              </Module>
            </Modules>
            <ServiceParameters>
              <ServiceParameter name="SlaveId" id="slave_id" accessRights="rw" description="Modbus slave address (set via DIP switch or software, max 126)" iecType="UINT">
                <BusMapping address="4096" count="1" registerType="holding"/>
                <DefaultValue>1</DefaultValue>
                <Range max="126" min="1"/>
              </ServiceParameter>
            </ServiceParameters>
            <StatusVariables>
              <StatusVariable name="wModbusRetries" description="Number of Modbus frame retransmissions since tongs started." iecType="UINT"/>
              <StatusVariable name="wModbusExceptionCount" description="Number of Modbus exception responses (illegal function / data / ...)." iecType="UINT"/>
              <StatusVariable name="xPwr" description="PWR as the bridge sees it: the device answered on Modbus within the timeout. NOT the mains lamp on the front — no register of this device reports its own LEDs." iecType="BOOL"/>
              <StatusVariable name="xRun" description="RUN as the bridge sees it: the DeviceState the connector publishes, 0 to 9. The values are the ordinals of tongs-core's DeviceState enum — see the warning note before changing either side." iecType="USINT"/>
              <StatusVariable name="bComm" description="COMM as a bit field, after the front lamp: bit 0 = traffic on COM1, bit 1 = traffic on COM2. 0 quiet, 1 COM1, 2 COM2, 3 both." iecType="USINT"/>
            </StatusVariables>
