                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="42031ca8-65f9-4d59-8843-c6d7837bc254"/>
                </data>
              </addData>
