              </initialValue>
            </variable>
            <variable name="isPreselected">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="FALSE"/>
              </initialValue>
            </variable>
            <variable name="isOpen">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="FALSE"/>
              </initialValue>
            </variable>
            <variable name="liquidationPeriod">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#0s"/>
              </initialValue>
            </variable>
            <variable name="remainingLiquidation">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#0s"/>
              </initialValue>
            </variable>
          </struct>
        </baseType>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">Status je Ventil (Betrieb.astValveStatus, Index z*4+v). bMode: je Betriebsart ein Bit (1 Manuell, 2 One-Shot, 4 wiederkehrend, 8 Auto), von jedem Modus-Baustein in seiner Schleife gesetzt. isPreselected: vorgewaehlt in der AKTIVEN Betriebsart, (bMode AND GVL.Betrieb.uModeActive) &lt;&gt; 0 — schreibt FB_TERMINAL_OUT. isOpen: wirklich offen = Freigabe der Arbitrierung in FB_TERMINAL_OUT (nie mehr als uMaxVentile, laufende halten, nachruecken in Index-Reihenfolge); haelt ueber die Zyklen. liquidationPeriod: eingestellte Laufdauer, vom Modus (Manuell T#0s = unbegrenzt). remainingLiquidation: Restlauf = liquidationPeriod − ET des Modus-Timers, vom Modus berechnet.</xhtml>
        </documentation>
      </dataType>
    </dataTypes>
