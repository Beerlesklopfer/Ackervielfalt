              <Led id="led-pwr" description="Power indicator. On the device: steady while supplied (manual 2.2.2)." elementId="led-pwr" ref="xPwr" source="statusVariable">
                <State blink="false" color="var(--led-off, #3f4448)" text="dark — no answer: supply or link down" value="0"/>
                <State blink="false" color="var(--led-ok, #4caf50)" text="steady green — powered and answering" value="1"/>
              </Led>
              <Led id="led-run" description="Run indicator. On the device: slow blink while the system runs (manual 2.2.2)." elementId="led-run" ref="xRun" source="statusVariable">
                <State blink="false" color="var(--led-off, #3f4448)" text="dark — Unknown: no state yet" value="0"/>
                <State blink="true" color="var(--led-warn, #f5a623)" text="amber, blinking — Connecting" value="1"/>
                <State blink="true" color="var(--led-ok, #4caf50)" text="green, SLOW blink — Online: running normally, as the front lamp shows it" value="2"/>
                <State blink="false" color="var(--led-warn, #f5a623)" text="amber, steady — Degraded: answering, but not cleanly" value="3"/>
                <State blink="true" color="var(--led-alarm, #e05a5a)" text="red, blinking — Timeout: no answer within the deadline" value="4"/>
                <State blink="false" color="var(--led-alarm, #e05a5a)" text="red, steady — Unreachable" value="5"/>
                <State blink="true" color="var(--led-warn, #f5a623)" text="amber, blinking — Backoff: waiting before the next attempt" value="6"/>
                <State blink="true" color="var(--led-alarm, #e05a5a)" text="red, blinking — ConfigError: the fault is in the configuration, not on the wire" value="7"/>
                <State blink="false" color="var(--led-off, #3f4448)" text="dark — Disabled: switched off on purpose" value="8"/>
                <State blink="false" color="var(--led-off, #3f4448)" text="dark — Shutdown" value="9"/>
              </Led>
              <Led id="led-comm" description="COM traffic. Two-colour on the device: yellow on COM1, red on COM2, alternating when both communicate (manual 2.2.2)." elementId="led-comm" ref="bComm" source="statusVariable">
                <State blink="false" color="var(--led-off, #3f4448)" text="dark — quiet" value="0"/>
                <State blink="true" color="var(--led-warn, #f5a623)" text="yellow, blinking — traffic on COM1" value="1"/>
                <State blink="true" color="var(--led-alarm, #e05a5a)" text="red, blinking — traffic on COM2" value="2"/>
                <State blink="true" color="var(--led-warn, #f5a623)" text="yellow and red ALTERNATING — both ports communicate" value="3"/>
              </Led>
