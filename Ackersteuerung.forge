                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="8b4d4a3f-c745-46c2-8171-222e84121e40"/>
