                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127858658" addressLocked="true" bellowsRead="true" createdMs="1780668473580" modifiedMs="1788127858658" monitorEnabled="true" uuid="fe5419aa-ee79-4988-ad6a-bfe34f229b22"/>
