        <globalVars name="Schrittkette">
          <variable name="uRunState" address="%MB3">
            <type>
              <USINT/>
            </type>
            <addData>
              <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                <ForgeIecVar xmlns="https://forgeiec.io/v2" bellowsRead="true" createdMs="1789879994107" modifiedMs="1789883090739" monitorEnabled="true" uuid="c016d37f-0f9f-4582-bed8-6cd56a56ef7e"/>
              </data>
            </addData>
            <documentation>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">Lauf-Zustand der One-Shot-Schrittkette: 0=Idle, 1=Running, 2=Paused, 3=Done. Von PLC_PRG geschrieben, vom HMI nur gelesen. Anwahl allein bewaessert nicht mehr — erst Start armt.</xhtml>
            </documentation>
          </variable>
        </globalVars>
        <globalVars name="Abbild"/>
        <globalVars name="Betrieb">
          <variable name="aValveJobs" address="%MD0">
            <type>
              <array>
                <dimension lower="0" upper="23"/>
                <baseType>
                  <derived name="ST_BedCfg"/>
                </baseType>
              </array>
            </type>
            <addData>
              <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782501481454" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1780691319052" label="Ventil-Jobs" modifiedMs="1790685113688" monitorEnabled="true" persistent="true" uuid="ddbfcefd-642c-4c69-8d47-41925e048467">
                  <ForgeIecVar documentation="Job Ventil Anvil.Pfirsich.xV_2 (%QX0.1), Zone Pfirsich Beet 2" element="1" label="Pfirsich xV_2"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Pfirsich.xV_3 (%QX0.2), Zone Pfirsich Beet 3" element="2" label="Pfirsich xV_3"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Pfirsich.xV_4 (%QX0.3), Zone Pfirsich Beet 4" element="3" label="Pfirsich xV_4"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Stachelbeere.xV_1 (%QX1.0), Zone Stachelbeere Beet 1" element="4" label="Stachelbeere xV_1"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Stachelbeere.xV_2 (%QX1.1), Zone Stachelbeere Beet 2" element="5" label="Stachelbeere xV_2"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Stachelbeere.xV_3 (%QX1.2), Zone Stachelbeere Beet 3" element="6" label="Stachelbeere xV_3"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Stachelbeere.xV_4 (%QX1.3), Zone Stachelbeere Beet 4" element="7" label="Stachelbeere xV_4"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maulbeere.xV_1 (%QX2.0), Zone Maulbeere Beet 1" element="8" label="Maulbeere xV_1"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maulbeere.xV_2 (%QX2.1), Zone Maulbeere Beet 2" element="9" label="Maulbeere xV_2"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maulbeere.xV_3 (%QX2.2), Zone Maulbeere Beet 3" element="10" label="Maulbeere xV_3"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maulbeere.xV_4 (%QX2.3), Zone Maulbeere Beet 4" element="11" label="Maulbeere xV_4"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Felsenbirne.xV_1 (%QX5.0), Zone Felsenbirne Beet 1" element="12" label="Felsenbirne xV_1"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Felsenbirne.xV_2 (%QX5.1), Zone Felsenbirne Beet 2" element="13" label="Felsenbirne xV_2"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Felsenbirne.xV_3 (%QX5.2), Zone Felsenbirne Beet 3" element="14" label="Felsenbirne xV_3"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Felsenbirne.xV_4 (%QX5.3), Zone Felsenbirne Beet 4" element="15" label="Felsenbirne xV_4"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maibeere.xV_1 (%QX3.0), Zone Maibeere Beet 1" element="16" label="Maibeere xV_1"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maibeere.xV_2 (%QX3.1), Zone Maibeere Beet 2" element="17" label="Maibeere xV_2"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maibeere.xV_3 (%QX3.2), Zone Maibeere Beet 3" element="18" label="Maibeere xV_3"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Maibeere.xV_4 (%QX3.3), Zone Maibeere Beet 4" element="19" label="Maibeere xV_4"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Johannisbeere.xV_1 (%QX4.0), Zone Johannisbeere Beet 1" element="20" label="Johannisbeere xV_1"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Johannisbeere.xV_2 (%QX4.1), Zone Johannisbeere Beet 2" element="21" label="Johannisbeere xV_2"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Johannisbeere.xV_3 (%QX4.2), Zone Johannisbeere Beet 3" element="22" label="Johannisbeere xV_3"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Johannisbeere.xV_4 (%QX4.3), Zone Johannisbeere Beet 4" element="23" label="Johannisbeere xV_4"/>
                  <ForgeIecVar documentation="Job Ventil Anvil.Pfirsich.xV_1 (%QX0.0), Zone Pfirsich Beet 1" element="0" label="Pfirsich xV_1"/>
                </ForgeIecVar>
              </data>
            </addData>
            <documentation>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">Job-Liste je Ventil, Index z*4+v (0..23) wie astValveStatus: Pfirsich 0-3, Stachelbeere 4-7, Maulbeere 8-11, Felsenbirne 12-15, Maibeere 16-19, Johannisbeere 20-23. Je Eintrag Anwahl, Startzeit (Stunde/Minute, Ortszeit) und Dauer (ST_BedCfg). Grundlage fuer One-Shot und wiederkehrend. Startzeit und Dauer setzt die HMI, die Anwahl fuehrt FB_SCHEDULE. Die Restzeit steht NICHT hier, sondern im nicht persistenten astValveStatus[i].remainingLiquidation. Persistent: uebersteht Neustart und Programm-Download.</xhtml>
            </documentation>
          </variable>
          <variable name="bWeekMask" address="%MB1">
            <type>
              <BYTE/>
            </type>
            <addData>
              <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782500392581" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1781296705679" label="Wochentage wiederkehrend" modifiedMs="1790035435157" monitorEnabled="true" persistent="true" uuid="39013e2a-20fb-41d0-b384-05c2c935ebca"/>
              </data>
            </addData>
            <documentation>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">Wochentag-Freigabe fuer den wiederkehrenden Betrieb (Betriebsart 3): Bit 0 = Montag bis Bit 6 = Sonntag, ein gesetztes Bit gibt den Tag frei. Von der HMI gesetzt, persistent.</xhtml>
            </documentation>
          </variable>
          <variable name="astValveStatus" address="%MD8">
            <type>
              <array>
                <dimension lower="0" upper="23"/>
                <baseType>
                  <derived name="ST_ValveStatus"/>
                </baseType>
              </array>
            </type>
            <addData>
              <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                <ForgeIecVar xmlns="https://forgeiec.io/v2" bellowsRead="true" createdMs="1790035594715" modifiedMs="1790627023886" monitorEnabled="true" uuid="4ff9409b-edb9-459b-b241-6bcbd6872359"/>
              </data>
            </addData>
            <documentation>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">Status je Ventil, Index z*4+v: bMode traegt je Betriebsart ein Bit (1 Manuell, 2 One-Shot, 4 wiederkehrend, 8 Auto) — jeder Modus-Baustein setzt sein Bit in einer FOR-Schleife.</xhtml>
            </documentation>
          </variable>
        </globalVars>
      </configuration>
    </configurations>
  </instances>
