                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="0a27c81c-9d5a-40e2-b2b2-0dd38706a369"/>
