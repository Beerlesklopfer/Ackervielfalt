            <variable name="udMp">
              <type>
                <ULINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="0c57747e-58a9-41fb-8385-f15bd353f4d3"/>
                </data>
              </addData>
