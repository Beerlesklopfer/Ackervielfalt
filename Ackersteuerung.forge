        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">Koppler im Schaltschrank (Weidmueller UR20-FBC-MOD-TCP, 192.168.24.229, Segment MODBUS_NORD) mit 8 digitalen Ein- und 8 Ausgaengen DI_0..7 und DO_0..7. Derzeit vom Programm nicht verwendet; die Betriebsart kommt aus der HMI-Gruppe Betrieb, nicht mehr von einem Wahlschalter.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_DEVICE_MONITOR" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="tonDmFault">
              <type>
                <derived name="TON"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="5c411c59-1508-4831-9f45-b336f9f4001e"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprell-Timer Offline</xhtml>
              </documentation>
            </variable>
            <variable name="tonDmRecover">
              <type>
                <derived name="TON"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="03b7d9ea-568b-42c5-bc49-5b59bbde8fb6"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprell-Timer Wiederkehr (stabil online)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xStatusValid">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="edf3a43a-26c0-4e13-8d5f-fdd7f5558de4"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Status-Quelle liefert Daten; FALSE = Quelle fehlt -&gt; Zustand Unbekannt</xhtml>
              </documentation>
            </variable>
            <variable name="xOnline">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="18205581-6175-442d-ae3f-528c41d144c5"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Geraet antwortet (Modbus-Transaktion ok); nur gueltig bei xStatusValid</xhtml>
              </documentation>
            </variable>
            <variable name="tDmFault">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#3S"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="85bfa546-5213-46fe-83c4-6771232c14bb"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprellung: Dauer ohne Antwort bis OFFLINE</xhtml>
              </documentation>
            </variable>
            <variable name="tDmRecover">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#2S"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="5854fc34-0642-4f3e-af16-492adcd8c371"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Dauer stabil online bis wieder ONLINE</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="uDmState">
              <type>
                <USINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="97763c00-282a-4044-9f67-23b559136580"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zustand: 0=Unbekannt, 1=Online, 2=Gestoert, 3=Offline</xhtml>
              </documentation>
            </variable>
            <variable name="sDmStatus">
              <type>
                <string/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="b8ff3185-ed62-4ec3-9cf7-265ac467672f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Klartext-Status fuer die HMI</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_DEVICE_MONITOR  —  Geraete-/Modulueberwachung mit Zustandsgraph + Klartext
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-06-06
   ----------------------------------------------------------------------------
   Zweck   : Ueberwacht den Comm-Status EINES Modbus-Geraets (bzw. Moduls) und
             liefert einen entprellten Zustand + einen KLARTEXT-STRING fuer die
             HMI (die rohen Status-Bits werden nicht an die HMI durchgereicht).
             Eingang xOnline kommt aus dem Runtime-Comm-Status (sobald verfuegbar);
             xStatusValid=FALSE =&gt; Quelle fehlt =&gt; Zustand Unbekannt.

   Zustandsgraph (uDmState):
     0 Unbekannt --(Quelle gueltig)--&gt; Online (xOnline) | Offline (sonst)
     1 Online    --(kurzer Aussetzer)--&gt; Gestoert
                 --(Offline laenger als tDmFault)--&gt; Offline
     2 Gestoert  --(stabil online tDmRecover)--&gt; Online
                 --(Offline laenger als tDmFault)--&gt; Offline
     3 Offline   --(stabil online tDmRecover)--&gt; Online
   HINWEIS : KEIN RETURN — der cxx-Transpiler kennt RETURN noch nicht. Der
             &quot;Quelle fehlt&quot;-Zweig laeuft daher als IF/ELSE (kein early-exit).
   ============================================================================ *)

(* --- Ohne gueltige Quelle: Unbekannt, Timer ruhen --- *)
IF NOT xStatusValid THEN
    uDmState  := 0;
    sDmStatus := 'Status-Quelle fehlt';
    tonDmFault(IN := FALSE, PT := tDmFault);
    tonDmRecover(IN := FALSE, PT := tDmRecover);
ELSE
    (* --- Entprell-Timer --- *)
    tonDmFault(IN := NOT xOnline, PT := tDmFault);
    tonDmRecover(IN := xOnline, PT := tDmRecover);

    (* --- Zustandsgraph --- *)
    IF uDmState = 0 THEN
        IF xOnline THEN uDmState := 1; ELSE uDmState := 3; END_IF;
    ELSIF NOT xOnline THEN
        IF tonDmFault.Q THEN
            uDmState := 3;                 (* dauerhaft weg -&gt; Offline *)
        ELSIF uDmState = 1 THEN
            uDmState := 2;                 (* kurzer Aussetzer -&gt; Gestoert *)
        END_IF;
    ELSE
        IF tonDmRecover.Q THEN
            uDmState := 1;                 (* stabil zurueck -&gt; Online *)
        END_IF;
    END_IF;

    (* --- Klartext fuer die HMI --- *)
    IF    uDmState = 1 THEN sDmStatus := 'Online';
    ELSIF uDmState = 2 THEN sDmStatus := 'Gestoert';
    ELSIF uDmState = 3 THEN sDmStatus := 'Keine Verbindung';
    ELSE                    sDmStatus := 'Unbekannt';
    END_IF;
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_DEVICE_MONITOR — Geräte-/Modul-Zustandsgraph + Klartext

Überwacht den Comm-Status EINES Geräts/Moduls. Zustandsgraph `uDmState`: **0 Unbekannt → 1 Online → 2 Gestört → 3 Offline** (entprellt über `tDmFault`/`tDmRecover`). Eingänge `xStatusValid` (Quelle liefert Daten) + `xOnline` (Gerät antwortet). Ausgabe: `uDmState` + **Klartext-STRING** `sDmStatus` (`Online`/`Gestört`/`Keine Verbindung`/`Unbekannt`/`Status-Quelle fehlt`). **Quellen-agnostisch** — passt auf Modbus-Comm-Status UND LoRaWAN-Uplink-Liveness.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_BUS_MONITOR" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="afbBmMon">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <derived name="FB_DEVICE_MONITOR"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1789996865025" monitorEnabled="true" uuid="9377c429-e810-4c1d-90e3-b642055f11ed">
                    <ForgeIecVar documentation="Zustandsgraph Geraet Pfirsich" element="0" label="Pfirsich"/>
                    <ForgeIecVar documentation="Zustandsgraph Geraet Stachelbeere" element="1" label="Stachelbeere"/>
                    <ForgeIecVar documentation="Zustandsgraph Geraet Maulbeere" element="2" label="Maulbeere"/>
                    <ForgeIecVar documentation="Zustandsgraph Geraet Felsenbirne" element="3" label="Felsenbirne"/>
                    <ForgeIecVar documentation="Zustandsgraph Geraet Maibeere" element="4" label="Maibeere"/>
                    <ForgeIecVar documentation="Zustandsgraph Geraet Johannisbeere" element="5" label="Johannisbeere"/>
                    <ForgeIecVar documentation="Zustandsgraph Geraet Schaltschrank" element="6" label="Schaltschrank"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Pro-Geraet-Zustandsgraph-Instanzen</xhtml>
              </documentation>
            </variable>
            <variable name="iBm">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="93c0a81b-45d8-4f9b-bb22-de8df98f04a9"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Schleifenindex 0..6</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xBmValid">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="92c9aa03-1d38-4b6b-b76e-64991d9e03a5"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Status-Quelle (Dev-Monitor / LoRaWAN-Netzserver) liefert Daten</xhtml>
              </documentation>
            </variable>
            <variable name="axBmOnline">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1789996865118" monitorEnabled="true" uuid="86281eca-5b51-4399-bb5e-370bdff22859">
                    <ForgeIecVar documentation="Online-Bit Geraet Pfirsich (Eingang)" element="0" label="Pfirsich online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Stachelbeere (Eingang)" element="1" label="Stachelbeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Maulbeere (Eingang)" element="2" label="Maulbeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Felsenbirne (Eingang)" element="3" label="Felsenbirne online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Maibeere (Eingang)" element="4" label="Maibeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Johannisbeere (Eingang)" element="5" label="Johannisbeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Schaltschrank (Eingang)" element="6" label="Schaltschrank online"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Online je Geraet: 0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne 4=Maibeere 5=Johannisbeere 6=Schaltschrank</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="asBmStatus">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <string/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1789996865214" monitorEnabled="true" uuid="67a74903-ffc8-4cee-98cb-1edffc163f44">
                    <ForgeIecVar documentation="Klartext-Status Geraet Pfirsich" element="0" label="Pfirsich"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Stachelbeere" element="1" label="Stachelbeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Maulbeere" element="2" label="Maulbeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Felsenbirne" element="3" label="Felsenbirne"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Maibeere" element="4" label="Maibeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Johannisbeere" element="5" label="Johannisbeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Schaltschrank" element="6" label="Schaltschrank"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Klartext-Status je Geraet (fuer HMI)</xhtml>
              </documentation>
            </variable>
            <variable name="auBmState">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <USINT/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1789996865310" monitorEnabled="true" uuid="9720bacb-1f38-43b0-a26e-40d3b1e064da">
                    <ForgeIecVar documentation="Zustand Geraet Pfirsich (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="0" label="Pfirsich"/>
                    <ForgeIecVar documentation="Zustand Geraet Stachelbeere (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="1" label="Stachelbeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Maulbeere (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="2" label="Maulbeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Felsenbirne (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="3" label="Felsenbirne"/>
                    <ForgeIecVar documentation="Zustand Geraet Maibeere (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="4" label="Maibeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Johannisbeere (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="5" label="Johannisbeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Schaltschrank (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="6" label="Schaltschrank"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zustand je Geraet (0=Unbekannt 1=Online 2=Gestoert 3=Offline)</xhtml>
              </documentation>
            </variable>
            <variable name="xBmAllOk">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="3445eacf-5770-472e-b892-d3d0b4b9c73f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = alle Geraete online</xhtml>
              </documentation>
            </variable>
            <variable name="iBmFaultCount">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="52387c70-cb19-4ba6-bcbf-fcaee362a979"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Anzahl Geraete nicht online (Gestoert/Offline/Unbekannt)</xhtml>
              </documentation>
            </variable>
            <variable name="sBmSummary">
              <type>
                <string/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="c86f8d9d-ea37-4144-a583-a1065d7b78af"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sammel-Klartext fuer die HMI</xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_BUS_MONITOR  —  Aggregierte Geraete-/Modulueberwachung fuer die HMI
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-06-06
   ----------------------------------------------------------------------------
   Zweck   : Fuehrt je ueberwachtem Geraet eine FB_DEVICE_MONITOR-Instanz
             (Zustandsgraph + Klartext) und buendelt die Ergebnisse fuer die
             HMI: Klartext je Geraet (asBmStatus), Zustand je Geraet (auBmState),
             Sammel-OK (xBmAllOk), Fehlerzahl (iBmFaultCount) und eine
             Sammelmeldung (sBmSummary).
             Quelle der Online-Bits (axBmOnline) liefert die Runtime-Monitor-
             Schicht (Dev) bzw. der LoRaWAN-Netzserver (Uplink-Liveness). Bis
             dahin xBmValid=FALSE -&gt; alle Geraete 'Status-Quelle fehlt'.
             Geraete-Index: 0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne
             4=Maibeere 5=Johannisbeere 6=Schaltschrank.
   ============================================================================ *)

xBmAllOk      := TRUE;
iBmFaultCount := 0;

FOR iBm := 0 TO 6 DO
    afbBmMon[iBm](xStatusValid := xBmValid, xOnline := axBmOnline[iBm]);
    auBmState[iBm]  := afbBmMon[iBm].uDmState;
    asBmStatus[iBm] := afbBmMon[iBm].sDmStatus;
    IF afbBmMon[iBm].uDmState &lt;&gt; 1 THEN          (* alles ausser Online = Stoerung *)
        xBmAllOk      := FALSE;
        iBmFaultCount := iBmFaultCount + 1;
    END_IF;
END_FOR;

(* --- Sammelmeldung (Klartext) fuer die HMI --- *)
IF NOT xBmValid THEN
    sBmSummary := 'Ueberwachung: Status-Quelle fehlt';
ELSIF xBmAllOk THEN
    sBmSummary := 'Alle Geraete online';
ELSE
    sBmSummary := 'Stoerung: Geraet(e) nicht online';
END_IF;</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_BUS_MONITOR — Aggregierte Geräteüberwachung für die HMI

Führt je Gerät eine `FB_DEVICE_MONITOR`-Instanz (7 Geräte) und bündelt: Zustand (`auBmState`) + Klartext (`asBmStatus`) je Gerät, Sammel-OK (`xBmAllOk`), Fehlerzahl (`iBmFaultCount`), Sammel-Klartext (`sBmSummary`). Eingänge: `xBmValid` + `axBmOnline[0..6]` (0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne 4=Maibeere 5=Johannisbeere 6=Schaltschrank), gespeist aus `Anvil.&lt;grp&gt;.Status.xOnline`. In PLC_PRG §9 → `Bellows.Diag.*` (HMI rendert Klartext aus dem Zustandscode).</xhtml>
        </documentation>
      </pou>
      <pou name="Diag" pouType="program">
        <interface>
          <globalVars>
            <variable name="asDevStatus" address="%MD1">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <string/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385094" addressLocked="true" bellowsRead="true" createdMs="1780699384752" label="Gerätestatus (Klartext)" modifiedMs="1789996864838" monitorEnabled="true" setting="true" uuid="27af31e6-0d91-46ca-9575-49a98d7142da">
                    <ForgeIecVar documentation="Klartext-Status Geraet Pfirsich fuer HMI" element="0" label="Pfirsich"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Stachelbeere fuer HMI" element="1" label="Stachelbeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Maulbeere fuer HMI" element="2" label="Maulbeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Felsenbirne fuer HMI" element="3" label="Felsenbirne"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Maibeere fuer HMI" element="4" label="Maibeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Johannisbeere fuer HMI" element="5" label="Johannisbeere"/>
                    <ForgeIecVar documentation="Klartext-Status Geraet Schaltschrank fuer HMI" element="6" label="Schaltschrank"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Klartext-Status je Geraet fuer HMI (0=Pfirsich..5=Johannisbeere,6=Schaltschrank)</xhtml>
              </documentation>
            </variable>
            <variable name="auDevState" address="%MD2">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <USINT/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385094" addressLocked="true" bellowsRead="true" createdMs="1780699384904" label="Gerätezustand (Code)" modifiedMs="1789996864931" monitorEnabled="true" setting="true" uuid="d202e036-1091-496d-ac27-a308540bcfb0">
                    <ForgeIecVar documentation="Zustand Geraet Pfirsich fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="0" label="Pfirsich"/>
                    <ForgeIecVar documentation="Zustand Geraet Stachelbeere fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="1" label="Stachelbeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Maulbeere fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="2" label="Maulbeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Felsenbirne fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="3" label="Felsenbirne"/>
                    <ForgeIecVar documentation="Zustand Geraet Maibeere fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="4" label="Maibeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Johannisbeere fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="5" label="Johannisbeere"/>
                    <ForgeIecVar documentation="Zustand Geraet Schaltschrank fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)" element="6" label="Schaltschrank"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zustand je Geraet fuer HMI-Farbcodierung (0=Unbekannt 1=Online 2=Gestoert 3=Offline)</xhtml>
              </documentation>
            </variable>
            <variable name="sSummary" address="%MD3">
              <type>
                <string/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385578" addressLocked="true" bellowsRead="true" createdMs="1780699385368" label="Sammelmeldung Geräte" modifiedMs="1780699385578" monitorEnabled="true" setting="true" uuid="92611cc2-fd70-434b-928e-0cedd9e6d0a7"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sammel-Klartext der Geraeteueberwachung fuer HMI</xhtml>
              </documentation>
            </variable>
            <variable name="xAllOk" address="%MX0.0">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699385993" addressLocked="true" bellowsRead="true" createdMs="1780699385783" label="Alle Geräte in Ordnung" modifiedMs="1780699385993" monitorEnabled="true" setting="true" uuid="a0a5abb3-f8d4-45d0-a22e-19449e994651"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = alle Geraete online (HMI-Sammelanzeige)</xhtml>
              </documentation>
            </variable>
            <variable name="iFaultCount" address="%MW0">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1780699386657" addressLocked="true" bellowsRead="true" createdMs="1780699386467" label="Anzahl gestörter Geräte" modifiedMs="1780699386657" monitorEnabled="true" setting="true" uuid="1010277f-c23d-4dca-83a1-cb1014b4f3d5"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Anzahl Geraete nicht online (HMI)</xhtml>
              </documentation>
            </variable>
          </globalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe Diag: Geraeteueberwachung fuer die HMI. auDevState[0..6] Zustand je Geraet (0 Unbekannt, 1 Online, 2 Gestoert, 3 Keine Verbindung), asDevStatus und sSummary als Klartext, xAllOk und iFaultCount als Sammelmeldung. Index 0 Pfirsich, 1 Stachelbeere, 2 Maulbeere, 3 Felsenbirne, 4 Maibeere, 5 Johannisbeere, 6 Schaltschrank.</xhtml>
        </documentation>
      </pou>
      <pou name="Betrieb" pouType="program">
        <interface>
          <globalVars>
            <variable name="uModeActive" address="%MB0">
              <type>
                <USINT/>
              </type>
              <initialValue>
                <simpleValue value="0"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1781336329254" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1781216915539" label="Aktive Betriebsart" modifiedMs="1790625928740" monitorEnabled="true" persistent="true" setting="true" uuid="4ccabb88-05f2-49d5-8cfd-ff62205058d1"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Aktive Betriebsart, je Betriebsart ein Bit: 0 = AUS, 1 = Manuell, 2 = One-Shot, 4 = wiederkehrend, 8 = Auto. Die EINE Quelle: PLC_PRG gibt damit die Modus-Bausteine frei (xEnable) und reicht dasselbe Bit als bModeBit weiter; FB_TERMINAL_OUT liest damit die Vorwahl aus astValveStatus[i].bMode. Von der HMI gesetzt, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="uMaxVentile" address="%MB2">
              <type>
                <USINT/>
              </type>
              <initialValue>
                <simpleValue value="24"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1785368375714" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1781477239426" label="Max. offene Ventile" modifiedMs="1790625552026" monitorEnabled="true" persistent="true" setting="true" uuid="db1f89d9-48fc-4b39-9300-fbca38abea4c"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Hoechstzahl gleichzeitig offener Ventile (Wasserdruck, Pumpenleistung). FB_TERMINAL_OUT begrenzt auf diese Zahl; weitere Anforderungen warten in Index-Reihenfolge und ruecken nach, sobald ein Platz frei wird. Startwert 24. Von der HMI gesetzt, persistent.</xhtml>
              </documentation>
            </variable>
            <variable name="rBlinkHz" address="%MD7">
              <type>
                <REAL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" bellowsRead="true" bellowsWrite="true" label="Blinkfrequenz wartende Ventile [Hz]" modifiedMs="1790627023477" monitorEnabled="true" persistent="true" setting="true" uuid="98ec68a7-c512-45a9-b244-73866f0676c2"/>
                </data>
              </addData>
              <initialValue>
                <simpleValue value="0.1"/>
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blinkfrequenz der Status-LEDs wartender Ventile in den Betriebsarten Manuell, One-Shot und wiederkehrend, in Hz: angefordert, aber vom Arbiter noch nicht freigegeben. PLC_PRG begrenzt auf 0.01..10 Hz, ein Wert unter 0.01 gilt als 0.1. Startwert 0.1 Hz = 5 s an / 5 s aus. Von der HMI gesetzt, persistent.</xhtml>
              </documentation>
            </variable>
          </globalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe Betrieb: Betriebsartwahl xManuell, xOneShot, xWiederkehrend, xAuto (genau eine gesetzt, sonst Aus), die bestaetigte Betriebsart uModeActive (0 Aus, 1 Manuell, 2 One-Shot, 3 wiederkehrend, 4 Auto) und die Einstellwerte uMaxVentile und rBlinkHz. Wahl und Einstellwerte sind persistent.</xhtml>
        </documentation>
      </pou>
      <pou name="HmiCmd" pouType="program">
        <interface/>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe HmiCmd: derzeit ohne Variablen.</xhtml>
        </documentation>
      </pou>
      <pou name="Schrittkette" pouType="program">
        <interface>
          <globalVars>
            <variable name="xStart" address="%MX0.5">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1781480919950" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1781480906406" modifiedMs="1781480919950" monitorEnabled="true" uuid="5962be06-9e5b-4788-9906-1c4645d52739"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Startimpuls One-Shot-Schrittkette (Puls via Handshake). Steigende Flanke armt die selektierten Beete.</xhtml>
              </documentation>
            </variable>
            <variable name="xStop" address="%MX0.6">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782427653719" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782423575765" modifiedMs="1782427653719" monitorEnabled="true" uuid="49cafa8c-6799-4231-aed8-a425c581f63b"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Stop One-Shot-Schrittkette (Puls via Handshake). Bricht den laufenden Lauf ab: alle Ventile zu, Schritte -&gt; idle; neuer Start noetig.</xhtml>
              </documentation>
            </variable>
            <variable name="xPause" address="%MX0.7">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782427660027" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782423631920" modifiedMs="1782427660027" monitorEnabled="true" uuid="ea732196-d683-414e-85a8-f434a039d95f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Pause One-Shot-Schrittkette (Halten/Toggle via Handshake). Pause: Ventile zu + Restzeit-Timer eingefroren; erneut = fortsetzen (Ventile wieder auf).</xhtml>
              </documentation>
            </variable>
            <variable name="xAcknowledge" address="%MX1.0">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782427657942" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782423654011" modifiedMs="1789880945164" monitorEnabled="true" uuid="af5c4667-15b9-41f1-83c1-1c64cc4e5429"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Quittieren One-Shot-Schrittkette (Puls via Handshake). Loescht den Fertig-/Stoerungs-Status (xSeqAllDone) nach einem Lauf.</xhtml>
              </documentation>
            </variable>
            <variable name="axSelToggle" address="%MD6">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1782429299638" addressLocked="true" bellowsRead="true" bellowsWrite="true" createdMs="1782429286940" modifiedMs="1790593509698" monitorEnabled="true" uuid="29d9785c-2b11-42b3-9c8b-a73a1e4b09b1">
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Pfirsich.xV_2 (%QX0.1), Zone Pfirsich Beet 2" element="1" label="Pfirsich xV_2"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Pfirsich.xV_3 (%QX0.2), Zone Pfirsich Beet 3" element="2" label="Pfirsich xV_3"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Pfirsich.xV_4 (%QX0.3), Zone Pfirsich Beet 4" element="3" label="Pfirsich xV_4"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Stachelbeere.xV_1 (%QX1.0), Zone Stachelbeere Beet 1" element="4" label="Stachelbeere xV_1"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Stachelbeere.xV_2 (%QX1.1), Zone Stachelbeere Beet 2" element="5" label="Stachelbeere xV_2"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Stachelbeere.xV_3 (%QX1.2), Zone Stachelbeere Beet 3" element="6" label="Stachelbeere xV_3"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Stachelbeere.xV_4 (%QX1.3), Zone Stachelbeere Beet 4" element="7" label="Stachelbeere xV_4"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maulbeere.xV_1 (%QX2.0), Zone Maulbeere Beet 1" element="8" label="Maulbeere xV_1"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maulbeere.xV_2 (%QX2.1), Zone Maulbeere Beet 2" element="9" label="Maulbeere xV_2"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maulbeere.xV_3 (%QX2.2), Zone Maulbeere Beet 3" element="10" label="Maulbeere xV_3"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maulbeere.xV_4 (%QX2.3), Zone Maulbeere Beet 4" element="11" label="Maulbeere xV_4"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Felsenbirne.xV_1 (%QX5.0), Zone Felsenbirne Beet 1" element="12" label="Felsenbirne xV_1"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Felsenbirne.xV_2 (%QX5.1), Zone Felsenbirne Beet 2" element="13" label="Felsenbirne xV_2"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Felsenbirne.xV_3 (%QX5.2), Zone Felsenbirne Beet 3" element="14" label="Felsenbirne xV_3"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Felsenbirne.xV_4 (%QX5.3), Zone Felsenbirne Beet 4" element="15" label="Felsenbirne xV_4"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maibeere.xV_1 (%QX3.0), Zone Maibeere Beet 1" element="16" label="Maibeere xV_1"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maibeere.xV_2 (%QX3.1), Zone Maibeere Beet 2" element="17" label="Maibeere xV_2"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maibeere.xV_3 (%QX3.2), Zone Maibeere Beet 3" element="18" label="Maibeere xV_3"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Maibeere.xV_4 (%QX3.3), Zone Maibeere Beet 4" element="19" label="Maibeere xV_4"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Johannisbeere.xV_1 (%QX4.0), Zone Johannisbeere Beet 1" element="20" label="Johannisbeere xV_1"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Johannisbeere.xV_2 (%QX4.1), Zone Johannisbeere Beet 2" element="21" label="Johannisbeere xV_2"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Johannisbeere.xV_3 (%QX4.2), Zone Johannisbeere Beet 3" element="22" label="Johannisbeere xV_3"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Johannisbeere.xV_4 (%QX4.3), Zone Johannisbeere Beet 4" element="23" label="Johannisbeere xV_4"/>
                    <ForgeIecVar documentation="HMI-Anwahl-Puls Ventil Anvil.Pfirsich.xV_1 (%QX0.0), Zone Pfirsich Beet 1" element="0" label="Pfirsich xV_1"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Anwahl-Puls je Beet (momentan, schreibbar), Index z*4+v wie Betrieb.astValveStatus (0..23). Beet-Taster im Bild und Vorwahl-Haken im Dialog geben denselben Puls; FB_SCHEDULE kippt daraus Betrieb.aValveJobs[].xSelected. Ersetzt das Schreiben auf den nicht-schreibbaren Anvil-Taster xT.</xhtml>
              </documentation>
            </variable>
          </globalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"/>
          </ST>
        </body>
        <addData>
          <data name="https://forgeiec.io/v2" handleUnknown="preserve">
            <ForgeIecPou xmlns="https://forgeiec.io/v2" pouType="globalVarList"/>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">HMI-Gruppe Schrittkette: Anwahl-Puls je Beet (axSelToggle, Index z*4+v, 0..23), die Befehle xStart, xStop, xPause und xAcknowledge (FB_SCHEDULE wertet je eine steigende Flanke aus) und der Laufzustand uRunState (0 Idle, 1 Running, 2 Paused, 3 Done). Die Restzeit je Beet steht in Betrieb.astValveStatus[i].remainingLiquidation (nicht persistent). Den Warterang (auQueue) gibt es nicht mehr.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_SCHEDULE" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="i">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790035570756" modifiedMs="1790035573559" monitorEnabled="true" uuid="94b09157-e881-4527-aa93-8cee40ff1fb4"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Laufindex ueber die 24 Ventile.</xhtml>
              </documentation>
            </variable>
            <variable name="fbJk">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <derived name="JK_FF"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790600558182" modifiedMs="1790602954990" monitorEnabled="true" uuid="0487366e-d9dc-49fa-a796-37568f8535a6"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ein JK-Flipflop je Beet, Index z*4+v in der Reihenfolge von FB_TERMINAL_OUT. Gleichberechtigt schalten um: der Taster am Beet (Anvil.&lt;Zone&gt;.xT_v) und der HMI-Puls auf Schrittkette.axSelToggle[i] (Beet-Taster im Bild, Vorwahl-Haken im Dialog); J = K = TRUE. Q ist Betrieb.aValveJobs[i].xSelected. Nicht persistent: nach einem Neustart ist nichts angewaehlt.</xhtml>
              </documentation>
            </variable>
            <variable name="aTonr">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <derived name="TONR"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790601192030" modifiedMs="1790602491603" monitorEnabled="true" uuid="02eb215d-bcb7-407c-a8a8-21ed1c3d4b37"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Lauf-Timer je Beet (TONR, pausierbar): IN = Lauf aktiv (uRunState 1), Beet noch nicht fertig und Ventil wirklich offen; PT = astValveStatus[i].liquidationPeriod. Pause, Warten auf Freigabe und Sperre lassen IN fallen, ET bleibt stehen. Start und Stopp setzen per RESET zurueck.</xhtml>
              </documentation>
            </variable>
            <variable name="artCmd">
              <type>
                <array>
                  <dimension lower="0" upper="3"/>
                  <baseType>
                    <derived name="R_TRIG"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790601213174" modifiedMs="1790601222939" monitorEnabled="true" uuid="53748225-3260-4859-914b-3e050103fab0"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Flanken der HMI-Befehle aus Schrittkette: 0 = xStart, 1 = xStop, 2 = xPause, 3 = xAcknowledge.</xhtml>
              </documentation>
            </variable>
            <variable name="axSelPrev">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790639096391" modifiedMs="1790639104520" monitorEnabled="true" uuid="fe78f10a-5cd1-4758-8c60-d3942d49d0a0"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Anwahl je Beet im vorigen Zyklus: steigende Flanke im Lauf/Pause laedt das Beet nach, fallende beendet es.</xhtml>
              </documentation>
            </variable>
          </localVars>
          <tempVars>
            <variable name="xAny">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790601257334" modifiedMs="1790602493542" monitorEnabled="true" uuid="e36621ae-4d21-4ed3-b564-a8fc81edf293"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Hilfsmerker: beim Start mindestens ein Beet geladen; im Lauf mindestens ein Beet noch nicht fertig.</xhtml>
              </documentation>
            </variable>
          </tempVars>
          <inputVars>
            <variable name="xEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1790017907801" monitorEnabled="true" uuid="6b66fed4-dee1-439b-aee9-478e3060226e"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Master-Enable der One-Shot-Zone. FALSE setzt alle Anwahl-Flipflops zurueck (RESET der JK_FFs) -&gt; Anwahl faellt, kein Ventil. Wird in PLC_PRG nur im One-Shot-Modus (uMode=2) auf TRUE gerufen; in anderen Modi nicht aufgerufen -&gt; Instanz-Zustand friert ein.</xhtml>
              </documentation>
            </variable>
            <variable name="bModeBit">
              <type>
                <BYTE/>
              </type>
              <initialValue>
                <simpleValue value="2"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790035565796" modifiedMs="1790035569157" monitorEnabled="true" uuid="9d438f67-92c3-4255-be16-fec84ee4ae1f"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Das Bit dieser Betriebsart im Ventilstatus (2 One-Shot, 4 wiederkehrend) — der Baustein dient beiden, PLC_PRG sagt ihm, welche.</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="axValve">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790018371984" modifiedMs="1790018374664" monitorEnabled="true" uuid="17c7f836-1f30-4cdc-a372-f54e318e79e3"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Das Ventilmuster dieser Betriebsart, Index z*4+v. In PLC_PRG waehlt der CASE aus.</xhtml>
              </documentation>
            </variable>
            <variable name="axLed">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790018383272" modifiedMs="1790018385968" monitorEnabled="true" uuid="b907294a-261d-422e-bf6b-8816cec499e3"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Das Lampenmuster dieser Betriebsart, Index z*4+v. In PLC_PRG waehlt der CASE aus.</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <inOutVars/>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_SCHEDULE  —  Einmal-Lauf (2) und wiederkehrend (4)
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-09-21 (leergeraeumt), Lauf 2026-09-28
   ----------------------------------------------------------------------------
   Vier Anschluesse, mehr nicht:
        xEnable   Freigabe der Betriebsart
        bModeBit  das Bit dieser Betriebsart im Ventilstatus (2 oder 4 —
                  der Baustein dient beiden, PLC_PRG sagt ihm, welche)
        axValve   Ventilmuster, Index z*4+v   (Ausgang)
        axLed     Lampenmuster, Index z*4+v   (Ausgang)

   Zwei Instanzen (fbOneShot, fbRecurring). Nur die freigegebene kommt
   hinter das RETURN; die gesperrte haelt nur ihre Timer an (IN FALSE,
   ET bleibt stehen) und schreibt nichts Gemeinsames.

   ANWAHL: Betrieb.aValveJobs[i].xSelected ist STATUS und gehoert der SPS.
   Gleichberechtigt schalten um: der Taster am Beet (Anvil.&lt;Zone&gt;.xT_v)
   und der HMI-Puls auf Schrittkette.axSelToggle[i] (Beet-Taster im Bild,
   Vorwahl-Haken im Dialog). Je Beet ein JK_FF, Q ist die Anwahl. Nicht
   persistent: nach einem Neustart ist nichts angewaehlt.
   Die Zuordnung Index -&gt; Zone/Ventil gibt FB_TERMINAL_OUT vor:
   Pfirsich 0-3, Stachelbeere 4-7, Maulbeere 8-11, Felsenbirne 12-15,
   Maibeere 16-19, Johannisbeere 20-23 (Index z*4+v, v = Taster/Ventil-1).

   LAUF (Schrittkette.uRunState: 0 Idle, 1 Running, 2 Paused, 3 Done):
        Start       Idle/Done: jedes angewaehlte Beet mit Dauer &gt; 0 wird
                    geladen (liquidationPeriod = Rest = tDuration, Timer
                    zurueck) -&gt; Running.  Paused -&gt; Running.
        Pause       Running &lt;-&gt; Paused. Pausiert faellt das Bit, die Ventile
                    schliessen, die Timer stehen.
        Stopp       jeder Rest 0, Timer zurueck -&gt; Idle.
        Quittieren  Done -&gt; Idle.
        Nachwahl    Running/Paused: ein Beet, das JETZT angewaehlt wird
                    (steigende Flanke der Anwahl), wird sofort geladen und
                    reiht sich ein. Ein fertiges Beet bleibt angewaehlt, ohne
                    neue Flanke — es laeuft nicht ein zweites Mal.
        Abwahl      Running/Paused: ein Beet, das abgewaehlt wird, endet
                    sofort (Rest 0, Timer zurueck, Ventil zu).
   Ein Beet zaehlt, solange Running, Rest &gt; 0 und das Ventil wirklich offen
   ist (Freigabe aus FB_TERMINAL_OUT) — ein TONR je Beet, der bei Pause und
   Warten stehen bleibt. Rest = PT - ET; Q -&gt; Rest 0. Sind alle fertig -&gt;
   Done. Die HMI zeigt die Restzeit direkt aus
   Betrieb.astValveStatus[i].remainingLiquidation — NICHT persistent. Eine
   Kopie in die persistente Job-Liste schrieb im Lauf alle 5 s die
   Persistenzdatei (29.09.2026) und ist deshalb entfallen.

   Alle Felder je Ventil laufen 0..23 (Index z*4+v).
   ============================================================================ *)

IF NOT xEnable THEN
    FOR i := 0 TO 23 DO
        aTonr[i](IN := FALSE, PT := Bellows.Betrieb.astValveStatus[i].liquidationPeriod, RESET := FALSE);
    END_FOR;
    RETURN;
END_IF;

(* --- 1) Anwahl je Beet: Feldtaster ODER HMI-Puls toggelt, Q ist der Status.
       Reihenfolge wie FB_TERMINAL_OUT. --- *)
(* Pfirsich: 0..3 *)
fbJk[0](xButton := Anvil.Pfirsich.xT_1 OR Bellows.Schrittkette.axSelToggle[0], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[1](xButton := Anvil.Pfirsich.xT_2 OR Bellows.Schrittkette.axSelToggle[1], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[2](xButton := Anvil.Pfirsich.xT_3 OR Bellows.Schrittkette.axSelToggle[2], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[3](xButton := Anvil.Pfirsich.xT_4 OR Bellows.Schrittkette.axSelToggle[3], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
(* Stachelbeere: 4..7 *)
fbJk[4](xButton := Anvil.Stachelbeere.xT_1 OR Bellows.Schrittkette.axSelToggle[4], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[5](xButton := Anvil.Stachelbeere.xT_2 OR Bellows.Schrittkette.axSelToggle[5], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[6](xButton := Anvil.Stachelbeere.xT_3 OR Bellows.Schrittkette.axSelToggle[6], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[7](xButton := Anvil.Stachelbeere.xT_4 OR Bellows.Schrittkette.axSelToggle[7], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
(* Maulbeere: 8..11 *)
fbJk[8](xButton := Anvil.Maulbeere.xT_1 OR Bellows.Schrittkette.axSelToggle[8], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[9](xButton := Anvil.Maulbeere.xT_2 OR Bellows.Schrittkette.axSelToggle[9], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[10](xButton := Anvil.Maulbeere.xT_3 OR Bellows.Schrittkette.axSelToggle[10], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[11](xButton := Anvil.Maulbeere.xT_4 OR Bellows.Schrittkette.axSelToggle[11], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
(* Felsenbirne: 12..15 *)
fbJk[12](xButton := Anvil.Felsenbirne.xT_1 OR Bellows.Schrittkette.axSelToggle[12], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[13](xButton := Anvil.Felsenbirne.xT_2 OR Bellows.Schrittkette.axSelToggle[13], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[14](xButton := Anvil.Felsenbirne.xT_3 OR Bellows.Schrittkette.axSelToggle[14], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[15](xButton := Anvil.Felsenbirne.xT_4 OR Bellows.Schrittkette.axSelToggle[15], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
(* Maibeere: 16..19 *)
fbJk[16](xButton := Anvil.Maibeere.xT_1 OR Bellows.Schrittkette.axSelToggle[16], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[17](xButton := Anvil.Maibeere.xT_2 OR Bellows.Schrittkette.axSelToggle[17], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[18](xButton := Anvil.Maibeere.xT_3 OR Bellows.Schrittkette.axSelToggle[18], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[19](xButton := Anvil.Maibeere.xT_4 OR Bellows.Schrittkette.axSelToggle[19], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
(* Johannisbeere: 20..23 *)
fbJk[20](xButton := Anvil.Johannisbeere.xT_1 OR Bellows.Schrittkette.axSelToggle[20], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[21](xButton := Anvil.Johannisbeere.xT_2 OR Bellows.Schrittkette.axSelToggle[21], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[22](xButton := Anvil.Johannisbeere.xT_3 OR Bellows.Schrittkette.axSelToggle[22], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);
fbJk[23](xButton := Anvil.Johannisbeere.xT_4 OR Bellows.Schrittkette.axSelToggle[23], J := TRUE, K := TRUE, RESET := FALSE, tDebounce := T#20ms);

FOR i := 0 TO 23 DO
    Bellows.Betrieb.aValveJobs[i].xSelected := fbJk[i].Q;
    (* Nachwahl und Abwahl waehrend des Laufs: die FLANKE der Anwahl, nicht
       ihr Zustand — ein fertiges Beet bleibt angewaehlt und laeuft nicht
       nochmal. Start laedt weiterhin alle Angewaehlten (Abschnitt 2). *)
    IF (Bellows.Schrittkette.uRunState = 1) OR (Bellows.Schrittkette.uRunState = 2) THEN
        IF fbJk[i].Q AND NOT axSelPrev[i]
           AND (Bellows.Betrieb.aValveJobs[i].tDuration &gt; T#0s) THEN
            Bellows.Betrieb.astValveStatus[i].liquidationPeriod := Bellows.Betrieb.aValveJobs[i].tDuration;
            Bellows.Betrieb.astValveStatus[i].remainingLiquidation := Bellows.Betrieb.aValveJobs[i].tDuration;
            aTonr[i](IN := FALSE, PT := Bellows.Betrieb.aValveJobs[i].tDuration, RESET := TRUE);
        ELSIF NOT fbJk[i].Q AND axSelPrev[i] THEN
            Bellows.Betrieb.astValveStatus[i].remainingLiquidation := T#0s;
            aTonr[i](IN := FALSE, PT := Bellows.Betrieb.astValveStatus[i].liquidationPeriod, RESET := TRUE);
        END_IF;
    END_IF;
    axSelPrev[i] := fbJk[i].Q;
END_FOR;

(* --- 2) Befehle: je eine steigende Flanke --- *)
artCmd[0](CLK := Bellows.Schrittkette.xStart);
artCmd[1](CLK := Bellows.Schrittkette.xStop);
artCmd[2](CLK := Bellows.Schrittkette.xPause);
artCmd[3](CLK := Bellows.Schrittkette.xAcknowledge);

IF artCmd[1].Q THEN
    FOR i := 0 TO 23 DO
        Bellows.Betrieb.astValveStatus[i].remainingLiquidation := T#0s;
        aTonr[i](IN := FALSE, PT := Bellows.Betrieb.astValveStatus[i].liquidationPeriod, RESET := TRUE);
    END_FOR;
    Bellows.Schrittkette.uRunState := 0;
ELSIF artCmd[0].Q THEN
    IF Bellows.Schrittkette.uRunState = 2 THEN
        Bellows.Schrittkette.uRunState := 1;
    ELSIF Bellows.Schrittkette.uRunState &lt;&gt; 1 THEN
        xAny := FALSE;
        FOR i := 0 TO 23 DO
            IF Bellows.Betrieb.aValveJobs[i].xSelected
               AND (Bellows.Betrieb.aValveJobs[i].tDuration &gt; T#0s) THEN
                Bellows.Betrieb.astValveStatus[i].liquidationPeriod := Bellows.Betrieb.aValveJobs[i].tDuration;
                Bellows.Betrieb.astValveStatus[i].remainingLiquidation := Bellows.Betrieb.aValveJobs[i].tDuration;
                aTonr[i](IN := FALSE, PT := Bellows.Betrieb.aValveJobs[i].tDuration, RESET := TRUE);
                xAny := TRUE;
            END_IF;
        END_FOR;
        IF xAny THEN
            Bellows.Schrittkette.uRunState := 1;
        END_IF;
    END_IF;
ELSIF artCmd[2].Q THEN
    IF Bellows.Schrittkette.uRunState = 1 THEN
        Bellows.Schrittkette.uRunState := 2;
    ELSIF Bellows.Schrittkette.uRunState = 2 THEN
        Bellows.Schrittkette.uRunState := 1;
    END_IF;
ELSIF artCmd[3].Q AND (Bellows.Schrittkette.uRunState = 3) THEN
    Bellows.Schrittkette.uRunState := 0;
END_IF;

(* --- 3) Lauf je Beet: Timer, Restzeit, Muster --- *)
xAny := FALSE;
FOR i := 0 TO 23 DO
    aTonr[i](IN := (Bellows.Schrittkette.uRunState = 1)
                   AND (Bellows.Betrieb.astValveStatus[i].remainingLiquidation &gt; T#0s)
                   AND Bellows.Betrieb.astValveStatus[i].isOpen,
             PT := Bellows.Betrieb.astValveStatus[i].liquidationPeriod,
             RESET := FALSE);

    IF Bellows.Betrieb.astValveStatus[i].remainingLiquidation &gt; T#0s THEN
        IF aTonr[i].Q THEN
            Bellows.Betrieb.astValveStatus[i].remainingLiquidation := T#0s;
        ELSE
            Bellows.Betrieb.astValveStatus[i].remainingLiquidation :=
                Bellows.Betrieb.astValveStatus[i].liquidationPeriod - aTonr[i].ET;
        END_IF;
    END_IF;

    axValve[i] := (Bellows.Schrittkette.uRunState = 1)
                  AND (Bellows.Betrieb.astValveStatus[i].remainingLiquidation &gt; T#0s);
    axLed[i] := axValve[i];
    xAny := xAny OR (Bellows.Betrieb.astValveStatus[i].remainingLiquidation &gt; T#0s);
END_FOR;

IF (Bellows.Schrittkette.uRunState = 1) AND NOT xAny THEN
    Bellows.Schrittkette.uRunState := 3;
END_IF;

(* --- 4) Status je Ventil: das Bit dieser Betriebsart nach dem Muster --- *)
FOR i := 0 TO 23 DO
    IF axValve[i] THEN
        Bellows.Betrieb.astValveStatus[i].bMode := Bellows.Betrieb.astValveStatus[i].bMode OR bModeBit;
    ELSE
        Bellows.Betrieb.astValveStatus[i].bMode := Bellows.Betrieb.astValveStatus[i].bMode AND NOT bModeBit;
    END_IF;
END_FOR;
</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_SCHEDULE — One-Shot (2) und wiederkehrend (4)

Ein Baustein fuer beide zeitgesteuerten Betriebsarten; `PLC_PRG` ruft ihn zweimal (`fbOneShot` mit `bModeBit := 2`, `fbRecurring` mit `bModeBit := 4`). Nur die Instanz mit `xEnable = TRUE` arbeitet; die andere haelt ihre Timer an (IN FALSE, ET bleibt) und schreibt nichts Gemeinsames.

- **Anwahl:** je Beet ein `JK_FF` (`fbJk[0..23]`, J = K = TRUE). Feldtaster `Anvil.&lt;Zone&gt;.xT_v` und HMI-Puls `Schrittkette.axSelToggle[i]` schalten gleichberechtigt um; Q ist `Betrieb.aValveJobs[i].xSelected`. Nicht persistent.
- **Befehle** (je eine steigende Flanke, `artCmd`): Start, Stopp, Pause, Quittieren aus `Schrittkette`.
- **Zustand** `Schrittkette.uRunState`: 0 Idle, 1 Running, 2 Paused, 3 Done. Start laedt jedes angewaehlte Beet mit `tDuration &gt; 0` (`liquidationPeriod` = Rest = Dauer, Timer zurueck).
- **Nachwahl/Abwahl im Lauf** (Running oder Paused, `axSelPrev`): die steigende Flanke der Anwahl laedt das Beet sofort nach, es reiht sich ein; die fallende beendet es (Rest 0). Ein fertiges Beet bleibt angewaehlt, ohne neue Flanke, und laeuft nicht ein zweites Mal.
- **Timer:** je Beet ein `TONR` (`aTonr[0..23]`, pausierbar). IN = Running UND Rest &gt; 0 UND Ventil wirklich offen (Freigabe aus `FB_TERMINAL_OUT`). Pause und Warten auf Freigabe halten ihn an.
- **Restzeit:** `astValveStatus[i].remainingLiquidation` = PT − ET, bei Q 0. Die HMI liest sie dort direkt; sie ist NICHT persistent. Eine Kopie in die persistente Job-Liste (`aValveJobs[i].tRemaining`) schrieb im Lauf alle 5 s die Persistenzdatei und ist seit 29.09.2026 entfallen.
- **Ausgaenge:** `axValve[i]`/`axLed[i]` = Running UND Rest &gt; 0; danach das Bit der Betriebsart in `astValveStatus[i].bMode`.

**Offen:** wiederkehrend wertet `uStartHour`, `uStartMin` und `Betrieb.bWeekMask` noch nicht aus (Wochenschaltuhr folgt).</xhtml>
        </documentation>
      </pou>
      <pou name="FB_MANUAL" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="fbJk">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <derived name="JK_FF"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790018716330" modifiedMs="1790018719132" monitorEnabled="true" uuid="65dafb13-a97c-4c53-8aac-ffa189c0a406"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ein JK-Flipflop je Ventil, Index z*4+v. Der entprellte Tastendruck toggelt die Anwahl; Q ist das Ventilmuster.</xhtml>
              </documentation>
            </variable>
            <variable name="tDebounce">
              <type>
                <TIME/>
              </type>
              <initialValue>
                <simpleValue value="T#20ms"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790034005673" modifiedMs="1790034699373" uuid="ea2f5b9f-e63f-421b-bb66-ad29000ea307"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Entprellzeit der Taster, an jedes JK_FF gereicht (tDebounce).</xhtml>
              </documentation>
            </variable>
            <variable name="i">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790035561337" modifiedMs="1790035564110" monitorEnabled="true" uuid="ee115b93-8a15-4591-a2ac-0b164376b68a"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Laufindex ueber die 24 Ventile.</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1790034654425" monitorEnabled="true" uuid="cb031d9d-6fb9-4e15-800d-53c2bbed0c3b"/>
                </data>
              </addData>
            </variable>
            <variable name="bModeBit">
              <type>
                <BYTE/>
              </type>
              <initialValue>
                <simpleValue value="1"/>
              </initialValue>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790035556383" modifiedMs="1790035559774" monitorEnabled="true" uuid="10820ade-27cf-4044-8fc6-3d7c4fa9bd10"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Das Bit dieser Betriebsart im Ventilstatus (1 Manuell, 2 One-Shot, 4 wiederkehrend, 8 Auto) — wie GVL.Betrieb.uModeActive.</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="axValve">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790018336356" modifiedMs="1790018339013" monitorEnabled="true" uuid="7d2b59a0-4fc2-411d-9af0-484e702691fe"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Das Ventilmuster dieser Betriebsart, Index z*4+v. In PLC_PRG waehlt der CASE aus, welcher Modus seinen Ausgang in den Spiegel legt.</xhtml>
              </documentation>
            </variable>
            <variable name="axLed">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790018346945" modifiedMs="1790018349663" monitorEnabled="true" uuid="16f712a6-a2be-46eb-ad3d-6105aa209baa"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Das Lampenmuster dieser Betriebsart, Index z*4+v. In PLC_PRG waehlt der CASE aus, welcher Modus seinen Ausgang in den Spiegel legt.</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <inOutVars/>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_MANUAL  —  Handbetrieb, Betriebsart 1
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-09-21
   ----------------------------------------------------------------------------
   Vier Anschluesse, mehr nicht:
        xEnable   Freigabe der Betriebsart
        bModeBit  das Bit dieser Betriebsart im Ventilstatus (1)
        axValve   Ventilmuster, Index z*4+v   (Ausgang)
        axLed     Lampenmuster, Index z*4+v   (Ausgang)

   ENABLE: der Baustein verlaesst sich in der ERSTEN Zeile selbst, wenn
   xEnable FALSE ist. PLC_PRG ruft ihn dafuer in JEDEM Zyklus. Bei FALSE
   friert die Instanz ein und behaelt ihre Anwahl.

   JE VENTIL EIN FLIPFLOP, 24 Instanzen in fbJk: Zustand und Entprellung
   brauchen je Ventil ein eigenes Gedaechtnis. Der entprellte Druck toggelt
   (J = K = TRUE), Q ist die Anwahl. Die Entprellzeit ist tDebounce
   (lokal, T#20ms) und wird jedem JK_FF gereicht.

   DIE ABWAHL VON AUSSEN: FB_TERMINAL_OUT loescht das Bit dieses Modus in
   bMode, wenn ein offenes Ventil faellt — die Vorwahl ist verbraucht. Steht
   Q noch, aber das Bit fehlt, wird das Flipflop zurueckgesetzt (RESET), sonst
   setzte die Schleife unten das Bit im naechsten Takt wieder.

   Der Taster kommt vom Acker (Anvil.&lt;Zone&gt;.xT_1..4). Wo die Bedienoberflaeche
   einen eigenen Taster hat — xT_2 und xT_3 je Zone —, ist er dazu verodert;
   fuer xT_1 und xT_4 gibt es auf dieser Seite keinen.

   STATUS JE VENTIL: Bellows.Betrieb.astValveStatus[i].bMode traegt je
   Betriebsart ein Bit. Am Ende setzt eine Schleife das Bit dieses Modus
   (bModeBit) nach dem Ventilmuster — gesetzt, wo das Ventil angewaehlt ist,
   geloescht sonst. Die anderen Bits gehoeren den anderen Modi. Die
   Laufdauer eines angewaehlten Ventils ist im Handbetrieb T#0s: unbegrenzt,
   bis der Bediener es abwaehlt. Ob es wirklich oeffnet, entscheidet die
   Arbitrierung in FB_TERMINAL_OUT (isOpen).

   Index z*4+v, Reihenfolge Pfirsich, Stachelbeere, Maulbeere, Felsenbirne,
   Maibeere, Johannisbeere.
   ============================================================================ *)

IF NOT xEnable THEN
    RETURN;
END_IF;

(* --- Pfirsich, Ventile 1..4 --- *)
fbJk[0](xButton := Anvil.Pfirsich.xT_1, J := TRUE, K := TRUE, RESET := fbJk[0].Q AND ((Bellows.Betrieb.astValveStatus[0].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[0] := fbJk[0].Q;  axLed[0] := fbJk[0].Q;
fbJk[1](xButton := Anvil.Pfirsich.xT_2 OR Bellows.Pfirsich.xT_2, J := TRUE, K := TRUE, RESET := fbJk[1].Q AND ((Bellows.Betrieb.astValveStatus[1].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[1] := fbJk[1].Q;  axLed[1] := fbJk[1].Q;
fbJk[2](xButton := Anvil.Pfirsich.xT_3 OR Bellows.Pfirsich.xT_3, J := TRUE, K := TRUE, RESET := fbJk[2].Q AND ((Bellows.Betrieb.astValveStatus[2].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[2] := fbJk[2].Q;  axLed[2] := fbJk[2].Q;
fbJk[3](xButton := Anvil.Pfirsich.xT_4, J := TRUE, K := TRUE, RESET := fbJk[3].Q AND ((Bellows.Betrieb.astValveStatus[3].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[3] := fbJk[3].Q;  axLed[3] := fbJk[3].Q;

(* --- Stachelbeere, Ventile 1..4 --- *)
fbJk[4](xButton := Anvil.Stachelbeere.xT_1, J := TRUE, K := TRUE, RESET := fbJk[4].Q AND ((Bellows.Betrieb.astValveStatus[4].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[4] := fbJk[4].Q;  axLed[4] := fbJk[4].Q;
fbJk[5](xButton := Anvil.Stachelbeere.xT_2 OR Bellows.Stachelbeere.xT_2, J := TRUE, K := TRUE, RESET := fbJk[5].Q AND ((Bellows.Betrieb.astValveStatus[5].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[5] := fbJk[5].Q;  axLed[5] := fbJk[5].Q;
fbJk[6](xButton := Anvil.Stachelbeere.xT_3 OR Bellows.Stachelbeere.xT_3, J := TRUE, K := TRUE, RESET := fbJk[6].Q AND ((Bellows.Betrieb.astValveStatus[6].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[6] := fbJk[6].Q;  axLed[6] := fbJk[6].Q;
fbJk[7](xButton := Anvil.Stachelbeere.xT_4, J := TRUE, K := TRUE, RESET := fbJk[7].Q AND ((Bellows.Betrieb.astValveStatus[7].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[7] := fbJk[7].Q;  axLed[7] := fbJk[7].Q;

(* --- Maulbeere, Ventile 1..4 --- *)
fbJk[8](xButton := Anvil.Maulbeere.xT_1, J := TRUE, K := TRUE, RESET := fbJk[8].Q AND ((Bellows.Betrieb.astValveStatus[8].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[8] := fbJk[8].Q;  axLed[8] := fbJk[8].Q;
fbJk[9](xButton := Anvil.Maulbeere.xT_2 OR Bellows.Maulbeere.xT_2, J := TRUE, K := TRUE, RESET := fbJk[9].Q AND ((Bellows.Betrieb.astValveStatus[9].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[9] := fbJk[9].Q;  axLed[9] := fbJk[9].Q;
fbJk[10](xButton := Anvil.Maulbeere.xT_3 OR Bellows.Maulbeere.xT_3, J := TRUE, K := TRUE, RESET := fbJk[10].Q AND ((Bellows.Betrieb.astValveStatus[10].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[10] := fbJk[10].Q;  axLed[10] := fbJk[10].Q;
fbJk[11](xButton := Anvil.Maulbeere.xT_4, J := TRUE, K := TRUE, RESET := fbJk[11].Q AND ((Bellows.Betrieb.astValveStatus[11].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[11] := fbJk[11].Q;  axLed[11] := fbJk[11].Q;

(* --- Felsenbirne, Ventile 1..4 --- *)
fbJk[12](xButton := Anvil.Felsenbirne.xT_1, J := TRUE, K := TRUE, RESET := fbJk[12].Q AND ((Bellows.Betrieb.astValveStatus[12].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[12] := fbJk[12].Q;  axLed[12] := fbJk[12].Q;
fbJk[13](xButton := Anvil.Felsenbirne.xT_2 OR Bellows.Felsenbirne.xT_2, J := TRUE, K := TRUE, RESET := fbJk[13].Q AND ((Bellows.Betrieb.astValveStatus[13].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[13] := fbJk[13].Q;  axLed[13] := fbJk[13].Q;
fbJk[14](xButton := Anvil.Felsenbirne.xT_3 OR Bellows.Felsenbirne.xT_3, J := TRUE, K := TRUE, RESET := fbJk[14].Q AND ((Bellows.Betrieb.astValveStatus[14].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[14] := fbJk[14].Q;  axLed[14] := fbJk[14].Q;
fbJk[15](xButton := Anvil.Felsenbirne.xT_4, J := TRUE, K := TRUE, RESET := fbJk[15].Q AND ((Bellows.Betrieb.astValveStatus[15].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[15] := fbJk[15].Q;  axLed[15] := fbJk[15].Q;

(* --- Maibeere, Ventile 1..4 --- *)
fbJk[16](xButton := Anvil.Maibeere.xT_1, J := TRUE, K := TRUE, RESET := fbJk[16].Q AND ((Bellows.Betrieb.astValveStatus[16].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[16] := fbJk[16].Q;  axLed[16] := fbJk[16].Q;
fbJk[17](xButton := Anvil.Maibeere.xT_2 OR Bellows.Maibeere.xT_2, J := TRUE, K := TRUE, RESET := fbJk[17].Q AND ((Bellows.Betrieb.astValveStatus[17].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[17] := fbJk[17].Q;  axLed[17] := fbJk[17].Q;
fbJk[18](xButton := Anvil.Maibeere.xT_3 OR Bellows.Maibeere.xT_3, J := TRUE, K := TRUE, RESET := fbJk[18].Q AND ((Bellows.Betrieb.astValveStatus[18].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[18] := fbJk[18].Q;  axLed[18] := fbJk[18].Q;
fbJk[19](xButton := Anvil.Maibeere.xT_4, J := TRUE, K := TRUE, RESET := fbJk[19].Q AND ((Bellows.Betrieb.astValveStatus[19].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[19] := fbJk[19].Q;  axLed[19] := fbJk[19].Q;

(* --- Johannisbeere, Ventile 1..4 --- *)
fbJk[20](xButton := Anvil.Johannisbeere.xT_1, J := TRUE, K := TRUE, RESET := fbJk[20].Q AND ((Bellows.Betrieb.astValveStatus[20].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[20] := fbJk[20].Q;  axLed[20] := fbJk[20].Q;
fbJk[21](xButton := Anvil.Johannisbeere.xT_2 OR Bellows.Johannisbeere.xT_2, J := TRUE, K := TRUE, RESET := fbJk[21].Q AND ((Bellows.Betrieb.astValveStatus[21].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[21] := fbJk[21].Q;  axLed[21] := fbJk[21].Q;
fbJk[22](xButton := Anvil.Johannisbeere.xT_3 OR Bellows.Johannisbeere.xT_3, J := TRUE, K := TRUE, RESET := fbJk[22].Q AND ((Bellows.Betrieb.astValveStatus[22].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[22] := fbJk[22].Q;  axLed[22] := fbJk[22].Q;
fbJk[23](xButton := Anvil.Johannisbeere.xT_4, J := TRUE, K := TRUE, RESET := fbJk[23].Q AND ((Bellows.Betrieb.astValveStatus[23].bMode AND bModeBit) = 0), tDebounce := tDebounce);
axValve[23] := fbJk[23].Q;  axLed[23] := fbJk[23].Q;

(* --- Status je Ventil: das Bit dieser Betriebsart nach dem Muster,
       Laufdauer unbegrenzt (T#0s) --- *)
FOR i := 0 TO 23 DO
    IF axValve[i] THEN
        Bellows.Betrieb.astValveStatus[i].bMode := Bellows.Betrieb.astValveStatus[i].bMode OR bModeBit;
        Bellows.Betrieb.astValveStatus[i].liquidationPeriod := T#0s;
    ELSE
        Bellows.Betrieb.astValveStatus[i].bMode := Bellows.Betrieb.astValveStatus[i].bMode AND NOT bModeBit;
    END_IF;
END_FOR;
</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml"># FB_MANUAL — Handbetrieb, Betriebsart 1

`FB_MANUAL` bildet den Handbetrieb fuer 24 Ventile ab. Der Baustein wird zyklisch von `PLC_PRG` aufgerufen und liefert zwei Muster zurueck:

- `axValve[0..23]`: angewaehlte Ventile im Handbetrieb
- `axLed[0..23]`: zugehoeriges Lampenmuster, aktuell identisch zu `axValve`

Die Reihenfolge der Ventile ist gruppiert nach sechs Zonen mit je vier Ventilen:

1. Pfirsich
2. Stachelbeere
3. Maulbeere
4. Felsenbirne
5. Maibeere
6. Johannisbeere

Der Index folgt dem Schema `z * 4 + v`, also vier Ventile pro Zone.

## Schnittstelle

| Variable | Richtung | Bedeutung |
|---|---:|---|
| `xEnable` | Eingang | Freigabe fuer diese Betriebsart. Ist `xEnable = FALSE`, verlaesst der Baustein den Ablauf sofort mit `RETURN`. |
| `bModeBit` | Eingang | Bitmaske dieser Betriebsart im Ventilstatus, im Handbetrieb standardmaessig `1`. |
| `axValve` | Ausgang | Ventilmuster des Handbetriebs, Index `0..23`. |
| `axLed` | Ausgang | Lampenmuster des Handbetriebs, Index `0..23`. |

Wichtig: Bei `xEnable = FALSE` werden die Flipflops und Ausgangsmuster in diesem Baustein nicht neu berechnet. Die Instanz behaelt dadurch ihre bisherige Anwahl.

## Bedienlogik

Jedes Ventil besitzt eine eigene `JK_FF`-Instanz in `fbJk[0..23]`. Der entprellte Tastendruck toggelt die Anwahl:

- `J := TRUE`
- `K := TRUE`
- `Q` ist die gespeicherte Anwahl des Ventils
- `tDebounce := T#20ms` wird an jede Instanz uebergeben

Die lokalen Ausgaenge folgen direkt dem Flipflop-Zustand:

```st
axValve[i] := fbJk[i].Q;
axLed[i] := fbJk[i].Q;
```

## Tasterquellen

Die Feldtaster kommen aus dem Anvil-Namensraum:

- `Anvil.&lt;Zone&gt;.xT_1`
- `Anvil.&lt;Zone&gt;.xT_2`
- `Anvil.&lt;Zone&gt;.xT_3`
- `Anvil.&lt;Zone&gt;.xT_4`

Fuer die Ventile 2 und 3 je Zone gibt es zusaetzlich HMI-/Bellows-Taster. Diese werden logisch mit dem jeweiligen Feldtaster verodert:

```st
Anvil.&lt;Zone&gt;.xT_2 OR Bellows.&lt;Zone&gt;.xT_2
Anvil.&lt;Zone&gt;.xT_3 OR Bellows.&lt;Zone&gt;.xT_3
```

Fuer `xT_1` und `xT_4` gibt es auf der Bedienoberflaeche in diesem Baustein keine zusaetzlichen Bellows-Taster.

## Abwahl von aussen

`FB_TERMINAL_OUT` kann das Bit dieser Betriebsart in `Bellows.Betrieb.astValveStatus[i].bMode` loeschen, wenn ein offenes Ventil faellt beziehungsweise die Vorwahl verbraucht ist.

Steht das Flipflop noch auf `Q = TRUE`, aber das Modus-Bit fehlt im Status, setzt `FB_MANUAL` das zugehoerige Flipflop zurueck:

```st
RESET := fbJk[i].Q AND ((Bellows.Betrieb.astValveStatus[i].bMode AND bModeBit) = 0)
```

Damit wird verhindert, dass die Statusschleife das Modus-Bit im naechsten Zyklus sofort wieder setzt.

## Statusschreibung

Am Ende des Bausteins wird fuer alle 24 Ventile der Status im Bellows-Spiegel aktualisiert:

- Wenn `axValve[i] = TRUE`, wird `bModeBit` in `Bellows.Betrieb.astValveStatus[i].bMode` gesetzt.
- Wenn `axValve[i] = FALSE`, wird `bModeBit` dort geloescht.
- Bei angewaehltem Ventil wird `liquidationPeriod := T#0s` geschrieben.

Im Handbetrieb bedeutet `T#0s`: keine automatische Laufzeitbegrenzung durch diesen Baustein; das Ventil bleibt angewaehlt, bis der Bediener es abwaehlt oder die externe Logik die Vorwahl verbraucht.

Ob ein angewaehltes Ventil tatsaechlich oeffnet, entscheidet nicht `FB_MANUAL`, sondern die nachgelagerte Arbitrierung beziehungsweise Ausgabe in `FB_TERMINAL_OUT`.</xhtml>
        </documentation>
      </pou>
      <pou name="BusMonitor" pouType="program">
        <interface>
          <localVars>
            <variable name="mon">
              <type>
                <derived name="FB_BUS_MONITOR"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1788127850054" monitorEnabled="true" uuid="2a517f29-94fb-48a9-94cb-cf92e4595127"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Aggregierte Geraeteueberwachung</xhtml>
              </documentation>
            </variable>
            <variable name="axOnline">
              <type>
                <array>
                  <dimension lower="0" upper="6"/>
                  <baseType>
                    <BOOL/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2/variable" handleUnknown="discard">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2/variable" accessedMs="1788127850054" createdMs="1788127850054" modifiedMs="1789996864743" monitorEnabled="true" uuid="fa5df993-7132-49b1-a90e-96fb518a0abb">
                    <ForgeIecVar documentation="Online-Bit Geraet Pfirsich (Index wie FB_BUS_MONITOR)" element="0" label="Pfirsich online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Stachelbeere (Index wie FB_BUS_MONITOR)" element="1" label="Stachelbeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Maulbeere (Index wie FB_BUS_MONITOR)" element="2" label="Maulbeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Felsenbirne (Index wie FB_BUS_MONITOR)" element="3" label="Felsenbirne online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Maibeere (Index wie FB_BUS_MONITOR)" element="4" label="Maibeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Johannisbeere (Index wie FB_BUS_MONITOR)" element="5" label="Johannisbeere online"/>
                    <ForgeIecVar documentation="Online-Bit Geraet Schaltschrank (Index wie FB_BUS_MONITOR)" element="6" label="Schaltschrank online"/>
                  </ForgeIecVar>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Online-Bits je Geraet, Index wie in FB_BUS_MONITOR</xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   BusMonitor  -  Runtime-Comm-Status  -&gt;  FB_BUS_MONITOR  -&gt;  Bellows/Hearth
   ----------------------------------------------------------------------------
   Drei Glieder, von denen bis heute nur das mittlere existierte:

   1. QUELLE  Der cxx-Codegen materialisiert je Anvil-Geraetegruppe eine
              read-only Status-Sub-Struct unter Anvil.&lt;grp&gt;.Status , gefuellt
              im Input-Scan VOR der POU-Ausfuehrung - pro Zyklus ein
              konsistentes Abbild. Vertrag:
              documentation/architecture/device-status-interface.md

   2. LOGIK   FB_BUS_MONITOR fuehrt je Geraet eine FB_DEVICE_MONITOR-Instanz
              (Zustandsgraph, Entprellung, Klartext) und buendelt sie. Steht
              seit 2026-06-06, lief aber mit xBmValid=FALSE leer, weil
              axBmOnline keinen Lieferanten hatte.

   3. SENKE   Der Deskriptor kennt nur POOL-Variablen mit bellowsRead. Was in
              der FB-Instanz bleibt, sieht Hearth nie. Die Bellows.Diag-
              Variablen sind dafuer angelegt und tragen die Flagge bereits -
              es fehlten nur die fuenf Zuweisungen unten.

   Index-Zuordnung wie in FB_BUS_MONITOR dokumentiert:
     0=Pfirsich 1=Stachelbeere 2=Maulbeere 3=Felsenbirne
     4=Maibeere 5=Johannisbeere 6=Schaltschrank

   ACHTUNG: Die Zuordnung ist HANDGEPFLEGT und an ARRAY[0..6] gebunden. Ein
   achtes Geraet bliebe unueberwacht, ein geloeschtes verschoebe alle
   folgenden Indizes - die HMI meldete dann das falsche Geraet. Der
   Automatismus, der das aus der Bus-Topologie ableitet, ist offen.
   ============================================================================ *)

(* --- 1. Quelle einlesen --- *)
axOnline[0] := Anvil.Pfirsich.Status.xOnline;
axOnline[1] := Anvil.Stachelbeere.Status.xOnline;
axOnline[2] := Anvil.Maulbeere.Status.xOnline;
axOnline[3] := Anvil.Felsenbirne.Status.xOnline;
axOnline[4] := Anvil.Maibeere.Status.xOnline;
axOnline[5] := Anvil.Johannisbeere.Status.xOnline;
axOnline[6] := Anvil.Schaltschrank.Status.xOnline;

(* --- 2. Auswerten --- *)
mon(xBmValid := TRUE, axBmOnline := axOnline);

(* --- 3. Nach Bellows durchreichen, damit Hearth es sieht --- *)
Bellows.Diag.auDevState  := mon.auBmState;
Bellows.Diag.asDevStatus := mon.asBmStatus;
Bellows.Diag.xAllOk      := mon.xBmAllOk;
Bellows.Diag.iFaultCount := mon.iBmFaultCount;
Bellows.Diag.sSummary    := mon.sBmSummary;
</xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">Programm in taskDiag (200 ms): liest je Geraet den Online-Status aus Anvil.&lt;Geraet&gt;.Status, wertet ihn mit FB_BUS_MONITOR aus (Zustandsgraph mit Entprellung je Geraet) und schreibt das Ergebnis nach Bellows.Diag, damit die HMI es anzeigt. Die Geraete-Indizes sind handgepflegt (0 Pfirsich bis 6 Schaltschrank); ein neues Geraet muss hier und in FB_BUS_MONITOR nachgetragen werden.</xhtml>
        </documentation>
      </pou>
      <pou name="FB_TERMINAL_OUT" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="fbBlink">
              <type>
                <derived name="FB_BLINK"/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790038001260" modifiedMs="1790038005662" monitorEnabled="true" uuid="a3c12715-a57c-41c9-93cd-309d06534102"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Blinktakt fuer angeforderte, aber nicht freigegebene Ventile; symmetrisch aus Betrieb.rBlinkHz.</xhtml>
              </documentation>
            </variable>
            <variable name="atRun">
              <type>
                <array>
                  <dimension lower="0" upper="23"/>
                  <baseType>
                    <derived name="TON"/>
                  </baseType>
                </array>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790038007790" modifiedMs="1790038019046" monitorEnabled="true" uuid="804e4514-e6d6-480c-8292-f7eae0d3c474"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Je Ventil ein Laufzeit-Timer: IN = Freigabe, ET = bisheriger Lauf (currentLiquidation). Faellt die Freigabe, faellt ET.</xhtml>
              </documentation>
            </variable>
            <variable name="i">
              <type>
                <INT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790038728012" modifiedMs="1790038731941" monitorEnabled="true" uuid="0d21bda2-5414-451a-96d0-8f5980645794"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Laufindex ueber die 24 Ventile.</xhtml>
              </documentation>
            </variable>
            <variable name="n">
              <type>
                <DINT/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790038821123" modifiedMs="1790625473876" monitorEnabled="true" uuid="cdf031bb-7520-4220-97ab-2cf90df5d752"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zaehler der Arbitrierung (offene Ventile gegen uMaxVentile) und danach die halbe Blinkperiode in ms.</xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="xEnable">
              <type>
                <BOOL/>
              </type>
              <addData>
                <data name="https://forgeiec.io/v2" handleUnknown="preserve">
                  <ForgeIecVar xmlns="https://forgeiec.io/v2" createdMs="1790015430587" modifiedMs="1790039876015" monitorEnabled="true" uuid="643d154f-1ff7-4cba-998f-7de47fa38f33"/>
                </data>
              </addData>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Der einzige Anschluss. FALSE = alle 48 Klemmen AUS — kein Einfrieren: ein Ausgabe-Baustein, der stehen bleibt, liesse Ventile offen.</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <inOutVars/>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* ============================================================================
   FB_TERMINAL_OUT  —  Der eine Setter: Arbitrierung auf der DUT, dann 48 Klemmen
   ----------------------------------------------------------------------------
   Projekt : Ackersteuerung (SoLaWi-Acker Bewaesserung)
   Autor   : Joerg Bernau / Blacksmith
   Datum   : 2026-09-22
   ----------------------------------------------------------------------------
   Der Zustand je Ventil ist Bellows.Betrieb.astValveStatus[i], Index z*4+v:
        bMode                je Betriebsart ein Bit, von den Modus-Bausteinen
        isPreselected        vorgewaehlt in der AKTIVEN Betriebsart
                             = (bMode AND GVL.Betrieb.uModeActive) &lt;&gt; 0
        isOpen               wirklich offen = Freigabe; haelt ueber die Zyklen
        liquidationPeriod    eingestellte Laufdauer, vom Modus (Manuell T#0s)
        remainingLiquidation Restlauf = liquidationPeriod - ET, vom Modus

   ARBITRIERUNG (ehemals FB_VALVE_ARBITER): nie mehr als uMaxVentile Ventile
   gleichzeitig offen. Laufende Freigaben HALTEN, solange vorgewaehlt; neue
   nur bei freiem Platz, in Index-Reihenfolge, keine Verdraengung. Einen
   Warterang gibt es nicht mehr (Schrittkette.auQueue entfernt 2026-09-28:
   geschrieben, von niemandem gelesen).

   DIE VORWAHL WIRD VOM LAUF VERBRAUCHT: faellt ein offenes Ventil (Flanke
   auf isOpen), loescht der Setter das Bit der aktiven Betriebsart in bMode —
   die Vorwahl faellt, das Ventil stellt sich nicht wieder an. Der Modus
   nimmt die Abwahl an (FB_MANUAL: RESET am JK_FF, wenn sein Bit fehlt).

   xEnable = FALSE (Betriebsart AUS): nichts ist vorgewaehlt, jede Freigabe
   faellt, alle 48 Klemmen AUS — kein Einfrieren.

   LED: offen = Dauerlicht, vorgewaehlt und wartend = Blink. Der Takt kommt
   aus Betrieb.rBlinkHz (0.01..10 Hz, darunter 0.1 Hz), halbe Periode in ms.

   Index z*4+v, Reihenfolge Pfirsich, Stachelbeere, Maulbeere, Felsenbirne,
   Maibeere, Johannisbeere. Seit 2026-09-28 laufen ALLE Felder je Ventil
   0..23 (astValveStatus, aValveJobs, axSelToggle).
   ============================================================================ *)

(* --- 1) Vorwahl: das Bit der aktiven Betriebsart, bei AUS nichts --- *)
FOR i := 0 TO 23 DO
    Bellows.Betrieb.astValveStatus[i].isPreselected := xEnable AND
        ((Bellows.Betrieb.astValveStatus[i].bMode AND GVL.Betrieb.uModeActive) &lt;&gt; 0);
END_FOR;

(* --- 2) Laufende Freigaben halten, solange vorgewaehlt und Platz ist.
       Faellt eine: die Vorwahl ist verbraucht. --- *)
n := 0;
FOR i := 0 TO 23 DO
    IF Bellows.Betrieb.astValveStatus[i].isOpen
       AND Bellows.Betrieb.astValveStatus[i].isPreselected
       AND (n &lt; USINT_TO_DINT(GVL.Betrieb.uMaxVentile)) THEN
        n := n + 1;
    ELSE
        IF Bellows.Betrieb.astValveStatus[i].isOpen THEN
            Bellows.Betrieb.astValveStatus[i].bMode :=
                Bellows.Betrieb.astValveStatus[i].bMode AND NOT GVL.Betrieb.uModeActive;
            Bellows.Betrieb.astValveStatus[i].isPreselected := FALSE;
        END_IF;
        Bellows.Betrieb.astValveStatus[i].isOpen := FALSE;
    END_IF;
END_FOR;

(* --- 3) Nachruecken: vorgewaehlt, noch zu, Platz frei — in Index-Reihenfolge --- *)
FOR i := 0 TO 23 DO
    IF Bellows.Betrieb.astValveStatus[i].isPreselected
       AND NOT Bellows.Betrieb.astValveStatus[i].isOpen
       AND (n &lt; USINT_TO_DINT(GVL.Betrieb.uMaxVentile)) THEN
        Bellows.Betrieb.astValveStatus[i].isOpen := TRUE;
        n := n + 1;
    END_IF;
END_FOR;

(* --- 4) Blinktakt fuer die Wartenden: halbe Periode in ms aus rBlinkHz --- *)
n := 5000;
IF GVL.Betrieb.rBlinkHz &gt;= 0.01 THEN
    n := REAL_TO_DINT(500.0 / GVL.Betrieb.rBlinkHz);
END_IF;
IF n &lt; 50 THEN
    n := 50;
END_IF;
fbBlink(xBlEnable := xEnable, tBlFlash := DINT_TO_TIME(n), tBlPause := DINT_TO_TIME(n));

(* --- 5) Die Ventilklemmen: offen = Freigabe --- *)
Anvil.Pfirsich.xV_1 := Bellows.Betrieb.astValveStatus[0].isOpen;
Anvil.Pfirsich.xV_2 := Bellows.Betrieb.astValveStatus[1].isOpen;
Anvil.Pfirsich.xV_3 := Bellows.Betrieb.astValveStatus[2].isOpen;
Anvil.Pfirsich.xV_4 := Bellows.Betrieb.astValveStatus[3].isOpen;

Anvil.Stachelbeere.xV_1 := Bellows.Betrieb.astValveStatus[4].isOpen;
Anvil.Stachelbeere.xV_2 := Bellows.Betrieb.astValveStatus[5].isOpen;
Anvil.Stachelbeere.xV_3 := Bellows.Betrieb.astValveStatus[6].isOpen;
Anvil.Stachelbeere.xV_4 := Bellows.Betrieb.astValveStatus[7].isOpen;

Anvil.Maulbeere.xV_1 := Bellows.Betrieb.astValveStatus[8].isOpen;
Anvil.Maulbeere.xV_2 := Bellows.Betrieb.astValveStatus[9].isOpen;
Anvil.Maulbeere.xV_3 := Bellows.Betrieb.astValveStatus[10].isOpen;
Anvil.Maulbeere.xV_4 := Bellows.Betrieb.astValveStatus[11].isOpen;

Anvil.Felsenbirne.xV_1 := Bellows.Betrieb.astValveStatus[12].isOpen;
Anvil.Felsenbirne.xV_2 := Bellows.Betrieb.astValveStatus[13].isOpen;
Anvil.Felsenbirne.xV_3 := Bellows.Betrieb.astValveStatus[14].isOpen;
Anvil.Felsenbirne.xV_4 := Bellows.Betrieb.astValveStatus[15].isOpen;

Anvil.Maibeere.xV_1 := Bellows.Betrieb.astValveStatus[16].isOpen;
Anvil.Maibeere.xV_2 := Bellows.Betrieb.astValveStatus[17].isOpen;
Anvil.Maibeere.xV_3 := Bellows.Betrieb.astValveStatus[18].isOpen;
Anvil.Maibeere.xV_4 := Bellows.Betrieb.astValveStatus[19].isOpen;

Anvil.Johannisbeere.xV_1 := Bellows.Betrieb.astValveStatus[20].isOpen;
Anvil.Johannisbeere.xV_2 := Bellows.Betrieb.astValveStatus[21].isOpen;
Anvil.Johannisbeere.xV_3 := Bellows.Betrieb.astValveStatus[22].isOpen;
Anvil.Johannisbeere.xV_4 := Bellows.Betrieb.astValveStatus[23].isOpen;

(* --- 6) Die LED-Klemmen: offen = an, vorgewaehlt und wartend = Blink --- *)
Anvil.Pfirsich.xLed_5 := Bellows.Betrieb.astValveStatus[0].isOpen OR (Bellows.Betrieb.astValveStatus[0].isPreselected AND fbBlink.xBlQ);
Anvil.Pfirsich.xLed_6 := Bellows.Betrieb.astValveStatus[1].isOpen OR (Bellows.Betrieb.astValveStatus[1].isPreselected AND fbBlink.xBlQ);
Anvil.Pfirsich.xLed_7 := Bellows.Betrieb.astValveStatus[2].isOpen OR (Bellows.Betrieb.astValveStatus[2].isPreselected AND fbBlink.xBlQ);
Anvil.Pfirsich.xLed_8 := Bellows.Betrieb.astValveStatus[3].isOpen OR (Bellows.Betrieb.astValveStatus[3].isPreselected AND fbBlink.xBlQ);

Anvil.Stachelbeere.xLed_5 := Bellows.Betrieb.astValveStatus[4].isOpen OR (Bellows.Betrieb.astValveStatus[4].isPreselected AND fbBlink.xBlQ);
Anvil.Stachelbeere.xLed_6 := Bellows.Betrieb.astValveStatus[5].isOpen OR (Bellows.Betrieb.astValveStatus[5].isPreselected AND fbBlink.xBlQ);
Anvil.Stachelbeere.xLed_7 := Bellows.Betrieb.astValveStatus[6].isOpen OR (Bellows.Betrieb.astValveStatus[6].isPreselected AND fbBlink.xBlQ);
Anvil.Stachelbeere.xLed_8 := Bellows.Betrieb.astValveStatus[7].isOpen OR (Bellows.Betrieb.astValveStatus[7].isPreselected AND fbBlink.xBlQ);

Anvil.Maulbeere.xLed_5 := Bellows.Betrieb.astValveStatus[8].isOpen OR (Bellows.Betrieb.astValveStatus[8].isPreselected AND fbBlink.xBlQ);
Anvil.Maulbeere.xLed_6 := Bellows.Betrieb.astValveStatus[9].isOpen OR (Bellows.Betrieb.astValveStatus[9].isPreselected AND fbBlink.xBlQ);
Anvil.Maulbeere.xLed_7 := Bellows.Betrieb.astValveStatus[10].isOpen OR (Bellows.Betrieb.astValveStatus[10].isPreselected AND fbBlink.xBlQ);
Anvil.Maulbeere.xLed_8 := Bellows.Betrieb.astValveStatus[11].isOpen OR (Bellows.Betrieb.astValveStatus[11].isPreselected AND fbBlink.xBlQ);

Anvil.Felsenbirne.xLed_5 := Bellows.Betrieb.astValveStatus[12].isOpen OR (Bellows.Betrieb.astValveStatus[12].isPreselected AND fbBlink.xBlQ);
Anvil.Felsenbirne.xLed_6 := Bellows.Betrieb.astValveStatus[13].isOpen OR (Bellows.Betrieb.astValveStatus[13].isPreselected AND fbBlink.xBlQ);
Anvil.Felsenbirne.xLed_7 := Bellows.Betrieb.astValveStatus[14].isOpen OR (Bellows.Betrieb.astValveStatus[14].isPreselected AND fbBlink.xBlQ);
Anvil.Felsenbirne.xLed_8 := Bellows.Betrieb.astValveStatus[15].isOpen OR (Bellows.Betrieb.astValveStatus[15].isPreselected AND fbBlink.xBlQ);

Anvil.Maibeere.xLed_5 := Bellows.Betrieb.astValveStatus[16].isOpen OR (Bellows.Betrieb.astValveStatus[16].isPreselected AND fbBlink.xBlQ);
Anvil.Maibeere.xLed_6 := Bellows.Betrieb.astValveStatus[17].isOpen OR (Bellows.Betrieb.astValveStatus[17].isPreselected AND fbBlink.xBlQ);
Anvil.Maibeere.xLed_7 := Bellows.Betrieb.astValveStatus[18].isOpen OR (Bellows.Betrieb.astValveStatus[18].isPreselected AND fbBlink.xBlQ);
Anvil.Maibeere.xLed_8 := Bellows.Betrieb.astValveStatus[19].isOpen OR (Bellows.Betrieb.astValveStatus[19].isPreselected AND fbBlink.xBlQ);

Anvil.Johannisbeere.xLed_5 := Bellows.Betrieb.astValveStatus[20].isOpen OR (Bellows.Betrieb.astValveStatus[20].isPreselected AND fbBlink.xBlQ);
Anvil.Johannisbeere.xLed_6 := Bellows.Betrieb.astValveStatus[21].isOpen OR (Bellows.Betrieb.astValveStatus[21].isPreselected AND fbBlink.xBlQ);
Anvil.Johannisbeere.xLed_7 := Bellows.Betrieb.astValveStatus[22].isOpen OR (Bellows.Betrieb.astValveStatus[22].isPreselected AND fbBlink.xBlQ);
Anvil.Johannisbeere.xLed_8 := Bellows.Betrieb.astValveStatus[23].isOpen OR (Bellows.Betrieb.astValveStatus[23].isPreselected AND fbBlink.xBlQ);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
