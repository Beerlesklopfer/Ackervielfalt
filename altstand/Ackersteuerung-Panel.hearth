# ── Politique de mot de passe — pourquoi un mot de passe a été refusé ────────
# Chaque motif a sa propre clé : le conducteur ne doit pas avoir à deviner ce
# qui manque encore. Un message collectif (« ne respecte pas la politique ») est
# le moyen le plus sûr de faire échouer quelqu'un trois fois de suite.
pw-min-length = Au moins { $need } caractères.
pw-too-short = Au moins { $need } caractères ({ $got } saisis).
pw-too-long = Au plus { $max } caractères ({ $got } saisis).
