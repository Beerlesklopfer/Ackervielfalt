[[groups.fields]]
name = "bellows.gvl.Schrittkette.xStart"
source = "gvl"
iec_type = "BOOL"
iec_address = "%MX0.5"
offset = 1
size = 1
bit = 5
writable = true
description = "HMI-Startimpuls One-Shot-Schrittkette (Puls via Handshake). Steigende Flanke armt die selektierten Beete."

[[groups.fields]]
name = "bellows.gvl.Schrittkette.xStop"
source = "gvl"
iec_type = "BOOL"
iec_address = "%MX0.6"
offset = 1
size = 1
bit = 6
writable = true
description = "HMI-Stop One-Shot-Schrittkette (Puls via Handshake). Bricht den laufenden Lauf ab: alle Ventile zu, Schritte -> idle; neuer Start noetig."

[[groups.fields]]
name = "bellows.gvl.Schrittkette.xPause"
source = "gvl"
iec_type = "BOOL"
iec_address = "%MX0.7"
offset = 1
size = 1
bit = 7
writable = true
description = "HMI-Pause One-Shot-Schrittkette (Halten/Toggle via Handshake). Pause: Ventile zu + Restzeit-Timer eingefroren; erneut = fortsetzen (Ventile wieder auf)."

[[groups.fields]]
name = "bellows.gvl.Schrittkette.xQuit"
source = "gvl"
iec_type = "BOOL"
iec_address = "%MX1.0"
offset = 2
size = 1
bit = 0
writable = true
description = "HMI-Quittieren One-Shot-Schrittkette (Puls via Handshake). Loescht den Fertig-/Stoerungs-Status (xSeqAllDone) nach einem Lauf."

