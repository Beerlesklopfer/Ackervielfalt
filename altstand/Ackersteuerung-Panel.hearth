  <asset name="menu-compiler.js" type="js"><![CDATA[// menu-compiler.js — DER MENÜ-COMPILER. Gehört BEIDEN: Editor und Anlage.
//
// Aus dem `<menus>`-Ast des Projekts wird der Teilbaum EINES Screens:
//
//     <div class="screen screen--tiles">
//       <nav class="nav"> … </nav>
//       <svg viewBox="0 0 1920 1080"> … </svg>
//     </div>
//
// ── WARUM IN JAVASCRIPT ─────────────────────────────────────────────────────
//
// Weil das Kompilat HTML ist und der Browser es versteht. Klappen, Umbruch,
// Tabulatorreihenfolge, Vorlesereihenfolge, `@media` — alles geschenkt. Baute
// der Compiler abstrakte Elemente, bräuchte es auf der Qt-Seite wieder etwas,
// das sie zeichnet und bedienbar macht: Zeile für Zeile die `QGraphicsScene`,
// die am 04.07.2026 aus genau diesem Grund abgelöst wurde.
//
// Und weil er dort laufen muss, wo das Kompilat lebt — im Editor UND auf der
// Anlage. Dieselbe Datei, unverändert, wie `screen-runtime.js`. Vorher gab es
// die Bausteine ZWEIMAL: 161 Zeilen von Hand in `canvas-editor.js` gegen 110
// Zeilen `nav_makros.html.tera`, dieselben zehn Klassennamen — und sie waren
// schon auseinandergelaufen. Der Editor kannte weder `nav__spacer` noch
// `nav__separator`, weder `nav__group` noch `nav__dropdown`: ein Untermenü im
// Baum hatte im Editor gar keine Gestalt.
//
// ── EIN STROM, KEIN HAUFEN ──────────────────────────────────────────────────
//
// Neun Bausteine, die je etwas zurückgeben, sind kein Compiler — dann leben
// Reihenfolge und Verschachtelung außerhalb der Bausteine, und genau dort
// laufen sie auseinander. Hier schreibt jede Sorte an DIESELBE Stelle, über
// `open`/`text`/`close`.
//
// Der Strom besteht aus KNOTEN, nicht aus Zeichen. `open`/`close` erzwingen die
// Wohlgeformtheit strukturell, statt sie zu hoffen; nichts ist von Hand zu
// escapen, und am Ende steht ein DOM, den `importNode` nimmt, ohne dass ihn
// jemand zurückparst. In C++ wäre `QXmlStreamWriter` die Entsprechung.
//
// ── WANN ER LÄUFT ───────────────────────────────────────────────────────────
//
// Bei einer Änderung der EINGABE: `<menus>`, die Zuordnung, `menu-form`, ein
// anderer Screen. NICHT beim Zoomen, Schieben, Auswählen oder wenn ein Livewert
// sich ändert — das sind Neuzeichnungen des DOM, den er hinterlassen hat.
//
// Das hält nur, solange das Kompilat NICHT vom Sichtfenster abhängt. Tut es
// auch nicht: die Form steht am Screen, und zwischen breit und schmal
// entscheidet `@media` im Browser. „Wählen kann nur, wer die Breite sieht."
//
// Ausgesetzt als window.HearthMenu = { compileScreen, compileNav }.

(function () {
  'use strict';

  // ── DER KNOTENSTROM ───────────────────────────────────────────────────────
  //
  // `doc` ist der Dokumentkontext, in dem die Knoten entstehen — im Editor die
  // Canvas-Seite, auf der Anlage die Screenseite. Er wird ÜBERGEBEN und nicht
  // aus `window` genommen: so lässt der Compiler sich gegen ein beliebiges
  // Dokument fahren, auch gegen eines, das nie gezeigt wird.
  function Strom(doc) {
    const wurzel = doc.createDocumentFragment();
    let stapel = [wurzel];
    const oben = () => stapel[stapel.length - 1];

    return {
      /// Ein Element öffnen. Alles Folgende hängt darin, bis `close()`.
      open(tag, attrs) {
        const e = doc.createElement(tag);
        if (attrs) {
          for (const k in attrs) {
            const v = attrs[k];
            // LEER HEISST NICHT GESAGT. Ein `data-var=""` behauptete eine
            // Bindung an eine Variable ohne Namen.
            if (v === undefined || v === null || v === '') continue;
            e.setAttribute(k, String(v));
          }
        }
        oben().appendChild(e);
        stapel.push(e);
        return e;
      },
      /// Text in das offene Element. Escapen entfällt — es ist ein Textknoten.
      text(s) {
        if (s === undefined || s === null || s === '') return;
        oben().appendChild(doc.createTextNode(String(s)));
      },
      /// Ein Element schließen. Ein `close()` zu viel wäre ein Fehler im
      /// Compiler, kein Zustand der Daten — deshalb wird es LAUT.
      close() {
        if (stapel.length <= 1) throw new Error('menu-compiler: close() ohne open()');
        stapel.pop();
      },
      /// Ein leeres Element in einem Zug.
      leaf(tag, attrs) { this.open(tag, attrs); this.close(); },
      /// Das Ergebnis. Offene Elemente sind ein Fehler und werden gemeldet.
      fertig() {
        if (stapel.length !== 1) throw new Error('menu-compiler: ' + (stapel.length - 1) + ' offene Elemente');
        return wurzel;
      },
    };
  }

  // ── DIE BAUSTEINE ─────────────────────────────────────────────────────────
  //
  // Je Sorte einer, alle mit derselben Gestalt: `(strom, eintrag, umgebung)`.
  // Das Markup ist WÖRTLICH das der Anlage (nav_makros.html.tera) — es ist
  // nicht nachgebaut, es ist dasselbe, nur an einer Stelle.
  //
  // `data-id` an jedem Eintrag: das ist seine Kennung aus dem Baum, und der
  // Editor braucht sie, um vom Angeklickten zurück zum Knoten zu finden. Auf
  // der Anlage stört sie nicht.

  /// Der Inhalt eines Eintrags — Sinnbild, Text, Zusatz. Aus `inhalt(e)`.
  function inhalt(s, e) {
    if (e.icon) s.leaf('img', { class: 'nav__glyph', src: e.icon, alt: '' });
    s.open('span', { class: 'nav__text' }); s.text(e.text || ''); s.close();
    if (e.hint) { s.open('span', { class: 'nav__hint' }); s.text(e.hint); s.close(); }
  }

  const bausteine = {
    /// SPRUNG — der häufigste Eintrag, und bis hierher hatte er keinen eigenen
    /// Baustein: er fiel in `{% elif e.target %}`, den vorletzten Zweig, weil er
    /// zufällig ein Ziel trägt. Der letzte Zweig fängt ab, „was keine bekannte
    /// Art ist" — dort hätte er ebenso landen können.
    jump(s, e, u) {
      const slug = u.slugFuer(e.screen);
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      // OHNE ZIEL KEIN KNOPF. Ein Verweis auf einen Screen, den es nicht gibt,
      // sähe aus wie Bedienung und antwortete mit 404 — gemessen am
      // Panel-Projekt: „Vollautomatik" zeigte auf `auto`, der Screen hiess
      // `vollautomatik`. Als Beschriftung zeigen ist ehrlicher.
      if (slug) {
        s.open('a', { class: 'nav__link', href: '/screen/' + slug });
      } else {
        u.warnen('Sprung „' + (e.text || e.id) + '" zeigt auf keinen Screen dieses Projekts');
        s.open('span', { class: 'nav__link nav__label' });
      }
      inhalt(s, e); s.close();
      s.close();
    },

    /// BESCHRIFTUNG — Text, kein Ziel.
    label(s, e) {
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      s.open('span', { class: 'nav__link nav__label' }); inhalt(s, e); s.close();
      s.close();
    },

    /// LIVEWERT auf dem Menü.
    variable(s, e) {
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      s.open('a', { class: 'nav__link nav__var', 'data-var': e.variable,
                    'data-cmd': e.command || 'select' });
      inhalt(s, e); s.close();
      s.close();
    },

    /// DEHNBARER ZWISCHENRAUM — schiebt, was folgt, ans andere Ende.
    spacer(s, e) {
      s.leaf('li', { class: 'nav__spacer', 'aria-hidden': 'true', 'data-id': e.id });
    },

    /// TRENNLINIE, nicht Zwischenraum. `<hr>` ist das Element dafür — es TRENNT,
    /// und das sagt es auch einem Vorleseprogramm. Die Richtung entscheidet der
    /// Zusammenhang in der CSS: in einem Kachelmenü ist eine Trennlinie weder
    /// senkrecht noch waagerecht.
    separator(s, e) {
      s.open('li', { class: 'nav__sep-halter', 'data-id': e.id });
      s.leaf('hr', { class: 'nav__separator' });
      s.close();
    },

    /// UNTERMENÜ. Das Klapp-Zeichen steht in der CSS, nicht hier: es ist Form,
    /// und Form hält keine zweite Menüform aus, wenn sie im Markup steht.
    submenu(s, e, u) {
      // BEI KACHELN GIBT ES KEIN AUFKLAPPEN. Kacheln sind flach; ein Untermenü
      // wird dort schlicht übergangen — und GESAGT, mit Screen, Eintrag und
      // Form. Stillschweigend zu verschwinden sähe für den Entwerfer aus wie
      // ein Untermenü, das er nie angelegt hat: er suchte im Menü, und das
      // Menü wäre in Ordnung.
      if (u.form === 'tiles') {
        u.warnen('Untermenü „' + (e.text || e.id) + '" wird auf Screen „'
                 + u.screenSlug + '" nicht gezeigt: die Form „tiles" ist flach');
        return;
      }
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      s.open('details', { class: 'nav__group' });
      s.open('summary', { class: 'nav__link nav__group-label' }); inhalt(s, e); s.close();
      s.open('ul', { class: 'nav__dropdown' });
      eintraege(s, e, u);
      s.close(); s.close(); s.close();
    },

    /// AUSWAHLGRUPPE: von ihren Punkten gilt GENAU EINER. Als Untermenü
    /// ausgegeben wäre sie eine Liste gleichrangiger Verweise — welcher gerade
    /// gilt, wäre darin nicht zu erkennen. `role=radiogroup` sagt es auch dem
    /// Vorleseprogramm.
    radiogroup(s, e, u) {
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      s.open('details', { class: 'nav__group nav__radio' });
      s.open('summary', { class: 'nav__link nav__group-label' }); inhalt(s, e); s.close();
      s.open('ul', { class: 'nav__dropdown', role: 'radiogroup', 'aria-label': e.text || '' });
      for (const c of kinder(e, 'variable')) {
        s.open('li', { class: 'nav__item', 'data-id': c.id });
        s.open('a', { class: 'nav__link nav__radio-item', role: 'radio',
                      'aria-checked': 'false', 'data-var': c.variable,
                      'data-cmd': 'select', 'data-value': c.value });
        inhalt(s, c); s.close();
        s.close();
      }
      s.close(); s.close(); s.close();
    },

    /// KNOPF — die einzige Sorte mit einem ANSCHLUSS.
    ///
    /// Er hatte bis hierher gar keine Gestalt und fiel in den Rückfall: sichtbar
    /// als reiner Text, nicht als Knopf. `<button>` ist das Element dafür — es
    /// ist von der Tastatur erreichbar und meldet sich einem Vorleseprogramm
    /// als Bedienelement, was ein `<a>` ohne Ziel nicht tut.
    ///
    /// `data-port` trägt die Kennung des Anschlusses. Ohne sie fände der Draht
    /// sein Ende auf der Anlage nicht — ein Knopf, der aussieht wie einer und
    /// nichts auslöst.
    button(s, e, u) {
      const anschluesse = kinder(e, 'port');
      if (!anschluesse.length)
        u.warnen('Knopf „' + (e.text || e.id) + '" hat keinen Anschluss — '
                 + 'kein Draht kann ihn fassen');
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      s.open('button', { type: 'button', class: 'nav__link nav__button',
                         'data-cmd': e.command,
                         'data-port': anschluesse.length ? anschluesse[0].id : '' });
      inhalt(s, e); s.close();
      s.close();
    },

    /// KNOPFGRUPPE — Knöpfe, die zusammengehören. `role=group` sagt es dem
    /// Vorleseprogramm; die CSS macht daraus einen zusammenhängenden Block.
    buttongroup(s, e, u) {
      s.open('li', { class: 'nav__item', 'data-id': e.id });
      s.open('div', { class: 'nav__buttons', role: 'group', 'aria-label': e.text || '' });
      for (const c of kinder(e, 'button')) bausteine.button(s, c, u);
      s.close(); s.close();
    },
  };

  /// Die Kinder einer Sorte aus einem Eintrag — immer ein Array, so wie
  /// `toJson()` sie liefert.
  function kinder(e, sorte) {
    const a = e && e[sorte];
    return Array.isArray(a) ? a : [];
  }

  /// Die Einträge eines Menüs oder Untermenüs, IN DOKUMENTREIHENFOLGE.
  ///
  /// Die Reihenfolge ist die des Baumes, und quer über die Sorten: ein
  /// `<spacer>` zwischen zwei Sprüngen hat nur so einen Sinn. `toJson()`
  /// gruppiert aber NACH Sorte — deshalb steht die Reihenfolge in `order`,
  /// falls der Aufrufer sie mitgibt, sonst gilt die Reihenfolge der Sorten.
  function eintraege(s, knoten, u) {
    // ── UEBER DIE VORGEFUNDENEN SCHLUESSEL, nicht ueber eine feste Liste ────
    //
    // Hier stand eine Aufzaehlung der neun Sorten. Damit wurde eine ZEHNTE nie
    // besucht — und die Meldung „hat keine Gestalt" darunter war toter Code,
    // der nie ausloesen konnte. Gefunden vom Nachweis, nicht vom Nachdenken.
    //
    // Ausgenommen sind die beiden Schluessel, die KEINE Eintraege sind:
    // `screen` ist die Zuordnung (WO das Menue steht), `port` gehoert dem
    // Knopf und wird von ihm selbst gelesen.
    const keineEintraege = new Set(['screen', 'port']);
    const alle = [];
    for (const sorte in knoten) {
      if (keineEintraege.has(sorte) || !Array.isArray(knoten[sorte])) continue;
      for (const e of knoten[sorte]) if (e && typeof e === 'object') alle.push([sorte, e]);
    }
    if (Array.isArray(knoten.order)) {
      const nach = new Map(knoten.order.map((id, i) => [id, i]));
      alle.sort((a, b) => (nach.has(a[1].id) ? nach.get(a[1].id) : 1e9)
                        - (nach.has(b[1].id) ? nach.get(b[1].id) : 1e9));
    }
    for (const [sorte, e] of alle) {
      const bau = bausteine[sorte];
      // EINE UNBEKANNTE SORTE WIRD GESAGT, nicht übergangen. Der Baum darf
      // wachsen; dass hier noch kein Baustein dafür steht, ist ein Befund.
      if (!bau) { u.warnen('Menüeintrag der Sorte „' + sorte + '" hat keine Gestalt'); continue; }
      bau(s, e, u);
    }
  }

  // ── DIE LEISTE ────────────────────────────────────────────────────────────

  /// Aus den Menüs DIESES Screens ein `<nav>` bauen.
  ///
  /// Mehrere dürfen es sein — das ist der Sinn von m:n. Sie stehen
  /// hintereinander, in Dokumentreihenfolge.
  function compileNav(doc, menus, u) {
    const s = Strom(doc);
    // DIE FORM STEHT AN DER LEISTE SELBST, nicht nur am Behaelter.
    //
    // Am Behaelter allein waere sie im Editor wirkungslos, solange die Leiste
    // dort noch als Ueberlagerung ausserhalb des Screens haengt. Und auf der
    // Anlage schadet sie nicht: dieselbe Regel greift ueber `.nav--tiles` wie
    // ueber `.screen--tiles .nav`.
    //
    // Leer heisst NICHT GESAGT — dann gilt, was `.nav` ohnehin vorgibt. Eine
    // hier erfundene Vorgabe waere eine zweite neben der der Gestalt.
    s.open('nav', { class: 'nav' + (u.form ? ' nav--' + u.form : '') });

    // DIE MARKE. `brand.home` sagt, wohin sie führt; ohne Angabe führt sie auf
    // `/`, und wohin das geht, entscheidet die Anlage.
    s.open('a', { class: 'nav__brand', href: u.brandHome ? '/screen/' + u.brandHome : '/' });
    if (u.brandImage) s.leaf('img', { class: 'nav__logo', src: u.brandImage, alt: u.brandText || '' });
    else s.text(u.brandText || 'HEARTH');
    s.close();

    s.open('ul', { class: 'nav__links' });
    for (const m of menus) eintraege(s, m, u);
    s.close();

    s.close();
    return s.fertig();
  }

  /// Der ganze Teilbaum eines Screens: Leiste und Zeichnung in EINEM Behälter.
  ///
  /// Dass beide zusammenliegen, ist der Punkt. Vorher lag die Leiste als
  /// Überlagerung in `document.body`, ausserhalb des SVG — deshalb musste
  /// `navPlace()` bei jedem Zoom ihre Matrix nachrechnen, und deshalb konnte
  /// ein Raster des Screens sie nie zeigen. Im selben `<div>` nimmt die
  /// Transformation des Behälters sie mit, und das Raster sieht sie.
  ///
  /// \param svg  Der `<svg>`-Knoten des Screens. Er wird per `importNode`
  ///             übernommen, nicht abgeschrieben: was der Weg nicht trägt, ginge
  ///             sonst verloren — Namensräume voran.
  function compileScreen(doc, menus, svg, opt) {
    const u = Object.assign({
      form: '', screenSlug: '', slugFuer: () => '',
      brandHome: '', brandImage: '', brandText: '',
      warnungen: [],
    }, opt || {});
    u.warnen = (t) => u.warnungen.push(t);

    // Erst der BEHAELTER, ausbalanciert. Der Inhalt wird danach eingehaengt —
    // die Leiste durch den Compiler, die Zeichnung per `importNode`.
    const s = Strom(doc);
    s.open('div', { class: 'screen' + (u.form ? ' screen--' + u.form : '') });
    if (menus && menus.length) { s.open('div', { class: 'screen__nav' }); s.close(); }
    s.close();
    const wurzel = s.fertig().firstChild;

    if (menus && menus.length) {
      const halter = wurzel.querySelector('.screen__nav');
      halter.appendChild(compileNav(doc, menus, u));
    }
    if (svg) wurzel.appendChild(doc.importNode(svg, true));
    return { root: wurzel, warnungen: u.warnungen };
  }

  const api = { compileScreen, compileNav };
  if (typeof window !== 'undefined') window.HearthMenu = api;
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
})();
