panel = Panel resolution
notes = Notes

# ── Password policy — why a password was refused ─────────────────────────────
# Each reason is its own key: the operator should not have to guess what is
# still missing. A collective message ("does not meet the policy") is the most
# reliable way to make someone fail three times in a row.
pw-min-length = At least { $need } characters.
pw-too-short = At least { $need } characters (entered { $got }).
pw-too-long = At most { $max } characters (entered { $got }).
pw-needs-upper = Must contain an upper-case letter.
pw-needs-lower = Must contain a lower-case letter.
pw-needs-digit = Must contain a digit.
pw-needs-symbol = Must contain a symbol.
pw-needs-classes = At least { $need } character classes (used { $got }).
pw-contains-username = Must not contain the login name.
pw-reused = One of the last { $last } passwords — please pick a new one.
pw-not-reused = Must not be one of the last { $last } passwords.
pw-forbidden = This password is not permitted.

