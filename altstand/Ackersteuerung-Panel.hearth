 </screens>
 <assets>
  <asset name="about.html.tera" type="tera"><![CDATA[{% extends "base" %}
{% block title %}{{ t(key="about") }}{% endblock %}
{% block content %}
{# DIESELBE DATEI wie im Dialog. Hier stand der Inhalt ein zweites Mal — als
   Tabelle mit `app_name`/`app_desc`/`app_author`, also einer AUSWAHL aus dem
   Metablock. Organisation, Kontakt, Anschrift, Notizen und Logo fehlten; wer
   sie im Editor eingetragen hatte, fand sie hier nicht wieder. #}
<h1>{{ t(key="about") }}</h1>
<div class="card">{% include "about_inhalt" %}</div>
{% endblock %}
]]></asset>
  <asset name="about_inhalt.html.tera" type="tera"><![CDATA[{# ÜBER DIESE ANLAGE — der Inhalt, EINMAL.

   Eingezogen von zwei Stellen: dem About-Dialog in `base` (von jeder Seite
   erreichbar) und der Seite `/about` (ohne JavaScript, und als Ziel, das man
   verschicken kann). Zwei Abschriften desselben Inhalts wären die nächste
   Stelle, an der etwas auseinanderläuft — hier ist schon eine Einpassung
   zweimal dagestanden und sofort abgewichen.

   Gefüllt wie der SPLASH, und aus demselben Grund: der Splash ist die Seite
   VOR der Anmeldung, dieser Dialog die Auskunft DANACH. Wer nachts vor einer
   stehenden Anlage steht, findet an beiden Stellen, wen er anruft.

   Ein Unterschied: die NOTIZEN stehen hier. Auf dem Splash haben sie nichts
   verloren (unbegrenzte Länge, und ein Splash ist ein Bild) — hier sind sie
   genau richtig, denn dieser Kasten rollt.

   Die Angaben kommen aus `project()`, einer Beilage, die mit dem Projekt
   mitreist. Fehlt sie, ist `p` Null und es bleibt bei der Systemauskunft — eine
   Seite ohne Projekt soll schweigen, nicht scheitern. #}
{% set p = project() %}

{% if p %}
<div class="about__plant">
  {% if p.logo %}<img class="about__logo" src="{{ p.logo }}" alt="{{ p.name | default(value='') }}">{% endif %}
  {% if p.name %}<div class="about__name">{{ p.name }}</div>{% endif %}
  {% if p.description %}<div class="about__desc">{{ p.description }}</div>{% endif %}

  {# Jede Zeile EINZELN geprüft: ein leeres Feld erzeugt keine leere Zeile. Eine
     Anlage ohne hinterlegte Telefonnummer soll nicht so aussehen, als fehle die
     Nummer nur in der Anzeige. #}
  <dl class="about__facts">
    {% if p.organisation %}<dt>{{ t(key="organisation") }}</dt><dd>{{ p.organisation }}</dd>{% endif %}
    {% if p.author %}<dt>{{ t(key="author") }}</dt><dd>{{ p.author }}</dd>{% endif %}
    {% if p["contact-email"] %}<dt>{{ t(key="email") }}</dt>
      <dd><a href="mailto:{{ p["contact-email"] }}">{{ p["contact-email"] }}</a></dd>{% endif %}
    {% if p["contact-phone"] %}<dt>{{ t(key="phone") }}</dt>
      <dd><a href="tel:{{ p["contact-phone"] }}">{{ p["contact-phone"] }}</a></dd>{% endif %}
    {# Die Anschrift MEHRZEILIG, wie sie eingegeben wurde: sie wird abgetippt. #}
    {% if p.address %}<dt>{{ t(key="address") }}</dt>
      <dd class="about__pre">{{ p.address }}</dd>{% endif %}
    {% if p.panel_width and p.panel_width > 0 %}<dt>{{ t(key="panel") }}</dt>
      <dd>{{ p.panel_width }} × {{ p.panel_height }}</dd>{% endif %}
  </dl>

  {% if p.notes %}
  <div class="about__notes-title">{{ t(key="notes") }}</div>
  <div class="about__pre">{{ p.notes }}</div>
  {% endif %}
</div>
{% endif %}

{# Die Systemauskunft — was unter der Anlage läuft. Sie steht auch ohne Projekt
   da: wer wissen will, welche Fassung antwortet, fragt oft genau dann, wenn
   sonst nichts geht. #}
<dl class="about__facts about__system">
  <dt>{{ t(key="hearth-server") }}</dt><dd>v{{ hearth_version | default(value="—") }}</dd>
  <dt>{{ t(key="ecosystem") }}</dt><dd>ForgeIEC</dd>
</dl>
]]></asset>
  <asset name="admin.html.tera" type="tera"><![CDATA[{% extends "base" %}
{% block title %}{{ t(key="administration") }}{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/hearth-admin.css">
{% endblock %}
{% block content %}
<h1>{{ t(key="administration") }}</h1>

{# ── Status (Vars + Heartbeat — aus der Navbar hierher) — von base.html.tera's
     WS-Handler live gefüllt. ── #}
<div class="card">
  <div class="card__title">{{ t(key="status") }}</div>
  <table>
    <tr><th style="width:240px;">{{ t(key="live-connection") }}</th><td><span id="plc-status">—</span></td></tr>
    <tr><th>{{ t(key="heartbeat-last-value") }}</th><td><span class="nav__hb" id="hb-indicator">♥ –</span></td></tr>
  </table>
</div>

{# ── Anlagen-Einstellungen (temporär hartcodiert; wird flag-getrieben sobald
     das `setting`-Flag im Descriptor steht) ─────────────────────────────── #}
<div class="card">
  <div class="card__title">{{ t(key="plant-settings") }}</div>
  <div class="settings">
    <div class="s-label">{{ t(key="max-open-valves") }}
      <small>uMaxVentile — {{ t(key="max-open-valves-hint") }}</small></div>
    <div class="s-cur" data-live="Betrieb.uMaxVentile">–</div>
    <span class="s-unit"></span>
    <input class="inp s-input" id="set-umax" type="number" min="1" max="24" step="1" placeholder="{{ t(key="eg") }} 4">
    <button class="btn" id="btn-umax">{{ t(key="set") }}</button>

    <div class="s-label">{{ t(key="default-watering-time") }}
      <small>{{ t(key="default-watering-time-hint") }}</small></div>
    <div class="s-cur" data-live="Zeitplan.aValveJobs.6.tDuration" data-fmt="min">–</div>
    <span class="s-unit">min</span>
    <input class="inp s-input" id="set-dur" type="number" min="0" max="600" step="1" placeholder="{{ t(key="eg") }} 30">
    <button class="btn" id="btn-dur">{{ t(key="apply-to-all-beds") }}</button>
  </div>
</div>

{# ── Darstellung / Theme (analog Studios Qt-Theme: Hell/Dunkel-Preset + Akzent) ── #}
<div class="card">
  <div class="card__title">{{ t(key="appearance") }}</div>
  <div class="theme-grid">
    <label>{{ t(key="logo-top-left") }}</label>
    <div><input type="file" id="th-logo" accept="image/*">
      <button class="btn btn--ghost" id="th-logo-clear" type="button">{{ t(key="remove") }}</button></div>
    <label>{{ t(key="accent-color") }}</label>    <input type="color" id="th-accent">
    <label>{{ t(key="background") }}</label>    <input type="color" id="th-bg">
    <label>{{ t(key="panel-cards") }}</label> <input type="color" id="th-panel">
    <label>{{ t(key="frames-lines") }}</label><input type="color" id="th-border">
    <label>{{ t(key="text-color") }}</label>      <input type="color" id="th-text">
    <label>{{ t(key="status") }} — {{ t(key="ok") }}</label>    <input type="color" id="th-ok">
    <label>{{ t(key="status") }} — {{ t(key="warning") }}</label><input type="color" id="th-warn">
    <label>{{ t(key="status") }} — {{ t(key="error") }}</label><input type="color" id="th-bad">
    <label>{{ t(key="font") }}</label>
    <select class="inp" id="th-font" style="width:auto;">
      <option value="'Inter', 'Segoe UI', system-ui, sans-serif">Inter / {{ t(key="system-default-font") }}</option>
      <option value="'Segoe UI', system-ui, sans-serif">Segoe UI</option>
      <option value="Roboto, system-ui, sans-serif">Roboto</option>
      <option value="Arial, Helvetica, sans-serif">Arial</option>
      <option value="'DejaVu Sans', sans-serif">DejaVu Sans</option>
      <option value="ui-monospace, 'Cascadia Code', monospace">Monospace</option>
    </select>
  </div>

  <div class="card__title" style="margin-top:20px;">{{ t(key="preview-clickable") }}</div>
  <div class="theme-preview" id="th-preview">
    <div class="tp-brand"><img id="tp-logo" alt="" style="display:none;"><span id="tp-brandtext">HEARTH</span></div>
    <div class="tp-card">
      <div class="tp-formrow"><span class="tp-lbl">{{ t(key="setpoint") }}</span><input class="tp-input" type="text" value="42"></div>
      <div class="tp-formrow"><span class="tp-lbl">{{ t(key="operating-mode") }}</span>
        <select class="tp-input"><option>{{ t(key="mode-manual") }}</option><option>{{ t(key="mode-one-shot") }}</option><option>{{ t(key="mode-auto") }}</option></select></div>
      <div class="tp-formrow"><span class="tp-lbl">{{ t(key="enable") }}</span><label class="tp-chk"><input type="checkbox" checked> {{ t(key="active") }}</label></div>
      <div class="tp-row" style="margin-top:12px;">
        <button class="tp-btn" type="button">{{ t(key="set") }}</button>
        <button class="tp-btn tp-toggle" type="button">{{ t(key="valve") }} A</button>
        <a class="tp-link">{{ t(key="details") }}…</a>
        <span class="tp-badge tp-ok">OK</span>
        <span class="tp-badge tp-warn">{{ t(key="warning") }}</span>
        <span class="tp-badge tp-bad">{{ t(key="fault") }}</span>
      </div>
    </div>
  </div>

  <div class="banner" id="theme-banner"></div>
  <div style="margin-top:14px; text-align:right;">
    <button class="btn btn--ghost" id="th-reset" type="button">{{ t(key="reset-to-default") }}</button>
    <button class="btn" id="th-save" type="button">{{ t(key="save") }}</button>
  </div>
</div>

{# ── Benutzerverwaltung ────────────────────────────────────────────────── #}
<div class="card">
  <div class="card__title">{{ t(key="user-management") }}</div>
  <div class="banner" id="user-banner"></div>
  <table>
    <thead><tr><th>{{ t(key="username") }}</th><th>{{ t(key="roles") }}</th><th class="user-actions">{{ t(key="action") }}</th></tr></thead>
    <tbody id="user-rows"><tr><td colspan="3" class="muted">{{ t(key="loading") }}…</td></tr></tbody>
  </table>
  <div style="margin-top:14px; text-align:right;">
    <button class="btn" id="btn-new">+ {{ t(key="new-user") }}</button>
  </div>
</div>

{# ── Edit/Anlegen-Modal ────────────────────────────────────────────────── #}
<div class="modal-backdrop" id="user-modal">
  <div class="modal">
    <div class="modal__title" id="modal-title">{{ t(key="create-user") }}</div>
    <label for="m-name">{{ t(key="username") }}</label>
    <input class="inp" id="m-name" type="text" autocomplete="off">
    <label for="m-pw">{{ t(key="password") }}</label>
    <input class="inp" id="m-pw" type="password" autocomplete="new-password" placeholder="{{ t(key='required') }}">
    <label>{{ t(key="roles") }}</label>
    <div class="role-pick" id="m-roles"><span class="muted">—</span></div>
    <div class="modal__err" id="m-err"></div>
    <div class="modal__actions">
      <button class="btn btn--ghost" id="m-cancel">{{ t(key="cancel") }}</button>
      <button class="btn" id="m-save">{{ t(key="save") }}</button>
    </div>
  </div>
</div>

<script>
// ── Anlagen-Settings: write over the live WS (window.writeValue from base) ──
var BED_DURATION_TAGS = [];
for (var i = 1; i <= 24; i++) BED_DURATION_TAGS.push('Zeitplan.aValveJobs.' + i + '.tDuration');

document.getElementById('btn-umax').addEventListener('click', function() {
  var v = parseInt(document.getElementById('set-umax').value, 10);
  if (isNaN(v) || v < 1 || v > 24) { showToast('✖ uMaxVentile: 1..24', 'err'); return; }
  writeValue('Betrieb.uMaxVentile', v);
});
document.getElementById('btn-dur').addEventListener('click', function() {
  var min = parseInt(document.getElementById('set-dur').value, 10);
  if (isNaN(min) || min < 0) { showToast('✖ {{ t(key="duration") }}: {{ t(key="minutes") }} ≥ 0', 'err'); return; }
  var ms = min * 60000; // IEC TIME is milliseconds on the wire
  BED_DURATION_TAGS.forEach(function(tag) { writeValue(tag, ms); });
});

// Live read-back: base WS calls onLiveUpdate(values); match by bare HMI tag,
// tolerating the bellows.gvl. / Bellows. prefixes. TIME→minutes when data-fmt=min.
window.onLiveUpdate = function(values) {
  if (!values) return;
  document.querySelectorAll('[data-live]').forEach(function(el) {
    var tag = el.getAttribute('data-live');
    var v = values[tag];
    if (v === undefined) v = values['bellows.gvl.' + tag];
    if (v === undefined) v = values['Bellows.' + tag];
    if (v === undefined) return;
    var raw = (v && typeof v === 'object') ? (v.v !== undefined ? v.v : v.value) : v;
    var num = parseFloat(raw);
    if (isNaN(num)) { el.textContent = String(raw); return; }
    if (el.getAttribute('data-fmt') === 'min') num = Math.round(num / 60000);
    el.textContent = String(num);
  });
};

// ── Benutzerverwaltung ──
var ALL_ROLES = [];
function esc(s) { return String(s).replace(/[&<>"]/g, function(c) {
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

function banner(msg, ok) {
  var b = document.getElementById('user-banner');
  b.style.display = 'block';
  b.textContent = msg;
  b.style.background = ok ? 'rgba(76,175,80,0.08)' : 'rgba(244,67,54,0.08)';
  b.style.border = '1px solid ' + (ok ? '#2a5a2a' : '#5a2a2a');
  b.style.color = ok ? '#9c9' : '#f99';
}

function renderUsers(list) {
  var tb = document.getElementById('user-rows');
  if (!list || !list.length) { tb.innerHTML = '<tr><td colspan="3" class="muted">{{ t(key="no-users") }}</td></tr>'; return; }
  tb.innerHTML = list.map(function(u) {
    var roles = (u.roles || []).join(' ');
    return '<tr><td>' + esc(u.name) + '</td><td class="muted">' + esc((u.roles||[]).join(', ')) + '</td>' +
      '<td class="user-actions">' +
      '<button class="btn btn--ghost" data-edit="' + esc(u.name) + '" data-roles="' + esc(roles) + '">{{ t(key="edit") }}</button>' +
      '<button class="btn btn--danger" data-del="' + esc(u.name) + '">{{ t(key="delete") }}</button></td></tr>';
  }).join('');
  tb.querySelectorAll('[data-del]').forEach(function(b) {
    b.addEventListener('click', function() { deleteUser(b.getAttribute('data-del')); });
  });
  tb.querySelectorAll('[data-edit]').forEach(function(b) {
    b.addEventListener('click', function() {
      openModal(b.getAttribute('data-edit'), (b.getAttribute('data-roles') || '').split(' ').filter(Boolean));
    });
  });
}

function loadUsers() {
  fetch('/api/users', { credentials: 'same-origin' })
    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function(d) {
      ALL_ROLES = (d.roles || []).map(function(r) { return r.name; });
      renderUsers(d.users || []);
    })
    .catch(function(e) {
      document.getElementById('user-rows').innerHTML =
        '<tr><td colspan="3" class="muted">{{ t(key="user-list-unavailable") }} (' + e + ').</td></tr>';
    });
}

// ── Modal (anlegen / bearbeiten) ──
var modal = document.getElementById('user-modal');
function openModal(name, roles) {
  var editing = !!name;
  document.getElementById('modal-title').textContent = editing ? '{{ t(key="edit-user") }}' : '{{ t(key="create-user") }}';
  var nameEl = document.getElementById('m-name');
  nameEl.value = name || '';
  nameEl.disabled = editing;                       // name is the identity — fixed on edit
  var pw = document.getElementById('m-pw');
  pw.value = '';
  pw.placeholder = editing ? '{{ t(key="empty-means-unchanged") }}' : '{{ t(key="required") }}';
  // Role checkboxes from the project's declared roles (Fremdanlage-tauglich).
  var have = roles || [];
  var box = document.getElementById('m-roles');
  box.innerHTML = ALL_ROLES.length ? ALL_ROLES.map(function(r) {
    var on = have.indexOf(r) !== -1 ? ' checked' : '';
    return '<label><input type="checkbox" value="' + esc(r) + '"' + on + '>' + esc(r) + '</label>';
  }).join('') : '<span class="muted">{{ t(key="no-roles-declared") }}</span>';
  document.getElementById('m-err').textContent = '';
  modal.classList.add('open');
  (editing ? pw : nameEl).focus();
}
function closeModal() { modal.classList.remove('open'); }
document.getElementById('btn-new').addEventListener('click', function() { openModal(null, []); });
document.getElementById('m-cancel').addEventListener('click', closeModal);
modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

document.getElementById('m-save').addEventListener('click', function() {
  var name = document.getElementById('m-name').value.trim();
  var pw = document.getElementById('m-pw').value;
  var roles = [];
  document.querySelectorAll('#m-roles input:checked').forEach(function(c) { roles.push(c.value); });
  var errEl = document.getElementById('m-err');
  if (!name) { errEl.textContent = '{{ t(key="username-missing") }}'; return; }
  fetch('/api/users', {
    method: 'POST', credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name, password: pw, roles: roles })
  }).then(function(r) {
    if (r.ok) { closeModal(); banner('{{ t(key="saved") }}: ' + name, true); loadUsers(); }
    else if (r.status === 409) errEl.textContent = '{{ t(key="last-admin-keeps-role") }}';
    else if (r.status === 400) errEl.textContent = '{{ t(key="user-input-invalid") }}';
    else r.text().then(function(t) { errEl.textContent = '{{ t(key="error") }} (' + r.status + ') ' + t; });
  }).catch(function(e) { errEl.textContent = '{{ t(key="network-error") }}: ' + e; });
});

function deleteUser(name) {
  if (!confirm('{{ t(key="delete-user-confirm") }}\n\n' + name)) return;
  fetch('/api/users/' + encodeURIComponent(name), { method: 'DELETE', credentials: 'same-origin' })
    .then(function(r) {
      if (r.ok) { banner('{{ t(key="deleted") }}: ' + name, true); loadUsers(); }
      else if (r.status === 409) banner('{{ t(key="last-admin-not-deletable") }}', false);
      else banner('{{ t(key="delete-failed") }} (' + r.status + ').', false);
    }).catch(function(e) { banner('{{ t(key="network-error") }}: ' + e, false); });
}

loadUsers();

// ── Darstellung / Theme ──
var THEME_DEFAULT = { accent:'#ff6b35', bg:'#0f0f1a', panel:'#181825', text:'#e0e0e0',
  border:'#222222', status_ok:'#4caf50', status_warn:'#ff9800', status_bad:'#f44336',
  font:"'Inter', 'Segoe UI', system-ui, sans-serif", logo:'' };
var thLogo = '';
function thVal(id) { return document.getElementById(id).value; }

function thInputs() {
  return { accent: thVal('th-accent'), bg: thVal('th-bg'), panel: thVal('th-panel'), text: thVal('th-text'),
    border: thVal('th-border'), status_ok: thVal('th-ok'), status_warn: thVal('th-warn'),
    status_bad: thVal('th-bad'), font: thVal('th-font'), logo: thLogo };
}
function thSetInputs(t) {
  document.getElementById('th-accent').value = t.accent;
  document.getElementById('th-bg').value = t.bg;
  document.getElementById('th-panel').value = t.panel;
  document.getElementById('th-text').value = t.text;
  document.getElementById('th-ok').value = t.status_ok;
  document.getElementById('th-warn').value = t.status_warn;
  document.getElementById('th-bad').value = t.status_bad;
  document.getElementById('th-border').value = t.border || THEME_DEFAULT.border;
  if (t.font) document.getElementById('th-font').value = t.font;
  if (t.logo !== undefined) thSetLogo(t.logo);
}
function thSetLogo(dataUrl) {
  thLogo = dataUrl || '';
  var img = document.getElementById('tp-logo'), bt = document.getElementById('tp-brandtext');
  if (thLogo) { img.src = thLogo; img.style.display = 'inline'; bt.style.display = 'none'; }
  else { img.style.display = 'none'; bt.style.display = 'inline'; }
}
function thApply() {
  var t = thInputs(), p = document.getElementById('th-preview');
  p.style.cssText = '--accent:'+t.accent+';--bg:'+t.bg+';--panel:'+t.panel+';--text:'+t.text+
    ';--border:'+t.border+';--ok:'+t.status_ok+';--warn:'+t.status_warn+';--bad:'+t.status_bad+';--font:'+t.font+';';
}
['th-accent','th-bg','th-panel','th-border','th-text','th-ok','th-warn','th-bad','th-font'].forEach(function(id){
  document.getElementById(id).addEventListener('input', thApply);
});
document.getElementById('th-logo').addEventListener('change', function(e){
  var f = e.target.files && e.target.files[0]; if (!f) return;
  var r = new FileReader(); r.onload = function(){ thSetLogo(r.result); }; r.readAsDataURL(f);
});
document.getElementById('th-logo-clear').addEventListener('click', function(){
  thSetLogo(''); document.getElementById('th-logo').value = '';
});
document.getElementById('th-reset').addEventListener('click', function(){
  thSetInputs(Object.assign({}, THEME_DEFAULT)); thApply();
});
document.querySelectorAll('#th-preview .tp-toggle').forEach(function(b){
  b.addEventListener('click', function(){ b.classList.toggle('on'); });
});
function thBanner(msg, ok){
  var b = document.getElementById('theme-banner');
  b.style.display='block'; b.textContent=msg;
  b.style.background = ok?'rgba(76,175,80,0.08)':'rgba(244,67,54,0.08)';
  b.style.border = '1px solid '+(ok?'#2a5a2a':'#5a2a2a'); b.style.color = ok?'#9c9':'#f99';
}
document.getElementById('th-save').addEventListener('click', function(){
  fetch('/api/theme', { method:'POST', credentials:'same-origin',
    headers:{'Content-Type':'application/json'}, body: JSON.stringify(thInputs()) })
   .then(function(r){
     if (r.ok) thBanner('{{ t(key="theme-saved") }}', true);
     else thBanner('{{ t(key="save-failed") }} ('+r.status+').', false);
   }).catch(function(e){ thBanner('{{ t(key="network-error") }}: '+e, false); });
});
fetch('/api/theme', { credentials:'same-origin' })
  .then(function(r){ return r.ok ? r.json() : {}; })
  .then(function(t){ thSetInputs(Object.assign({}, THEME_DEFAULT, t || {})); thApply(); })
  .catch(function(){ thSetInputs(Object.assign({}, THEME_DEFAULT)); thApply(); });
</script>
{% endblock %}
]]></asset>
  <asset name="alarms.html.tera" type="tera"><![CDATA[{% extends "base" %}
{% block title %}Alarms{% endblock %}
{% block content %}
<h1>Alarms <span style="font-size: 14px; color: #f44336;" id="alarm-badge">{{ active_count }}</span></h1>

<div class="card">
  <div class="card__title">Active Alarms</div>
  <table>
    <thead>
      <tr><th>ID</th><th>State</th><th>Value</th><th>Time</th><th>Action</th></tr>
    </thead>
    <tbody>
      {% for a in alarms %}
      <tr>
        <td>{{ a.id }}</td>
        <td class="{% if a.state == 'Active' %}q-bad{% elif a.state == 'Acknowledged' %}q-stale{% else %}q-good{% endif %}">
          {{ a.state }}
        </td>
        <td>{{ a.value }}</td>
        <td>{{ a.time }}</td>
        <td>
          {% if a.state == "Active" %}
          <form method="post" action="/alarms/{{ a.id }}/acknowledge" style="display:inline;">
            <button type="submit" style="background:#ff6b35;border:none;color:#fff;padding:4px 12px;border-radius:4px;cursor:pointer;">ACK</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      {% if alarms | length == 0 %}
      <tr><td colspan="5" style="color: #4caf50; text-align: center; padding: 24px;">{{ t(key="no-active-alarms") }}</td></tr>
      {% endif %}
    </tbody>
  </table>
</div>
{% endblock %}
]]></asset>
  <asset name="base.html.tera" type="tera"><![CDATA[{# Makros der Navigation. Der Import gehoert HIERHER: navbar wird per
   {% include %} eingezogen, und Tera traegt Importe nicht ueber Einbindungen
   hinweg — er muss in der Vorlage stehen, die tatsaechlich gerendert wird. #}
{% import "nav_makros" as menue %}
<!DOCTYPE html>
<html lang="{{ lang() }}" dir="{{ dir() }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Hearth{% endblock %} — ForgeIEC</title>
<link rel="stylesheet" href="/static/css/hearth.css">
{# ── Project theme (colors / font), from POST /api/theme via theme(). This
   override block follows the defaults above, so set values win; unset ones fall
   back to the built-in dark ("Esse") palette. Analog to Studio's Qt theme. #}
{% set th = theme() %}
<style>
:root {
  --bg:     {{ th.bg     | default(value='#0f0f1a') }};
  --panel:  {{ th.panel  | default(value='#181825') }};
  --border: {{ th.border | default(value='#222222') }};
  --text:   {{ th.text   | default(value='#e0e0e0') }};
  --muted:  {{ th.muted  | default(value='#888888') }};
  --accent: {{ th.accent | default(value='#ff6b35') }};
  --ok:     {{ th.status_ok   | default(value='#4caf50') }};
  --warn:   {{ th.status_warn | default(value='#ff9800') }};
  --bad:    {{ th.status_bad  | default(value='#f44336') }};
  --font:   {{ th.font | default(value="'Inter', 'Segoe UI', system-ui, sans-serif") }};
  /* Die Palette hatte Luecken: Text auf gefuelltem Grund, Text beim Ueberfahren,
     Linien und Raender standen als feste Werte in hearth.css und waren von
     keiner Einstellung erreichbar. Ohne Namen laufen sie ausserdem auseinander
     — gemessen stand #2a2a38 (4x) neben #2a2a3a (3x), zwei Werte fuer
     dieselbe Sache. Sie fallen hier zusammen. */
  --text-bright:   {{ th.text_bright   | default(value='#ffffff') }};
  --text-dim:  {{ th.text_dim  | default(value='#cccccc') }};
  --line:       {{ th.line       | default(value='#2a2a38') }};
  --line-strong: {{ th.line_strong | default(value='#3a3a4a') }};
  --info:        {{ th.info        | default(value='#2196f3') }};

  /* ── DIE MENUELEISTE ───────────────────────────────────────────────────────
     Eigene Merkmale, aus demselben Grund wie beim Dialog: die Leiste ist eine
     eigene FLAECHE. Sie borgte sich `panel`, `border`, `muted`, `text-dim`,
     `text-bright`, `line` und `accent` — wer ihr eine andere Farbe geben
     wollte, nahm sie damit zwangslaeufig auch jeder Karte.

     Sie steht ausserdem auf JEDEM Screen und traegt das Gesicht der Anlage.
     Ein Anlagenbauer, der sein Firmenblau dort haben will, soll dafuer nicht
     die Messwertkarten umfaerben muessen.

     Die `default`-Werte sind GENAU die bisherigen: ein Projekt, das die
     Merkmale noch nicht fuehrt, sieht aus wie vorher. */
  --nav-bg:            {{ th.nav_bg            | default(value='#181825') }};
  --nav-line:          {{ th.nav_line          | default(value='#222222') }};
  --nav-brand:         {{ th.nav_brand         | default(value='#ff6b35') }};
  --nav-text:          {{ th.nav_text          | default(value='#888888') }};
  --nav-text-hover:    {{ th.nav_text_hover    | default(value='#cccccc') }};
  --nav-text-active:   {{ th.nav_text_active   | default(value='#ffffff') }};
  --nav-dropdown-bg:   {{ th.nav_dropdown_bg   | default(value='#181825') }};
  --nav-dropdown-line: {{ th.nav_dropdown_line | default(value='#2a2a38') }};
  --nav-action:        {{ th.nav_action        | default(value='#ff6b35') }};
  --nav-action-text:   {{ th.nav_action_text   | default(value='#0f0f1a') }};
  --nav-btn-bg:        {{ th.nav_btn_bg        | default(value='#2a2a38') }};
  --nav-btn-line:      {{ th.nav_btn_line      | default(value='#3a3a4a') }};
  --nav-btn-text:      {{ th.nav_btn_text      | default(value='#cfcfe0') }};
  --nav-admin-bg:      {{ th.nav_admin_bg      | default(value='#243044') }};
  --nav-admin-line:    {{ th.nav_admin_line    | default(value='#2f5070') }};
  --nav-admin-text:    {{ th.nav_admin_text    | default(value='#9cc4ff') }};

  /* ── DIALOG UND FORMULARFELDER ─────────────────────────────────────────────
     Eigene Merkmale, KEINE Wiederverwendung von `--bg`/`--panel`.

     Ein Dialog gehoert vom Anlagenhintergrund ABGESETZT: er liegt darueber und
     verlangt Aufmerksamkeit. Borgt er sich `--bg`, verschwimmt er mit dem, was
     er verdeckt — und folgt einer Einstellung, die fuer eine andere Flaeche
     gedacht war.

     Gemessen, wohin das fuehrt: ein Projekt stand auf `bg: #deddda` (hell) bei
     `text: #e0e0e0` (hell). Die Anmeldefelder nahmen beides — weisse Schrift
     auf hellgrauem Grund. Unlesbar, ohne Fehler, ohne Meldung. */
  --dialog-bg:   {{ th.dialog_bg   | default(value='#1c1c2b') }};
  --dialog-text: {{ th.dialog_text | default(value='#e8e8ef') }};
  --dialog-line: {{ th.dialog_line | default(value='#33334a') }};
  --field-bg:    {{ th.field_bg    | default(value='#0f0f18') }};
  --field-text:  {{ th.field_text  | default(value='#e8e8ef') }};
  --field-line:  {{ th.field_line  | default(value='#3a3a52') }};

  /* ── EINSTELLUNGEN DES PROJEKTS ────────────────────────────────────────────
     Sie stehen HIER, bei den Themafarben, und nicht als `style="…"` an dem
     einen Element, das sie gerade braucht. Ein Inline-Stil ist das Gegenteil
     von Vererbung: eine Abschrift, die kein zweites Element erreicht und keine
     Regel ueberschreiben kann. Als Variable auf `:root` kaskadiert der Wert
     durch die ganze Seite — Rahmen, Screens, Symbole —, wird einmal gesetzt und
     ist an jeder Stelle mit `var(--surround)` zu haben.

     `default` faengt die Seiten ab, die kein Projekt im Kontext haben
     (Anmeldung, Verwaltung): sie kennen die Einstellung nicht und sollen
     deswegen nicht scheitern. */
  --surround: {{ project_surround | default(value='#101014') }};
}
/* HIER STEHEN NUR NOCH DEFINITIONEN, KEINE REGELN.
   Zehn Regeln standen darunter — body, .nav, .nav__brand(+:hover), .card,
   .nav__btn--login(+:hover), .q-good/.q-stale/.q-bad mit ihren Herzschlag-
   Geschwistern. Alle zehn gab es schon in hearth.css, und dieser <style>-Block
   steht NACH dem <link> darauf: er gewann still. Wer in hearth.css an `.nav`
   etwas aenderte, sah nichts davon, und nichts schlug fehl.
   Was sie leisteten, leistet hearth.css jetzt selbst — dort verbraucht jede
   Regel dieselben Variablen, die hier oben definiert werden. */
</style>
{% block extra_css %}{% endblock %}
</head>
<body>
{# Navbar = compiler-owned. The Studio Menübar-Compiler emits navbar.html.tera
   from the placed menu-system symbols on the nav screen and ships it with the
   deploy package; the daemon serves the bundled fallback otherwise. base just
   includes it — the {{ th.* }} theme + nav() helper are already in scope. #}
{# Als BLOCK, damit der Splash sie wirklich weglassen kann. Sie per CSS zu
   verstecken waere der Unterschied zwischen „sieht so aus" und „ist so": sie
   laege weiter im DOM, im Tab-Weg der Tastatur und im Vorlesegeraet. #}
{% block navbar %}{% include "navbar" %}{% endblock %}
<div id="hb-popup" role="alert" aria-live="assertive">
  <div class="hb-popup__title">⚠ {{ t(key="no-heartbeat") }}</div>
  <div class="hb-popup__msg" id="hb-msg"></div>
  <button id="hb-dismiss" type="button">{{ t(key="understood") }}</button>
</div>
<div id="wtoast"></div>
{# ANMELDEN — ein Dialog auf dem laufenden Screen, keine eigene Seite.

   Ummelden kann auf JEDEM Screen nötig werden: die Schicht wechselt, jemand
   braucht kurz ein höheres Recht, eine Sitzung läuft ab. Ein eigener Screen
   verlangte dafür jedes Mal einen Sprung und brächte den Bediener nicht dorthin
   zurück, wo er war.

   Nach dem Schließen ändern sich die Rechte des AKTUELLEN Screens: das Formular
   trägt `next` mit dem eigenen Pfad, der Server schickt dorthin zurück, und der
   Screen wird serverseitig neu bewertet (`required-role`). Kein `/dashboard`.

   ── Warum ein echtes <form> und kein fetch() ────────────────────────────────

   Es trägt OHNE JavaScript. Ein Panel, dessen Skript noch lädt oder an einer
   Fremdquelle hängt, hätte sonst einen Knopf, der nichts tut — und niemand käme
   mehr hinein. Die nativen Felder bringen ausserdem Bildschirmtastatur,
   Kennwortverwaltung und Pflichtfeldprüfung mit, statt sie nachzubauen.

   `login.html.tera` bleibt als SEITE bestehen: der erste Zugang, bevor
   überhaupt ein Screen dasteht. #}
<div class="help-modal" id="login-modal">
  <div class="help-modal__box">
    <div class="help-modal__head">
      <span class="help-modal__title">{{ t(key="login") }}</span>
      <button class="help-modal__close" data-dialog-close type="button" aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body">
      <form method="POST" action="/login" class="login-form">
        {# Das Ziel: der Pfad, auf dem der Bediener STEHT. Ohne JavaScript bleibt
           es leer, dann führt der Server auf „/" — nie nach draussen, siehe
           `safe_next()`. #}
        <input type="hidden" name="next" id="login-next" value="">
        <label for="login-user">{{ t(key="username") }}</label>
        <input type="text" id="login-user" name="username"
               autocomplete="username" required>
        <label for="login-pass">{{ t(key="password") }}</label>
        <input type="password" id="login-pass" name="password"
               autocomplete="current-password" required>
        <button type="submit" class="nav__btn nav__btn--login">{{ t(key="login") }}</button>
      </form>
    </div>
  </div>
</div>
{# MEIN PROFIL — Kennwort ändern, ohne den Screen zu verlassen.

   Hier stand ein Sprung auf `/profile`. Das war derselbe Rückfall, den wir beim
   Anmelden abgeschafft haben: nach dem Anmelden fiel alles wieder auf Seiten
   zurück. Wer im Tanklager steht und sein Kennwort wechselt, will danach im
   Tanklager stehen.

   ── Der ERZWUNGENE Fall ─────────────────────────────────────────────────────

   Meldet sich jemand mit dem Vorgabekennwort an, führt der Server auf denselben
   Screen zurück und hängt `pwchange=1` an. Das Skript zieht diesen Dialog dann
   UNABWEISBAR auf — kein Kreuz, kein Escape, kein Klick daneben. Ein Zwang, den
   man wegklicken kann, ist keiner.

   ── Die Regeln stehen DA, bevor getippt wird ────────────────────────────────

   Aus `project().password_policy`. Die Datei speichert nur Abweichungen (damit
   spätere Verbesserungen an den Vorgaben ein Projekt noch erreichen), die
   Beilage trägt die WIRKSAMEN Werte — sonst meldete der Dialog „mindestens 0
   Zeichen", wo zwölf verlangt sind. #}
{% set pol = project() %}
{% set pw = pol.password_policy | default(value=false) %}
<div class="help-modal" id="profile-modal">
  <div class="help-modal__box">
    <div class="help-modal__head">
      <span class="help-modal__title">{{ t(key="my-profile") }}</span>
      <button class="help-modal__close" data-dialog-close type="button" aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body">
      <div id="profile-forced" class="profile__banner profile__banner--err" style="display:none;">
        {{ t(key="password-must-change") }}
        {#- EIN AUSWEG, auch wenn der Zwang bleibt.
            Im erzwungenen Fall versteckt das CSS das Kreuz — richtig so, „ein
            Zwang, den man wegklicken kann, ist keiner". Es gab dann aber gar
            keinen Weg mehr hinaus: kein Abbruch, kein Abmelden. Wer die Regel
            gerade nicht erfuellen kann (falsches Tastaturlayout, vergessenes
            altes Passwort), sass fest. Gemeldet am 25.08.2026.
            Abmelden hebt den Zwang NICHT auf — beim naechsten Anmelden steht
            er wieder da. Es ist der Ausweg, nicht die Umgehung. -#}
        <form method="POST" action="/logout" class="profile__ausweg">
          <button type="submit" class="nav__btn">{{ t(key="logout") }}</button>
        </form>
      </div>
      <div id="profile-msg" class="profile__banner" style="display:none;"></div>

      {#- ── DIE KONTAKTDATEN ─────────────────────────────────────────────
          Zum Profil gehoert nicht nur das Kennwort: E-Mail, Festnetz und
          Mobil. Zwei Nummern und nicht eine — eine Festnetznummer erreicht
          den PLATZ, eine Mobilnummer die PERSON. Wer nachts eine Anlage
          sucht, braucht die zweite; wer eine Rueckfrage zur Bedienung hat,
          oft die erste.

          UEBER AJAX, nicht ueber ein Formular: eine Nummer zu speichern
          rechtfertigt keinen Seitenwechsel. Der Dialog bleibt offen, der
          Screen darunter steht still, und es entsteht keine
          `?pwnotice=`-Fahne, die der naechste Sprung mitschleppt.

          Der KENNWORTWECHSEL darunter geht denselben Weg. Er BLEIBT ein
          echtes `<form>`, aber nur als Rueckfall: ohne JavaScript schickt es
          an `/profile/password` mit Weiterleitung, mit JavaScript faengt das
          Skript es ab und ruft `/api/profile/password`. Zwei Wege zu
          DERSELBEN Pruefung — nicht zwei Regeln. -#}
      <div class="profile__abschnitt" id="profile-kontakt">
        <div class="profile__abschnitt-titel"
             id="profile-kontakt-titel">{{ t(key="contact-details") }}</div>
        <label for="pf-email">{{ t(key="email") }}</label>
        <input type="email" id="pf-email" autocomplete="email">
        <label for="pf-landline">{{ t(key="phone-landline") }}</label>
        <input type="tel" id="pf-landline" autocomplete="tel">
        <label for="pf-mobile">{{ t(key="phone-mobile") }}</label>
        <input type="tel" id="pf-mobile" autocomplete="tel">
        <div class="profile__aktionen">
          <button type="button" class="nav__btn" id="pf-speichern">{{ t(key="save") }}</button>
          <span class="profile__hinweis" id="pf-hinweis"></span>
        </div>
      </div>

      <div class="profile__abschnitt-titel">{{ t(key="change-password") }}</div>
      {#- DIE REGELN KOMMEN AUS DER RICHTLINIE, NICHT AUS DER VORLAGE.
          Hier stand eine serverseitig gerenderte Liste mit `got=0` — eine
          Zaehlung, die fest im Text stand und immer „eingegeben: 0" sagte.
          Eine Liste, die EINMAL beim Rendern entsteht, kann nicht wissen, was
          danach getippt wird.

          Jetzt baut das Skript sie aus der Richtlinie, die ueber
          `/api/profile` mitreist, und hakt bei jedem Tastendruck ab. Der
          Server prueft trotzdem: was der Browser rechnet, ist eine HILFE. -#}
      <form id="pf-pwform" class="login-form" autocomplete="off"
            method="POST" action="/profile/password">
        <input type="hidden" name="next" id="profile-next" value="">
        <label for="pw-old">{{ t(key="current-password") }}</label>
        <input type="password" id="pw-old" name="old_password"
               autocomplete="current-password" required>
        <label for="pw-new">{{ t(key="new-password") }}</label>
        <input type="password" id="pw-new" name="new_password"
               autocomplete="new-password" required>
        <label for="pw-new2">{{ t(key="repeat-password") }}</label>
        <input type="password" id="pw-new2" name="confirm_password"
               autocomplete="new-password" required>

        {#- Die Liste ist LEER im Markup und wird vom Skript gefuellt. Ohne
            JavaScript bleibt sie leer und das Formular geht den alten Weg —
            `/profile/password` mit Weiterleitung.

            WAS OHNE JAVASCRIPT WIRKLICH PASSIERT, damit hier nichts steht, was
            niemand geprueft hat: der Wechsel FUNKTIONIERT — der Server prueft
            und speichert —, aber der Bediener sieht weder die Regeln vorher
            noch die Gruende danach. Die Weiterleitung traegt sie in der
            Abfrage (`?pwerror=…&reasons=…`), und gelesen werden sie allein vom
            Skript. Hier stand „er sieht die Regeln nur erst nach dem
            Absenden"; gemessen am 25.08.2026 sieht er sie gar nicht.

            Kein Ersatzbau dafuer, und zwar aus einem Grund: dieselbe Anlage
            zeigt ohne JavaScript auch keinen einzigen Messwert — der ganze
            Live-Kanal haengt daran. Eine servergerenderte Gruendeliste waere
            Sorgfalt an der einzigen Stelle, die ohne Skript ohnehin nie eine
            vollstaendige Seite ergibt. -#}
        <ul class="pw-rules" id="pw-regeln"></ul>

        <div class="profile__aktionen">
          <button type="submit" class="nav__btn nav__btn--login">{{ t(key="change-password") }}</button>
          <button type="button" class="nav__btn help-modal__close-alt"
                  data-dialog-close>{{ t(key="close") }}</button>
        </div>
      </form>
    </div>
  </div>
</div>
{# ÜBER DIESE ANLAGE — ein Dialog, kein Seitenwechsel.
   Wie An-/Abmelden und Hilfe gehört die Auskunft zum festen Mobiliar: sie muss
   von JEDEM Screen erreichbar sein, und danach steht der Screen noch da. Ein
   Sprung auf eine Seite nähme dem Bediener seinen Platz.
   Der Inhalt kommt aus `about_inhalt` — dieselbe Datei, die auch `/about`
   einzieht. #}
<div class="help-modal" id="about-modal">
  <div class="help-modal__box">
    <div class="help-modal__head">
      <span class="help-modal__title">{{ t(key="about") }}</span>
      <button class="help-modal__close" data-dialog-close type="button" aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body">{% include "about_inhalt" %}</div>
  </div>
</div>
<div class="help-modal" id="help-modal">
  <div class="help-modal__box">
    <div class="help-modal__head">
      <span class="help-modal__title">{{ t(key="help") }}</span>
      <button class="help-modal__close" data-dialog-close type="button" aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body" id="help-body"></div>
  </div>
</div>
<main>
  {% block content %}{% endblock %}
</main>
{# DIE MELDUNGSTEXTE FUER DEN BROWSER — vor dem Skript, das sie liest.
   `hearth-base.js` faellt ohne sie auf den SCHLUESSEL zurueck, und genau so
   stand `pw-mismatch` auf der Profilseite statt eines Satzes. Nur die
   argumentfreien Texte: einen mit `{ $count }` koennte der Browser nicht
   fertig einsetzen, und halb eingesetzt waere schlechter als gar nicht. #}
<script>window.HEARTH_TEXTS = {{ texte() | json_encode | safe }};</script>
<script src="/static/js/hearth-base.js"></script>
{% block extra_js %}{% endblock %}
</body>
</html>
]]></asset>
  <asset name="dashboard.html.tera" type="tera"><![CDATA[{# Das DASHBOARD — der Arbeitsplatz der Anlage.

   ── Dieselbe Bauart wie der Splash ──────────────────────────────────────────

   Rahmen, Panel, Flaeche und Einpassung kommen aus `frame`; hier steht nur,
   was diesen Seitentyp ausmacht. Der Splash ist der EINGANG (keine Leiste,
   Logo und Angaben aus den Projekt-Eigenschaften), das Dashboard ist der
   ARBEITSPLATZ — mit Leiste, und mit dem, was jede Anlage hat.

   Vorher war das eine eigene SEITE unter `/dashboard`, neben einem Screen
   gleichen Namens. Zwei Seiten mit demselben Namen, und der Bediener sah je
   nach Adresse etwas anderes.

   ── Verbindlich gegen variabel ──────────────────────────────────────────────

   Was hier steht, ist VERBINDLICH: es gehoert zu jeder Anlage und liegt nicht
   auf dem Screen. Was der Entwerfer platziert, ist VARIABEL und liegt darueber
   — die Platzierungen zeichnet `frame` nach diesem Block.

   Deshalb sitzen die Standards in einem schmalen Streifen am unteren Rand und
   nicht mittig: die Arbeitsflaeche gehoert dem Entwurf. Ein Standard, der die
   Flaeche frisst, waere kein Standard, sondern ein Hindernis.

   ── Die Werte kommen LIVE, nicht aus dem Kontext ────────────────────────────

   `sys.version`, `sys.bridges`, `sys.vars` und `sys.connected` reisen im
   `live`-Rahmen mit — in derselben Karte wie jeder Anlagenwert. `hearth-base.js`
   ruft `onLiveUpdate(values)`, und die Vorlage holt sie dort heraus.

   Sie NICHT aus dem Tera-Kontext zu nehmen ist Absicht: der Kontext waere eine
   zweite Quelle, die beim Laden einmal stimmt und danach altert. Ein Dashboard,
   das die Brueckenzahl von vorgestern zeigt, ist schlimmer als eines, das sie
   gar nicht zeigt. #}
{% extends "frame" %}

{% block screen_chrome %}
{# OHNE ZEILEN WIRD NICHTS GEZEICHNET — auch keine Trennlinie.
   Eine Linie ueber nichts ist die Leiche mit Namen: sie sagt „hier steht
   etwas", und es steht nichts da. #}
{% if screen.standards | length > 0 %}
  {% set W = screen.viewport_width %}
  {% set H = screen.viewport_height %}
  {% set fs = H * 0.018 %}
  {% set zeilenzahl = screen.standards | length %}
  {# Von unten nach oben stapeln: die UNTERSTE Zeile bleibt dort, wo der
     Streifen immer war. Kommt eine dazu, waechst er nach oben in die Flaeche
     hinein — nicht nach unten aus dem Bild. #}
  {% set y0 = H - fs * 1.4 - (zeilenzahl - 1) * fs * 1.6 %}

  {# Eine feine Trennlinie statt eines Kastens: der Streifen soll die Flaeche
     begrenzen, nicht mit ihr konkurrieren. #}
  <line x1="{{ W * 0.04 }}" y1="{{ y0 - fs * 1.1 }}"
        x2="{{ W * 0.96 }}" y2="{{ y0 - fs * 1.1 }}"
        stroke="{{ screen_ink }}" stroke-opacity="0.14" stroke-width="1"/>

  <g font-size="{{ fs }}" fill="{{ screen_ink }}" fill-opacity="0.55">
  {% for zeile in screen.standards %}
    {# Den AEUSSEREN Index festhalten: `loop` zeigt in der inneren Schleife auf
       die innere, und eine verschachtelte Zeilennummer waere still falsch. #}
    {% set r = loop.index0 %}
    {% set spalten = zeile | length %}
    {% if spalten > 0 %}
    {% for zelle in zeile %}
      {# Gleichmaessig ueber die Breite. Die vier mitgelieferten Standards
         landen damit auf 4 %, 27 %, 50 % und 73 % — dieselbe Aufteilung, die
         vorher von Hand dastand. #}
      <text x="{{ W * 0.04 + loop.index0 * (W * 0.92 / spalten) }}"
            y="{{ y0 + r * fs * 1.6 }}">
        {#- BESCHRIFTUNG: Freitext schlaegt Katalogschluessel. Was der
            Entwerfer tippt, gilt; der Schluessel ist der Weg der
            MITGELIEFERTEN Zellen, damit dieselbe Datei in vier Sprachen
            antwortet. -#}
        {%- if zelle.label -%}{{ zelle.label }}
        {%- elif zelle.label_key -%}{{ t(key=zelle.label_key) }}
        {%- endif %}
        {#- Beschriftung und Wert getrennt: die Beschriftung ist fest, der Wert
            wird zur Laufzeit ersetzt. Der Gedankenstrich steht, bis der erste
            Rahmen kommt — eine 0 waere eine Behauptung. -#}
        <tspan id="std-{{ r }}-{{ loop.index0 }}" font-weight="600">—</tspan>
      </text>
    {% endfor %}
    {% endif %}
  {% endfor %}
  </g>
{% endif %}
{% endblock %}

{% block extra_js %}
{# Dieselbe Laufzeit wie jeder Screen — ein Dashboard ist keiner mit
   Sonderrechten. #}
<script>window.HEARTH_BINDINGS = {{ bindings_json | safe }};</script>
<script type="module" src="/static/js/screen-runtime.js"></script>
<script>
// DIE STANDARDS AUS DEM LIVE-KANAL.
//
// `hearth-base.js` ruft diese Funktion mit der Werte-Karte; `screen-runtime.js`
// umschliesst sie spaeter fuer die Platzierungen, ruft aber die vorige zuerst.
// Deshalb genuegt es, sie hier zu setzen — beide Seiten kommen dran.
(function () {
  // DIE ABBILDUNG ENTSTEHT AUS DENSELBEN ZELLEN wie die Beschriftungen.
  //
  // Vorher stand hier eine feste Viererliste neben den vier fest verdrahteten
  // Texten oben — zwei Listen fuer dieselbe Sache, und wer eine Zeile
  // hinzufuegte, musste an beide denken. Eine Liste, die gepflegt werden muss,
  // wird irgendwann nicht gepflegt.
  var felder = {
{%- for zeile in screen.standards %}{% set r = loop.index0 %}
{%- for zelle in zeile %}{% if zelle.var %}
    {{ zelle.var | json_encode | safe }}: 'std-{{ r }}-{{ loop.index0 }}',
{%- endif %}{% endfor %}
{%- endfor %}
  };
  var vorher = window.onLiveUpdate;
  window.onLiveUpdate = function (values) {
    if (typeof vorher === 'function') { try { vorher(values); } catch (e) {} }
    for (var schluessel in felder) {
      var lv = values[schluessel];
      if (!lv) continue;
      var el = document.getElementById(felder[schluessel]);
      if (!el) continue;
      var v = (lv && lv.v != null) ? lv.v : lv;
      // BOOL kommt als true/false: der Bediener liest kein „false".
      if (lv.t === 'BOOL') v = (v === true || v === 'true' || v === 1 || v === '1') ? '✓' : '✕';
      el.textContent = String(v);
    }
  };
})();
</script>
{% endblock %}
]]></asset>
  <asset name="frame.html.tera" type="tera"><![CDATA[{# DER RAHMEN — die eine Stelle, an der ein Screen eingepasst wird.

   ── Warum es diese Vorlage gibt ─────────────────────────────────────────────

   Die Einpassung stand ZWEIMAL da: einmal in `screen`, einmal in `splash`. Als
   der Rahmen eine Projekteinstellung wurde, bekam `screen` sie — und `splash`
   blieb bei `screen.background`, malte also seinen Rand in der Screenfarbe und
   liess nicht erkennen, wo der Screen aufhoert. Eine Abschrift, sofort
   zurueckgeblieben; die zweite haette es beim naechsten Mal wieder getan.

   Hier steht sie einmal. Wer einen dritten Screen-artigen Seitentyp anlegt,
   erbt sie, statt sie abzuschreiben.

   ── ZWEI AUFLOESUNGEN, nicht eine ───────────────────────────────────────────

   PANEL (Projekteinstellung) — die physikalische Aufloesung des Zielgeraets.
   SCREEN — die Aufloesung, auf die dieser eine Screen entworfen ist.

   Der Screen liegt IM Panel, mittig; was uebrig bleibt, ist der Rahmen. Das
   Panel wiederum wird als Ganzes ins Fenster eingepasst
   (`preserveAspectRatio="xMidYMid meet"`).

   Erst dadurch ist „nach aussen immer gleich, nach innen skaliert" woertlich
   wahr: die aeussere Geometrie ist IMMER das Panel — unabhaengig davon, wie
   gross der einzelne Screen entworfen wurde. Mit nur einer Aufloesung waere
   jeder Screen sein eigenes Format gewesen, und ein Sprung von einem
   1280er- auf einen 1920er-Screen haette die ganze Seite umspringen lassen.

   Ohne Panel-Einstellung ist das Panel der Screen — dann faellt die aeussere
   Ebene zusammen, und es verhaelt sich wie vorher.

   ── Die Kette, die vorher eine Ebene zu frueh riss ──────────────────────────

   `.screen-frame` bekam `flex: 1 1 auto` — aber sein Elternteil `<main>` war
   kein Flex-Container, sondern trug aus hearth.css `padding: 24px;
   max-width: 1400px`. Eine Hoehenangabe in Prozent gegen ein `height: auto`
   loest sich nicht auf: das `<svg>` fiel auf seine Ersatzgroesse zurueck, und
   der Screen sass winzig in der Mitte. Die Kette muss von `body` bis zum `svg`
   DURCHGEHEND flex sein, sonst traegt sie nicht. #}
{% extends "base" %}
{% block title %}{{ screen.name }}{% endblock %}

{% block extra_css %}
<style>
/* Von body bis svg durchgehend — jede Unterbrechung kappt die Hoehe. */
body { display: flex; flex-direction: column; min-height: 100vh; }
main {
  /* `flex: 1` fragt NICHT, wie hoch die Leiste ist — es nimmt, was uebrig
     bleibt. Eine abgezogene Zahl (`calc(100vh - 48px)`) stimmt in dem Moment
     nicht mehr, in dem die Leiste auf einem schmalen Panel umbricht. */
  flex: 1 1 auto; min-height: 0; display: flex;
  padding: 0; max-width: none; margin: 0;
}
.screen-frame {
  flex: 1 1 auto; min-height: 0; width: 100%;
  display: flex; align-items: center; justify-content: center;
  /* Die Projekteinstellung, GEERBT — nicht eingeklebt. Gesetzt wird sie einmal
     auf `:root` in `base`, bei den Themafarben. Sie deckt hier den Bereich, den
     auch das Panel nicht fuellt (Fenster breiter als das Zielgeraet), damit
     aussen und innen dieselbe Farbe stehen. */
  background: var(--surround, #101014);
}
.screen-frame__svg { width: 100%; height: 100%; display: block; }

/* ── DIE FORMULAREBENE ──────────────────────────────────────────────────────
   Ein Screen ist ein `<svg>`, und SVG kennt kein Eingabefeld. Hier liegt die
   HTML-Ebene darueber — Fundament der Formularfamilie, nicht Anmelde-Sonderweg.

   Lage und Massstab setzt `alignScreenLayer()` in screen-runtime.js: eine
   Transformation auf der Ebene, die Kinder rechnen in SCREEN-Einheiten.

   `position: fixed` wie bei den bestehenden Ueberlagerungen (makeOverlay,
   Bildschirmschoner) — dieselbe Bezugsflaeche, dieselbe Rechnung.

   DURCHLAESSIG, ihre Kinder nicht: eine leere Ebene liegt sonst wie eine
   Glasscheibe ueber der Zeichenflaeche, und kein Klick kaeme mehr an. Genau so
   ein Fehler ist erst zu bemerken, wenn jemand einen Taster drueckt und nichts
   geschieht. */
.screen-layer {
  position: fixed; left: 0; top: 0;
  pointer-events: none;
  overflow: hidden;
}
.screen-layer > * { pointer-events: auto; position: absolute; }

/* Die GROESSE gehoert der Platzierung, so wie x und y — nicht dem Element.
   Ein einzelnes Kind fuellt deshalb seinen Wirt. Ohne diese Regel stand das
   Eingabefeld in seiner Eigengroesse da (gemessen: 128,8 statt 400 Einheiten),
   und der Entwerfer haette eine Groesse eingestellt, die nichts bewirkt.

   `:only-child`, damit ein zusammengesetztes Element (Beschriftung + Feld,
   spaeter Reiter) seine eigene Aufteilung behaelt. */
.screen-layer > * > :only-child {
  width: 100%; height: 100%; box-sizing: border-box;
}
</style>
{% block frame_extra_css %}{% endblock %}
{% endblock %}

{% block content %}
{# Ohne Panel-Einstellung IST das Panel der Screen: dann ist der Versatz null
   und das Rahmenrechteck deckungsgleich mit der Flaeche. Ein Sonderfall weniger
   als eine Weiche „mit/ohne Panel" — aufgeloest wird das in Rust, weil eine
   Null in Tera keine fehlende Angabe ist und `default` dort nicht greift. #}
{% set pw = panel_width %}
{% set ph = panel_height %}
{% set ox = (pw - screen.viewport_width) / 2 %}
{% set oy = (ph - screen.viewport_height) / 2 %}

<div class="screen-frame">
  <svg class="screen-frame__svg" viewBox="0 0 {{ pw }} {{ ph }}"
       preserveAspectRatio="xMidYMid meet"
       {% if screen.font_family %}style="font-family: {{ screen.font_family }};{% if screen.font_size %} font-size: {{ screen.font_size }}px;{% endif %}{% if screen.font_bold %} font-weight: 700;{% endif %}"{% endif %}>

    {# DAS PANEL — der Rahmen, in Geraetekoordinaten. Als Rechteck und nicht nur
       als CSS-Hintergrund: nur so ist der Rand auch dann sichtbar, wenn er
       INNERHALB des eingepassten Bereichs liegt (Screen kleiner als Panel). #}
    <rect x="0" y="0" width="{{ pw }}" height="{{ ph }}" fill="var(--surround, #101014)"/>

    {# DER PLATZ DES SCHIRMS im Panel — ein verschachteltes `<svg>` und
       ausdruecklich KEIN `<g transform="translate(…)">`.

       Der Unterschied ist nicht Geschmack, sondern gemessen: `screen.svg` ist
       ein VOLLSTAENDIGES `<svg>` mit eigenem viewBox und ohne width/height. Ein
       solches Element fuellt 100 % des umgebenden VIEWPORTS. Unter einem `<g>`
       ist das der Viewport des Panels — der Screen haette sich also auf das
       ganze Geraet gedehnt, und die zweite Aufloesung waere folgenlos geblieben.

       Ein verschachteltes `<svg>` setzt beides zugleich: Ursprung UND Groesse.
       Damit sind 100 % genau die Screengroesse. Nebenwirkung, die hier
       erwuenscht ist: ein verschachteltes `<svg>` beschneidet — ein Screen kann
       nicht mehr in den Rahmen hinausmalen.

       Alles darin rechnet weiter in SCREEN-Koordinaten, so wie es entworfen
       wurde; der Versatz ist Sache des Rahmens, nicht des Inhalts. #}
    {# `id="screen-surface"` — DERSELBE Bezeichner wie im Editor.
       ([canvas-editor.js](../../resources/canvas/canvas-editor.js) legt so seine
       Zeichenflaeche an.) `screenRect()` in screen-runtime.js sucht genau
       diesen: damit hat sie EINEN Weg statt zweier, und was der Editor als
       „der Screen" versteht, versteht die Anlage genauso.

       Vorher fiel ihr Hearth-Zweig auf `window.innerWidth/innerHeight` zurueck.
       Das stimmte, solange der Screen die ganze Seite fuellte — seit dem Rahmen
       deckt er nur diesen Schacht. Betroffen war nicht erst die Formularebene,
       sondern schon Bildschirmschoner und Abdunkeln: sie legten sich ueber den
       Rahmen mit. #}
    <svg id="screen-surface" x="{{ ox }}" y="{{ oy }}"
         width="{{ screen.viewport_width }}" height="{{ screen.viewport_height }}"
         viewBox="0 0 {{ screen.viewport_width }} {{ screen.viewport_height }}">

      {# Die Flaeche des Screens: sie deckt GENAU seinen Bereich, nicht das Panel. #}
      <rect x="0" y="0" width="{{ screen.viewport_width }}"
            height="{{ screen.viewport_height }}" fill="{{ screen.background }}"/>

      {# Was die Seite dem Screen VORANSTELLT — im Screen-Koordinatensystem, also
         mitskalierend. Der Splash setzt hier Logo und Angaben; ein gewoehnlicher
         Screen laesst es leer. #}
      {% block screen_chrome %}{% endblock %}

      {{ screen.svg | safe }}
    </svg>
  </svg>

  {# DIE FORMULAREBENE — leer, bis Formularelemente platziert sind. Sie wird von
     `alignScreenLayer()` auf den Schacht gelegt; ohne die Rechnung bleibt sie
     bei 0/0 stehen und faellt sofort auf, statt still danebenzuliegen. #}
  {# Was eine SEITE in die Ebene stellt — HTML im Screen-Koordinatensystem.
     Der Splash setzt hier seine Angaben; ein gewoehnlicher Screen laesst es
     leer, und dann steht die Ebene da wie bisher. #}
  <div id="screen-layer" class="screen-layer">{% block screen_layer %}{% endblock %}</div>
</div>

{# ── WEITERLEITEN nach Zeitablauf ─────────────────────────────────────────────

   Gebaut fuer den SPLASH: er ist der Eingang und soll nicht der Aufenthalt
   sein. Auf einem Panel ohne Tastatur ist der Selbstsprung nicht Komfort,
   sondern die einzige Bedienung.

   Im RAHMEN und nicht in `splash`, weil es kein Splash-Sonderfall ist: eine
   Bedienseite, die nach fuenf Minuten zur Uebersicht zurueckkehrt, ist derselbe
   Vorgang. Ein Feld, das nur eine Vorlage kennt, waere die naechste Sonderregel.

   ── Ab der letzten BEDIENUNG, nicht ab dem Laden ────────────────────────────

   Der Zaehler faengt bei jeder Beruehrung von vorn an. Auf dem Splash aendert
   das nichts (dort bedient niemand), auf einer Bedienseite ist es der
   Unterschied zwischen „kehrt zurueck, wenn keiner mehr da ist" und „wirft den
   Bediener mitten im Eingeben hinaus".

   `pagehide` haelt den Zaehler an: ein Reiter im Hintergrund soll nicht
   weiterspringen und beim Zurueckkehren woanders stehen.

   KEIN `<meta http-equiv="refresh">`: das laedt auch dann neu, wenn der
   Bediener gerade tippt, und es ist nicht anzuhalten. #}
{% if screen.timeout and screen.timeout > 0 and screen.redirect_to %}
<script>
(function () {
  var ziel = {{ screen.redirect_to | json_encode | safe }};
  var sekunden = {{ screen.timeout }};
  var uhr = null;
  // NACHSCHAUEN statt springen, solange ein Dialog offen steht.
  //
  // Auf dem Splash koennen Dialoge stehen: die Anmeldung, und nach einem Login
  // mit Vorgabekennwort der unabweisbare Kennwortwechsel. Ein Seitenwechsel
  // mitten hinein risse den Dialog samt Eingabe weg — beim erzwungenen Wechsel
  // ginge der Zwang verloren. Geprueft wird die Klasse `.open`, die derselbe
  // Mechanismus setzt, der die Dialoge oeffnet: keine zweite Liste, die
  // auseinanderlaufen koennte.
  //
  // Stand vorher NUR im Splash, zusammen mit einem fest verdrahteten Ziel.
  // Das Ziel ist gefallen; die Wache gehoert hierher, weil sie kein
  // Splash-Sonderfall ist — eine Bedienseite mit Ruecksprung darf einen
  // offenen Dialog genauso wenig wegreissen.
  function los() {
    if (document.querySelector('.help-modal.open')) {
      window.setTimeout(los, 500);
      return;
    }
    window.location.href = '/screen/' + encodeURIComponent(ziel);
  }
  function neu() {
    if (uhr) clearTimeout(uhr);
    uhr = setTimeout(los, sekunden * 1000);
  }
  ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (e) {
    window.addEventListener(e, neu, { passive: true });
  });
  window.addEventListener('pagehide', function () { if (uhr) clearTimeout(uhr); });
  neu();
})();
</script>
{% endif %}
{% endblock %}
]]></asset>
  <asset name="login.html.tera" type="tera"><![CDATA[<!DOCTYPE html>
<html lang="{{ lang() }}" dir="{{ dir() }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{# Der Titel nennt die ANLAGE. Er steht in der Fensterleiste, im Lesezeichen
   und im Verlauf — an drei Stellen, an denen „Hearth" nichts unterscheidet,
   wenn jemand zwei Anlagen betreut. #}
<title>{{ t(key="login") }} — {{ meta.name | default(value="Hearth") }}</title>
<link rel="stylesheet" href="/static/css/hearth-login.css">
</head>
<body>
{# DIE MARKE: das Logo der Anlage, wenn es eines gibt — sonst die Wortmarke.
   NICHT der Anlagenname: der steht als Untertitel unter „Anmelden", und
   zweimal dasselbe auf einer Seite liest sich wie ein Fehler. Die Marke sagt,
   WESSEN Oberflaeche das ist; der Untertitel, WELCHE Anlage. #}
{% if meta.logo %}
<a href="/" class="brand"><img src="{{ meta.logo }}" alt="{{ meta.name }}" class="brand__logo"></a>
{% else %}
<a href="/" class="brand">HEARTH</a>
{% endif %}
<main class="card">
  <h1>{{ t(key="login") }}</h1>
  {#- HIER STAND DER PRODUKTNAME. „Hearth SCADA/HMI" — der Name der Software.
      Wer vor einem Panel steht, will wissen, an WELCHER ANLAGE er sich
      anmeldet; welches Programm darunter laeuft, ist die Auskunft, die er
      zuletzt braucht. Gemeldet am 25.08.2026.

      Die Organisation darunter, wenn es eine gibt: bei einem Dienstleister mit
      mehreren Anlagen desselben Namens ist sie der Unterschied.

      Faellt beides weg (Projekt ohne Namen), bleibt der Produktname aus dem
      Katalog — ein leerer Untertitel saehe aus wie ein Ladefehler. -#}
  {% if meta.name %}
  <div class="subtitle">{{ meta.name }}</div>
  {% else %}
  <div class="subtitle">{{ t(key="hearth-server") }}</div>
  {% endif %}
  {% if meta.organisation %}<div class="subtitle subtitle--org">{{ meta.organisation }}</div>{% endif %}

  {% if already_in %}
    <div class="notice">{{ t(key="already-logged-in") }} <a href="/dashboard" style="color:#4caf50;">{{ t(key="to-dashboard") }}</a></div>
  {% endif %}

  {% if error %}
    {% if error == "invalid" %}
      <div class="error">{{ t(key="password-wrong") }}</div>
    {% elif error == "internal" %}
      <div class="error">{{ t(key="login-internal-error") }}</div>
    {% else %}
      <div class="error">{{ t(key="error-detail", detail=error) }}</div>
    {% endif %}
  {% endif %}

  <form method="POST" action="/login">
    <label for="username">{{ t(key="username") }}</label>
    <input type="text" id="username" name="username" autocomplete="username" required autofocus>

    <label for="password">{{ t(key="password") }}</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>

    <button type="submit">{{ t(key="login") }}</button>
  </form>
</main>
</body>
</html>
]]></asset>
  <asset name="nav_makros.html.tera" type="tera"><![CDATA[{# ── Makros fuer die Navigation ──────────────────────────────────────────────
   EIGENE DATEI, weil `self::` in einer EINGEBUNDENEN Vorlage nicht gilt: navbar
   wird per {% include %} in base gezogen, und Tera meldet dort
   „Macro namespace `self` was not found in template `base`". Aus einer
   importierten Makrodatei heraus funktioniert die Rekursion dagegen.
#}
{# ── EIN MENUEEINTRAG — ein <li>, in jeder Tiefe ─────────────────────────────

   HTML5, nicht <div>-Suppe. Ein Menue IST eine Liste, ein aufklappbarer Punkt
   IST ein <details>, eine Trennlinie IST ein <hr>. Das kostet nichts und bringt
   drei Dinge, die wir sonst von Hand nachbauen muessten:

   1. DIE VERSCHACHTELUNG TRAEGT DAS MARKUP. <ul>/<li> sagt, was worin liegt;
      vorher behaupteten das Klassennamen, und ein Vorleseprogramm sah eine
      Reihe gleichrangiger <span>.

   2. AUFKLAPPEN OHNE JAVASCRIPT. <details>/<summary> klappt auf Klick auf —
      der Browser macht es, mit Tastatur und Vorleseprogramm inklusive. Vorher
      oeffnete die CSS die Klappliste bei `:hover`. Auf einem Panel gibt es
      kein hover; der Kommentar am Profilmenue haelt das selbst fest
      („touch panels have no hover"). Das Untermenue ging dort also GAR NICHT
      auf — der Fehler war nicht zu sehen, weil bis vor Kurzem niemand ein
      Untermenue veroeffentlicht hatte.

   3. EIN STEIN JE ART. Jeder Zweig gibt genau ein <li> aus, und die Kinder
      stehen in einem <ul> darin. Damit laesst sich dasselbe Markup aus einer
      FLACHEN Steinliste zusammensetzen (auf/zu statt Rekursion) — die
      Voraussetzung dafuer, dass Server und Editor denselben Zusammensetzer
      benutzen und nicht zwei.

   Rekursiv ist hier vorerst nur noch das Untermenue. Das ist der naechste
   Schnitt, nicht dieser.
#}
{# ── Der INHALT eines Eintrags: Sinnbild, Beschriftung, zweite Zeile ─────────
   Eigenes Makro, weil es sonst bei jeder Art noch einmal dastuende — und beim
   naechsten Feld an sechs Stellen nachgezogen werden muesste.

   DAS SINNBILD REIST ALS BILD, nicht als Markup. Der Server hat keine
   Symbolbibliothek; er rendert die Navigation aus JSON. Der Compiler loest den
   Symbolnamen auf und bettet die Grafik als data-URL ein — denselben Weg nimmt
   die Marke seit jeher. Als eingeschleustes SVG waere es ausserdem beliebiges
   Markup aus einer Projektdatei.

   Leiste, Kacheln und Menueband zeigen dasselbe Markup; WAS davon zu sehen ist,
   entscheidet die CSS. Die Leiste blendet die zweite Zeile aus, die Kachel
   stellt das Sinnbild gross. #}
{% macro inhalt(e) %}
  {%- if e.icon %}<img class="nav__glyph" src="{{ e.icon }}" alt="">{% endif -%}
  <span class="nav__text">{{ e.label }}</span>
  {%- if e.hint %}<span class="nav__hint">{{ e.hint }}</span>{% endif -%}
{% endmacro inhalt %}

{% macro eintrag(e) %}
  {% if e.kind == "spacer" %}
  {# Dehnbarer Zwischenraum — schiebt, was folgt, ans andere Ende. #}
  <li class="nav__spacer" aria-hidden="true"></li>
  {% elif e.kind == "separator" %}
  {# TRENNLINIE, nicht Zwischenraum. Die beiden waren einmal dieselbe Ausgabe:
     wer eine Linie setzte, bekam eine Luecke.

     <hr> ist das Element dafuer — es TRENNT, und das sagt es auch einem
     Vorleseprogramm. Die Richtung entscheidet der ZUSAMMENHANG in der CSS, nicht
     die Tiefe: in einem Kachelmenue ist eine Trennlinie weder senkrecht noch
     waagerecht, und eine Vorlage, die das entschiede, braeuchte fuer jede neue
     Form einen weiteren Zweig. #}
  <li class="nav__sep-halter"><hr class="nav__separator"></li>
  {% elif e.kind == "radio" %}
  {# AUSWAHLGRUPPE: von ihren Punkten gilt GENAU EINER. Als Untermenue
     ausgegeben war sie eine Liste gleichrangiger Verweise — welcher gerade
     gilt, war darin nicht zu erkennen. `role=radiogroup` sagt es auch dem
     Vorleseprogramm, `data-var`/`data-value` geben der Laufzeit das, was sie
     zum Markieren des geltenden Punktes braucht. #}
  <li class="nav__item">
    <details class="nav__group nav__radio">
      <summary class="nav__link nav__group-label">{{ self::inhalt(e=e) }}</summary>
      <ul class="nav__dropdown" role="radiogroup" aria-label="{{ e.label }}">
        {% for c in e.children %}
        <li class="nav__item">
          <a class="nav__link nav__radio-item" role="radio" aria-checked="false"
             data-var="{{ c.target }}" data-cmd="select"
             {% if c.value %}data-value="{{ c.value }}"{% endif %}>{{ self::inhalt(e=c) }}</a>
        </li>
        {% endfor %}
      </ul>
    </details>
  </li>
  {% elif e.kind == "label" %}
  <li class="nav__item"><span class="nav__link nav__label">{{ self::inhalt(e=e) }}</span></li>
  {% elif e.kind == "variable" %}
  <li class="nav__item"><a class="nav__link nav__var" data-var="{{ e.target }}" data-cmd="{{ e.command | default(value='select') }}">{{ self::inhalt(e=e) }}</a></li>
  {% elif e.kind == "submenu" %}
  <li class="nav__item">
    <details class="nav__group">
      {# Das Klapp-Zeichen steht in der CSS, nicht hier: es ist Form, und Form
         haelt keine zweite Menueform aus, wenn sie im Markup steht. #}
      <summary class="nav__link nav__group-label">{{ self::inhalt(e=e) }}</summary>
      <ul class="nav__dropdown">
        {% for c in e.children %}{{ self::eintrag(e=c) }}{% endfor %}
      </ul>
    </details>
  </li>
  {% elif e.target %}
  <li class="nav__item"><a href="/screen/{{ e.target }}" class="nav__link">{{ self::inhalt(e=e) }}</a></li>
  {% else %}
  {# Kein Ziel und keine bekannte Art: als BESCHRIFTUNG zeigen statt als toten
     Link. Ein Eintrag, der aussieht wie ein Knopf und nirgendwohin fuehrt, ist
     schlimmer als einer, der sichtbar nur Text ist. #}
  <li class="nav__item"><span class="nav__link nav__label">{{ self::inhalt(e=e) }}</span></li>
  {% endif %}
{% endmacro eintrag %}
]]></asset>
  <asset name="navbar.html.tera" type="tera"><![CDATA[{# Der Import steht in base.html.tera, NICHT hier: {% include %} zieht diesen
   Inhalt dorthin, und Tera nimmt Importe dabei NICHT mit. Ein Import an dieser
   Stelle meldet beim Rendern „Macro namespace `menue` was not found in
   template `base`". #}
{# ── Navbar — fixed system header ─────────────────────────────────────────────
   This file is the OUTPUT of the Menübar-Compiler (Studio): it walks the placed
   menu-system symbols on a designated nav screen and emits this template. Until
   the compiler exists, this hand-authored variant ships as the baseline and is
   bundled with every Hearth deployment so every project ALWAYS has the fixed
   system entries (Login/Profil/Dashboard/Einstellungen) — even when no project
   navigation has been uploaded.

   Contract for the compiler emission:
     - Brand block must use {{ navg.brand.* }} (data fed by nav() helper).
     - Project entries are rendered into .nav__links from {{ navg.entries }}.
     - The .nav__status block (system menu) is INVARIANT and must be emitted
       verbatim — it owns the standard Profil/Einstellungen/Abmelden
       dropdown, the Verwaltung shortcut, the Anmelden CTA, and the About/Help
       icons. The Menübar-Compiler MUST NOT strip or reorder these entries.

   Included from base.html.tera via {% include "navbar" %}. Theme + nav() helper
   are in scope (set/registered in base before the include).
─────────────────────────────────────────────────────────────────────────────#}
<nav class="nav">
  {# Dedicated project navigation: the uploaded definition (nav()), authored
     in Studio and pushed via gRPC. Falls back to the system pages until one
     has been uploaded. The active entry is marked client-side by path. #}
{% set navg = nav() %}
  {# Brand = configurable plant logo (Corporate Identity). Clicking it opens the
     Home screen. Image (data URL) wins; else the brand text; defaults HEARTH.

     AUF `navg.brand` WIRD GEPRUEFT, nicht auf den `default`-Filter. Der faengt
     nur UNDEFINIERTES; steht die Marke auf NULL, liefert `navg.brand.text` eine
     leere Zeichenkette, und `default` greift nicht — die Leiste stand dann ohne
     Marke da, statt auf „HEARTH" zurueckzufallen. Gemessen: 35 statt 1990
     akzentfarbige Pixel in der Leiste, und niemand meldete etwas. #}
  <a href="/screen/{{ navg.brand.home | default(value='home') }}" class="nav__brand">
    {% if th.logo %}<img src="{{ th.logo }}" class="nav__logo" alt="Logo">
    {% elif navg.brand and navg.brand.image %}<img src="{{ navg.brand.image }}" class="nav__logo" alt="{{ navg.brand.text | default(value='') }}">
    {% elif navg.brand and navg.brand.text %}{{ navg.brand.text }}
    {% else %}HEARTH{% endif %}
  </a>
  {# ── Umschalter fuer schmale Anzeigen ────────────────────────────────────
     Auf einem Panel-PC oder Desktop ist er unsichtbar, die Leiste steht offen.
     Unterhalb der Schwelle in hearth.css nimmt er die Projekt-Eintraege auf.

     ER STEHT IMMER IM MARKUP, nicht nur unter der Schwelle. Was per Skript
     nachgeruestet wird, fehlt genau so lange, wie das Skript braucht — und auf
     einem Panel, das gerade hochfaehrt, ist das die Zeit, in der jemand
     draufdrueckt. Sichtbar ist er nur, wo er gebraucht wird; das entscheidet
     CSS, nicht JavaScript.

     aria-expanded traegt den Zustand, damit auch eine Sprachausgabe ihn
     bekommt; hearth-base.js schreibt es mit. #}
  <button class="nav__burger" id="nav-burger" type="button"
          aria-label="{{ t(key="menu") }}" aria-controls="nav-links" aria-expanded="false">
    <span class="nav__burger-strich"></span>
    <span class="nav__burger-strich"></span>
    <span class="nav__burger-strich"></span>
  </button>
  {# EINE LISTE, und die festen Eintraege stehen darin wie alle anderen.
     Vorher war es ein <div> mit lose eingestreuten <a> — fuer ein
     Vorleseprogramm eine Reihe gleichrangiger Verweise ohne Aussage, dass sie
     zusammen ein Menue bilden. Ausserdem faellt damit der Sonderfall weg: der
     Editor, der dieselbe Leiste zeichnen soll, sieht ueberall <li>. #}
  {# ── HIER STEHT AUSSCHLIESSLICH DIE NAVIGATION DES PROJEKTS ────────────────

     Hat das Projekt keine, bleibt die Leiste LEER. Kein Rueckfall.

     Hier standen vorher ein fester „Dashboard"-Eintrag und — wenn das Projekt
     nichts mitbrachte — „Bildschirme", „Alarme", „Trends". Das sah aus wie die
     Navigation der Anlage und war die der Anlagensoftware. Wer sein Menue noch
     nicht entworfen hatte, sah eine fertige Leiste und konnte nicht erkennen,
     dass sie nicht seine ist.

     Dieselbe Sorte Irrefuehrung wie die liegengebliebene Fremdnavigation
     („Tanklager", „Betriebsmodi") — nur kam die aus einer alten Datei und
     diese aus der Vorlage selbst.

     Die drei Systemseiten sind NICHT verschwunden: sie stehen im Systemmenue
     rechts, wo die Anlagensoftware hingehoert. Sie ersatzlos zu streichen
     haette Phantasie gegen Sackgasse getauscht. #}
  <ul class="nav__links" id="nav-links">
    {% if navg and navg.entries %}
      {% for e in navg.entries %}{{ menue::eintrag(e=e) }}{% endfor %}
    {% endif %}
  </ul>
  {# ── Fixed system status area — INVARIANT, see file header. ──────────────#}
  <div class="nav__status">
    {# Admin shortcut: button into the combined admin screen (Benutzerverwaltung
       + Anlagen-Settings). Shown only to admins; sits just LEFT of the login. #}
    {# HIER STAND EIN „Verwaltung"-KNOPF — entfallen, weil redundant.
       Dasselbe Ziel steht im Benutzermenue direkt daneben als
       „Einstellungen". Zwei Knoepfe fuer denselben Weg sind kein
       Komfort: der Bediener fragt sich, worin sie sich unterscheiden,
       und beim naechsten Umbau bleibt einer von beiden zurueck. #}
    {# Fixed system menu — present in every Hearth project regardless of the
       uploaded project navigation. The Menübar-Compiler must NOT touch this. #}
    <div class="nav__profile" id="nav-user" style="display:none;">
      <button class="nav__btn nav__profile-btn" id="nav-profile-btn" type="button">
        <span class="nav__avatar" id="nav-avatar"></span>
        <span id="nav-user-name">—</span>
        <span style="opacity:0.7;">▾</span>
      </button>
      <div class="nav__dropdown nav__profile-menu">
        <div class="nav__profile-roles" id="nav-user-roles">—</div>
        {# ── DER FESTE SATZ ──────────────────────────────────────────────────
           Anmeldename (im Knopf darueber) → Profil → Einstellungen → Trenner →
           Abmelden. Vorgegeben, nicht hergeleitet.

           Hier standen zwischenzeitlich „Dashboard", „Bildschirme", „Alarme"
           und „Trends". Die drei letzten hatte ich aus der linken Leiste
           hierher gezogen, damit sie nicht unerreichbar werden — die Sorge war
           richtig, die Stelle GERATEN. Ein Menue, dessen Reihenfolge sich
           niemand ueberlegt hat, ist genauso eine Behauptung wie ein erfundener
           Eintrag.

           Die vier Seiten sind ueber ihre Adressen erreichbar (/dashboard,
           /screens, /alarms, /trends). Ob und wo sie einen Menueweg bekommen,
           ist eine Entscheidung, keine Nebenwirkung. #}
        {# Der Verweis bleibt als Weg ohne JavaScript; das Skript nimmt den Klick
           ab und oeffnet stattdessen den Dialog — dann steht der Screen danach
           noch da. #}
        <a href="/profile" data-dialog="profile-modal" id="nav-profile-link" class="nav__menuitem">👤 {{ t(key="my-profile") }}</a>
        <a href="/admin"     class="nav__menuitem" id="nav-menu-admin" style="display:none;">⚙ {{ t(key="settings") }}</a>
        {# DER TRENNER vor dem Abmelden. `var(--line)` und keine feste Farbe: eine
           festverdrahtete Linie geht beim Umfaerben des Projekts nicht mit,
           und dann findet der Kunde genau die eine Stelle, die stehenbleibt. #}
        <form method="POST" action="/logout"
              style="border-top:1px solid var(--line, #2a2a38); margin-top:4px; padding-top:4px;">
          <button type="submit" class="nav__menuitem">⏻ {{ t(key="logout") }}</button>
        </form>
      </div>
    </div>
    {# `href="/login"` BLEIBT: ohne JavaScript ist der Verweis der Weg. Das
       Skript nimmt nur den Klick ab und oeffnet stattdessen den Dialog — dann
       steht der Screen danach noch da. #}
    <a href="/login" data-dialog="login-modal" class="nav__btn nav__btn--login" id="nav-anon" style="display:none;">{{ t(key="login") }}</a>
    {# ── Sprachumschalter ────────────────────────────────────────────────
       Nur, wenn das Projekt MEHR ALS EINE Sprache anbietet — `languages()`
       liefert sonst eine leere Liste. Ein Umschalter mit einem Eintrag ist
       kein Umschalter, er ist eine Behauptung.

       Als Verweise, nicht als Auswahlfeld: ein <select> braucht JavaScript,
       um etwas zu bewirken, und ein Panel, dessen Skript noch laedt, haette
       dann einen Knopf, der nichts tut. Ein Verweis wirkt immer. #}
    {% set langs = languages() %}
    {% if langs %}
    {# ── SPRACHE — ein Aufklappmenue mit Flaggen ──────────────────────────
       Hier stand eine Reihe von Kuerzeln (DE EN FR ES). Mit zwei Sprachen ging
       das; mit vieren ist es eine Buchstabensuppe in der Leiste, und mit acht
       drueckt sie die Navigation weg.

       FLAGGE UND NAME zusammen: die Flagge findet man im Vorbeigehen, der Name
       sagt, was es ist. Und der Name steht IN DER SPRACHE SELBST — „Deutsch",
       nicht „German". Wer die Oberflaeche nicht versteht, sucht das Wort, das
       er kennt; eine Liste in der aktuellen Sprache waere fuer genau den
       nutzlos, der sie braucht.

       Zur Flagge selbst: Sprache ist nicht Land. `en` gehoert nicht
       Grossbritannien, `es` nicht Spanien. Die Zuordnung steht an EINER Stelle
       im Server (`flagge()`), mit derselben Warnung — sie hilft beim Finden und
       behauptet nichts.

       `?next=` haengt das Skript an: der Server fuehrt danach auf DENSELBEN
       Screen zurueck. Ohne Skript springt der `Referer` ein, und erst wenn auch
       der fehlt, auf „/". Wir bleiben, wo wir sind. #}
    <div class="nav__profile" id="nav-lang">
      <button class="nav__btn" id="nav-lang-btn" type="button"
              title="{{ t(key="language") }}" aria-haspopup="true">
        {% for l in langs %}{% if l.active %}<span class="nav__flag">{{ l.flag }}</span> {{ l.name }}{% endif %}{% endfor %}
        <span style="opacity:0.7;">▾</span>
      </button>
      <div class="nav__dropdown nav__lang-menu">
        {% for l in langs %}
        <a href="/lang/{{ l.code }}" data-lang-link
           class="nav__menuitem{% if l.active %} is-active{% endif %}"
           hreflang="{{ l.code }}" lang="{{ l.code }}">
          <span class="nav__flag">{{ l.flag }}</span> {{ l.name }}
          <span class="nav__lang-code">{{ l.code | upper }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {# `href="/about"` BLEIBT stehen, obwohl der Knopf einen Dialog oeffnet: ohne
       JavaScript ist der Verweis der Weg, und mittlere Maustaste oder „in neuem
       Reiter oeffnen" sollen weiter funktionieren. Das Skript nimmt den Klick
       ab, nicht den Verweis. #}
    <a href="/about" data-dialog="about-modal" class="nav__icon" id="nav-about" title="{{ t(key="about-this-app") }}" aria-label="{{ t(key="about") }}">
      <span class="nav__icon-glyph" style="--glyph:url('/static/media/about.svg')"></span>
    </a>
    <a href="#" class="nav__icon" id="nav-help" title="{{ t(key="help") }}" aria-label="{{ t(key="help") }}">
      <span class="nav__icon-glyph" style="--glyph:url('/static/media/help.svg')"></span>
    </a>
  </div>
</nav>
]]></asset>
  <asset name="profile.html.tera" type="tera"><![CDATA[{% extends "base" %}
{% block title %}{{ t(key="my-profile") }}{% endblock %}

{# ── Profil-Self-Service ──────────────────────────────────────────────────────
   Fixed system screen — present in every Hearth deployment. Requires a session;
   the daemon route MUST redirect anonymous visits to /login?next=/profile.

   Daemon contract (to be wired on the Rust side — daemon is locked from here):

     GET  /profile
       Context the template expects:
         - username (string)
         - roles    ([string])
         - error    (optional string code:
                       wrong_old | mismatch | too_short | internal)
         - notice   (optional string code: changed)
         - csrf     (optional string — opaque CSRF token; rendered into the form
                     when provided, server may reject without)

     POST /profile/password
       Form fields:  old_password, new_password, confirm_password, csrf
       Behaviour:    verify old_password; reject with error=wrong_old.
                     compare new_password == confirm_password → error=mismatch.
                     enforce minimum length (>= 8) → error=too_short.
                     hash + persist; redirect to /profile?notice=changed.

   Any logged-in user may change their OWN password here; the admin route in
   /admin handles other users (and remains role-gated to admin).
─────────────────────────────────────────────────────────────────────────────#}

{% block extra_css %}
<style>
.profile-grid { display: grid; grid-template-columns: 200px 1fr; gap: 14px 24px; align-items: center; max-width: 540px; }
.profile-grid label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
.profile-grid .val { color: var(--text); font-size: 14px; }
.profile-grid input[type=password] { background: #0f0f1a; border: 1px solid #2a2a3a; border-radius: 4px;
  color: var(--text); font: inherit; font-size: 14px; padding: 9px 11px; width: 100%; }
.profile-grid input[type=password]:focus { outline: none; border-color: var(--accent); }
.profile__roles { display: inline-flex; flex-wrap: wrap; gap: 6px; }
.profile__role { background: #243044; color: #9cc4ff; border: 1px solid #2f5070; border-radius: 4px;
  padding: 2px 8px; font-size: 12px; }
.profile__btn { background: var(--accent); border: none; color: #0f0f1a; font: inherit; font-weight: 600;
  font-size: 13px; padding: 10px 18px; border-radius: 4px; cursor: pointer; }
.profile__btn:hover { filter: brightness(1.12); }
.profile__banner { padding: 10px 12px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
.profile__banner--err { background: rgba(244,67,54,0.10); border: 1px solid #552a2a; color: #ffb3b3; }
.profile__banner--ok  { background: rgba(76,175,80,0.10); border: 1px solid #2a5a2a; color: #b6e6b6; }
</style>
{% endblock %}

{% block content %}
<h1>{{ t(key="my-profile") }}</h1>

{% if error %}
  {% if error == "wrong_old" %}
    <div class="profile__banner profile__banner--err">{{ t(key="password-wrong-current") }}</div>
  {% elif error == "mismatch" %}
    <div class="profile__banner profile__banner--err">{{ t(key="password-mismatch") }}</div>
  {% elif error == "too_short" %}
    <div class="profile__banner profile__banner--err">{{ t(key="password-too-short", min=8) }}</div>
  {% elif error == "internal" %}
    <div class="profile__banner profile__banner--err">{{ t(key="internal-error-retry") }}</div>
  {% else %}
    <div class="profile__banner profile__banner--err">{{ t(key="error-detail", detail=error) }}</div>
  {% endif %}
{% endif %}

{% if notice == "changed" %}
  <div class="profile__banner profile__banner--ok">{{ t(key="password-updated") }}</div>
{% endif %}

<div class="card">
  <div class="card__title">{{ t(key="account") }}</div>
  <div class="profile-grid">
    <label>{{ t(key="username") }}</label>
    <div class="val">{{ username | default(value="—") }}</div>

    <label>{{ t(key="roles") }}</label>
    <div class="val">
      <span class="profile__roles">
        {% if roles %}
          {% for r in roles %}<span class="profile__role">{{ r }}</span>{% endfor %}
        {% else %}
          <span style="color:#666;">— {{ t(key="none") }} —</span>
        {% endif %}
      </span>
    </div>
  </div>
</div>

<div class="card">
  <div class="card__title">{{ t(key="change-password") }}</div>
  <form method="POST" action="/profile/password" autocomplete="off">
    {% if csrf %}<input type="hidden" name="csrf" value="{{ csrf }}">{% endif %}
    <div class="profile-grid">
      <label for="old_password">{{ t(key="current-password") }}</label>
      <input type="password" id="old_password" name="old_password" autocomplete="current-password" required>

      <label for="new_password">{{ t(key="new-password") }}</label>
      <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="8" required>

      <label for="confirm_password">{{ t(key="new-password-repeat") }}</label>
      <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" minlength="8" required>

      <span></span>
      <div>
        <button type="submit" class="profile__btn">{{ t(key="update-password") }}</button>
      </div>
    </div>
  </form>
</div>
{% endblock %}
]]></asset>
  <asset name="screen.html.tera" type="tera"><![CDATA[{# Der GEWOEHNLICHE Screen: Rahmen, Flaeche und Einpassung kommen aus `frame`,
   die Navigationsleiste aus `base`. Hier steht nur noch, was diesen Seitentyp
   ausmacht — seine Laufzeit. Alles Vorherige (Container, viewBox, Hintergrund-
   Rechteck, Flex-Kette) stand hier ALS ABSCHRIFT und ist genau deshalb vom
   Splash abgewichen, als der Rahmen eine Projekteinstellung wurde. #}
{% extends "frame" %}

{% block extra_js %}
<!-- Client runtime served from /static. Studio deploys it per project at publish
     time (gRPC Deploy → STATIC_ASSETS_DIR), NOT at server-install time. Provides
     window.HearthScreen: hides any placed screensaver on load, maximizes it after
     its idle timeout. -->
<script src="/static/js/screen-runtime.js"></script>
<script>
// Binding data (from server)
var bindings = {{ bindings_json | safe }};

// Track current values for toggle logic
var currentValues = {};

// Write a value to the PLC via WebSocket
function writeValue(address, value) {
  if (window._hearth_ws && window._hearth_ws.readyState === 1) {
    window._hearth_ws.send(JSON.stringify({
      type: 'write',
      address: address,
      value: value
    }));
  }
}

// Setup click handlers for writable bindings (toggle on click)
function setupWritables() {
  for (var i = 0; i < bindings.length; i++) {
    var b = bindings[i];
    if (!b.writable) continue;
    var el = document.getElementById(b.element_id);
    if (!el) continue;
    el.style.cursor = 'pointer';
    (function(binding) {
      el.addEventListener('click', function() {
        var cmd = binding.command || '';
        var t = (binding.write_address && binding.write_address.length)
          ? binding.write_address : binding.address;
        if (cmd === 'select') {
          // Kind::Selection (e.g. a mode): a SINGLE write 1. The server-side
          // handshake HOLDS req (the held level IS the selection) and one-hot
          // releases the siblings in the group. A pulse would be wrong here —
          // its trailing 0 would immediately deselect.
          writeValue(t, 1);
        } else if (cmd === 'deselect') {
          // e.g. "AUS": leave the active selection → write 0 to every
          // select-command target (the server releases whichever is held).
          for (var k = 0; k < bindings.length; k++) {
            var sb = bindings[k];
            if (sb.command === 'select' && sb.write_address && sb.write_address.length) {
              writeValue(sb.write_address, 0);
            }
          }
        } else if (cmd === 'pulse' || (binding.write_address && binding.write_address.length)) {
          // Leuchtdrucktaster on a JK-toggle PLC input (xT): emit a momentary
          // PULSE (rising edge 0→1, then release →0) — exactly like a physical
          // momentary button. The PLC ORs phys-%IX || HMI-xT and toggles on the
          // edge, so each click = one edge = one toggle (on/off/on…). A held
          // LEVEL would give only ONE rising edge → turns on but never off.
          writeValue(t, 1);
          setTimeout(function() { writeValue(t, 0); }, 150);
        } else {
          // Direct writable (e.g. a plain bit): level toggle on the displayed state.
          var cur = currentValues[binding.address] || 0;
          writeValue(binding.address, cur > 0 ? 0 : 1);
        }
      });
    })(b);
  }
}
document.addEventListener('DOMContentLoaded', setupWritables);

function onLiveUpdate(values) {
  for (var i = 0; i < bindings.length; i++) {
    var b = bindings[i];
    var lv = values[b.address];
    if (!lv) continue;
    var el = document.getElementById(b.element_id);
    if (!el) continue;
    var val = parseFloat(lv.v);
    currentValues[b.address] = val;

    switch (b.bind_type) {
      case 'display_value':
        // Explicit per-binding format wins (author intent); otherwise fall
        // back to the SHARED type-cast fmtByType(lv.t, …) — the same helper
        // the dashboard uses, so BOOL→0/1, ints→integer, REAL→decimals are
        // consistent everywhere. The typecast lives only on the JS side.
        var text;
        if (b.format) {
          text = b.format.replace(/%\.(\d+)f/, function(_, d) { return val.toFixed(parseInt(d)); });
        } else if (typeof fmtByType === 'function') {
          text = fmtByType(lv.t, val);
        } else {
          text = String(val);
        }
        if (b.unit) text += ' ' + b.unit;
        el.textContent = text;
        break;
      case 'duration':
        // value = TIME int64 NANOSEKUNDEN (atRemaining-Countdown). ns/1e9 = s →
        // m:ss. 0 = aus/fertig (Strich). f64 hält ns exakt bis ~104 Tage.
        var secs = Math.max(0, Math.round(val / 1e9));
        el.textContent = secs > 0
          ? (Math.floor(secs / 60) + ':' + ('0' + (secs % 60)).slice(-2))
          : '–';
        break;
      case 'fill_level':
        var pct = Math.max(0, Math.min(100, (val - b.range_min) / (b.range_max - b.range_min) * 100));
        el.setAttribute('height', pct + '%');
        break;
      case 'state':
        for (var s = 0; s < (b.states || []).length; s++) {
          if (b.states[s].value == String(val) || b.states[s].value == String(Math.round(val))) {
            el.setAttribute('class', b.states[s].class);
            break;
          }
        }
        break;
      case 'rotation':
        el.setAttribute('transform',
          'rotate(' + val + ',' + (b.pivot_x||0) + ',' + (b.pivot_y||0) + ')');
        break;
      case 'flow_animation':
        el.classList.toggle('flow-active', val > 0);
        break;
    }
  }
}

// Schaltzeiten-Editor-Dialog (nur auf dem Schaltzeiten-Screen aktiv).
// Pro Zeile "Setzen" → Dialog mit Std/Min/Dauer-Steppern → OK schreibt die
// Bellows-RETAIN-Vars Zeitplan.J<n>.* (Ventil implizit = Zeile), Abbrechen schließt.
(function() {
  var dlg = document.getElementById('sz_dialog');
  if (!dlg) return;
  var job = null, draft = { h: 0, m: 0, d: 0 };
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function render() {
    document.getElementById('sz_dlg_title').textContent = '{{ t(key="valve") }} ' + job + ' · {{ t(key="switching-time") }}';
    document.getElementById('sz_dlg_h_val').textContent = draft.h;
    document.getElementById('sz_dlg_m_val').textContent = draft.m;
    document.getElementById('sz_dlg_d_val').textContent = draft.d;
  }
  function openJob(n) {
    job = n;
    draft.h = Math.round(currentValues['Zeitplan.J' + n + '.StartH'] || 0);
    draft.m = Math.round(currentValues['Zeitplan.J' + n + '.StartM'] || 0);
    // tDuration = TIME int64 NANOSEKUNDEN → Stepper rechnet in Minuten (ns / 60e9).
    draft.d = Math.round((currentValues['Zeitplan.J' + n + '.Dauer'] || 0) / 6e10);
    render();
    dlg.style.display = 'block';
  }
  function close() { dlg.style.display = 'none'; job = null; }
  for (var n = 1; n <= 24; n++) {
    (function(n) {
      var b = document.getElementById('sz_edit' + n);
      if (b) b.addEventListener('click', function() { openJob(n); });
    })(n);
  }
  // Stepper mit Long-Press-Auto-Repeat: kurzer Klick = 1 Schritt; gedrückt
  // halten zählt nach ~350ms automatisch weiter und beschleunigt (350→40ms).
  function step(id, field, delta, lo, hi) {
    var el = document.getElementById(id);
    if (!el) return;
    var timer = null;
    function doStep() { draft[field] = clamp(draft[field] + delta, lo, hi); render(); }
    function start(e) {
      e.preventDefault();
      doStep();
      var delay = 350;
      function repeat() { doStep(); delay = Math.max(40, delay * 0.85); timer = setTimeout(repeat, delay); }
      timer = setTimeout(repeat, delay);
    }
    function stop() { if (timer) { clearTimeout(timer); timer = null; } }
    el.addEventListener('mousedown', start);
    el.addEventListener('touchstart', start, { passive: false });
    el.addEventListener('mouseup', stop);
    el.addEventListener('mouseleave', stop);
    el.addEventListener('touchend', stop);
    el.addEventListener('touchcancel', stop);
  }
  step('sz_dlg_h_m', 'h', -1, 0, 23);  step('sz_dlg_h_p', 'h', 1, 0, 23);
  step('sz_dlg_m_m', 'm', -1, 0, 59);  step('sz_dlg_m_p', 'm', 1, 0, 59);
  step('sz_dlg_d_m', 'd', -5, 0, 1440); step('sz_dlg_d_p', 'd', 5, 0, 1440);
  document.getElementById('sz_dlg_cancel').addEventListener('click', close);
  document.getElementById('sz_dlg_ok').addEventListener('click', function() {
    if (job == null) return;
    writeValue('Zeitplan.J' + job + '.StartH', draft.h);
    writeValue('Zeitplan.J' + job + '.StartM', draft.m);
    // Minuten → TIME int64 ns. Dauer 0 = Job inaktiv → uValveIdx=0 (sonst Ventil=Zeile),
    // bWeekMask=0x7F (täglich), damit der Job in der PLC anläuft.
    writeValue('Zeitplan.J' + job + '.Dauer', draft.d * 6e10);
    writeValue('Zeitplan.J' + job + '.ValveIdx', draft.d > 0 ? job : 0);
    writeValue('Zeitplan.J' + job + '.WeekMask', 127);
    close();
  });
})();

// Settings: − N + Stepper für Settings.MaxVentile (nur auf dem Einstellungen-
// Screen aktiv). Jeder Klick schreibt SOFORT (Floor 1); die PLC-ST clampt die
// Obergrenze, der Read-Back füllt set_max_val (display_value-Binding).
(function() {
  var minus = document.getElementById('set_max_minus');
  var plus  = document.getElementById('set_max_plus');
  if (!minus || !plus) return;
  function cur() { return Math.round(currentValues['Settings.MaxVentile'] || 0); }
  minus.addEventListener('click', function() { writeValue('Settings.MaxVentile', Math.max(1, cur() - 1)); });
  plus.addEventListener('click',  function() { writeValue('Settings.MaxVentile', cur() + 1); });
})();
</script>
{% endblock %}
]]></asset>
  <asset name="screens.html.tera" type="tera"><![CDATA[{% extends "base" %}
{% block title %}Screens{% endblock %}
{% block content %}
<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 12px;">
  <h1 style="margin: 0;">Screens</h1>
  {% if autostart %}
    <span style="color: #888; font-size: 13px;">
      Autostart: <strong style="color:#ff6b35;">{{ autostart }}</strong>
      {% if is_admin %}
        <form method="post" action="/api/screens/autostart/clear"
              style="display:inline; margin-left: 8px;">
          <button type="submit" class="btn btn--ghost" style="font-size: 12px;">
            Clear
          </button>
        </form>
      {% endif %}
    </span>
  {% else %}
    <span style="color: #555; font-size: 13px;">Autostart: off (landing on Dashboard)</span>
  {% endif %}
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
  {% for s in screens %}
  <div class="card" style="display: flex; flex-direction: column; gap: 8px; {% if s.autostart == 'true' %}border: 1px solid #ff6b35;{% endif %}">
    <a href="/screen/{{ s.slug }}" style="text-decoration: none; color: inherit;">
      <div class="card__title">
        {{ s.group }}
        {% if s.autostart == "true" %}
          <span style="float:right; color:#ff6b35; font-size: 11px; font-weight: 700;">★ AUTOSTART</span>
        {% endif %}
      </div>
      <div style="font-size: 18px; font-weight: 600; color: #ff6b35;">{{ s.name }}</div>
    </a>
    {% if is_admin %}
      {% if s.autostart != "true" %}
        <form method="post" action="/api/screens/{{ s.slug }}/autostart" style="margin: 0;">
          <button type="submit" class="btn btn--ghost" style="width: 100%; font-size: 12px;">
            {{ t(key="set-as-autostart") }}
          </button>
        </form>
      {% endif %}
    {% endif %}
  </div>
  {% endfor %}
  {% if screens | length == 0 %}
  <div class="card" style="grid-column: 1/-1; text-align: center; color: #555; padding: 48px;">
    No screens — add XML files to the project/screens/ directory
  </div>
  {% endif %}
</div>
{% endblock %}
]]></asset>
  <asset name="settings_dialog.html.tera" type="tera"><![CDATA[{# EINSTELLUNGEN — derselbe Satz wie „Projekt → Eigenschaften" in Studio.

   ── Warum 1:1 und nicht „das Wichtigste" ─────────────────────────────────────

   Zwei Oberflächen für dieselbe Sache mit unterschiedlichem Umfang sind
   schlimmer als eine: der Bediener sucht ein Feld, findet es nicht und weiss
   nicht, ob es die Anlage nicht kann oder nur diese Ansicht. Gemessen an der
   alten Seite: sie bot 8 von 21 Themenmerkmalen an — die dreizehn übrigen waren
   unerreichbar, ohne dass etwas darauf hingewiesen hätte.

   Deshalb dieselben vier Reiter wie im Dialog von Studio, in derselben
   Reihenfolge: Anlage · Kontakt · Sicherheit · Sprache. Dazu ein fünfter für
   das Aussehen, den Studio als eigenen Dialog führt.

   ── Was hier GESCHRIEBEN wird, und was nicht ─────────────────────────────────

   Studio schreibt in die QUELLDATEI; die Anlage hat davon eine veröffentlichte
   Kopie. Beides schreiben zu lassen hiesse zwei Schreiber für dieselbe Sache —
   und beim nächsten Veröffentlichen gewönne Studio und überschriebe es wortlos.

   Editierbar ist deshalb, was die Anlage ehrlich besitzt:

     * das AUSSEHEN — es hat mit `POST /api/theme` einen eigenen Weg und wird
       vom Deploy als Beilage geführt, nicht aus der Quelldatei erzeugt
     * die BENUTZER — sie leben ohnehin auf der Anlage (`/api/users`)

   Alles andere steht hier als AUSKUNFT: dieselben Felder, dieselbe Anordnung,
   aber gesperrt und mit dem Hinweis, wo es geändert wird. Ein gesperrtes Feld,
   das sagt warum, ist ehrlicher als ein fehlendes. #}
{% set p = project() %}
{% set pw = p.password_policy | default(value=false) %}
{% set th = theme() %}
{% set tm = theme_meta() %}

<div class="help-modal" id="settings-modal">
  <div class="help-modal__box help-modal__box--wide">
    <div class="help-modal__head">
      <span class="help-modal__title">{{ t(key="settings") }}</span>
      <button class="help-modal__close" data-dialog-close type="button"
              aria-label="{{ t(key="close") }}">×</button>
    </div>

    <div class="dlg-tabs" role="tablist">
      <button class="dlg-tab is-active" data-tab="set-plant"    role="tab">{{ t(key="plant") }}</button>
      <button class="dlg-tab"           data-tab="set-contact"  role="tab">{{ t(key="contact") }}</button>
      <button class="dlg-tab"           data-tab="set-security" role="tab">{{ t(key="security") }}</button>
      <button class="dlg-tab"           data-tab="set-language" role="tab">{{ t(key="language") }}</button>
      <button class="dlg-tab"           data-tab="set-look"     role="tab">{{ t(key="appearance") }}</button>
    </div>

    <div class="help-modal__body">
      {# ── ANLAGE ─────────────────────────────────────────────────────────── #}
      <div class="dlg-page is-active" id="set-plant">
        <dl class="set-grid">
          <dt>{{ t(key="name") }}</dt><dd>{{ p.name | default(value="—") }}</dd>
          <dt>{{ t(key="description") }}</dt><dd>{{ p.description | default(value="—") }}</dd>
          <dt>{{ t(key="panel") }}</dt>
          <dd>{% if p.panel_width %}{{ p.panel_width }} × {{ p.panel_height }}{% else %}—{% endif %}</dd>
          <dt>{{ t(key="surround") }}</dt>
          <dd><span class="set-swatch" style="background: {{ p.surround | default(value='#101014') }}"></span>
              {{ p.surround | default(value="—") }}</dd>
          {% if p.logo %}<dt>{{ t(key="logo") }}</dt>
          <dd><img class="set-logo" src="{{ p.logo }}" alt=""></dd>{% endif %}
        </dl>
        <p class="set-hint">{{ t(key="settings-source-hint") }}</p>
      </div>

      {# ── KONTAKT ────────────────────────────────────────────────────────── #}
      <div class="dlg-page" id="set-contact">
        <dl class="set-grid">
          <dt>{{ t(key="organisation") }}</dt><dd>{{ p.organisation | default(value="—") }}</dd>
          <dt>{{ t(key="author") }}</dt><dd>{{ p.author | default(value="—") }}</dd>
          <dt>{{ t(key="email") }}</dt>
          <dd>{% if p["contact-email"] %}<a href="mailto:{{ p["contact-email"] }}">{{ p["contact-email"] }}</a>{% else %}—{% endif %}</dd>
          <dt>{{ t(key="phone") }}</dt>
          <dd>{% if p["contact-phone"] %}<a href="tel:{{ p["contact-phone"] }}">{{ p["contact-phone"] }}</a>{% else %}—{% endif %}</dd>
          <dt>{{ t(key="address") }}</dt><dd class="about__pre">{{ p.address | default(value="—") }}</dd>
          <dt>{{ t(key="notes") }}</dt><dd class="about__pre">{{ p.notes | default(value="—") }}</dd>
        </dl>
        <p class="set-hint">{{ t(key="settings-source-hint") }}</p>
      </div>

      {# ── SICHERHEIT ─────────────────────────────────────────────────────── #}
      <div class="dlg-page" id="set-security">
        {% if pw %}
        <dl class="set-grid">
          <dt>{{ t(key="pw-min-length") }}</dt><dd>{{ pw.min_length }}</dd>
          <dt>{{ t(key="pw-max-length") }}</dt><dd>{{ pw.max_length }}</dd>
          <dt>{{ t(key="require") }}</dt>
          <dd>
            {% if pw.require_upper %}A {% endif %}{% if pw.require_lower %}a {% endif %}
            {% if pw.require_digit %}1 {% endif %}{% if pw.require_symbol %}! {% endif %}
            {% if not pw.require_upper and not pw.require_lower and not pw.require_digit and not pw.require_symbol %}—{% endif %}
          </dd>
          <dt>{{ t(key="pw-min-classes") }}</dt><dd>{{ pw.min_classes }} / 4</dd>
          <dt>{{ t(key="pw-allow-username") }}</dt>
          <dd>{% if pw.allow_username %}{{ t(key="yes") }}{% else %}{{ t(key="no") }}{% endif %}</dd>
          <dt>{{ t(key="pw-history") }}</dt><dd>{{ pw.history }}</dd>
          <dt>{{ t(key="pw-max-age") }}</dt>
          <dd>{% if pw.max_age_days > 0 %}{{ pw.max_age_days }}{% else %}—{% endif %}</dd>
        </dl>
        {% endif %}
        <p class="set-hint">{{ t(key="settings-source-hint") }}</p>
      </div>

      {# ── SPRACHE ────────────────────────────────────────────────────────── #}
      <div class="dlg-page" id="set-language">
        <dl class="set-grid">
          <dt>{{ t(key="language") }}</dt><dd>{{ lang() }}</dd>
        </dl>
        <p class="set-hint">{{ t(key="settings-source-hint") }}</p>
      </div>

      {# ── AUSSEHEN — hier wird WIRKLICH geschrieben ───────────────────────
         Der Katalog kommt aus `theme_meta()`, also aus FTheme::keys(). Eine
         Liste in dieser Vorlage wäre die zweite Aufzählung, und genau die ist
         schon einmal bei acht von einundzwanzig stehengeblieben. #}
      <div class="dlg-page" id="set-look">
        <div id="theme-msg" class="profile__banner" style="display:none;"></div>
        <div class="set-theme">
          {% if tm %}{% for m in tm %}
          <label class="set-theme__row" for="thv-{{ m.key }}">
            <span class="set-theme__label">{{ m.label }}</span>
            {% if m.is_color %}
            {# Der Farbknopf öffnet den Wählerdialog — kein `<input type=color>`:
               das öffnet den Wähler des Betriebssystems, und auf einem
               Bedienpanel im Vollbild gibt es den nicht. #}
            <button type="button" class="set-swatch set-swatch--btn"
                    data-colour-for="thv-{{ m.key }}"
                    style="background: {{ th[m.key] | default(value='#000000') }}"></button>
            {% endif %}
            <input class="set-theme__val" id="thv-{{ m.key }}" data-theme-key="{{ m.key }}"
                   value="{{ th[m.key] | default(value='') }}">
          </label>
          {% endfor %}{% endif %}
        </div>
        <button class="nav__btn nav__btn--login" id="theme-save" type="button">
          {{ t(key="save") }}
        </button>
      </div>
    </div>
  </div>
</div>

{# ── DER FARBWÄHLER — ein eigener Dialog ──────────────────────────────────────

   Nicht `<input type="color">`: das öffnet den Wähler des BETRIEBSSYSTEMS. Auf
   einem Bedienpanel im Vollbild-Kiosk gibt es keinen, und auf einem
   Touch-Gerät ohne Fenstermanager erscheint gar nichts — der Knopf täte dann
   nichts, ohne Fehlermeldung.

   Stattdessen: ein Dialog wie die anderen, über denselben Mechanismus. Er
   trägt die Farben, die das Thema SCHON benutzt — wer eine Anlage einfärbt,
   greift meist eine vorhandene Nuance wieder auf, statt eine neue zu erfinden. #}
<div class="help-modal" id="colour-modal">
  <div class="help-modal__box help-modal__box--narrow">
    <div class="help-modal__head">
      <span class="help-modal__title" id="colour-title">{{ t(key="colour") }}</span>
      <button class="help-modal__close" data-dialog-close type="button"
              aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body">
      <div class="colour-preview" id="colour-preview"></div>
      <label for="colour-hex">{{ t(key="colour-value") }}</label>
      <input id="colour-hex" class="set-theme__val" autocomplete="off" spellcheck="false">
      <div class="colour-palette" id="colour-palette"></div>
      <button class="nav__btn nav__btn--login" id="colour-apply" type="button">
        {{ t(key="apply") }}
      </button>
    </div>
  </div>
</div>
]]></asset>
  <asset name="splash.html.tera" type="tera"><![CDATA[{# Der SPLASH — der Eingang der Anlage.

   Rahmen, Panel, Flaeche und Einpassung kommen aus `frame`; hier steht nur,
   was diesen Seitentyp ausmacht: KEINE Navigationsleiste, und Logo samt
   Angaben statt Bedienbildern.

   Die Leiste wird per BLOCK weggelassen, nicht per CSS versteckt — das ist der
   Unterschied zwischen „sieht so aus" und „ist so": versteckt laege sie
   weiterhin im DOM, im Tab-Weg der Tastatur und im Vorlesegeraet. Wer hier
   steht, hat sich noch nicht angemeldet und soll auch nichts erreichen koennen.

   ── ALLES IM SCREEN-KOORDINATENSYSTEM, nichts in vw/vh ──────────────────────

   Die erste Fassung rechnete in FENSTEREINHEITEN: das Logo `max-width: 45vw`,
   die Angaben `position: fixed; bottom: 0`. Damit hing die Aufteilung am
   Fenster statt am Screen — in einem flachen Fenster schrumpfte das Logo auf
   nichts, waehrend die Angaben ihre Hoehe in Pixeln behielten. Beide
   ueberlagerten sich, und der Screen wirkte winzig.

   Im `screen_chrome`-Block rechnet alles in Screen-Einheiten und skaliert
   deshalb mit: die Seite sieht bei jeder Aufloesung gleich aus, nur kleiner. #}
{% extends "frame" %}

{% block navbar %}{% endblock %}

{% block frame_extra_css %}
<style>
  /* Ein Eingang hat keinen Rand und keine Bildlaufleiste. */
  html, body { height: 100%; overflow: hidden; }

  /* ── DIE ANGABEN ALS TEXT, NICHT ALS ZEICHNUNG ────────────────────────────
     Sie standen als `<text>` im SVG — sichtbar, aber ohne Aussage: ein
     Vorlesegeraet fand keine Ueberschrift, eine Suche keinen Namen, und der
     Bediener konnte eine Telefonnummer nicht markieren. Jetzt HTML in der
     Ebene, die schon da ist (`screen-layer`), und damit `h1` fuer den Namen
     und `strong` fuer das, was man nachts braucht.

     Die Ebene rechnet in SCREEN-Einheiten und wird als Ganzes skaliert — px
     hier sind Entwurfseinheiten, keine Bildschirmpixel. Deshalb duerfen die
     Groessen aus H kommen wie vorher im SVG. */
  .splash-angaben {
    text-align: center;
    pointer-events: none;             /* Text faengt keine Beruehrung ab */
    font-size: {{ screen.viewport_height * 0.024 }}px;
    line-height: 1.33;
  }
  .splash-angaben h1 {
    margin: 0 0 {{ screen.viewport_height * 0.012 }}px;
    font-size: {{ screen.viewport_height * 0.0324 }}px;
    font-weight: 700;
  }
  /* Blasser als der Name — durch DECKKRAFT, damit es auf hellem wie auf
     dunklem Grund in dieselbe Richtung geht. */
  .splash-angaben address {
    font-style: normal;               /* `address` kursiviert von sich aus */
    opacity: 0.62;
  }
  .splash-angaben .splash-was { margin: 0; opacity: 0.62; }
  /* Die Kontaktangaben tragen Gewicht — sie sind der Grund, warum diese Seite
     ohne Anmeldung erreichbar ist. */
  .splash-angaben strong { font-weight: 600; opacity: 0.84; }
</style>
{% endblock %}

{% block screen_chrome %}
  {% set W = screen.viewport_width %}
  {% set H = screen.viewport_height %}
  {% set fs = H * 0.024 %}
  {% set lh = H * 0.032 %}

  {# DAS LOGO in der oberen Haelfte. Es IST die Aussage der Seite, nicht ihr
     Beiwerk. Feste Bahn, damit es den Angaben nie ins Gehege kommt —
     `preserveAspectRatio` haelt sein Seitenverhaeltnis darin. #}
  {# NACH OBEN AUSGERICHTET, nicht in die Flaeche gemittelt.
     Logo und Angaben sind EIN Block: das Logo haelt eine feste Bahn von 4 %
     bis 40 %, die Angaben setzen bei 44 % an. Beide rechnen aus derselben
     Hoehe, damit zwischen ihnen kein Spalt entsteht, der mit dem
     Seitenverhaeltnis wandert. `preserveAspectRatio` haelt das Bild in seiner
     Bahn — es waechst nicht in die Angaben hinein. #}
  {% if project_logo %}
  <image href="{{ project_logo }}" x="{{ W * 0.275 }}" y="{{ H * 0.04 }}"
         width="{{ W * 0.45 }}" height="{{ H * 0.36 }}"
         preserveAspectRatio="xMidYMid meet"/>
  {% endif %}

{% endblock %}

{# DIE ANGABEN in der unteren Haelfte — HTML, nicht Zeichnung.

   Nicht Schmuck: der Splash ist die einzige Seite, die jemand OHNE Anmeldung
   sieht. Wer nachts vor einer stehenden Anlage steht, findet hier, wen er
   anruft — statt auf einem Zettel im Schaltschrank, der nach fuenf Jahren
   nicht mehr da ist. Deshalb `strong`: die Nummer ist die Aussage, nicht die
   Beschriftung daneben.

   Ein leeres Feld hinterlaesst keine Luecke, weil jede Zeile ihre eigene ist.
   Eine Anlage ohne hinterlegte Telefonnummer soll nicht so aussehen, als
   fehle die Nummer nur in der Anzeige.

   Die NOTIZEN stehen bewusst NICHT hier: ihre Laenge ist unbegrenzt, und ein
   Splash ist ein Bild, kein Handbuch. Sie reisen in der Datei mit. #}
{% block screen_layer %}
  <div class="splash-angaben"
       style="left:0; top:{{ screen.viewport_height * 0.44 }}px;
              width:{{ screen.viewport_width }}px; color:{{ screen_ink }};">
    {% if project_name %}<h1>{{ project_name }}</h1>{% endif %}
    {% if project_description %}<p class="splash-was">{{ project_description }}</p>{% endif %}
    <address>
      {% if project_organisation %}<div>{{ project_organisation }}</div>{% endif %}
      {% if project_author %}<div>{{ project_author }}</div>{% endif %}
      {% if project_email %}<div><strong>{{ project_email }}</strong></div>{% endif %}
      {% if project_phone %}<div><strong>{{ project_phone }}</strong></div>{% endif %}
      {# Die Anschrift MEHRZEILIG, wie sie eingegeben wurde: sie wird abgetippt. #}
      {% if project_address %}{% for zeile in project_address | split(pat="
") %}<div><strong>{{ zeile }}</strong></div>{% endfor %}{% endif %}
    </address>
  </div>
{% endblock %}

{% block extra_js %}
{# Dieselbe Laufzeit wie beim gewoehnlichen Screen: ein Splash darf leben — ein
   Fortschrittsbalken, ein Zustandslaempchen, ein Zeitablauf. Er ist ein Screen,
   nur ohne Beiwerk. #}
<script>window.HEARTH_BINDINGS = {{ bindings_json | safe }};</script>
<script type="module" src="/static/js/screen-runtime.js"></script>
{# ── DER EINGANG IST KEIN AUFENTHALT ─────────────────────────────────────────

   Hier stand ein eigener Sprung: `/screen/dashboard` nach 3 Sekunden, fest im
   Quelltext. Der Rahmen kann dasselbe laengst aus der Datei — `timeout` und
   `redirect-to` am `<screen>`, im Inspektor als "Weiterleiten nach/zu".

   Damit gab es ZWEI Weiterleitungen auf derselben Seite, und die feste gewann,
   weil sie kuerzer war. Wer die Eigenschaft im Inspektor stellte, sah sie
   wirkungslos verpuffen und suchte den Fehler bei sich.

   Der feste Sprung ist gefallen. Die Wache gegen offene Dialoge ist in den
   Rahmen gewandert, wo sie jeder Seite mit Ruecksprung zugutekommt. #}
{% endblock %}
]]></asset>
  <asset name="trends.html.tera" type="tera"><![CDATA[{% extends "base" %}
{% block title %}Trends{% endblock %}
{% block content %}
<h1>Trends</h1>

{% for t in trends %}
<div class="card">
  <div class="card__title">{{ t.name }}</div>
  <canvas id="chart-{{ t.id }}" width="800" height="200" style="width:100%;background:#111;border-radius:4px;"></canvas>
  <div style="margin-top:8px;font-size:11px;color:#555;">
    {% for pen in t.pens %}
    <span style="color:{{ pen.color }};">&#9632;</span> {{ pen.label }} ({{ pen.unit }})
    {% endfor %}
  </div>
</div>
{% endfor %}

{% if trends | length == 0 %}
<div class="card" style="text-align: center; color: #555; padding: 48px;">
  No trends configured — add XML files to project/trends/
</div>
{% endif %}
{% endblock %}
]]></asset>
  <asset name="hearth-base.js" type="js"><![CDATA[// Hearth — Verhalten der ausgelieferten Seiten.
//
// HERAUSGELOEST aus base.html.tera, wo knapp 300 Zeilen JavaScript zwischen
// Markup standen. Als Datei laesst es sich lesen, vergleichen und je Projekt
// ersetzen — und die Vorlage ist wieder das, was sie sein soll: Struktur.
//
// ACHTUNG bei kuenftigen Aenderungen: hier darf NICHTS stehen, das aus
// Tera-Daten entsteht ({{ ... }}). Was aus Daten kommt, gehoert in die Vorlage;
// eine statische Datei wird nicht gerendert.

// Mark the active project-navigation entry by current path.
(function() {
  try {
    var links = document.querySelectorAll('.nav__link[href]');
    for (var i = 0; i < links.length; i++) {
      if (links[i].getAttribute('href') === location.pathname) {
        links[i].classList.add('nav__link--active');
      }
    }
  } catch (e) {}
})();

// Navigation variable entries (e.g. mode select) write to the PLC over the
// live socket. select/direct → write 1 (the server one-hot handshake releases
// siblings); pulse → 1 then 0; deselect → 0.
(function() {
  var vars = document.querySelectorAll('.nav__var[data-var]');
  for (var i = 0; i < vars.length; i++) {
    (function(a) {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        var addr = a.getAttribute('data-var');
        var cmd = a.getAttribute('data-cmd') || 'select';
        if (typeof window.writeValue !== 'function') return;
        if (cmd === 'pulse') { window.writeValue(addr, 1); setTimeout(function() { window.writeValue(addr, 0); }, 150); }
        else if (cmd === 'deselect') { window.writeValue(addr, 0); }
        else { window.writeValue(addr, 1); }
      });
    })(vars[i]);
  }
})();

// Umschalter der Navigationsleiste auf schmalen Anzeigen ("Hamburger").
//
// SICHTBAR MACHT IHN DIE CSS, nicht dieses Skript — hier steht nur das
// Auf und Zu. Wer die Schwelle auch im Skript fuehrte, haette sie zweimal, und
// zwei Aufzaehlungen derselben Sache laufen auseinander; die Schwelle steht
// einmal, in hearth.css.
//
// aria-expanded wird MITGESCHRIEBEN: es traegt den Zustand fuer eine
// Sprachausgabe und ist zugleich das, woran die CSS den Umschalter zum Kreuz
// macht. Ein Zustand, zwei Leser.
(function() {
  var burger = document.getElementById('nav-burger');
  var links = document.getElementById('nav-links');
  if (!burger || !links) return;

  function setzen(offen) {
    links.classList.toggle('nav__links--offen', offen);
    burger.setAttribute('aria-expanded', offen ? 'true' : 'false');
  }
  burger.addEventListener('click', function(e) {
    e.stopPropagation();
    setzen(!links.classList.contains('nav__links--offen'));
  });
  // Ein Klick daneben schliesst — auf einem Panel ohne Tastatur ist das der
  // einzige Weg zurueck, wenn man danebengegriffen hat.
  document.addEventListener('click', function(e) {
    if (!links.contains(e.target)) setzen(false);
  });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') setzen(false); });
  // Wird das Fenster breit, gilt wieder die offene Leiste. Ohne das bliebe die
  // Klasse haengen und die Liste stuende nach dem Drehen eines Tablets als
  // Streifen ueber dem Bild.
  window.addEventListener('resize', function() {
    if (window.innerWidth > 900) setzen(false);
  });
})();

// Profile menu: click-toggle (touch panels have no hover) + close on outside click.
(function() {
  var btn = document.getElementById('nav-profile-btn');
  var menu = document.querySelector('.nav__profile-menu');
  if (!btn || !menu) return;
  btn.addEventListener('click', function(e) { e.stopPropagation(); menu.classList.toggle('open'); });
  document.addEventListener('click', function() { menu.classList.remove('open'); });
})();

// Help button: per-screen help (Studio-provided) is on the backlog — for now a
// screen may register window.showHelp(); otherwise an honest placeholder.
(function() {
  var h = document.getElementById('nav-help');
  var modal = document.getElementById('help-modal');
  var body = document.getElementById('help-body');
  if (!h || !modal) return;
  // Die Hilfe wird ABGEHOLT, nicht mitgeliefert.
  //
  // Sie stand einmal als `window.screenHelp` im Markup. Das reiste in jeder
  // Seite mit, auch wenn niemand den Knopf drueckt, und es war der Stand des
  // SEITENAUFBAUS: wer die Sprache umschaltet, bekam die andere erst nach dem
  // naechsten Laden.
  //
  // Der Slug steht im Pfad (`/screen/<slug>`) — kein zweites Feld dafuer. Auf
  // einer Seite ohne diesen Pfad (Alarme, Trends) gibt es keine Screenhilfe,
  // und das sagt der Dialog dann auch.
  //
  // ALS TEXT, NICHT ALS MARKUP: geschrieben wird er in einem Klartextfeld im
  // Inspektor, und ein `<` in der Prosa („Druck < 3 bar") verschluckte sonst
  // den Rest des Absatzes. Zeilenumbrueche bleiben ueber `pre-wrap` stehen.
  function openHelp() {
  body.style.whiteSpace = 'pre-wrap';
  body.textContent = '…';
  window.HearthDialog.open('help-modal');

  var m = /^\/screen\/([^\/?#]+)/.exec(location.pathname);
  if (!m) { body.textContent = 'Für diese Seite gibt es keine Screen-Hilfe.'; return; }
  fetch('/api/help/' + encodeURIComponent(m[1]), { credentials: 'same-origin' })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(d) {
        body.textContent = (d && d.text)
          ? d.text
          : 'Für diesen Screen ist noch keine Hilfe hinterlegt.';
      })
      .catch(function() {
        // Ein Fehlschlag ist etwas ANDERES als „keine Hilfe hinterlegt" — wer
        // das gleichsetzt, sucht den Text im Projekt statt am Netz.
        body.textContent = 'Die Hilfe konnte nicht geladen werden.';
      });
  }
  window.showHelp = openHelp;
  h.addEventListener('click', function(e) { e.preventDefault(); openHelp(); });
  // Schliessen, Hintergrundklick und Escape kommen aus dem gemeinsamen
  // Mechanismus — hier bleibt nur, WAS in den Dialog hineingeschrieben wird.
})();

// ── SPRACHWAHL — aufklappen, und danach BLEIBEN ──────────────────────────────
//
// Der Verweis traegt `?next=` mit dem aktuellen Ort, damit der Server nach dem
// Wechsel hierher zurueckfuehrt. Ohne Skript springt der `Referer` ein — beides
// wird serverseitig gefiltert, ein fremdes Ziel waere eine offene Weiterleitung.
//
// Vorher sprang der Bediener nach jedem Sprachwechsel auf den Splash und musste
// sich neu hinnavigieren.
(function () {
  var knopf = document.getElementById('nav-lang-btn');
  var box = document.getElementById('nav-lang');
  if (knopf && box) {
    // `.open` an das MENUE, nicht an den Behaelter: die Regel in hearth.css
    // heisst `.nav__lang-menu.open`. Am Behaelter gesetzt tat sie nichts — und
    // nichts zu tun ist der Fehler, den man am laengsten sucht.
    var menue = box.querySelector('.nav__lang-menu');
    knopf.addEventListener('click', function (e) {
    e.stopPropagation();
    if (menue) menue.classList.toggle('open');
    });
    document.addEventListener('click', function () {
    if (menue) menue.classList.remove('open');
    });
  }
  document.querySelectorAll('[data-lang-link]').forEach(function (a) {
    var trenner = a.getAttribute('href').indexOf('?') >= 0 ? '&' : '?';
    a.setAttribute('href', a.getAttribute('href') + trenner + 'next='
                   + encodeURIComponent(window.location.pathname + window.location.search));
  });
})();

// ── EIN MECHANISMUS FÜR ALLE DIALOGE ─────────────────────────────────────────
//
// Hier standen drei fast gleiche Blöcke — Anmelden, Über, Profil. Jeder mit
// eigenem Öffnen, eigenem Schließen, eigenem Escape-Halter. Beim vierten Dialog
// wäre es der vierte gewesen, und spätestens dann hätte sich einer anders
// verhalten als die anderen; genau so entstehen Oberflächen, in denen manche
// Dialoge auf Escape hören und manche nicht.
//
// ── Wie es benutzt wird ──────────────────────────────────────────────────────
//
//   <a href="/login" data-dialog="login-modal">…</a>   ← öffnet, Verweis bleibt
//   <button data-dialog-close>×</button>               ← schließt den eigenen
//   window.HearthDialog.open('profile-modal', {force: true})
//
// Der VERWEIS bleibt im Markup und wird nur abgefangen: ohne JavaScript ist er
// der Weg, und Strg-/Mittelklick sollen weiter einen neuen Reiter öffnen.
//
// `force` macht einen Dialog unabweisbar — kein Kreuz, kein Escape, kein Klick
// daneben. Für den erzwungenen Kennwortwechsel: ein Zwang, den man wegklicken
// kann, ist keiner.
// ── DER KATALOGTEXT — EINE Stelle, beide Closures ───────────────────────────
//
// `t()` stand INNERHALB des Rueckmeldungs-Blocks und war damit fuer den
// Dialogblock daneben unsichtbar. Gemessen: `regelnBauen()` warf beim ersten
// `t(...)` eine ReferenceError, brach mitten in der Schleife ab und hinterliess
// zwei von vier Regelzeilen — ohne dass etwas meldete, weil ein `.catch` daneben
// den Fehler schluckte.
//
// Zwei Closures, eine Funktion: sie gehoert nach oben, nicht zweimal hinein.
  // Der Katalogtext, mit eingesetzten Zahlen.
//
// `{ $need }` wird schlicht ersetzt — das reicht fuer die Texte, die der
// Server herausgibt, und fuer mehr nicht: Auswahlausdruecke (`{ $n -> … }`)
// schickt er absichtlich NICHT mit, weil sie nach Sprachregeln waehlen, die
// nur Fluent kennt. Wer einen dazuschreibt, faellt automatisch auf den
// Serverweg zurueck.
//
// Fehlt der Schluessel, kommt der SCHLUESSEL — sichtbar falsch statt still
// falsch.
function t(schluessel, args) {
  var k = (window.HEARTH_TEXTS || {})[schluessel];
  if (!k) return schluessel;
  if (!args) return k;
  return k.replace(/\{\s*\$([A-Za-z0-9_-]+)\s*\}/g, function (ganz, name) {
    return Object.prototype.hasOwnProperty.call(args, name) ? String(args[name]) : ganz;
  });
}



// ── DIE MELDUNG IM PROFILDIALOG — auch sie gehoert beiden Closures ──────────
//
// `sage()` stand wie `t()` im Rueckmeldungs-Block und war fuer den Dialogblock
// unsichtbar. Zweite Auflage desselben Fehlers, an derselben Naht: der
// Absende-Handler rief sie, fand sie nicht, und der `.catch` daneben rief sie
// AUCH — deshalb kam nicht einmal die Fehlermeldung an.
//
// Die Lehre steht hier, damit die dritte Auflage ausbleibt: was zwei Bloecke
// brauchen, gehoert vor beide. Ein Closure ist eine Grenze, keine Kulisse.
// ── DER KONTAKTABSCHNITT, EIN- UND AUSGEBLENDET ────────────────────────────
//
// Vor beiden Bloecken, nicht in einem: der Zwang wird beim Aufziehen gesetzt
// und beim erfolgreichen Wechsel zurueckgenommen — zwei Closures, ein Helfer.
// `t()` und `sage()` standen aus demselben Grund schon zweimal am falschen
// Ort; die dritte Auflage bleibt aus.
//
// Die UEBERSCHRIFT gehoert dazu. Sie steht als Geschwister vor dem Abschnitt,
// und eine „Kontaktdaten"-Zeile ueber nichts ist die Leiche mit Namen.
function kontaktZeigen(an) {
  var k = document.getElementById('profile-kontakt');
  if (!k) return;
  k.style.display = an ? '' : 'none';
  var t = document.getElementById('profile-kontakt-titel');
  if (t) t.style.display = an ? '' : 'none';
}

function sage(text, schlecht) {
  var meldung = document.getElementById('profile-msg');
  if (!meldung) return;
  meldung.textContent = text;
  meldung.className = 'profile__banner profile__banner--' + (schlecht ? 'err' : 'ok');
  meldung.style.display = '';
}

(function () {
  var erzwungen = {};

  function open(id, opt) {
    var d = document.getElementById(id);
    if (!d) return;
    erzwungen[id] = !!(opt && opt.force);
    d.classList.add('open');
    // Der Profildialog holt seine Kontaktdaten beim OEFFNEN — siehe unten.
    if (id === 'profile-modal' && typeof kontaktEinlesen === 'function') kontaktEinlesen();
    if (erzwungen[id]) d.classList.add('forced');
    // Den Fokus in den Dialog setzen: wer ihn aufzieht, will darin tippen, und
    // ein Vorlesegerät muss erfahren, dass sich der Ort geändert hat.
    var erstes = d.querySelector('input:not([type=hidden]), select, textarea, button');
    if (erstes) erstes.focus();
  }

  function close(id) {
    if (erzwungen[id]) return;              // unabweisbar
    var d = document.getElementById(id);
    if (d) d.classList.remove('open');
  }

  // Öffnen: ein Klick auf alles mit `data-dialog`.
  document.addEventListener('click', function (e) {
    var ausloeser = e.target.closest && e.target.closest('[data-dialog]');
    if (ausloeser) {
    // Sondertasten NICHT abfangen: wer mit Strg oder mittlerer Taste klickt,
    // will einen neuen Reiter und keinen Dialog.
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    open(ausloeser.getAttribute('data-dialog'),
           { force: ausloeser.hasAttribute('data-dialog-force') });
    return;
    }
    // Schließen: Kreuz, oder der Klick auf den Hintergrund daneben.
    var kreuz = e.target.closest && e.target.closest('[data-dialog-close]');
    if (kreuz) {
    var box = kreuz.closest('.help-modal');
    if (box) close(box.id);
    return;
    }
    if (e.target.classList && e.target.classList.contains('help-modal')) close(e.target.id);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var offen = document.querySelector('.help-modal.open');
    if (offen) close(offen.id);
  });

  window.HearthDialog = { open: open, close: close };

  // ── DAS PROFIL: KONTAKTDATEN LESEN UND SCHREIBEN ─────────────────────────
  //
  // Ueber `/api/profile`, nicht ueber `/api/me`: `me` beantwortet „wer bin ich
  // und was darf ich" fuer die Leiste — eine Auskunft, die JEDE Seite beim
  // Laden holt. Drei Felder mitzuschicken, die nur ein Dialog braucht, waere
  // Fracht auf jedem Seitenaufruf.
  //
  // GELESEN WIRD BEIM OEFFNEN, nicht beim Laden der Seite: wer den Dialog nie
  // aufzieht, soll die Anfrage nicht bezahlen. Und wer ihn zum zweiten Mal
  // aufzieht, bekommt den JETZIGEN Stand — nicht den von vorhin.
  var kontaktFelder = { email: 'pf-email', phone_landline: 'pf-landline', phone_mobile: 'pf-mobile' };

  function kontaktEinlesen() {
    if (!document.getElementById('pf-email')) return;
    fetch('/api/profile', { credentials: 'same-origin' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
        if (!d) return;
        for (var k in kontaktFelder) {
          var el = document.getElementById(kontaktFelder[k]);
          if (el) el.value = d[k] || '';
        }
        // Die Richtlinie kommt im selben Ruf mit — ein zweiter waere ein
        // zweiter Ort, an dem „was gilt hier" beantwortet wird.
        if (d.policy) { richtlinie = d.policy; regelnBauen(); }
    })
    // NICHT STILL SCHLUCKEN. Hier stand ein leeres `catch` mit dem Vermerk
    // „offline: die Felder bleiben leer, das ist ehrlich". Ehrlich waere es
    // nur fuer einen NETZfehler gewesen — es fing aber auch jeden Fehler aus
    // dem `then`, und genau dort warf `regelnBauen()` eine ReferenceError.
    // Zwei von vier Regelzeilen entstanden, der Rest fehlte, und niemand
    // erfuhr warum. Ein Fehler, der niemandem auffaellt, ist der teuerste.
    .catch(function (e) {
        console.error('[hearth] Profil konnte nicht gelesen werden:', e);
        kontaktHinweis(t('save-failed'), true);
    });
  }

  function kontaktHinweis(text, schlecht) {
    var h = document.getElementById('pf-hinweis');
    if (!h) return;
    h.textContent = text;
    h.className = 'profile__hinweis' + (schlecht ? ' profile__hinweis--err' : ' profile__hinweis--ok');
  }

  // ── DIE KENNWORTREGELN, BEI JEDEM TASTENDRUCK ────────────────────────────
  //
  // Die Richtlinie kommt ueber `/api/profile` MIT — der Browser hat sie nicht,
  // er rechnet sie nach. Das ist der Unterschied zwischen einer Hilfe und einer
  // zweiten Wahrheit: die Zahlen stammen vom Server, und ob ein Kennwort
  // durchgeht, entscheidet er beim Speichern trotzdem selbst.
  //
  // WAS DER BROWSER NICHT PRUEFEN KANN, faerbt er auch nicht gruen: die
  // Sperrliste kennt er nicht, und die frueheren Kennwoerter sind Hashes. Diese
  // Regeln stehen neutral da, mit dem Vermerk, dass sie beim Speichern geprueft
  // werden. Ein Haken, der nichts geprueft hat, ist schlimmer als kein Haken.
  var richtlinie = null;

  function zeichenklassen(pw) {
    return {
    upper: /\p{Lu}/u.test(pw),
    lower: /\p{Ll}/u.test(pw),
    digit: /\p{Nd}/u.test(pw),
    symbol: /[^\p{L}\p{Nd}]/u.test(pw)
    };
  }

  // ZEICHEN zaehlen, nicht Bytes — genau wie der Server. `"Müller".length` ist
  // in JS zwar 6, aber ein Emoji zaehlt als 2. `[...pw].length` zaehlt
  // Codepunkte und trifft damit dieselbe Zahl.
  function zeichenzahl(pw) { return Array.from(pw).length; }

  function regelnBauen() {
    var ul = document.getElementById('pw-regeln');
    if (!ul || !richtlinie) return;
    var p = richtlinie, r = [];
    if (p.min_length > 0) r.push({ id: 'len', pruefbar: true });
    if (p.require_upper)  r.push({ id: 'upper', pruefbar: true, key: 'pw-needs-upper' });
    if (p.require_lower)  r.push({ id: 'lower', pruefbar: true, key: 'pw-needs-lower' });
    if (p.require_digit)  r.push({ id: 'digit', pruefbar: true, key: 'pw-needs-digit' });
    if (p.require_symbol) r.push({ id: 'symbol', pruefbar: true, key: 'pw-needs-symbol' });
    if (p.min_classes > 1) r.push({ id: 'classes', pruefbar: true });
    if (!p.allow_username) r.push({ id: 'username', pruefbar: true, key: 'pw-contains-username' });
    // ── PRUEFBAR, UND ZWAR ZUM TEIL ─────────────────────────────────────
    //
    // Sie stand als `pruefbar: false` da und blieb damit fuer immer grau —
    // eine Zeile, die nie erfuellt werden kann, waehrend daneben drei Haken
    // stehen. Wer alles richtig macht, sieht trotzdem etwas Offenes.
    //
    // Die frueheren Kennwoerter sind Hashes; die kann der Browser nicht
    // pruefen. EINES der gesperrten kennt er aber: das AKTUELLE, das der
    // Bediener eine Zeile darueber selbst eingetippt hat — und seit dem
    // 25.08.2026 zaehlt es mit (`std::iter::once(user.pw_hash)`). Genau der
    // Fall, der in der Praxis fast immer gemeint ist: dasselbe noch einmal.
    //
    // Der Haken sagt also, was er geprueft hat, und nicht mehr: nicht das
    // aktuelle. Die uebrigen prueft der Server beim Speichern und meldet sie
    // dann einzeln.
    if (p.history > 0) r.push({ id: 'reused', pruefbar: true });
    ul.innerHTML = '';
    r.forEach(function (regel) {
    var li = document.createElement('li');
    li.dataset.regel = regel.id;
    li.dataset.pruefbar = regel.pruefbar ? '1' : '0';
    if (regel.key) li.textContent = t(regel.key);
    ul.appendChild(li);
    });
    regelnPruefen();
  }

  function regelnPruefen() {
    var ul = document.getElementById('pw-regeln');
    var feld = document.getElementById('pw-new');
    if (!ul || !feld || !richtlinie) return;
    var pw = feld.value, p = richtlinie;
    var altFeld = document.getElementById('pw-old');
    var alt = altFeld ? altFeld.value : '';
    var n = zeichenzahl(pw), k = zeichenklassen(pw);
    var klassen = (k.upper ? 1 : 0) + (k.lower ? 1 : 0) + (k.digit ? 1 : 0) + (k.symbol ? 1 : 0);
    var name = (document.getElementById('nav-user-name') || {}).textContent || '';

    Array.prototype.forEach.call(ul.children, function (li) {
    var id = li.dataset.regel, ok = null;
    switch (id) {
        case 'len':
          // DIE ECHTE ZAEHLUNG. Sie stand als `got=0` fest im Vorlagentext —
          // die Zeile behauptete zu zeigen, was getippt wurde, und sagte immer
          // null. Jetzt zaehlt sie wirklich.
          li.textContent = t('pw-too-short', { need: p.min_length, got: n });
          ok = n >= p.min_length;
          break;
        case 'upper':  ok = k.upper; break;
        case 'lower':  ok = k.lower; break;
        case 'digit':  ok = k.digit; break;
        case 'symbol': ok = k.symbol; break;
        case 'classes':
          li.textContent = t('pw-needs-classes', { need: p.min_classes, got: klassen });
          ok = klassen >= p.min_classes;
          break;
        case 'username':
          ok = !name || pw.toLowerCase().indexOf(name.toLowerCase()) === -1;
          break;
        case 'reused':
          // Die FORDERUNG, nicht der Verstoss. `pw-reused` sagt „eines der
          // letzten fuenf" — das ist die Meldung des Servers, wenn es eines
          // IST, und als Regelzeile war sie eine Behauptung ueber etwas, das
          // gerade nicht zutrifft.
          li.textContent = t('pw-not-reused', { last: p.history });
          li.title = t('checked-on-save');
          ok = !alt || pw !== alt;
          break;
    }
    if (li.dataset.pruefbar !== '1' || !pw) {
        li.className = 'pw-regel';
    } else {
        li.className = 'pw-regel ' + (ok ? 'pw-regel--ok' : 'pw-regel--offen');
    }
    });
  }

  document.addEventListener('input', function (e) {
    // `pw-old` GEHOERT DAZU: die Wiederverwendungsregel vergleicht gegen ihn.
    // Ohne ihn bliebe die Zeile stehen, wenn jemand zuerst das neue und dann
    // das aktuelle Kennwort tippt — und die Reihenfolge steht niemandem frei
    // vorzuschreiben.
    if (e.target && (e.target.id === 'pw-new' || e.target.id === 'pw-new2'
                     || e.target.id === 'pw-old')) regelnPruefen();
  });

  // ── ABSENDEN UEBER DIE API ───────────────────────────────────────────────
  //
  // Dasselbe Formular, abgefangen: ohne JavaScript geht es weiter den alten
  // Weg (`/profile/password` mit Weiterleitung). Ein Bediener mit
  // abgeschaltetem JavaScript soll sein Kennwort aendern koennen.
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (!f || f.id !== 'pf-pwform') return;
    e.preventDefault();
    var last = {
    old_password: (document.getElementById('pw-old') || {}).value || '',
    new_password: (document.getElementById('pw-new') || {}).value || '',
    confirm_password: (document.getElementById('pw-new2') || {}).value || ''
    };
    fetch('/api/profile/password', {
    method: 'POST', credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(last)
    })
    .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function (d) {
        if (d.ok) {
          sage(t('password-updated'), false);
          f.reset();
          regelnPruefen();
          // Der Zwang ist damit erfuellt — der Dialog laesst sich wieder
          // schliessen, und das Banner hat nichts mehr zu sagen.
          var zw = document.getElementById('profile-forced');
          if (zw) zw.style.display = 'none';
          var d2 = document.getElementById('profile-modal');
          if (d2) d2.classList.remove('forced');
          erzwungen['profile-modal'] = false;
          return;
        }
        // DIE GRUENDE EINZELN, mit ihren Zahlen. Der Server hat jeden
        // ermittelt; sie zu einer Sammelmeldung zusammenzuziehen waere, die
        // Arbeit wegzuwerfen und den Bediener raten zu lassen.
        var texte = (d.reasons || []).map(function (g) { return t(g.key, g.args); });
        sage(texte.join('  '), true);
    })
    .catch(function (code) {
        sage(code === 401 ? t('not-logged-in') : t('pw-internal'), true);
    });
  });

  document.addEventListener('click', function (e) {
    var knopf = e.target.closest && e.target.closest('#pf-speichern');
    if (!knopf) return;
    e.preventDefault();
    var last = {};
    for (var k in kontaktFelder) {
    var el = document.getElementById(kontaktFelder[k]);
    last[k] = el ? el.value : '';
    }
    knopf.disabled = true;
    fetch('/api/profile/contact', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(last)
    })
    .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function (d) {
        // DIE ANTWORT ZURUECKSCHREIBEN, nicht das Gesendete stehenlassen: der
        // Server schneidet Leerraum ab. Sonst zeigte der Dialog etwas anderes
        // als die Datei, und beim naechsten Oeffnen spraenge der Wert.
        for (var k in kontaktFelder) {
          var el = document.getElementById(kontaktFelder[k]);
          if (el && typeof d[k] === 'string') el.value = d[k];
        }
        kontaktHinweis(t('saved'), false);
    })
    .catch(function (code) {
        // LAUT, und mit dem Grund. „Ging nicht" ohne Ursache ist die Sorte
        // Meldung, an der dieser Baum reihenweise Zeit verloren hat.
        kontaktHinweis(code === 401 ? t('not-logged-in') : t('save-failed'), true);
    })
    .then(function () { knopf.disabled = false; });
  });
})();

// ── DIE RÜCKMELDUNG DES SERVERS — sie kommt in der Adresse ───────────────────
//
// Ein Dialog schickt ein echtes `<form>` ab (damit es ohne JavaScript trägt);
// der Server antwortet mit einer Weiterleitung auf DENSELBEN Screen und hängt
// an, was zu sagen ist. Hier wird das ausgepackt.
//
// `next` bekommt jedes Formular mit auf den Weg: ohne diesen Wert führte der
// Server auf „/" — der Bediener stünde nach dem Kennwortwechsel woanders.
(function () {
  var ort = window.location.pathname + window.location.search;
  var frage = new URLSearchParams(window.location.search);

  // Den Rückweg in jedes Dialogformular schreiben, OHNE die Meldungsfelder:
  // sonst nähme der nächste Absprung `pwerror=…` wieder mit und der Dialog
  // meldete einen Fehler, der längst behoben ist.
  var sauber = new URLSearchParams(window.location.search);
  ['pwchange', 'pwerror', 'pwnotice', 'reasons'].forEach(function (k) { sauber.delete(k); });
  var rueckweg = window.location.pathname + (sauber.toString() ? '?' + sauber : '');
  ['login-next', 'profile-next'].forEach(function (id) {
    var f = document.getElementById(id);
    if (f) f.value = rueckweg;
  });

  var meldung = document.getElementById('profile-msg');
  var zwang = document.getElementById('profile-forced');



  if (frage.get('pwnotice') === 'changed') sage(t('password-updated'), false);

  var fehler = frage.get('pwerror');
  if (fehler === 'policy') {
    // DIE GRÜNDE EINZELN. Der Server hat jeden ermittelt; sie hier zu einer
    // Sammelmeldung zusammenzuziehen wäre, die Arbeit wegzuwerfen und den
    // Bediener raten zu lassen, was noch fehlt.
    //
    // Jeder Grund kommt als `schlüssel:name=wert:name=wert` — die Zahlen
    // gehören in den Satz, nicht daneben. Hier stand `gruende.map(t)`, und
    // `Array.map` reicht dem Aufgerufenen DREI Argumente: Element, INDEX,
    // Feld. Der Index landete damit als `args`, `hasOwnProperty` auf einer
    // Zahl fand nichts, und im Panel stand wörtlich „Mindestens { $need }
    // Zeichen". `map` mit einer mehrstelligen Funktion ist eine stille Falle:
    // sichtbar wird sie erst am Text, den der Bediener liest.
    var gruende = (frage.get('reasons') || '').split(/[+\s]+/).filter(Boolean);
    sage(gruende.map(function (roh) {
    var teile = roh.split(':');
    var args = null;
    for (var i = 1; i < teile.length; i++) {
        var paar = teile[i].split('=');
        if (paar.length === 2) {
          args = args || {};
          args[paar[0]] = paar[1];
        }
    }
      return t(teile[0], args);
    }).join('  '), true);
  } else if (fehler) {
    sage(t('pw-' + fehler), true);
  }

  // ERZWUNGEN: unabweisbar, mit Hinweis. Ein Zwang, den man wegklicken kann,
  // ist keiner.
  if (frage.get('pwchange') === '1') {
    if (zwang) zwang.style.display = '';
    // NUR DAS KENNWORT. Der Dialog heisst „Mein Profil" und zeigte im
    // Zwangszustand das ganze Profil — Anschrift, Telefonnummern, einen
    // Speichern-Knopf. Daneben stand „Das Passwort muss geaendert werden,
    // bevor es weitergeht", und der Bediener konnte alles ausser dem tun,
    // worum er gebeten wurde.
    //
    // Der Server weist diesen Weg jetzt ab (403, siehe api_profile_contact).
    // Hier verschwindet er zusaetzlich aus dem Blick: ein Feld anzubieten,
    // dessen Speichern verweigert wird, waere eine Falle statt einer Sperre.
    kontaktZeigen(false);
    window.HearthDialog.open('profile-modal', { force: true });
  } else if (fehler || frage.get('pwnotice')) {
    window.HearthDialog.open('profile-modal');
  }

  // Notbehelf, bis die Meldungstexte auch im Browser aus dem Katalog kommen:
  // der Schlüssel ist besser als eine erfundene Übersetzung, und er ist als
  // solcher erkennbar.
})();

// Session status: fetch /api/me, show user + logout or anon login link
fetch('/api/me', { credentials: 'same-origin' })
  .then(function(r) { return r.ok ? r.json() : null; })
  .then(function(data) {
    if (data && data.username) {
      var roles = data.roles || [];
      document.getElementById('nav-user-name').textContent = data.username;
      document.getElementById('nav-user-roles').textContent = roles.join(', ');
      var av = document.getElementById('nav-avatar');
      // Avatar: profile image (data.avatar, future per-user field) else the initial.
      if (data.avatar) av.innerHTML = '<img src="' + data.avatar + '" alt="">';
      else av.textContent = (data.username[0] || '?').toUpperCase();
      var nutzer = document.getElementById('nav-user');
      if (nutzer) nutzer.style.display = 'inline-block';
      // Und den Anmelden-Knopf AUSDRUECKLICH verbergen: er steht im Markup auf
      // `display:none`, aber wer sich im Dialog anmeldet und die Seite neu
      // laedt, soll ihn auch dann nicht sehen, wenn ihn etwas eingeblendet hat.
      var anon = document.getElementById('nav-anon');
      if (anon) anon.style.display = 'none';
      // Admin button only for admins — gates the entry, not the security
      // (the /admin route + every /api/users op re-check the role server-side).
      if (roles.indexOf('admin') !== -1) {
        // KEIN `nav-admin` mehr — der eigene „Verwaltung"-Knopf ist entfallen,
        // weil das Systemmenue direkt daneben dasselbe Ziel fuehrt.
        //
        // Hier stand ein ungeprueftes `getElementById('nav-admin').style` und
        // WARF, sobald jemand mit Admin-Rolle angemeldet war. Der Rest dieses
        // `then()` lief nicht mehr, der `catch()` sprang ein — und blendete
        // „Anmelden" ein, waehrend der Benutzername schon dastand. Die Leiste
        // behauptete gleichzeitig angemeldet und nicht angemeldet.
        //
        // Deshalb hier wie ueberall: erst pruefen, dann anfassen. Ein Element,
        // das es nicht mehr gibt, darf keine Sitzungsanzeige zerlegen.
        var mAdm = document.getElementById('nav-menu-admin');
        if (mAdm) mAdm.style.display = 'block';
      }
    } else {
      zeigeAnmelden();
    }
  })
  .catch(zeigeAnmelden);

function zeigeAnmelden() {
  var anon = document.getElementById('nav-anon');
  if (anon) anon.style.display = 'inline-flex';
}

// Client-side typecast: the wire delivers a raw numeric value + its IEC
// type ("t"); the display format is decided HERE, not in Rust. BOOL→0/1,
// integer/bit/time families→integer, REAL/LREAL→2 decimals, unknown type
// →raw. Later the Editor/wire will deliver an already-typed value and this
// becomes a passthrough.
// Shared write helper: send a value to the PLC over the live WebSocket.
// The server re-checks the write ACL authoritatively (handle_write).
window.writeValue = function(address, value) {
  if (window._hearth_ws && window._hearth_ws.readyState === 1) {
    window._hearth_ws.send(JSON.stringify({ type: 'write', address: address, value: value }));
  } else {
    if (typeof showToast === 'function') showToast('✖ Keine Live-Verbindung — Schreiben nicht möglich', 'err');
  }
};

// Transient write-feedback toasts (bottom-right). The server answers every
// write with write_ack / write_denied on the same socket — surface it so a
// click is never silently swallowed (the #1 cause of "nichts passiert" is a
// denied write on an expired/anonymous session).
// ── Toast + Popup runtime API ──────────────────────────────────────────────
// Every screen the base layout serves gets these helpers, so a placed symbol's
// runtime script can just call Runtime.toast(...) / Runtime.popup(...) without
// requiring per-screen plumbing.
//
// showToast(text, kind, duration?) — kinds: 'info' | 'ok' | 'warn' | 'err'.
//   Historical filter — only 'err' was emitted — is gone; symbol scripts get
//   the full quadruplet now. The runtime-side write_ack handler stays muted
//   though (it'd be noisy on every value write), so each call site decides.
window.showToast = function(text, kind, duration) {
  var wrap = document.getElementById('wtoast');
  if (!wrap) return;
  kind = kind || 'info';
  var t = document.createElement('div');
  t.className = 'wtoast wtoast--' + kind;
  t.textContent = text;
  wrap.appendChild(t);
  requestAnimationFrame(function() { t.classList.add('wtoast--show'); });
  var ms = (typeof duration === 'number' && duration > 0) ? duration
         : (kind === 'err' ? 5000 : kind === 'warn' ? 4000 : 2400);
  setTimeout(function() {
    t.classList.remove('wtoast--show');
    setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 250);
  }, ms);
};

window.Runtime = window.Runtime || {};

// Runtime.toast — alias of showToast with the API shape the symbol scripts use.
window.Runtime.toast = function(text, kind, duration) {
  window.showToast(text, kind, duration);
};

// Runtime.popup({ title, body, buttons, kind }) -> Promise<value>
//   title    string  (mandatory, ends up in the head)
//   body     string  (mandatory, ends up in the body)
//   kind     'info' | 'ok' | 'warn' | 'err'  (default 'info')
//   buttons  [{ label, value, primary? }, …]  (default single "OK"→true button)
// Resolves with the picked button's `value`; rejects on Esc (resolves `null`
// if no Esc handler — see below). Non-blocking but only one popup at a time.
(function() {
  var modal = null;
  function build() {
    if (modal) return modal;
    var root = document.createElement('div');
    root.id = 'hb-modal';
    root.className = 'hb-modal';
    root.innerHTML = '<div class="hb-modal__box">'
      + '<div class="hb-modal__head" id="hb-modal__head"></div>'
      + '<div class="hb-modal__body" id="hb-modal__body"></div>'
      + '<div class="hb-modal__foot" id="hb-modal__foot"></div>'
      + '</div>';
    document.body.appendChild(root);
    modal = root;
    return root;
  }
  window.Runtime.popup = function(opts) {
    opts = opts || {};
    var kind = opts.kind || 'info';
    var buttons = (opts.buttons && opts.buttons.length) ? opts.buttons
                : [{ label: 'OK', value: true, primary: true }];
    var root = build();
    var head = root.querySelector('#hb-modal__head');
    var body = root.querySelector('#hb-modal__body');
    var foot = root.querySelector('#hb-modal__foot');
    head.className = 'hb-modal__head hb-modal__head--' + kind;
    head.textContent = opts.title || '';
    body.textContent = opts.body || '';
    foot.innerHTML = '';
    return new Promise(function(resolve) {
      function close(val) {
        root.classList.remove('open');
        document.removeEventListener('keydown', onEsc);
        resolve(val);
      }
      function onEsc(e) { if (e.key === 'Escape') close(null); }
      buttons.forEach(function(b) {
        var el = document.createElement('button');
        el.className = 'hb-modal__btn' + (b.primary ? ' hb-modal__btn--primary' : '');
        el.textContent = b.label;
        el.addEventListener('click', function() { close(b.value); });
        foot.appendChild(el);
      });
      document.addEventListener('keydown', onEsc);
      root.classList.add('open');
    });
  };
})();

window.fmtByType = function(t, val) {
  var n = (typeof val === 'number') ? val : parseFloat(val);
  if (isNaN(n)) return String(val);
  switch (String(t || '').toUpperCase()) {
    case 'BOOL': return n != 0 ? '1' : '0';
    case 'REAL':
    case 'LREAL': return n.toFixed(2);
    case '': return String(n); // unknown type — show raw, don't round
    default: return String(Math.round(n)); // SINT..ULINT, BYTE..LWORD, TIME, DATE…
  }
};

// Heartbeat monitor: the server reports `heartbeat_age_ms` (age of the
// freshest live value across all vars) in every status frame. Show it
// continuously in the nav and pop up a warning when it stalls — so the
// operator KNOWS the bus went quiet/dead (e.g. after a PLC redeploy) and can
// act. Deliberately no silent auto-reconnect; the judgement stays with the human.
(function() {
  // STALE_MS: nav indicator goes amber. POPUP_MS: hearth-server has started auto-
  // reconnecting → inform the operator. FAIL_MS: reconnect keeps failing →
  // escalate the message so the user knows it isn't working and should act.
  var POPUP_MS = 8000, STALE_MS = 3000, FAIL_MS = 25000;
  var ind = document.getElementById('hb-indicator');
  var popup = document.getElementById('hb-popup');
  var msgEl = document.getElementById('hb-msg');
  var dismissed = false;
  function human(ms) {
    var s = Math.round(ms / 1000);
    if (s < 60) return s + ' s';
    return Math.floor(s / 60) + ' min ' + (s % 60) + ' s';
  }
  window.updateHeartbeat = function(age) {
    if (age === null || age === undefined) {
      if (ind) { ind.textContent = '♥ –'; ind.className = 'nav__hb'; }
      if (popup) popup.style.display = 'none';
      return;
    }
    if (ind) {
      ind.textContent = '♥ ' + human(age);
      ind.className = 'nav__hb' + (age > POPUP_MS ? ' nav__hb--dead' : age > STALE_MS ? ' nav__hb--stale' : '');
    }
    if (age > POPUP_MS) {
      if (msgEl) {
        msgEl.textContent = (age > FAIL_MS)
          ? 'Seit ' + human(age) + ' kein Heartbeat. Auto-Reconnect bisher erfolglos — Bus/SPS prüfen, ggf. hearth-server neu starten.'
          : 'Seit ' + human(age) + ' kein Heartbeat. Auto-Reconnect der Bus-Verbindung läuft…';
      }
      if (popup && !dismissed) popup.style.display = 'block';
    } else {
      dismissed = false;
      if (popup) popup.style.display = 'none';
    }
  };
  var btn = document.getElementById('hb-dismiss');
  if (btn) btn.addEventListener('click', function() {
    dismissed = true;
    if (popup) popup.style.display = 'none';
  });
})();

// Minimal WebSocket client for status updates
(function() {
  var ws, txt = document.getElementById('plc-status');
  function connect() {
    var proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    ws = new WebSocket(proto + '//' + location.host + '/ws/live');
    window._hearth_ws = ws;
    ws.onmessage = function(e) {
      try {
        var msg = JSON.parse(e.data);
        if (msg.type === 'status') {
          // The Vars/heartbeat indicators live on the admin screen now — update
          // them only when present (guards null on screen/dashboard pages).
          if (txt) txt.textContent = msg.connected ? msg.vars + ' Vars' : 'Offline';
          if (typeof updateHeartbeat === 'function') updateHeartbeat(msg.heartbeat_age_ms);
        }
        if (msg.type === 'live' && typeof onLiveUpdate === 'function') {
          onLiveUpdate(msg.values);
        }
        if (msg.type === 'write_ack') {
          // Stumm: die Werte-Aktualisierung selbst bestätigt den Schreibvorgang;
          // ein Toast wäre auf jedem Tipp zu laut (Operator-Wunsch).
        }
        if (msg.type === 'write_denied') {
          showToast('✖ ' + (msg.address || '') + ' — ' + (msg.reason || 'abgelehnt'), 'err');
        }
      } catch(_) {}
    };
    ws.onclose = function() { setTimeout(connect, 2000); };
  }
  connect();
})();
]]></asset>
  <asset name="hearth-admin.css" type="css"><![CDATA[/* Hearth — Verwaltungsseite.
 *
 * HERAUSGELOEST aus admin.html.tera. Gestalt gehoert in eine Datei, nicht in die
 * Vorlage: als /static-Datei ist sie je Projekt ueberschreibbar (der Daemon
 * bedient /static aus zwei Verzeichnissen, das beschreibbare mit Vorrang), und
 * wer die Vorlage aendert, aendert nicht mehr ungewollt das Aussehen mit.
 */

/* ── Anlagen-Settings: aligned grid (label | value | unit | input | button) ── */
.settings { display: grid; grid-template-columns: minmax(260px, 1fr) auto 2.4em 150px max-content;
  gap: 16px; align-items: center; }
.s-label { color: #cfcfe0; font-size: 13px; }
.s-label small { display: block; color: #666; font-size: 11px; margin-top: 2px; }
.s-cur { text-align: right; color: #4fc3f7; font-weight: 600; font-size: 15px; font-variant-numeric: tabular-nums; }
.s-unit { color: #666; font-size: 12px; }

/* ── inputs / buttons ── */
.inp { background: #0f0f1a; border: 1px solid #333; border-radius: 4px; color: #e0e0e0; font: inherit;
  font-size: 13px; padding: 7px 10px; }
.inp:focus { outline: none; border-color: #ff6b35; }
.s-input { width: 150px; }
.btn { background: #ff6b35; border: none; color: #0f0f1a; font: inherit; font-weight: 600;
  font-size: 12px; padding: 7px 14px; border-radius: 4px; cursor: pointer; white-space: nowrap; }
.btn:hover { background: #ff7d4d; }
.btn--ghost { background: #2a2a3a; color: #ccc; border: 1px solid #3a3a4a; }
.btn--ghost:hover { background: #34344a; color: #fff; }
.btn--danger { background: #3a1620; color: #ffb3b3; border: 1px solid #5a2a2a; }
.btn--danger:hover { background: #4a1a28; }

/* ── user table ── */
.card__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.user-actions { text-align: right; white-space: nowrap; }
.user-actions .btn { margin-left: 6px; }
.muted { color: #666; font-size: 12px; }
.banner { padding: 10px 12px; border-radius: 6px; font-size: 13px; margin-bottom: 12px; display: none; }

/* ── modal ── */
.modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1200;
  display: none; align-items: center; justify-content: center; }
.modal-backdrop.open { display: flex; }
.modal { background: #181825; border: 1px solid #2a2a38; border-radius: 10px; padding: 24px;
  width: 420px; max-width: 92vw; box-shadow: 0 12px 48px rgba(0,0,0,0.6); }
.modal__title { font-size: 16px; font-weight: 600; color: #ddd; margin-bottom: 4px; }
.modal label { display: block; font-size: 11px; color: #888; text-transform: uppercase;
  letter-spacing: 0.05em; margin: 16px 0 6px; }
.modal .inp { width: 100%; }
.modal .inp:disabled { color: #888; border-style: dashed; }
.role-pick { display: flex; flex-wrap: wrap; gap: 6px 16px; }
.role-pick label { display: inline-flex; align-items: center; gap: 6px; margin: 0; color: #bbb;
  font-size: 12px; text-transform: none; letter-spacing: 0; }
.modal__actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
.modal__err { color: #f99; font-size: 12px; margin-top: 12px; min-height: 14px; }

/* ── Darstellung / Theme ── */
.theme-grid { display: grid; grid-template-columns: 170px 1fr; gap: 12px 18px; align-items: center; max-width: 560px; }
.theme-grid label { color: #bbb; font-size: 12px; text-transform: none; letter-spacing: 0; }
.theme-grid input[type=color] { width: 52px; height: 30px; padding: 0; border: 1px solid #333; border-radius: 4px; background: none; cursor: pointer; }
.theme-grid .presets .btn { margin-right: 8px; }
.theme-preview { border: 1px solid var(--border); border-radius: 8px; padding: 18px; margin-top: 4px;
  background: var(--bg); color: var(--text); font-family: var(--font); }
.tp-brand { color: var(--accent); font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
.tp-brand img { height: 24px; }
.tp-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
.tp-btn { background: var(--accent); color: #0f0f1a; border: none; border-radius: 4px; padding: 6px 13px;
  font: inherit; font-weight: 600; cursor: pointer; }
.tp-link { color: var(--accent); cursor: pointer; text-decoration: none; }
.tp-link:hover { text-decoration: underline; }
.tp-badge { padding: 3px 10px; border-radius: 11px; font-size: 12px; font-weight: 600; }
.tp-ok { background: var(--ok); color: #08180a; } .tp-warn { background: var(--warn); color: #1a1200; } .tp-bad { background: var(--bad); color: #1a0000; }
.tp-card { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 14px; }
.tp-card .tp-btn { margin-right: 8px; }
.tp-toggle.on { box-shadow: 0 0 0 2px var(--accent); }
.tp-formrow { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.tp-lbl { color: var(--text); opacity: 0.75; font-size: 12px; width: 110px; }
.tp-input { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; color: var(--text);
  font: inherit; font-size: 13px; padding: 6px 10px; }
.tp-input:focus { outline: none; border-color: var(--accent); }
.tp-chk { color: var(--text); font-size: 13px; display: inline-flex; align-items: center; gap: 6px; }
]]></asset>
  <asset name="hearth-login.css" type="css"><![CDATA[/* Hearth — Anmeldeseite.
 *
 * HERAUSGELOEST aus login.html.tera. Gestalt gehoert in eine Datei, nicht in die
 * Vorlage: als /static-Datei ist sie je Projekt ueberschreibbar (der Daemon
 * bedient /static aus zwei Verzeichnissen, das beschreibbare mit Vorrang), und
 * wer die Vorlage aendert, aendert nicht mehr ungewollt das Aussehen mit.
 */

* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  background: #0f0f1a;
  color: #e0e0e0;
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand {
  position: fixed;
  top: 16px;
  left: 24px;
  font-weight: 700;
  color: #ff6b35;
  font-size: 15px;
  letter-spacing: 0.05em;
}
.card {
  background: #181825;
  border: 1px solid #222;
  border-radius: 8px;
  padding: 32px;
  width: 360px;
  max-width: 92vw;
}
h1 {
  font-size: 20px;
  font-weight: 600;
  color: #ccc;
  margin-bottom: 4px;
}
.subtitle {
  color: #666;
  font-size: 13px;
  margin-bottom: 24px;
}
label {
  display: block;
  font-size: 12px;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 6px;
  margin-top: 16px;
}
input[type="text"], input[type="password"] {
  width: 100%;
  background: #0f0f1a;
  border: 1px solid #2a2a3a;
  border-radius: 4px;
  color: #e0e0e0;
  font-size: 14px;
  padding: 10px 12px;
  font-family: inherit;
}
input:focus {
  outline: none;
  border-color: #ff6b35;
}
button {
  width: 100%;
  margin-top: 24px;
  background: #ff6b35;
  border: none;
  color: #0f0f1a;
  font-weight: 600;
  font-size: 14px;
  padding: 12px;
  border-radius: 4px;
  cursor: pointer;
  font-family: inherit;
}
button:hover { background: #ff7d4d; }
.error {
  margin-top: 16px;
  padding: 10px 12px;
  background: rgba(244, 67, 54, 0.1);
  border: 1px solid #552a2a;
  border-radius: 4px;
  color: #f77;
  font-size: 13px;
}
.notice {
  margin-top: 16px;
  padding: 10px 12px;
  background: rgba(76, 175, 80, 0.08);
  border: 1px solid #2a5a2a;
  border-radius: 4px;
  color: #9c9;
  font-size: 13px;
}

/* Das Logo der Anlage auf der Anmeldeseite — begrenzt, damit ein grosses Bild
   die Karte nicht wegdrueckt. Ein Logo ist eine Angabe, kein Hintergrund. */
.brand__logo { max-height: 42px; max-width: 220px; display: block; }
/* Die Organisation unter dem Anlagennamen: leiser als der Name, denn sie ist
   die Einordnung und nicht die Antwort auf „wo bin ich". */
.subtitle--org { opacity: 0.7; font-size: 0.9em; }
]]></asset>
  <asset name="hearth.css" type="css"><![CDATA[/* Hearth — Grundgestalt der ausgelieferten Seiten.
 *
 * DIESE DATEI VERBRAUCHT, SIE DEFINIERT NICHT. Jede Farbe steht als
 * `var(--token, #rueckfall)`; die Werte selbst kommen aus dem Anlagen-Thema und
 * werden in base.html.tera auf :root gesetzt.
 *
 * WOFUER DER RUECKFALL. Nicht fuer die Anmeldeseite — die laedt diese Datei gar
 * nicht, sondern nur hearth-login.css; das war eine Fehlannahme und ist
 * nachgeprueft. Er traegt fuer den Fall, der wirklich vorkommt: hearth.css wird
 * OHNE base.html.tera geladen, und dann gibt es keinen :root-Block.
 *
 * Genau das tut der Editor. Das Menueband holt sich diese Datei ueber
 * `canvas://app/hearth.css` in einen Shadow-Root — dort steht kein :root, und
 * ohne Rueckfall waere jede Farbe ungueltig. Ausserdem ist base.html.tera eine
 * BEARBEITBARE Systemvorlage: wer den Block daraus entfernt, soll eine Seite in
 * Vorgabefarben bekommen und keine ohne.
 *
 * RICHTUNGEN SIND LOGISCH, NICHT PHYSISCH. `margin-inline-start` statt
 * `margin-left`, `inset-inline-end` statt `right`. Der Grund ist nicht
 * Geschmack: der Entwickler schreibt deutsch, der Kunde liest womoeglich
 * arabisch — dann laeuft die Leiste von rechts, und das Untermenue klappt nach
 * links auf. Mit physischen Angaben braeuchte jede davon eine zweite Fassung.
 *
 * Der Browser dreht logische Angaben anhand von `dir` am <html>, und `dir`
 * kommt aus der Sprache. Damit kostet eine Sprache von rechts nach links KEINE
 * eigene Gestalt — sie kostet ein Attribut.
 *
 * Gemessen vor dem Umbau: 20 physische Richtungen, 0 logische.
 *
 * WAS HIER NICHT MEHR PASSIEREN DARF: dass die Vorlage dieselben Selektoren
 * noch einmal regelt. Ihr <style>-Block steht NACH dem <link> und gewann still
 * — wer hier an `.nav` etwas aenderte, sah nichts davon. Neun Regeln waren so
 * doppelt vergeben. Sie stehen jetzt nur noch hier.
 */
/* (Fortsetzung des urspruenglichen Kopfes)
 *
 * HERAUSGELOEST aus base.html.tera. Dort standen 131 Zeilen CSS in einem
 * <style>-Block, mitten in der Vorlage: wer das Aussehen aendern wollte, musste
 * die Vorlage anfassen — und wer die Vorlage anfasste, aenderte ungewollt das
 * Aussehen mit. Zwei Dinge in einer Datei, die verschiedenen Leuten gehoeren.
 *
 * Als Datei unter /static ist sie ausserdem JE PROJEKT ueberschreibbar: der
 * Daemon bedient /static aus zwei Verzeichnissen, das beschreibbare mit Vorrang.
 * Eine eigene hearth.css im Projekt schlaegt damit diese hier, ohne dass an der
 * Vorlage etwas geaendert werden muesste.
 *
 * NICHT hierher gehoert der Farbblock: er entsteht aus dem Projekt-Thema
 * (theme()) und bleibt deshalb in base.html.tera. Was aus Daten entsteht, kann
 * keine statische Datei sein.
 */

* { margin: 0; padding: 0; box-sizing: border-box; }
body { background: var(--bg, #0f0f1a); color: var(--text, #e0e0e0);
  /* Der Rueckfall traegt den ganzen Stapel — alles nach dem ersten Komma
     gehoert dazu, Kommas eingeschlossen. */
  font-family: var(--font, 'Inter', 'Segoe UI', system-ui, sans-serif); }
/* ── DIE LEISTE HAT EIGENE MERKMALE ──────────────────────────────────────────
 *
 * Sie borgte sich `--panel`, `--border`, `--muted`, `--text-dim`, `--text-bright`
 * und `--line` — also die Merkmale der Karten, der Raender und des Fliesstexts.
 * Wer der Leiste eine andere Farbe geben wollte, nahm sie damit zwangslaeufig
 * auch jeder Karte; wer die Karten aufhellte, hellte die Leiste mit auf, ohne es
 * zu wollen. Ein geborgtes Merkmal ist keine Einstellung, sondern eine Kopplung.
 *
 * WAS ABSICHTLICH GEBORGT BLEIBT, und nur das: `--ok`/`--warn`/`--bad` am
 * HERZSCHLAG. Die drei sind keine Gestaltung, sondern eine Aussage ueber den
 * Zustand — ein Gruen, das in der Leiste ein anderes waere als auf der Karte
 * daneben, waere eine Falle. Alles Uebrige heisst jetzt nach dem, was es
 * faerbt.
 *
 * Die Vorgaben sind GENAU die bisherigen Werte: ein bestehendes Projekt sieht
 * nach dem Umbau aus wie vorher.
 */
.nav { background: var(--nav-bg, #181825); border-bottom: 1px solid var(--nav-line, #222); padding: 0 16px; display: flex; align-items: center; height: 48px; }
.nav__brand { font-weight: 700; color: var(--nav-brand, #ff6b35); font-size: 15px; letter-spacing: 0.05em;
  text-decoration: none; display: inline-flex; align-items: center; }
.nav__brand:hover { color: var(--nav-brand, #ff6b35); filter: brightness(1.15); }
.nav__logo { height: 28px; width: auto; display: block; }
/* ── Das Menue ist eine LISTE ────────────────────────────────────────────────
 * <ul>/<li> traegt die Verschachtelung, nicht der Klassenname. Die Liste selbst
 * bringt Punkte und Einzug mit; beides muss weg, sonst stuenden Aufzaehlungs-
 * zeichen in der Leiste. */
.nav__links, .nav__dropdown { list-style: none; margin: 0; padding: 0; }
.nav__links { display: flex; gap: 4px; margin-inline-start: 24px; align-items: center; }
.nav__item { display: block; }
.nav__link { display: inline-block; color: var(--nav-text, #888); text-decoration: none;
  font-size: 13px; padding: 6px 12px; border-radius: 4px; }
.nav__link:hover { color: var(--nav-text-hover, #ccc); background: rgba(255,255,255,0.05); }
.nav__link--active { color: var(--nav-text-active, #fff); background: rgba(255,255,255,0.08); }

/* ── Aufklappen macht der BROWSER ────────────────────────────────────────────
 *
 * <details>/<summary> statt <div> mit :hover. Der Unterschied ist kein
 * Geschmack: die Klappliste ging bei `:hover` auf, und auf einem Panel gibt es
 * kein hover — das Untermenue liess sich dort NICHT oeffnen. Jetzt oeffnet ein
 * Klick oder die Tastatur, und das Vorleseprogramm bekommt den Zustand vom
 * Element selbst.
 *
 * Das Dreieck, das <summary> von Haus aus mitbringt, wird abgeschaltet: unser
 * Zeichen steht in ::after und richtet sich nach dem Zusammenhang. */
.nav__group { position: relative; }
.nav__group-label { cursor: pointer; list-style: none; user-select: none; }
.nav__group-label::-webkit-details-marker { display: none; }
.nav__group-label::marker { content: ""; }
.nav__dropdown { display: none; position: absolute; top: 100%; inset-inline-start: 0; z-index: 900;
  background: var(--nav-dropdown-bg, #181825); border: 1px solid var(--nav-dropdown-line, #2a2a38);
  border-radius: 4px; padding: 4px;
  min-width: 160px; box-shadow: 0 8px 24px rgba(0,0,0,0.45); }
.nav__group[open] > .nav__dropdown { display: block; }
/* AB DER ZWEITEN EBENE KLAPPT ES ZUR SEITE AUF, nicht nach unten.
 *
 * `top: 100%` heisst „unter dem Elternteil" — auf der ersten Ebene ist das die
 * Leiste, also richtig. Auf der zweiten ist das Elternteil ein Eintrag INNERHALB
 * einer Klappliste; das Untermenue legte sich damit ueber die Geschwister, die
 * darunter stehen. Sichtbar wird das erst mit einem Untermenue IM Untermenue —
 * eine Tiefe, die das Makro immer konnte und die bis heute niemand
 * veroeffentlicht hatte.
 *
 * Entschieden wird wieder am ZUSAMMENHANG, nicht an einer Tiefenzahl: „eine
 * Klappliste in einer Klappliste" gilt fuer jede Ebene ab der zweiten. */
.nav__dropdown .nav__dropdown { top: -5px; inset-inline-start: 100%; margin-inline-start: 4px; }
.nav__dropdown .nav__link { display: block; }
.nav__spacer { flex: 1 1 auto; }

/* ── Sinnbild und zweite Zeile ───────────────────────────────────────────────
 *
 * Beide stehen IMMER im Markup, wenn das Modell sie traegt; was davon zu sehen
 * ist, entscheidet die Form. In der Leiste ist Platz fuer ein kleines Sinnbild
 * neben der Beschriftung, aber nicht fuer eine zweite Zeile — die gehoert zur
 * Kachel. Genau dafuer ist die Trennung da: EIN Markup, drei Formen.
 *
 * `nav__glyph`, nicht `nav__icon`: letzteres gehoert seit jeher den Zeichen im
 * Statusbereich (Ueber, Hilfe). Zwei Bedeutungen fuer einen Klassennamen sind
 * derselbe Fehler wie zwei Werte fuer eine Farbe.
 */
.nav__glyph { width: 16px; height: 16px; object-fit: contain; vertical-align: -3px;
  margin-inline-end: 6px; flex: 0 0 auto; }
.nav__text { }
.nav__hint { display: none; }          /* in der Leiste kein Platz — siehe oben */
.nav__dropdown .nav__hint { display: block; font-size: 11px; color: var(--nav-text, #888); }
.nav__dropdown .nav__glyph { vertical-align: -3px; }

/* TRENNLINIE — die Richtung entscheidet der ZUSAMMENHANG, nicht die Vorlage.
 *
 * Sie stand als {% if tiefe > 0 %} im Makro: die Vorlage entschied ueber die
 * Form. Das traegt bis zur zweiten Form und keinen Schritt weiter — in einem
 * Kachelmenue ist eine Trennlinie weder senkrecht noch waagerecht, und die
 * Vorlage bekaeme einen dritten Zweig. Jetzt gibt es EIN <hr>, und wo es
 * landet, bestimmt sein Aussehen. */
.nav__sep-halter { display: flex; align-self: stretch; }
.nav__separator { align-self: center; width: 1px; height: 18px; border: 0;
  background: var(--nav-dropdown-line, #2a2a38); margin: 0 6px; }
.nav__dropdown .nav__separator { width: 100%; height: 0; margin: 4px 0;
  border-top: 1px solid var(--nav-dropdown-line, #2a2a38); background: none; }

/* Das Zeichen fuer „hier geht es weiter" — aus demselben Grund hier und nicht
 * im Makro. In der Leiste zeigt es nach unten, in einer Klappliste nach
 * rechts; eine Kachel braucht gar keines und schaltet es einfach ab. */
.nav__group-label::after { content: "\25BE"; margin-inline-start: 6px; font-size: 10px; opacity: .7; }
.nav__dropdown .nav__group-label::after { content: "\203A"; }
/* Auswahlgruppe: der geltende Punkt traegt einen Punkt, kein Haekchen —
   „eines von mehreren" sieht anders aus als „ein oder aus". */
.nav__radio-item { position: relative; padding-inline-start: 26px; }
.nav__radio-item::before { content: ""; position: absolute; inset-inline-start: 10px; top: 50%;
                           width: 8px; height: 8px; margin-top: -4px;
                           border-radius: 50%; border: 1px solid var(--nav-text, #888); }
.nav__radio-item[aria-checked="true"]::before { background: var(--nav-action, #ff6b35); border-color: var(--nav-action, #ff6b35); }
.nav__radio-item[aria-checked="true"] { color: var(--nav-text-active, #fff); }
.nav__label { color: var(--nav-text, #888); cursor: default; }

/* ── DIE DREI MENÜFORMEN ────────────────────────────────────────────────────
 *
 * Dasselbe Markup, drei Gestalten. Das ist der Punkt: Leiste, Kacheln und
 * Menüband zeigen dieselben `<li class="nav__item">` — WAS davon zu sehen ist,
 * entscheidet allein die CSS. Eine Vorlage, die je Form anderes Markup
 * schriebe, bräuchte für jede weitere Form einen weiteren Zweig, und der
 * Editor müsste jeden davon nachbauen.
 *
 * Gewählt wird am SCREEN (`menu-form`), nicht am Menü: je voller ein Bild,
 * desto kleiner soll die Navigation sein. Dasselbe Menü darf auf der leeren
 * Übersicht als Kachelfeld und auf dem vollen Prozessbild als schmale Leiste
 * stehen.
 *
 * Die Regeln greifen über `.nav--<form>` UND über `.screen--<form> .nav`: das
 * erste trägt die Leiste selbst (im Editor hängt sie noch außerhalb des
 * Screens), das zweite der Behälter des Kompilats. Beide führen zur selben
 * Gestalt — es gibt keine zweite Fassung, nur einen zweiten Weg, sie zu
 * treffen.
 *
 * KEINE Vorgabe hier: ohne Form gilt `.nav`, und das ist die Leiste. Sie hier
 * zu wiederholen hieße, sie an zwei Stellen zu führen.
 */

/* LEISTE — die Grundform, wie `.nav` sie schon zeichnet. Ausgeschrieben, damit
 * `bar` ausdrücklich gewählt werden kann und nicht nur „nichts gesagt" heißt. */
.nav--bar, .screen--bar .nav { }

/* ── KACHELN ────────────────────────────────────────────────────────────────
 *
 * Ein Feld statt einer Zeile: die Leiste wächst über die Höhe, die Einträge
 * werden Flächen. Für ein Panel, das mit den Fingern bedient wird — ein
 * Ziel von 140 px trifft man, ein Wort von 60 px nicht zuverlässig.
 *
 * Sinnbild und Zusatztext werden hier SICHTBAR (`.nav__hint` ist in der Leiste
 * ausgeblendet, weil dort kein Platz ist). Genau dafür trägt der Baum sie.
 */
.nav--tiles, .screen--tiles .nav { height: auto; align-items: flex-start; padding: 16px; }
.nav--tiles .nav__links, .screen--tiles .nav__links {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px; margin-inline-start: 24px; flex: 1 1 auto; align-items: stretch;
}
.nav--tiles .nav__link, .screen--tiles .nav__link {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 6px; min-height: 96px; padding: 12px; text-align: center;
  border: 1px solid var(--nav-line, #222); border-radius: 8px;
}
.nav--tiles .nav__glyph, .screen--tiles .nav__glyph {
  width: 40px; height: 40px; vertical-align: baseline;
}
.nav--tiles .nav__hint, .screen--tiles .nav__hint {
  display: block; font-size: 11px; color: var(--nav-text, #888);
}
/* Ein dehnbarer Zwischenraum hat im Raster keinen Sinn — er schöbe eine Kachel
 * ans andere Ende einer Zeile, die es nicht gibt. */
.nav--tiles .nav__spacer, .screen--tiles .nav__spacer { display: none; }
/* Die Trennlinie liegt QUER über das Raster: sie trennt Gruppen von Kacheln,
 * nicht zwei Nachbarn. */
.nav--tiles .nav__sep-halter, .screen--tiles .nav__sep-halter { grid-column: 1 / -1; }
.nav--tiles .nav__separator, .screen--tiles .nav__separator {
  width: 100%; height: 0; border-top: 1px solid var(--nav-line, #222);
}

/* ── MENÜBAND ───────────────────────────────────────────────────────────────
 *
 * Höher als die Leiste, mit Sinnbild ÜBER dem Wort — die Form, die eine
 * Werkzeugleiste hat. Zwischen Leiste und Kacheln: eine Zeile, aber greifbare
 * Ziele.
 */
.nav--ribbon, .screen--ribbon .nav { height: 72px; padding: 0 16px; }
.nav--ribbon .nav__links, .screen--ribbon .nav__links { gap: 8px; align-items: stretch; }
.nav--ribbon .nav__link, .screen--ribbon .nav__link {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 4px; min-width: 76px; padding: 8px 12px;
}
.nav--ribbon .nav__glyph, .screen--ribbon .nav__glyph {
  width: 24px; height: 24px; vertical-align: baseline;
}

/* ── SCHMAL ─────────────────────────────────────────────────────────────────
 *
 * Die Umschaltung zwischen breit und schmal macht der BROWSER, nicht der
 * Server: er allein sieht die Breite. Dieselbe Auslieferung bedient einen
 * Leitstand und ein Handgerät.
 *
 * Kacheln werden schmaler, das Band wird zur Leiste — die Form bleibt
 * gewählt, ihre Ausprägung folgt dem Platz.
 */
@media (max-width: 640px) {
  .nav--tiles .nav__links, .screen--tiles .nav__links {
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px;
  }
  .nav--tiles .nav__link, .screen--tiles .nav__link { min-height: 72px; }
  .nav--ribbon, .screen--ribbon .nav { height: 48px; }
  .nav--ribbon .nav__link, .screen--ribbon .nav__link {
    flex-direction: row; min-width: 0; padding: 6px 10px;
  }
  .nav--ribbon .nav__glyph, .screen--ribbon .nav__glyph { width: 16px; height: 16px; }
}

.nav__var { cursor: pointer; }
.nav__var--active { color: var(--nav-text-active, #fff); background: rgba(255,107,53,0.28); }
/* Sprachumschalter — die Kuerzel, nicht die vollen Namen: im Statusbereich ist
 * die Breite knapp, und „DE | EN" liest jeder. Der volle Name steht im lang-
 * Attribut, damit auch eine Sprachausgabe ihn bekommt. */
.nav__langs { display: flex; gap: 2px; align-items: center; }
.nav__lang { color: var(--nav-text, #888); text-decoration: none; font-size: 11px;
  font-weight: 600; padding: 3px 6px; border-radius: 4px; letter-spacing: .04em; }
.nav__lang:hover { color: var(--nav-text-hover, #ccc); background: rgba(255,255,255,.06); }
.nav__lang--active { color: var(--nav-action-text, #0f0f1a); background: var(--nav-action, #ff6b35); }
.nav__status { margin-inline-start: auto; display: flex; align-items: center; gap: 16px; font-size: 12px; }
.nav__user { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--nav-text, #888); }
.nav__user a { color: var(--nav-text, #888); text-decoration: none; }
.nav__user a:hover { color: var(--nav-text-hover, #ccc); }
.nav__user form { display: inline; }
.nav__user button {
  background: none; border: none; color: var(--nav-text, #888); font: inherit; cursor: pointer; padding: 0;
}
.nav__user button:hover { color: var(--nav-text-hover, #ccc); }
.nav__btn { display: inline-flex; align-items: center; gap: 6px; background: var(--nav-btn-bg, #2a2a38);
  border: 1px solid var(--nav-btn-line, #3a3a4a); color: var(--nav-btn-text, #cfcfe0); font: inherit; font-size: 12px; font-weight: 600;
  height: 28px; box-sizing: border-box; padding: 0 10px; border-radius: 5px; cursor: pointer;
  text-decoration: none; line-height: 1; }
/* UEBERFAHREN ueber `brightness`, wie beim Anmeldeknopf daneben. Ein fester
   Farbwert hier waere eine vierte Farbe, die keine Einstellung erreicht — und
   er muesste bei jeder Aenderung des Grundtons von Hand nachgezogen werden. */
.nav__btn:hover { filter: brightness(1.25); color: var(--nav-text-active, #fff); }
.nav__btn--login { background: var(--nav-action, #ff6b35); border-color: var(--nav-action, #ff6b35); color: var(--nav-action-text, #0f0f1a); }
.nav__btn--login:hover { background: var(--nav-action, #ff6b35); filter: brightness(1.12);
  color: var(--nav-action-text, #0f0f1a); }
.nav__btn--admin { background: var(--nav-admin-bg, #243044);
  border-color: var(--nav-admin-line, #2f5070); color: var(--nav-admin-text, #9cc4ff); }
.nav__btn--admin:hover { filter: brightness(1.25); }
.nav__profile { position: relative; }
.nav__profile-btn { display: inline-flex; align-items: center; gap: 8px; }
.nav__avatar { width: 19px; height: 19px; border-radius: 50%; background: var(--nav-action); color: var(--nav-action-text, #0f0f1a);
  display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px;
  overflow: hidden; flex: 0 0 auto; }
.nav__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.nav__profile-menu { inset-inline-end: 0; inset-inline-start: auto; min-width: 210px; }
.nav__profile:hover .nav__profile-menu, .nav__profile-menu.open { display: block; }
.nav__profile-roles { color: var(--nav-text, #888); font-size: 11px; padding: 7px 10px 6px; border-bottom: 1px solid var(--nav-dropdown-line, #2a2a38); margin-bottom: 4px; }
.nav__menuitem { display: block; width: 100%; text-align: start; background: none; border: none; color: var(--nav-text-hover, #ccc);
  font: inherit; font-size: 13px; padding: 7px 10px; border-radius: 4px; cursor: pointer; }
.nav__menuitem:hover { background: rgba(255,255,255,0.07); color: var(--nav-text-active, #fff); }
.nav__icon { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 28px;
  box-sizing: border-box; color: var(--nav-text, #888); border-radius: 5px; text-decoration: none; flex: 0 0 auto; }
.nav__icon:hover { color: var(--nav-text-active, #fff); background: rgba(255,255,255,0.08); }
/* Das Sinnbild als MEDIUM, nicht als festes Markup.
   Die Pfade standen wortwoertlich in navbar.html.tera; wer eines tauschen
   wollte, musste die ganze Vorlage ueberschreiben. Jetzt liegen sie als
   `/static/media/<name>.svg` im Projekt und lassen sich ersetzen.
   Als MASKE, nicht als <img>: nur so folgt die Farbe weiter `currentColor` und
   damit `--nav-text` samt Hover. Ein <img> braechte seine eigene Farbe mit, und
   das Thema griffe an dieser einen Stelle nicht mehr. */
.nav__icon-glyph { width: 18px; height: 18px; display: block; background: currentColor;
  -webkit-mask: var(--glyph) center / contain no-repeat;
          mask: var(--glyph) center / contain no-repeat; }
main { padding: 24px; max-width: 1400px; margin: 0 auto; }
h1 { font-size: 20px; font-weight: 600; margin-bottom: 16px; color: var(--text-dim, #ccc); }
.card { background: var(--panel, #181825); border: 1px solid var(--border, #222); border-radius: 8px; padding: 16px; margin-bottom: 16px; }
.card__title { font-size: 13px; font-weight: 600; color: var(--muted, #888); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th { text-align: start; color: var(--muted, #888); font-weight: 500; padding: 6px 8px; border-bottom: 1px solid var(--border, #222); }
td { padding: 6px 8px; border-bottom: 1px solid #1a1a2a; }
.q-good { color: var(--ok, #4caf50); }
.q-bad { color: var(--bad, #f44336); }
.q-stale { color: var(--warn, #ff9800); }
.q-disconnected { color: var(--muted, #888); }
.nav__hb { font-size: 12px; color: var(--ok, #4caf50); margin-inline-start: 2px; font-variant-numeric: tabular-nums; }
.nav__hb--stale { color: var(--warn, #ff9800); }
.nav__hb--dead { color: var(--bad, #f44336); }
#hb-popup {
  display: none; position: fixed; top: 64px; inset-inline-start: 50%; transform: translateX(-50%);
  z-index: 1000; background: #2a1620; border: 1px solid var(--bad, #f44336); border-radius: 8px;
  padding: 16px 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.55); max-width: 92%;
}
#hb-popup .hb-popup__title { color: var(--bad, #f44336); font-weight: 700; font-size: 14px; margin-bottom: 6px; }
#hb-popup .hb-popup__msg { color: var(--text-dim, #ccc); font-size: 13px; margin-bottom: 12px; line-height: 1.4; }
#hb-popup button { background: var(--bad, #f44336); color: var(--text-bright, #fff); border: none; border-radius: 4px;
  padding: 6px 14px; font: inherit; cursor: pointer; }
#hb-popup button:hover { background: var(--bad, #f44336); }
.hb-toggle { border: none; border-radius: 4px; padding: 3px 12px; font: inherit; font-size: 12px;
  font-weight: 600; cursor: pointer; width: 130px; }
.hb-toggle--on { background: var(--ok, #4caf50); color: var(--text-bright, #fff); }
.hb-toggle--off { background: var(--line-strong, #3a3a4a); color: var(--text-dim, #ccc); }
.hb-toggle:disabled { cursor: default; opacity: 0.55; }
.hb-input { background: var(--bg, #0f0f1a); border: 1px solid var(--line, #2a2a38); border-radius: 4px; color: var(--text, #e0e0e0);
  font: inherit; font-size: 12px; padding: 3px 8px; width: 130px; font-variant-numeric: tabular-nums; }
.hb-input:focus { outline: none; border-color: var(--accent, #ff6b35); }
.hb-input--ro { color: var(--muted, #888); border-style: dashed; }
#wtoast { position: fixed; bottom: 16px; inset-inline-end: 16px; z-index: 1100; display: flex; flex-direction: column; gap: 8px; }
.wtoast { padding: 8px 14px; border-radius: 6px; font-size: 13px; box-shadow: 0 4px 16px rgba(0,0,0,0.45);
  opacity: 0; transform: translateY(6px); transition: opacity 0.2s, transform 0.2s; }
.wtoast--show { opacity: 1; transform: translateY(0); }
.wtoast--ok { background: #16301a; border: 1px solid var(--ok, #4caf50); color: #b6e6b6; }
.wtoast--err { background: #361620; border: 1px solid var(--bad, #f44336); color: #ffb3b3; }
.wtoast--info { background: #161e30; border: 1px solid var(--info, #2196f3); color: #b3d6ff; }
.wtoast--warn { background: #322516; border: 1px solid var(--warn, #ff9800); color: #ffd9a1; }
/* Generic modal popup (any-screen runtime API). Same backdrop + box treatment
   as help-modal but with the alert-style head/foot the operator already knows
   from the heartbeat popup. */
.hb-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55);
  z-index: 1200; align-items: center; justify-content: center; }
.hb-modal.open { display: flex; }
.hb-modal__box { background: var(--dialog-bg, #1c1c2b); border: 1px solid var(--dialog-line, #33334a); border-radius: 8px;
  min-width: 320px; max-width: 92vw; box-shadow: 0 12px 48px rgba(0,0,0,0.6); }
.hb-modal__head { padding: 12px 16px; border-bottom: 1px solid var(--dialog-line, #33334a); font-weight: 700;
  color: var(--text, #e0e0e0); font-size: 14px; }
.hb-modal__head--info  { color: var(--info, #2196f3); }
.hb-modal__head--ok    { color: var(--ok, #4caf50); }
.hb-modal__head--warn  { color: var(--warn, #ff9800); }
.hb-modal__head--err   { color: var(--bad, #f44336); }
.hb-modal__body { padding: 14px 16px; color: var(--text-dim, #ccc); font-size: 13px; line-height: 1.5; }
.hb-modal__foot { padding: 10px 16px; border-top: 1px solid var(--dialog-line, #33334a); display: flex;
  justify-content: flex-end; gap: 8px; }
.hb-modal__btn  { background: var(--line-strong, #3a3a4a); color: var(--text-bright, #fff); border: none; border-radius: 4px;
  padding: 6px 14px; font: inherit; cursor: pointer; }
.hb-modal__btn:hover { filter: brightness(1.25); }
.hb-modal__btn--primary { background: var(--accent, #ff6b35); }
.hb-modal__btn--primary:hover { background: var(--accent, #ff6b35); }
.help-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1300;
  align-items: center; justify-content: center; }
.help-modal.open { display: flex; }
/* Der Dialog nimmt EIGENE Merkmale, nicht `--panel`/`--text`: er liegt ueber
   der Anlage und soll sich von ihr absetzen. Wer `--bg` faerbt, faerbt die
   Anlage — nicht das, was darueber liegt. */
.help-modal__box { background: var(--dialog-bg); border: 1px solid var(--dialog-line);
  border-radius: 10px;
  width: 520px; max-width: 92vw; max-height: 80vh; display: flex; flex-direction: column;
  box-shadow: 0 12px 48px rgba(0,0,0,0.6); }
.help-modal__head { display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px; border-bottom: 1px solid var(--dialog-line); }
.help-modal__title { font-weight: 600; color: var(--dialog-text); }
.help-modal__close { background: none; border: none; color: var(--dialog-text, #e8e8ef); font-size: 22px; line-height: 1; cursor: pointer; }
.help-modal__close:hover { color: var(--dialog-text); }
.help-modal__body { padding: 18px; overflow: auto; color: var(--dialog-text); font-size: 14px; line-height: 1.5; }

/* ── Schmale Anzeigen: die Leiste klappt zusammen ─────────────────────────────
 *
 * Bis hierher gab es in dieser Datei KEINE einzige @media-Regel — gemessen,
 * nicht vermutet. Das viewport-Meta in base.html.tera versprach eine Seite, die
 * sich anpasst, und nichts loeste es ein: auf einem 7-Zoll-Panel (800x480) oder
 * einem Telefon lief die Navigationsleiste einfach aus dem Bild, mitsamt der
 * Anmeldung. Fuer eine Anlagenbedienung ist das kein Schoenheitsfehler.
 *
 * DIE SCHWELLE liegt bei 900 Pixeln. Darueber: Panel ab 10.1", Desktop, Tablet
 * quer — die Leiste steht offen, wie bisher. Darunter: Panel 4.3" und 7",
 * Tablet hoch, jedes Telefon — die Projekt-Eintraege wandern hinter den
 * Umschalter. Die Marke und der Statusbereich (Anmeldung, Verwaltung, Hilfe)
 * bleiben IMMER sichtbar; sie sind das, was ein Bediener im Zweifel braucht.
 *
 * Umgeschaltet wird an der WIRKLICHEN Breite des Fensters, nicht an einer im
 * Projekt eingestellten Groesse. Ein Panel-Projekt, das jemand am Telefon
 * aufruft, ist ein Telefon — und keine Einstellung im Editor weiss das besser
 * als das Geraet, auf dem es laeuft.
 */
.nav__burger { display: none; background: none; border: 0; cursor: pointer;
  padding: 8px 10px; margin-inline-start: 12px; border-radius: 6px; }
.nav__burger:hover { background: var(--nav-dropdown-line, #2a2a38); }
.nav__burger-strich { display: block; width: 20px; height: 2px; margin: 4px 0;
  background: var(--nav-text-hover, #ccc); border-radius: 2px; transition: transform .15s, opacity .15s; }

@media (max-width: 900px) {
  .nav { position: relative; }
  .nav__burger { display: block; }
  .nav__links {
    /* Aufgeklappt liegt die Liste UEBER dem Inhalt, sie schiebt ihn nicht weg:
     * ein Bediener, dem beim Antippen die halbe Anlage nach unten rutscht,
     * trifft den Knopf daneben, den er vorher gesehen hat. */
    display: none; position: absolute; top: 48px; inset-inline-start: 0; inset-inline-end: 0;
    flex-direction: column; gap: 0; margin-inline-start: 0; z-index: 40;
    background: var(--panel, #181825); border-bottom: 1px solid var(--border, #222);
    box-shadow: 0 8px 24px rgba(0,0,0,.45);
  }
  .nav__links.nav__links--offen { display: flex; }
  .nav__links > * { padding: 12px 16px; }
}

/* Der aufgeklappte Umschalter wird zum Kreuz — der Zustand steht am Knopf
 * selbst, nicht nur an der Liste, die ihn gerade verdeckt. */
.nav__burger[aria-expanded="true"] .nav__burger-strich:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.nav__burger[aria-expanded="true"] .nav__burger-strich:nth-child(2) { opacity: 0; }
.nav__burger[aria-expanded="true"] .nav__burger-strich:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

/* ── Anmeldeformular im Dialog ───────────────────────────────────────────────
   Ausschliesslich Themavariablen, keine festen Farben: eine einzige
   festverdrahtete Farbe genuegt, damit ein Kunde beim Umfaerben die eine Stelle
   findet, die nicht mitgeht. Gemessen wurde das hier schon einmal — #2a2a38
   stand neben #2a2a3a, zwei Werte fuer dieselbe Linie. */
.login-form { display: flex; flex-direction: column; gap: 6px; min-width: 260px; }
.login-form label { color: var(--dialog-text, #e8e8ef); font-size: 13px; }
.login-form button { margin-top: 10px; }

/* ── FORMULARFELDER — eine Regel fuer BEIDE Orte ──────────────────────────────
 *
 * Der Anmeldedialog und die Formularebene ueber dem Screen benutzen dieselben
 * Elemente des `<form>`-Tags; sie muessen gleich aussehen, sonst wirkt dasselbe
 * Eingabefeld an zwei Stellen wie zwei verschiedene.
 *
 * `--field-*` und NICHT `--bg`/`--text`: hier stand `background: var(--bg)` mit
 * `color: var(--text)`. In einem Projekt, das `bg` auf hell gestellt und `text`
 * hell gelassen hatte, ergab das WEISS AUF WEISS — man tippte blind. Kein
 * Fehler, keine Meldung.
 *
 * Ein Feld braucht eigene Merkmale, weil es sich von seiner Umgebung abheben
 * muss: man soll sehen, wo geschrieben werden kann. */
.login-form input,
.login-form select,
.login-form textarea,
.screen-layer input,
.screen-layer select,
.screen-layer textarea {
  background: var(--field-bg); color: var(--field-text);
  border: 1px solid var(--field-line); border-radius: 4px;
  padding: 8px 10px; font: inherit;
}
.login-form input:focus,
.login-form select:focus,
.login-form textarea:focus,
.screen-layer input:focus,
.screen-layer select:focus,
.screen-layer textarea:focus {
  outline: none; border-color: var(--accent);
}
/* Der Platzhaltertext gedaempft — sonst liest er sich wie ein eingetragener
   Wert, und der Bediener loescht ihn, statt zu schreiben. */
.login-form ::placeholder,
.screen-layer ::placeholder { color: var(--muted); opacity: 1; }

/* ── Ueber diese Anlage ──────────────────────────────────────────────────── */
.about__logo { display: block; max-width: 200px; max-height: 90px; margin-bottom: 10px; }
.about__name { font-weight: 700; font-size: 18px; color: var(--text-bright); }
.about__desc { color: var(--muted); margin-bottom: 10px; }
.about__facts { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; }
.about__facts dt { color: var(--muted); }
.about__facts dd { margin: 0; color: var(--text); }
.about__facts a { color: var(--accent); }
.about__system { margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--dialog-line); }
.about__notes-title { margin-top: 14px; color: var(--muted); }
/* Anschrift und Notizen behalten ihre Zeilenumbrueche — sie werden abgetippt. */
.about__pre { white-space: pre-line; }

/* Die Regeln der Kennwortrichtlinie im Profildialog. Als LISTE, nicht als Satz:
   der Bediener soll beim Tippen abhaken können, nicht einen Absatz auswerten. */
.pw-rules { margin: 8px 0 0; padding-left: 18px; color: var(--muted); font-size: 12px; }
.pw-rules li { margin: 2px 0; }
.profile__banner { padding: 8px 10px; border-radius: 4px; margin-bottom: 10px; font-size: 13px; }
.profile__banner--err { background: rgba(244,67,54,0.14); color: var(--bad); }
.profile__banner--ok  { background: rgba(76,175,80,0.14); color: var(--ok); }
/* Ein erzwungener Dialog zeigt kein Kreuz — sonst sieht er aus, als ließe er
   sich wegklicken, und der Bediener sucht den Ausweg statt zu tippen. */
.help-modal.forced .help-modal__close { display: none; }
/* Der zweite Schliessknopf im Dialogfuss faellt unter dieselbe Regel: im
   Zwangsfall gibt es keinen Abschluss, nur den Ausweg (Abmelden im Banner). */
.help-modal.forced .help-modal__close-alt { display: none; }
.profile__aktionen { display: flex; gap: 10px; align-items: center; }
.profile__ausweg { display: inline-block; margin-left: 10px; }

/* ── Sprachwahl: Flagge, Name, Kürzel ───────────────────────────────────────── */
.nav__lang-menu { inset-inline-end: 0; inset-inline-start: auto; min-width: 190px; }
/* Aufklappen — dieselbe Regel wie beim Benutzermenue. Sie fehlte, und das
   Menue blieb unsichtbar, obwohl das Skript brav umschaltete. */
.nav__profile:hover .nav__lang-menu, .nav__lang-menu.open { display: block; }
.nav__flag { font-size: 15px; line-height: 1; }
.nav__lang-code { float: right; color: var(--nav-text); font-size: 11px; letter-spacing: .06em; }
.nav__lang-menu .is-active { color: var(--nav-action); }

/* Das Profil hat zwei Abschnitte: Kontaktdaten und Kennwort. Die Ueberschrift
   trennt sie sichtbar — sonst liest sich ein Formular mit sechs Feldern wie
   eines, und der Bediener sucht den Speichern-Knopf fuer die falsche Haelfte. */
.profile__abschnitt-titel { font-weight: 600; margin: 16px 0 8px; color: var(--dialog-text); }
.profile__abschnitt-titel:first-child { margin-top: 0; }
.profile__abschnitt input { width: 100%; box-sizing: border-box; }
.profile__hinweis { font-size: 0.9em; }
.profile__hinweis--ok  { color: var(--ok, #4caf50); }
.profile__hinweis--err { color: var(--bad, #f44336); }

/* Die Kennwortregeln, waehrend getippt wird.
   NEUTRAL, solange das Feld leer ist: eine rote Liste beim Aufziehen des
   Dialogs sieht aus wie ein Fehler, dabei hat noch niemand etwas getan.
   Und was der Browser NICHT pruefen kann (Wiederverwendung — die frueheren
   Kennwoerter sind Hashes), bleibt neutral. Ein Haken, der nichts geprueft
   hat, ist schlimmer als kein Haken. */
.pw-regel { color: var(--muted); }
.pw-regel--ok::before    { content: "✓ "; color: #4caf50; }
.pw-regel--ok            { color: #4caf50; }
.pw-regel--offen::before { content: "• "; }
.pw-regel--offen         { color: var(--muted); }
]]></asset>
  <asset name="about.svg" type="media"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Ueber diese Anwendung — Standardmedium der Anlagensoftware.
     Die Pfade sind WOERTLICH die aus navbar.html.tera; sie standen dort fest im
     Markup, und wer das Sinnbild tauschen wollte, musste die Vorlage
     ueberschreiben. Als Medium reist es in der .hearth und laesst sich
     ersetzen.
     `currentColor` bleibt: die Leiste faerbt es ueber `--nav-text`. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round">
  <circle cx="12" cy="12" r="10"/>
  <line x1="12" y1="16" x2="12" y2="12"/>
  <line x1="12" y1="8" x2="12.01" y2="8"/>
</svg>
]]></asset>
  <asset name="help.svg" type="media"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Hilfe — Standardmedium der Anlagensoftware. Siehe about.svg. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round">
  <circle cx="12" cy="12" r="10"/>
  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
  <line x1="12" y1="17" x2="12.01" y2="17"/>
</svg>
]]></asset>
  <asset encoding="base64" name="DejaVuSans.woff" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSans.woff2" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSansCondensed.woff" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSansCondensed.woff2" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSansMono.woff" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSansMono.woff2" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSerif.woff" type="font"><![CDATA[]]></asset>
  <asset encoding="base64" name="DejaVuSerif.woff2" type="font"><![CDATA[]]></asset>
  <asset name="screen-runtime.js" type="js"><![CDATA[// screen-runtime.js — PROJECT / runtime JS.
//
// Belongs to the SCREEN (the deployed page), not to the Studio editor. Plain JS,
// no editor dependencies. Studio's editor (canvas-editor.js) only *initiates*
// these actions; the behaviour lives here so the deployed hearth screen runs the
// exact same code. Later this is also driven by a JS inactivity timer.
//
// Exposed as window.HearthScreen = { blankScreen, screensaver, ... }.

(function () {
  'use strict';

  // Embed the base webfont set on the DEPLOYED page — the fonts ship via the
  // unified deploy to /static, and this injects the matching @font-face so the
  // hearth screen renders text identically to the editor. Skipped in the Studio
  // editor (canvas:// scheme), which embeds the fonts from its own QRC.
  (function injectFonts() {
    if (location.protocol === 'canvas:') return;
    const fams = [['DejaVu Sans', 'DejaVuSans'], ['DejaVu Sans Condensed', 'DejaVuSansCondensed'],
                  ['DejaVu Sans Mono', 'DejaVuSansMono'], ['DejaVu Serif', 'DejaVuSerif']];
    const css = fams.map((f) =>
      "@font-face{font-family:'" + f[0] + "';src:url('/static/media/" + f[1] + ".woff2') format('woff2'),"
      + "url('/static/media/" + f[1] + ".woff') format('woff');}").join('');
    const st = document.createElement('style');
    st.textContent = css;
    (document.head || document.documentElement).appendChild(st);
  })();

  // Project fonts (per-project TTF/OTF/WOFF/WOFF2 uploads, ausgespielt von der
  // Studio-Publish-Pipeline als /static/project-fonts.css). Eine <link>-Datei
  // wuerde leichter im Browser-Cache landen als ein inline-<style>. Im Studio-
  // Editor (canvas://) ueberspringen, dort liefern die :/canvas/fonts-Resourcen
  // die Schriften.
  (function injectProjectFonts() {
    if (location.protocol === 'canvas:') return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    // Sie ist eine CSS-Datei und liegt deshalb bei den anderen. Der Pfad hinkte
    // nach dem Umbau nach: 404, und die Schriften erreichten die Seite nicht.
    link.href = '/static/css/project-fonts.css';
    (document.head || document.documentElement).appendChild(link);
  })();

  // Project custom CSS/JS: Multi-File-Inject. Studio publisht je einen Index
  // (project-custom-{css,js}.json) als Reihenfolge-Definition, dazu jede
  // Datei einzeln unter /static/<name>. Wir fetchen die Indizes parallel und
  // haengen die Dateien in der publizierten Reihenfolge an — so kann der
  // Operator Abhaengigkeiten (jquery vor app.js) ueber die Sortierung im
  // Custom-Code-Tool steuern. Fehlende Indizes (alte Deploys / leere
  // Projekte) werden ohne Console-Rauschen ignoriert.
  (function injectCustomCode() {
    if (location.protocol === 'canvas:') return;
    const fetchList = (path) => fetch(path, { cache: 'no-store' })
      .then(r => r.ok ? r.json() : [])
      .catch(() => []);
    fetchList('/static/project-custom-css.json').then((names) => {
      (names || []).forEach((n) => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/static/css/' + n;
        document.head.appendChild(link);
      });
    });
    fetchList('/static/project-custom-js.json').then((names) => {
      // Sequentiell anhaengen, sodass spaetere Files frueheren Globals
      // zugreifen koennen (jquery → app.js). async=false reicht nicht, weil
      // wir die Tags via JS einbauen — deshalb Promise-Kette.
      (names || []).reduce((chain, n) => chain.then(() => new Promise((resolve) => {
        const s = document.createElement('script');
        s.src = '/static/js/' + n;
        s.onload = s.onerror = resolve;
        document.head.appendChild(s);
      })), Promise.resolve());
    });
  })();

  // DER SCHIRM — die Flaeche, die der Screen tatsaechlich einnimmt.
  //
  // `#screen-surface` gibt es auf BEIDEN Seiten: im Editor als Zeichenflaeche
  // (canvas-editor.js), in der Anlage als der eingepasste Schacht im Rahmen
  // (frame.html.tera). Ein Bezeichner, eine Rechnung — was der Editor als „der
  // Screen" versteht, versteht die Anlage genauso.
  //
  // ── Warum der Fensterrueckfall nicht mehr genuegt ──────────────────────────
  //
  // Hier stand: „in hearth that's the whole page". Das war richtig, solange der
  // Screen die ganze Seite fuellte. Seit dem Rahmen sitzt er MITTIG IM PANEL,
  // und das Panel wird ins Fenster eingepasst — zwischen beiden bleibt Rand.
  // Der Rueckfall deckte diesen Rand mit, und zwar nicht erst fuer die
  // Formularebene: Bildschirmschoner und Abdunkeln legten sich schon darueber.
  //
  // Der Rueckfall BLEIBT, aber als das, was er ist: die Antwort fuer eine Seite
  // ohne Rahmen (Anmeldung, Verwaltung). Nicht als Regelfall.
  function screenRect() {
    const el = document.getElementById('screen-surface');
    if (el) {
      const r = el.getBoundingClientRect();
      return { left: r.left, top: r.top, width: r.width, height: r.height };
    }
    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
  }

  // ── DIE FORMULAREBENE ──────────────────────────────────────────────────────
  //
  // Ein Screen ist ein `<svg>`, und SVG kennt kein Eingabefeld. Darueber liegt
  // deshalb eine HTML-Ebene — kein Anmelde-Sonderweg, sondern das Fundament der
  // Formularfamilie (Eingabefeld, Passwortfeld, Schaltflaeche, spaeter Auswahl
  // und Dialog).
  //
  // ── Die eine Idee ──────────────────────────────────────────────────────────
  //
  // Die Ebene traegt EINE Transformation, ihre Kinder rechnen in
  // SCREEN-EINHEITEN — denselben Zahlen, die eine SVG-Platzierung traegt. Ein
  // Eingabefeld bei x=320,y=180 liegt damit in beiden Ebenen an derselben
  // Stelle, ohne dass irgendwo umgerechnet wird.
  //
  // Das ist dieselbe Regel wie im DOM-Baum: gespeichert wird nur das Lokale,
  // verkettet wird beim Zeichnen. Wer die Kinder einzeln skalierte, haette N
  // Rechnungen, die auseinanderlaufen koennen — hier ist es eine.
  //
  // ── Warum ResizeObserver und nicht window.resize ───────────────────────────
  //
  // Die Navigationsleiste kann umbrechen, ohne dass sich das Fenster aendert.
  // Beobachtet wird deshalb die FLAECHE selbst; sie weiss als Erste, dass sie
  // sich geaendert hat.
  function alignScreenLayer() {
    const layer = document.getElementById('screen-layer');
    const surf = document.getElementById('screen-surface');
    if (!layer || !surf) return;

    // Die Entwurfsbreite: aus dem viewBox, nicht aus der gezeichneten Groesse —
    // die gezeichnete IST das Ergebnis der Einpassung, die wir gerade messen.
    const vb = surf.viewBox && surf.viewBox.baseVal;
    const bw = (vb && vb.width)  || Number(surf.getAttribute('width'))  || 0;
    const bh = (vb && vb.height) || Number(surf.getAttribute('height')) || 0;
    if (!(bw > 0) || !(bh > 0)) return;

    const r = screenRect();
    layer.style.left = r.left + 'px';
    layer.style.top = r.top + 'px';
    // Groesse in SCREEN-Einheiten, danach als Ganzes skaliert: so ist die Box
    // der Ebene deckungsgleich mit dem Schacht, und die Kinder sehen die
    // Entwurfskoordinaten.
    layer.style.width = bw + 'px';
    layer.style.height = bh + 'px';
    layer.style.transformOrigin = '0 0';
    layer.style.transform = 'scale(' + (r.width / bw) + ')';
  }

  // ── HTML-KOERPER IN DIE EBENE MONTIEREN ────────────────────────────────────
  //
  // Gelesen wird der BAUM (`<hearth-placements>`), nicht der base64-Block.
  //
  // ── Warum hier zwei Wege stehen, und wann der zweite verschwindet ──────────
  //
  // SVG-Symbole montiert `symbolMount()` weiter aus dem Block. Zwei Quellen fuer
  // dieselbe Sache sind genau die Krankheit, gegen die v2 angetreten ist — das
  // ist hier eine UEBERGANGSSTELLE und keine Absicht.
  //
  // Sie steht so, weil der Baum ohnehin schon in der Seite liegt, alles traegt,
  // was gebraucht wird (Koerper, Matrix, Parameter), und weil der umgekehrte
  // Weg — die Formularelemente in den Block zu zwaengen — Exporter UND Modell
  // um ein Feld erweitert haette, das beim naechsten Schritt wieder entfaellt.
  //
  // ENDE DES UEBERGANGS: sobald `symbolMount()` seine Symbole ebenfalls aus dem
  // Baum montiert, faellt der Block (`hearth-screen-model`) — und mit ihm die
  // 2,7 MB, die er heute je Screen kostet.
  function mountFormLayer() {
    const layer = document.getElementById('screen-layer');
    if (!layer) return;
    // NUR EINMAL — aber an einer Marke, nicht an der Kinderzahl. Die zaehlte
    // auch, was die VORLAGE in die Ebene stellt (der Splash setzt dort seine
    // Angaben als HTML). Ein Screen mit Vorlageninhalt haette danach nie
    // Formularelemente bekommen, ohne dass irgendwo etwas meldete.
    if (layer.dataset.formMounted) return;
    layer.dataset.formMounted = '1';
    const wurzel = document.querySelector('hearth-placements');
    if (!wurzel) return;

    wurzel.querySelectorAll('hearth-placement').forEach((pl) => {
      const koerper = pl.querySelector(':scope > symbols > hearth-body');
      if (!koerper || koerper.getAttribute('layer') !== 'html') return;

      const host = document.createElement('div');
      host.setAttribute('data-placement', pl.getAttribute('id') || '');

      // Die MATRIX woertlich uebernehmen — dieselben sechs Zahlen wie im SVG.
      // Zerlegen (x, y, Massstab, Drehung) waeren fuenf Zahlen fuer sechs, und
      // die fehlende ist die Scherung: der Verlust faellt spaeter auf und sieht
      // dann nach einem Zeichenfehler aus.
      // SVG schreibt `matrix(1 0 0 1 320 180)` mit LEERZEICHEN, CSS verlangt
      // KOMMATA. CSS verwirft einen ungueltigen Wert stillschweigend — das
      // Element sass dann bei 0/0, ohne dass irgendwo etwas meldete. Gemessen,
      // nicht vermutet: das Feld stand bei 31/69 statt bei 350/253.
      const tf = pl.getAttribute('transform');
      if (tf) {
        host.style.transformOrigin = '0 0';
        host.style.transform = tf.replace(/\(([^)]*)\)/g,
          (_, zahlen) => '(' + zahlen.trim().split(/[\s,]+/).join(',') + ')');
      }

      // Groesse aus den Parametern der PLATZIERUNG, nicht aus dem Koerper: sie
      // gehoert zur Platzierung, so wie x und y.
      pl.querySelectorAll(':scope > hearth-param').forEach((p) => {
        const n = p.getAttribute('name'), v = p.getAttribute('value');
        if (n === 'width')  host.style.width  = v + 'px';
        if (n === 'height') host.style.height = v + 'px';
      });

      // Der Koerper steht im XHTML-Namensraum im SVG — dort wird er GEHALTEN,
      // aber nicht gezeichnet. Fuer die Ebene muss er als HTML neu entstehen;
      // ein `importNode` uebernaehme den Namensraum mitsamt seiner Wirkungslo-
      // sigkeit.
      host.innerHTML = koerper.innerHTML;
      layer.appendChild(host);
    });
  }

  (function watchScreenLayer() {
    if (typeof document === 'undefined') return;
    const start = () => {
      // ERST montieren, dann ausrichten: eine leere Ebene auszurichten und die
      // Kinder danach einzuhaengen hiesse, dass die erste Messung die falsche
      // Groesse sieht.
      mountFormLayer();
      alignScreenLayer();

      // ── WARUM NICHT NUR DER ResizeObserver AUF DER FLAECHE ─────────────────
      //
      // Gemessen, nicht vermutet: die Ebene lag 43 px zu hoch. Ausgerichtet
      // wurde bei `DOMContentLoaded`, als die Flex-Kette noch nicht sass — die
      // Flaeche stand da bei y=111, endgueltig bei y=155. Nachgezogen wurde nie,
      // denn `ResizeObserver` meldet GROESSEN, keine LAGEN, und die Groesse war
      // beide Male 590,6 px.
      //
      // Dieselbe Falle im Betrieb: bricht die Navigationsleiste auf einem
      // schmalen Panel um, WANDERT die Flaeche, ohne sich zu aendern.
      //
      // Deshalb wird der RAHMEN mitbeobachtet — seine Hoehe aendert sich, wenn
      // ueber ihm etwas waechst — und zusaetzlich nach `load` nachgezogen, wenn
      // Schriften und Bilder die Aufteilung ein letztes Mal verschieben.
      const surf = document.getElementById('screen-surface');
      const layer = document.getElementById('screen-layer');
      if (typeof ResizeObserver === 'function') {
        const ro = new ResizeObserver(alignScreenLayer);
        if (surf) ro.observe(surf);
        if (layer && layer.parentElement) ro.observe(layer.parentElement);
        ro.observe(document.documentElement);
      }
      // `position: fixed` misst gegen den Sichtbereich — beim Rollen wandert
      // das SVG darunter weg. Auf einem Panel rollt nichts, auf einem
      // Bueroschirm schon.
      window.addEventListener('scroll', alignScreenLayer, { passive: true });
      window.addEventListener('resize', alignScreenLayer, { passive: true });
      window.addEventListener('load', alignScreenLayer);
      // Ein Bild nach dem Zeichnen: die letzte Verschiebung der Aufteilung
      // faellt sonst genau zwischen die Ereignisse.
      if (typeof requestAnimationFrame === 'function')
        requestAnimationFrame(alignScreenLayer);
    };
    if (document.readyState !== 'loading') start();
    else document.addEventListener('DOMContentLoaded', start);
  })();

  function makeOverlay(bg) {
    const r = screenRect();
    const ov = document.createElement('div');
    ov.style.cssText = `position:fixed; left:${r.left}px; top:${r.top}px; `
      + `width:${r.width}px; height:${r.height}px; background:${bg}; `
      + `z-index:99999; cursor:none; overflow:hidden;`;
    document.body.appendChild(ov);
    return ov;
  }

  function dismissOverlay(ov, cleanup) {
    const go = (e) => {
      if (e) e.preventDefault();
      window.removeEventListener('keydown', go, true);
      window.removeEventListener('pointerdown', go, true);
      if (cleanup) cleanup();
      ov.remove();
    };
    window.addEventListener('keydown', go, true);
    window.addEventListener('pointerdown', go, true);
  }

  // Anti-stick shimmer state — module-level so the deeper BLANK stage can stop it.
  let shimmerCanvas = null, shimmerRaf = 0;
  function stopShimmer() {
    if (shimmerRaf) { cancelAnimationFrame(shimmerRaf); shimmerRaf = 0; }
    if (shimmerCanvas) { shimmerCanvas.remove(); shimmerCanvas = null; }
  }

  // BLANK (deeper stage): black the screen out until any key / click — power-save
  // + total burn-in stop. Driven by the SCREEN's own timeout; supersedes the
  // shimmer (so it stops the shimmer first).
  function blankScreen() {
    stopShimmer();
    dismissOverlay(makeOverlay('#000'));
  }

  // The active screensaver is whatever screensaver ELEMENT is placed on the
  // screen — an animated SVG that lives in the DOM. Rather than cloning it, we
  // manipulate the SAME node in place (HTMx-style): hide it on load, maximize it
  // when fired, hide it again on dismiss.
  function screensaverHost() {
    return document.querySelector('[data-screensaver]');
  }

  // Hide the placed screensaver by collapsing its GEOMETRY to Rect(0,0,0,0):
  // invisible inline, only ever maximized by playScreensaver() when fired.
  // Geometry (not display:none) keeps it a normal, re-showable node and remembers
  // the original transform. Runs on screen load for the LIVE screen only — Studio's
  // editor (window.Canvas) keeps it visible so it can be placed/configured.
  function hideScreensaver(host) {
    host = host || screensaverHost();
    if (!host) return;
    if (!host.hasAttribute('data-ss-xform'))
      host.setAttribute('data-ss-xform', host.getAttribute('transform') || '');
    host.setAttribute('transform', 'translate(0,0) scale(0,0)');   // Rect(0,0,0,0)
    host.removeAttribute('data-ss-on');
  }

  // Maximize the SAME node to cover the screen's SVG viewBox (compute scale from
  // its content bbox; getBBox ignores the node's own transform, so the collapsed
  // state doesn't affect the measurement). Bring to front.
  function maximizeScreensaver(host) {
    host = host || screensaverHost();
    if (!host || typeof host.getBBox !== 'function') return false;
    const bb = host.getBBox();
    if (!bb.width || !bb.height) return false;
    const svg = host.ownerSVGElement;
    const vb = svg && svg.viewBox && svg.viewBox.baseVal;
    const W = (vb && vb.width)  || (svg ? svg.clientWidth  : window.innerWidth);
    const H = (vb && vb.height) || (svg ? svg.clientHeight : window.innerHeight);
    const s = Math.max(W / bb.width, H / bb.height);            // cover
    const tx = (W - bb.width * s) / 2 - bb.x * s;
    const ty = (H - bb.height * s) / 2 - bb.y * s;
    host.setAttribute('transform', `translate(${tx},${ty}) scale(${s})`);
    host.parentNode.appendChild(host);                          // raise to front
    host.setAttribute('data-ss-on', '1');
    return true;
  }

  // ── Anti-stick (burn-in prevention) ────────────────────────────────────────
  // SCREENSAVER stage: instead of MOVING content (shifting a uniform field — e.g.
  // the green Acker — onto itself changes nothing) we overlay a FULLSCREEN random
  // pixmap that jitters every colour channel by ±5 each frame: a barely-
  // perceptible "hot shimmer" so no pixel ever stays static and nothing burns in.
  // The live screen stays readable underneath; any input dismisses it. Fired by
  // the placed screensaver SYMBOL's `data-ss-timeout` (the symbol is just the
  // trigger — we render the shimmer, not its content).
  function playScreensaver() {
    if (shimmerCanvas) return;                                      // already shimmering
    // True OS fullscreen on a kiosk/operator panel if the browser grants it; the
    // overlay covers the full screen regardless (so "fullscreen" holds either way).
    try { if (!document.fullscreenElement) document.documentElement.requestFullscreen(); }
    catch (e) { /* needs a gesture — overlay still covers the screen */ }
    const r = screenRect();
    const cv = document.createElement('canvas');
    cv.setAttribute('data-ss-jitter', '1');
    cv.style.cssText = `position:fixed; left:${r.left}px; top:${r.top}px; `
      + `width:${r.width}px; height:${r.height}px; z-index:99998; cursor:none; `
      + `mix-blend-mode:overlay;`;
    // Coarse noise buffer (cheap), CSS-scaled to cover the screen. Per-channel
    // random around mid-grey (128 ±5); the `overlay` blend turns that into a
    // ±~5 drift of each underlying colour value → the shimmer.
    const NW = 640, NH = 360;
    cv.width = NW; cv.height = NH;
    document.body.appendChild(cv);
    shimmerCanvas = cv;
    const ctx = cv.getContext('2d');
    const img = ctx.createImageData(NW, NH);
    const d = img.data;
    for (let i = 3; i < d.length; i += 4) d[i] = 255;             // opaque alpha
    let last = 0;
    const draw = (t) => {
      shimmerRaf = requestAnimationFrame(draw);
      if (t - last < 60) return;                                  // ~16 fps shimmer
      last = t;
      for (let i = 0; i < d.length; i += 4) {
        d[i]     = 123 + ((Math.random() * 11) | 0);              // R 128 ±5
        d[i + 1] = 123 + ((Math.random() * 11) | 0);              // G
        d[i + 2] = 123 + ((Math.random() * 11) | 0);              // B
      }
      ctx.putImageData(img, 0, 0);
    };
    shimmerRaf = requestAnimationFrame(draw);
    dismissOverlay(cv, stopShimmer);
  }

  // Two independent inactivity stages, both reset on input:
  //   • SCREENSAVER shimmer at the placed symbol's `data-ss-timeout`.
  //   • BLANK (black) at the SCREEN's `data-blank-timeout` (0 = disabled).
  // Constraint: blank ≥ screensaver — a smaller blank is clamped UP so it still
  // fires (otherwise it would precede the shimmer and the black would never make
  // sense). This is the runtime guard; the editor/MCP also clamp on save.
  let ssTimer = null, blankTimer = null;
  function ssSecs() {
    const ss = screensaverHost();
    return ss ? Math.max(0, parseInt(ss.getAttribute('data-ss-timeout') || '0', 10)) : 0;
  }
  function blankSecs() {
    const root = document.querySelector('svg[data-blank-timeout]');
    let b = root ? Math.max(0, parseInt(root.getAttribute('data-blank-timeout') || '0', 10)) : 0;
    const s = ssSecs();
    if (b > 0 && s > 0 && b < s) b = s;                            // clamp: blank ≥ screensaver
    return b;
  }
  function armIdleTimer() {
    const s = ssSecs(), b = blankSecs();
    if (!(s > 0) && !(b > 0)) return;                             // nothing configured
    const reset = () => {
      if (ssTimer) clearTimeout(ssTimer);
      if (blankTimer) clearTimeout(blankTimer);
      if (s > 0) ssTimer = setTimeout(playScreensaver, s * 1000);
      if (b > 0) blankTimer = setTimeout(blankScreen, b * 1000);
    };
    ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(
      (ev) => window.addEventListener(ev, reset, true));
    reset();
  }

  function onScreenLoad() {
    if (typeof window !== 'undefined' && window.Canvas) return;      // editor: keep visible
    hideScreensaver();                                             // hide any placed saver content
    // Snapshot mode (?snapshot): a headless capture shows the screen, not the saver.
    if (/[?&]snapshot\b/.test(location.search || '')) return;
    armIdleTimer();
  }
  if (document.readyState !== 'loading') onScreenLoad();
  else document.addEventListener('DOMContentLoaded', onScreenLoad);

  // ── Screen-lifecycle writes (compiled OnScreenLoad / OnScreenLeave) ──────────
  // The logic compiler turns OnScreenLoad/Leave chains into `onload_write` /
  // `onleave_write` bindings: { bind_type, write_address, format }, where
  // `format` is a numeric JS expression over the live cache `currentValues`.
  // hearth has no per-screen trigger, so these run CLIENT-side: onload after the
  // WebSocket opens, onleave on pagehide. Writes go through window.writeValue
  // (the shared, ACL-checked path). Skipped in the Studio editor (canvas://).
  (function screenLifecycleWrites() {
    if (typeof window !== 'undefined' && window.Canvas) return;     // editor preview
    if (typeof location !== 'undefined' && location.protocol === 'canvas:') return;

    function evalExpr(expr) {
      try {
        return new Function('currentValues', 'return (' + expr + ');')(window.currentValues || {});
      } catch (e) { return 0; }
    }
    function eventWrites(kind) {
      var out = [];
      var b = window.bindings || [];
      for (var i = 0; i < b.length; i++)
        if (b[i] && b[i].bind_type === kind)
          out.push({ addr: b[i].write_address || b[i].address, expr: b[i].format });
      return out;
    }
    function runWrites(list) {
      for (var i = 0; i < list.length; i++)
        if (list[i].addr && typeof window.writeValue === 'function')
          window.writeValue(list[i].addr, evalExpr(list[i].expr));
    }

    // OnScreenLoad: fire once the WebSocket is actually open (a write before the
    // socket connects is silently dropped). Poll briefly, then give up.
    function onLoad() {
      var loads = eventWrites('onload_write');
      if (!loads.length) return;
      var tries = 0;
      (function waitWs() {
        var ws = window._hearth_ws;
        if (ws && ws.readyState === 1) { runWrites(loads); return; }
        if (++tries > 100) return;                                 // ~10 s cap
        setTimeout(waitWs, 100);
      })();
    }
    // OnScreenLeave: write on navigation away. pagehide is the reliable unload
    // signal (fires on tab close, reload, and back/forward).
    window.addEventListener('pagehide', function () { runWrites(eventWrites('onleave_write')); });

    if (document.readyState !== 'loading') onLoad();
    else document.addEventListener('DOMContentLoaded', onLoad);
  })();

  // ── Symbol mount + wiring (deployed page runs symbol control classes 1:1) ────
  // Reads the base64 screen model embedded in the SVG (#hearth-screen-model),
  // mounts each library symbol via the SAME forge-symbol-runtime the editor uses
  // — so the symbol's OWN behaviour runs (Taster press, lamp colour, gate
  // compute). Wires connectors: variable→connector (live value → setInput),
  // connector→variable (emit → writeValue, routed to <base>_req), connector→
  // connector (emit → setInput). Ports/connector markers are hidden (live).
  (function symbolMount() {
    if (typeof window !== 'undefined' && window.Canvas) return;          // editor mounts itself
    if (typeof location !== 'undefined' && location.protocol === 'canvas:') return;
    const el = document.getElementById('hearth-screen-model');
    if (!el) return;
    let model;
    try { model = JSON.parse(decodeURIComponent(escape(atob((el.textContent || '').trim())))); }
    catch (e) { try { model = JSON.parse(atob((el.textContent || '').trim())); } catch (e2) { return; } }

    const st = document.createElement('style');
    st.textContent = '.hearth-connector{display:none !important}';
    (document.head || document.documentElement).appendChild(st);

    function start() {
      import('/static/js/forge-symbol-runtime.js').then((rt) => {
        const svg = (el.closest && el.closest('svg')) || document.querySelector('.screen-svg');
        if (!svg || typeof rt.mount !== 'function') return;
        const insts = {}, place = {};
        (model.placements || []).forEach((p) => {
          let inst; try { inst = rt.mount(p.symbol, svg); } catch (e) { return; }
          const sy = (p.scaleY != null ? p.scaleY : p.scale);
          inst.root.setAttribute('transform',
            'translate(' + p.x + ',' + p.y + ') scale(' + p.scale + ',' + sy + ') rotate(' + (p.rotation || 0) + ')');
          // Logic helpers mount (their class computes for the client propagation)
          // but are never PAINTED in live — design-time chrome only.
          if (p.logic) inst.root.style.display = 'none';
          if (typeof inst.realignRef === 'function') inst.realignRef();
          insts[p.instanceId] = inst; place[p.instanceId] = p;
        });

        const routes = model.routes || {};
        // Write a (possibly command-routed) variable. The page only signals the
        // canonical INTENT (write <base>=1 on a truthy value — the native handshake
        // runs the pulse/selection slot-mapping). A falsy value writes 0 only for a
        // Selection (deselect); for a Pulse the FSM owns the release, so the
        // momentary taster's release-0 is ignored (no abort).
        //
        // Pre-cleanup the route entry also carried a `req` field and we wrote
        // <base>_req here — variable-acl-model.md §2.1+§2.2: the HMI uses
        // canonical names, the bridge owns the handshake-slot. A `r.req` field
        // surviving in an older deployed model is still honored for back-compat.
        const writeVar = (v, val) => {
          if (!v || !window.writeValue) return;
          const r = routes[v];
          const target = (r && r.req) ? r.req : v;
          if (r) {
            if (val) window.writeValue(target, 1);
            else if (r.sel) window.writeValue(target, 0);
          } else {
            window.writeValue(v, val ? 1 : 0);
          }
        };
        const paramOf = (ref, k) => { const p = place[ref]; return p && p.symbol && p.symbol.params ? p.symbol.params[k] : undefined; };
        const isVarNode = (ref) => { const p = place[ref]; return !!(p && p.symbol && /^Variable/.test(p.symbol.name || '')); };

        const deliver = (w, val) => {
          if (w.tgtType === 'variable') { writeVar(w.tgtRef, val); return; }
          if (isVarNode(w.tgtRef)) { writeVar(paramOf(w.tgtRef, 'address'), val); return; }
          const inst = insts[w.tgtRef]; if (inst) inst.setInput(w.tgtPort, String(val));
        };

        const liveTargets = {};                                   // canonical var → [cb]
        const onVar = (v, cb) => { if (v) (liveTargets[v] = liveTargets[v] || []).push(cb); };

        (model.wires || []).forEach((w) => {
          if (w.srcType === 'variable') { onVar(w.srcRef, (val) => deliver(w, val)); return; }
          if (isVarNode(w.srcRef)) { onVar(paramOf(w.srcRef, 'address'), (val) => deliver(w, val)); return; }
          const inst = insts[w.srcRef];
          if (inst) inst.on(w.srcPort, (val) => deliver(w, val));
        });
        // Variable nodes also drive their OWN visual from the live value.
        (model.placements || []).forEach((p) => {
          if (!isVarNode(p.instanceId)) return;
          const a = paramOf(p.instanceId, 'address'), inst = insts[p.instanceId];
          if (a && inst) onVar(a, (val) => inst.setInput('value', String(val)));
        });

        // Feed live values by wrapping the page's onLiveUpdate (bindings keep working).
        const prev = window.onLiveUpdate;
        window.onLiveUpdate = function (values) {
          if (typeof prev === 'function') { try { prev(values); } catch (e) {} }
          for (const k in values) {
            const arr = liveTargets[k]; if (!arr) continue;
            const lv = values[k], val = (lv && lv.v != null) ? lv.v : lv;
            for (let i = 0; i < arr.length; i++) { try { arr[i](val); } catch (e) {} }
          }
        };
      }).catch(() => {});
    }
    if (document.readyState !== 'loading') start();
    else document.addEventListener('DOMContentLoaded', start);
  })();

  window.HearthScreen = Object.assign(window.HearthScreen || {},
    { blankScreen, playScreensaver, screensaver: playScreensaver,
      hideScreensaver, maximizeScreensaver,
      // Fuer den Editor und fuer Nachmessungen: dieselbe Rechnung, kein
      // Nachbau. Zwei Rechnungen fuer die Lage der Ebene waeren die naechste
      // Stelle, an der Entwurf und Anlage auseinanderlaufen.
      screenRect, alignScreenLayer });
})();
]]></asset>
  <asset name="forge-symbol-runtime.js" type="js"><![CDATA[// forge-symbol-runtime — the in-page HOST runtime (JS).
//
// The host-side adapter of the Host↔Symbol interface (docs/runtime-interface.md).
// A screen (and the editor test) is ONE big SVG in the HTML body; this mounts a
// symbol as a `<g>` inside that SVG, binds its control class to the group, and
// exposes the host API. Plain DOM JS — engine-agnostic — embedded by the host in
// a Chromium web view (hearth-symbols: QWebEngineView; Studio/hearth: same/CEF).
//
//   symbol = { svg, source, params }
//     svg    — the symbol's inner SVG (elements carry data-role="…")
//     source — the generated control class "class extends HearthSymbol {…}"
//     params — optional { key: value } applied as data-<key> on the group

import { HearthSymbol } from './HearthSymbol.js';
export { HearthSymbol };

const SVGNS = 'http://www.w3.org/2000/svg';

/// Mount one symbol into `svgContainer` (an <svg> in the body). Returns Instance.
export function mount(symbol, svgContainer) {
  const g = document.createElementNS(SVGNS, 'g');
  g.setAttribute('class', 'hearth-symbol');
  for (const [k, v] of Object.entries(symbol.params || {})) g.setAttribute('data-' + k, v);
  g.innerHTML = symbol.svg;                       // the symbol drawing (with data-roles)
  svgContainer.appendChild(g);
  return new Instance(g, symbol);
}

class Instance {
  constructor(root, symbol) {
    this.root = root;
    this.symbol = symbol;
    this._instantiate();
  }
  _instantiate() {
    // ── EIN KAPUTTES SKRIPT DARF DAS SYMBOL NICHT VERSCHLUCKEN ─────────────
    //
    // Hier stand der Aufruf blank. Warf er, brach `mount()` ab — NACHDEM die
    // Gruppe schon im Baum hing. Zurueck blieb ein Gebilde, das aussieht wie
    // ein Symbol und keines ist: in keiner Instanzliste, ohne Klickgriff, in
    // keinem Modell. Auf dem Schirm ein Symbol, das sich nicht anwaehlen
    // laesst.
    //
    // Gemessen am 26.08.2026 an der Konstantpumpe: `SyntaxError: Unexpected
    // token 'const'`. Ihr Skript ist kein `class extends HearthSymbol {…}`,
    // sondern ein Anweisungsblock im aelteren Stil — so schreiben es 44 von 64
    // Bibliothekssymbolen.
    //
    // Der Rueckfall ist die LEERE Steuerklasse: das Symbol zeichnet seinen
    // statischen Koerper, laesst sich waehlen, verschieben und loeschen wie
    // jedes andere, und nur sein Eigenleben fehlt. Das ist ein sichtbarer
    // Mangel statt eines unsichtbaren.
    let Ctl;
    try {
      Ctl = new Function('HearthSymbol', `return (${this.symbol.source});`)(HearthSymbol);
      if (typeof Ctl !== 'function') throw new TypeError('source is not a class');
    } catch (e) {
      console.warn('[symbol] control class of', this.symbol.name || '(unnamed)',
                   'did not load — mounting statically:', e.message);
      this.sourceFailed = e;
      Ctl = class extends HearthSymbol {};
    }
    this.ctl = new Ctl();
    this.ctl.root = this.root;
    // Dasselbe fuer den Anlauf: eine Klasse, die beim Start stolpert, nimmt
    // sonst dieselbe Gruppe mit in den Baum und laesst denselben Geist zurueck.
    if (typeof this.ctl.onInit === 'function') {
      try { this.ctl.onInit(); }
      catch (e) {
        console.warn('[symbol] onInit of', this.symbol.name || '(unnamed)',
                     'failed — mounted statically:', e.message);
        this.initFailed = e;
      }
    }
    this._applyRef();
    this._unmirrorTexts();
  }

  // Reference designation (Betriebsmittelkennzeichen): the per-placement `ref`
  // param (data-ref) becomes the symbol's OWN label, so the SYMBOL itself shows
  // its identity — in the editor AND in deployed hearth. Uses an authored
  // data-role="ref" text if present, else auto-creates one above the symbol.
  _applyRef() {
    const ref = this.root.getAttribute('data-ref') || '';
    let el = this.root.querySelector('[data-role="ref"]');
    let leader = this.root.querySelector('[data-role="ref-leader"]');
    // No ref, or the label is hidden (identity kept in data-ref for export/wiring,
    // only the visible text + leader are removed): nothing to draw.
    const hidden = /^(1|true|yes)$/i.test(this.root.getAttribute('data-refhidden') || '');
    if (!ref || hidden) { if (el) el.remove(); if (leader) leader.remove(); return; }

    // Stable anchor point on the SYMBOL (computed once, before the label/leader
    // affect the bbox). The label hangs off this point; the leader connects them.
    let ax = parseFloat(this.root.getAttribute('data-refax'));
    let ay = parseFloat(this.root.getAttribute('data-refay'));
    if (!isFinite(ax) || !isFinite(ay)) {
      let bb; try { bb = this.root.getBBox(); } catch (e) { bb = { x: 0, y: 0, width: 100, height: 0 }; }
      ax = bb.x + bb.width / 2; ay = bb.y - 5;
      this.root.setAttribute('data-refax', ax);
      this.root.setAttribute('data-refay', ay);
    }
    // User-draggable offset (local coords). Label sits at anchor + (dx,dy).
    const dx = parseFloat(this.root.getAttribute('data-refdx')) || 0;
    const dy = parseFloat(this.root.getAttribute('data-refdy')) || 0;
    const lx = ax + dx, ly = ay + dy;

    // Leader line (Gummilinie) anchor→label, only when the label was moved away.
    const moved = (dx * dx + dy * dy) > 36;
    if (moved) {
      if (!leader) {
        leader = document.createElementNS(SVGNS, 'line');
        leader.setAttribute('data-role', 'ref-leader');
        leader.setAttribute('class', 'hearth-ref-leader');
        leader.setAttribute('stroke', '#8a8a8a');
        leader.setAttribute('stroke-width', '1');
        leader.setAttribute('stroke-dasharray', '4 3');
        if (el) this.root.insertBefore(leader, el); else this.root.appendChild(leader);
      }
      leader.setAttribute('x1', ax); leader.setAttribute('y1', ay);
      leader.setAttribute('x2', lx); leader.setAttribute('y2', ly);
    } else if (leader) { leader.remove(); }

    if (!el) {
      el = document.createElementNS(SVGNS, 'text');
      el.setAttribute('data-role', 'ref');
      el.setAttribute('class', 'hearth-ref');
      el.setAttribute('text-anchor', 'middle');
      el.setAttribute('font-size', '13');
      el.setAttribute('font-family', 'DejaVu Sans, sans-serif');
      el.setAttribute('font-weight', '700');
      el.setAttribute('fill', '#161616');
      el.setAttribute('paint-order', 'stroke');
      el.setAttribute('stroke', '#ffffff');
      el.setAttribute('stroke-width', '3');
      el.setAttribute('stroke-linejoin', 'round');
      el.style.cursor = 'move';
      this.root.appendChild(el);                 // text always on top
    }
    el.setAttribute('x', lx);
    el.setAttribute('y', ly);
    el.textContent = ref;
    this._uprightRef(el);
  }

  // Keep the reference label horizontal and constant-size regardless of the
  // placement's rotate()/scale() on this.root — a Betriebsmittelkennzeichen must
  // stay legible even on a rotated/scaled symbol. Counters the root transform
  // about the label's own anchor point. Call realignRef() after the host changes
  // the placement transform (the editor mounts before it sets rotate()).
  _uprightRef(el) {
    if (!el) return;
    let rot = 0, sx = 1, sy = 1;
    const list = this.root.transform && this.root.transform.baseVal;
    if (list) for (let i = 0; i < list.numberOfItems; i++) {
      const t = list.getItem(i);
      if (t.type === 4 /*ROTATE*/) rot += t.angle;
      else if (t.type === 3 /*SCALE*/) { sx *= t.matrix.a; sy *= t.matrix.d; }
    }
    // User label rotation (data-refrot, deg): added on top of the auto-upright
    // correction, so 0 = upright and any other value tilts the label.
    const refrot = parseFloat(this.root.getAttribute('data-refrot')) || 0;
    const ang = refrot - rot;
    if (!ang && sx === 1 && sy === 1) { el.removeAttribute('transform'); return; }
    const ax = parseFloat(el.getAttribute('x')) || 0;
    const ay = parseFloat(el.getAttribute('y')) || 0;
    el.setAttribute('transform',
      `translate(${ax} ${ay}) rotate(${ang}) scale(${1 / sx} ${1 / sy}) translate(${-ax} ${-ay})`);
  }

  /// Re-level the reference label AND un-mirror all text after the host updates
  /// the placement transform (rotate/scale/flip).
  realignRef() {
    this._uprightRef(this.root.querySelector('[data-role="ref"]'));
    this._unmirrorTexts();
  }

  // A flipped symbol (negative scale on this.root) must NOT render mirrored text —
  // an IEC gate glyph "≥1", a value, a tag etc. stay readable. Counter-flip each
  // <text> about its own anchor so glyphs read normally regardless of flip. Only
  // touches text we own (data-unmirror) or text with no authored transform, and
  // leaves the reference label to _uprightRef.
  _unmirrorTexts() {
    let rot = 0, sx = 1, sy = 1;
    const list = this.root.transform && this.root.transform.baseVal;
    if (list) for (let i = 0; i < list.numberOfItems; i++) {
      const t = list.getItem(i);
      if (t.type === 4 /*ROTATE*/) rot += t.angle;
      else if (t.type === 3 /*SCALE*/) { sx *= t.matrix.a; sy *= t.matrix.d; }
    }
    const fx = sx < 0 ? -1 : 1, fy = sy < 0 ? -1 : 1;
    const texts = this.root.querySelectorAll('text');
    for (const el of texts) {
      if (el.getAttribute('data-role') === 'ref') continue;     // _uprightRef owns it
      const owned = el.getAttribute('data-unmirror') === '1';
      if (rot === 0 && fx === 1 && fy === 1) {
        if (owned) { el.removeAttribute('transform'); el.removeAttribute('data-unmirror'); }
        continue;
      }
      if (!owned && el.getAttribute('transform')) continue;     // don't clobber authored transforms
      const ax = parseFloat(el.getAttribute('x')) || 0;
      const ay = parseFloat(el.getAttribute('y')) || 0;
      // Counter the placement rotate() AND flip about the text's own anchor, so a
      // value/tag stays upright + readable on a rotated/flipped symbol (the beds
      // are placed at -90 — the number must read horizontally everywhere).
      el.setAttribute('transform',
        `translate(${ax} ${ay}) rotate(${-rot}) scale(${fx} ${fy}) translate(${-ax} ${-ay})`);
      el.setAttribute('data-unmirror', '1');
    }
  }

  // host → symbol
  setInput(connector, value) { this.ctl.set(connector, value); }
  setParam(key, value) {
    this.root.setAttribute('data-' + key, value);   // visible after reload()
    if (key === 'ref' || key === 'refdx' || key === 'refdy' ||
        key === 'refrot' || key === 'refhidden')
      this._applyRef();                              // ref / position / rotation / visibility live
  }

  // symbol → host
  on(connector, cb) { this.root.addEventListener(connector, e => cb(e.detail)); }

  /// Parameter change → reload → visible: re-instantiate the control class
  /// against the same group, so onInit re-reads the (changed) parameters.
  reload() { this._instantiate(); }

  dispose() { this.root.remove(); }
}
]]></asset>
  <asset name="HearthSymbol.js" type="js"><![CDATA[// HearthSymbol — the JS interface + GLOBAL behaviour library every symbol uses.
//
// Two layers (keep them apart):
//   • HearthSymbol.js  = GLOBAL methods — the reusable behaviour primitives
//     shared by ALL symbols (colour swap, text readout, analog mapping, a
//     momentary contact …). The behaviour lives HERE, once, in JS.
//   • the per-symbol "Symbol JS" (generated control class) = the SYMBOL DYNAMICS
//     — a thin subclass that only declares which connectors this symbol has and
//     wires each to a global method. It contains NO behaviour logic itself:
//
//         class extends HearthSymbol {
//           static observed = ['open', 'ontime'];        // in-connectors
//           onInit() { this.wireMomentary('button', 'contact', 'contact_type'); }
//           onAttr(name, v) {
//             if (name === 'open')   this.setColor('valve', v, 'color_on', 'color_off');
//             if (name === 'ontime') this.setText('ontime', v, { hideZero: 'ontime_hide_zero' });
//           }
//         }
//
// Model: a screen (and the editor test) is ONE big SVG in the HTML body; each
// placed symbol is a `<g>`. A control class is a plain JS object bound to that
// group's root; it manipulates the group's elements BY `data-role`. This file is
// the SYMBOL-SIDE adapter of the runtime interface (docs/runtime-interface.md) —
// plain JS, the single canonical definition shared 1:1 by every host via
// `forge-symbol-runtime`.
//
// The host drives a symbol only through the protocol:
//   in-connector  → inst.setInput(name, value) → set(name, v) → onAttr(name, v)
//   out-connector → emit(name, v)              → CustomEvent on the root (bubbles)
//   parameter     → data-<key> / var(--key)    → prop(key)
//   lifecycle     → onInit() once after mount
//
// VALUES ARRIVE AS STRINGS. Parameters too. The global methods coerce per the
// data type (bool: '1'/'true' → true; number: Number(v); string: as-is), so the
// per-symbol dynamics never coerce by hand.

export class HearthSymbol {

  // ── Protocol (the host↔symbol seam) ──────────────────────────────────────

  /// The runtime assigns `this.root` (the symbol's SVG group) before onInit().

  /// The element tagged data-role="r" WITHIN this symbol's group (instance-safe:
  /// querySelector is scoped to this.root, so identical roles in sibling
  /// instances never collide).
  role(r) {
    return this.root ? this.root.querySelector(`[data-role="${r}"]`) : null;
  }

  // ── SVG-building framework (used by dynamic symbols that reshape themselves
  //    from props at runtime — e.g. a logic gate that grows with each pin, or
  //    any symbol that adds/removes geometry). Generic, reusable by all symbols.

  /// Create an SVG <tag> with `attrs` (use key "text" for textContent) and
  /// append it to `parent` (default this.root). Returns the new element.
  make(tag, attrs, parent) {
    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
    if (attrs) for (const k in attrs) {
      if (k === 'text') el.textContent = attrs[k];
      else el.setAttribute(k, attrs[k]);
    }
    (parent || this.root).appendChild(el);
    return el;
  }

  /// Empty a role element so it can be rebuilt; returns the (now empty) element.
  clearRole(r) {
    const g = this.role(r);
    if (g) while (g.firstChild) g.removeChild(g.firstChild);
    return g;
  }

  /// Announce that the symbol rebuilt its geometry (e.g. added/removed
  /// .hearth-connector pins). The host re-scans connectors, redraws their
  /// handles and re-routes wires — this is what makes DYNAMIC connectors work.
  refresh() {
    if (this.root)
      this.root.dispatchEvent(new CustomEvent('hearth-geometry', { bubbles: true }));
  }

  /// A parameter value: the data-<key> attribute on the root wins, else the CSS
  /// var(--key). Always a string (or '' if unset). This is how per-instance
  /// configuration ("symbol properties" set by the host/Studio) reaches the
  /// dynamics — e.g. this.prop('color_on'), this.prop('ontime_hide_zero').
  prop(key) {
    const a = this.root && this.root.getAttribute('data-' + key);
    if (a !== null && a !== undefined) return a;
    const v = this.root ? getComputedStyle(this.root).getPropertyValue('--' + key) : '';
    return v ? v.trim() : '';
  }

  /// Report an out-connector to the host. Dispatches a CustomEvent(name) on the
  /// root; it bubbles up the SVG to the body where the host listens.
  emit(name, value) {
    this.root.dispatchEvent(new CustomEvent(name, { detail: value, bubbles: true }));
  }

  /// host → symbol: deliver an in-connector value (the runtime calls this).
  set(name, value) {
    if (typeof this.onAttr === 'function') this.onAttr(name, value);
  }

  /// symbol → host: PERSIST a per-instance property the symbol changed itself
  /// (e.g. an operator right-clicking a pin to invert it). Sets data-<key> live
  /// so prop(key) reflects it immediately, AND dispatches 'hearth-prop'
  /// {key,value} so the host stores it on the placement — surviving reload and
  /// deploy. This is the write-back counterpart of prop() (the read side).
  setProp(key, value) {
    if (this.root) this.root.setAttribute('data-' + key, value);
    this.emit('hearth-prop', { key: key, value: value });
  }

  // ── Global behaviour methods (the reusable dynamics primitives) ───────────
  // The generated per-symbol class calls these; it never re-implements them.

  /// Coerce a delivered value (a string, number or boolean) to a real boolean.
  /// '1' | 'true' | 1 | true → true; everything else (incl. '0') → false.
  truthy(v) {
    return v === true || v === 1 || v === '1' || v === 'true';
  }

  /// BOOL → colour swap. Set the role element's fill to the ON colour when the
  /// value is truthy, else the OFF colour. The colours come from PROPERTIES
  /// (pass their keys), so they are configurable per instance.
  /// @param role   data-role of the element to recolour (e.g. 'valve', 'lens')
  /// @param v      the connector value (string)
  /// @param onKey  property key holding the ON colour (e.g. 'color_on')
  /// @param offKey property key holding the OFF colour (e.g. 'color_off')
  setColor(role, v, onKey, offKey) {
    const el = this.role(role);
    if (el) el.setAttribute('fill', this.truthy(v) ? this.prop(onKey) : this.prop(offKey));
  }

  /// STATIC PROPERTY → element attribute. Apply a per-instance symbol property
  /// (set by the host/Studio as data-<key> / var(--key)) onto a role element's
  /// attribute at init — e.g. this.applyAttr('tag','fill','color'). Skipped when
  /// the property is unset, so the authored default stays. This is how the JS
  /// "sets the properties" rather than relying on var() in presentation attrs.
  applyAttr(role, attr, key) {
    const el = this.role(role);
    const v = this.prop(key);
    if (el && v) el.setAttribute(attr, v);
  }

  /// BOOL → visibility. Show the role element when truthy, else hide it.
  setVisible(role, v) {
    const el = this.role(role);
    if (el) el.style.display = this.truthy(v) ? '' : 'none';
  }

  /// DISPLAY VALUE → set the role element's text. Hidden when the value is
  /// null/undefined/empty ("sichtbar != null"). Formatting is the host's job —
  /// it delivers the already-formatted string.
  /// @param opts.hideZero  OPTIONAL property key (a bool property). When that
  ///        property is 'true', a numeric 0 ALSO hides the field. This is a
  ///        SYMBOL PROPERTY — the symbol declares & sets it; the value flows
  ///        through the symbol, it is never hard-coded.
  setText(role, v, opts = {}) {
    const el = this.role(role);
    if (!el) return;
    const hideZero = opts.hideZero && this.prop(opts.hideZero) === 'true';
    const empty = (v === null || v === undefined || v === '' || (hideZero && Number(v) === 0));
    el.style.display = empty ? 'none' : '';
    if (!empty) {
      el.textContent = String(v);
      // Squish into the authored box width so long names (e.g. a variable's
      // group.tag) never overflow the symbol.
      const w = el.getAttribute('data-w');
      if (w) { el.setAttribute('textLength', w); el.setAttribute('lengthAdjust', 'spacingAndGlyphs'); }
    }
  }

  /// ANALOG (real/int) → geometry. Clamp v into an input range, lerp to an
  /// output range, and apply it to the role element. Optionally colour it by
  /// thresholds (green/amber/red).
  /// @param opts.map    'rotate' (needle, degrees) | 'fill-y' (bar, % via scale)
  ///                    | anything else → data-value
  /// @param opts.range  [min, max] of the INPUT. Each entry is a number OR a
  ///                    property KEY (string) read at runtime — so the operator
  ///                    can scale per instance (e.g. ['range_min','range_max']).
  /// @param opts.out    [outMin, outMax] of the OUTPUT (degrees / percent).
  /// @param opts.level  OPTIONAL [warnKey, alarmKey] property keys; the element
  ///                    turns #2ecc40 / #f39c12 / #e74c3c as v crosses them.
  setAnalog(role, v, opts) {
    const el = this.role(role);
    if (!el) return;
    const n = (x) => (typeof x === 'string' ? Number(this.prop(x)) : x);
    const lo = n(opts.range[0]), hi = n(opts.range[1]);
    const t = Math.max(0, Math.min(1, (Number(v) - lo) / (hi - lo)));
    const o = opts.out[0] + t * (opts.out[1] - opts.out[0]);
    if (opts.map === 'rotate')      el.setAttribute('transform', 'rotate(' + o + ')');
    else if (opts.map === 'fill-y') {
      // Fill from the element's BOTTOM up: scale(1,t) alone pivots on the SVG
      // origin (0,0), which slides the bar toward the canvas top instead of
      // draining it at its own base. Anchor the scale on the element's bottom
      // edge so 0% = empty at the bottom, 100% = full.
      const b = el.getBBox(), yb = b.y + b.height;
      el.setAttribute('transform',
        'translate(0 ' + yb + ') scale(1,' + (o / 100) + ') translate(0 ' + (-yb) + ')');
    }
    else                            el.setAttribute('data-value', o);
    if (opts.level) {
      const w = Number(this.prop(opts.level[0])), a = Number(this.prop(opts.level[1]));
      el.setAttribute('fill', Number(v) >= a ? '#e74c3c' : Number(v) >= w ? '#f39c12' : '#2ecc40');
    }
  }

  /// MOMENTARY CONTACT → wire pointer press/release on the role element to emit
  /// an out-connector. Emits 1 on press, 0 on release; inverted (NC) when the
  /// type property equals 'NC'. Emits the idle value once at mount.
  /// @param role     data-role of the pressable element (e.g. 'button')
  /// @param name     out-connector name to emit (e.g. 'contact')
  /// @param typeKey  OPTIONAL property key for NO/NC (e.g. 'contact_type').
  wireMomentary(role, name, typeKey) {
    const r = this.role(role);
    if (!r) return;
    const send = (pressed) => {
      const nc = typeKey && this.prop(typeKey) === 'NC';
      this.emit(name, nc ? (pressed ? 0 : 1) : (pressed ? 1 : 0));
    };
    r.style.cursor = 'pointer';
    r.onpointerdown = () => send(true);
    r.onpointerup   = () => send(false);
    send(false);
  }
}
]]></asset>
  <asset name="de.ftl" type="locale"><![CDATA[# Hearth — deutscher Sprachschatz.
#
# Die Schluessel sind ENGLISCH und nach dem ZWECK benannt, nicht nach dem
# deutschen Wort: `password-wrong`, nicht `passwort-falsch`. Sonst waere Deutsch
# die heimliche Ausgangssprache jeder weiteren Uebersetzung — und wer nach dem
# Knopf „Speichern" sucht, faende ihn in einer Datei, die er nicht lesen kann.
#
# Sortiert, damit ein fehlender Eintrag beim Vergleich mit en/hearth.ftl
# auffaellt.

