# Angaben ueber die Anlage — About-Dialog und /about.
organisation = Organisation
email = E-Mail
phone = Telefon
address = Anschrift
panel = Panel-Auflösung
notes = Notizen

# ── Kennwortrichtlinie — warum ein Kennwort abgelehnt wurde ──────────────────
# Jeder Grund ein eigener Schluessel: der Bediener soll nicht raten muessen,
# was noch fehlt. Eine Sammelmeldung („entspricht nicht der Richtlinie") ist die
# zuverlaessigste Art, jemanden dreimal hintereinander scheitern zu lassen.
pw-min-length = Mindestens { $need } Zeichen.
pw-too-short = Mindestens { $need } Zeichen (eingegeben: { $got }).
pw-too-long = Höchstens { $max } Zeichen (eingegeben: { $got }).
pw-needs-upper = Muss einen Großbuchstaben enthalten.
pw-needs-lower = Muss einen Kleinbuchstaben enthalten.
pw-needs-digit = Muss eine Ziffer enthalten.
pw-needs-symbol = Muss ein Sonderzeichen enthalten.
pw-needs-classes = Mindestens { $need } Zeichenklassen (verwendet: { $got }).
pw-contains-username = Darf den Anmeldenamen nicht enthalten.
pw-reused = Eines der letzten { $last } Kennwörter — bitte ein neues wählen.
pw-not-reused = Darf keines der letzten { $last } Kennwörter sein.
pw-forbidden = Dieses Kennwort ist nicht zulässig.

# Fehlten seit je: die Vorlage rief sie, kein Katalog fuehrte sie. Auf der
# Seite stand deshalb der ROHE Schluessel — gemeldet am 25.08.2026.
password-must-change = Das Passwort muss geändert werden, bevor es weitergeht.
repeat-password = Neues Passwort wiederholen
pw-mismatch = Die beiden neuen Passwörter stimmen nicht überein.
pw-wrong-old = Das aktuelle Passwort stimmt nicht.
pw-internal = Konnte nicht gespeichert werden — bitte erneut versuchen.
checked-on-save = Wird beim Speichern geprüft.

# Profil — die Kontaktdaten des BEDIENERS (nicht die der Anlage, die
# stehen in <meta> und erscheinen auf dem Splash).
contact-details = Kontaktdaten
phone-landline = Festnetz
phone-mobile = Mobil
not-logged-in = Nicht angemeldet — bitte neu anmelden.

# Dashboard — die Standards, die jede Anlage hat
version = Fassung
bridges = Brücken
variables = Variablen
connection = Verbindung
]]></asset>
