  <g hearth:layer="actions" hearth:layer-name="Actions" id="8e3b02af-4197-4d6c-b5e8-3f70a1c9d426"/>
  <script type="text/javascript">class extends HearthSymbol {

  // ── EIN GESKRIPTETES SVG, KEINE SMIL-LAWINE ────────────────────────────────
  //
  // Die aelteren Schoner (Winterstimmung, Sommerwiese) sind deklarativ: je
  // Flocke ein &lt;circle&gt; mit drei &lt;animate&gt;. Fuer Schnee reicht das — er faellt
  // auf Bahnen, die vorher feststehen. Wind tut das nicht: eine Boe wirkt auf
  // JEDES Blatt, das gerade in der Luft ist, und was sie tut, haengt davon ab,
  // wie das Blatt gerade steht. Das laesst sich nicht vorzeichnen.
  //
  // Also rechnet diese Klasse je Bild, und das SVG traegt nur, was man sieht:
  // sechs Blattformen in &lt;defs&gt;, ein &lt;use&gt; je Blatt, EIN &lt;rect&gt; fuer den ganzen
  // Regen (ein Muster, das wandert — nicht tausend Striche).

  onInit() {
    const NS = 'http://www.w3.org/2000/svg';
    this.mkEl = (tag, attrs, parent) =&gt; {
      const el = document.createElementNS(NS, tag);
      for (const k in attrs) el.setAttribute(k, attrs[k]);
      (parent || this.root).appendChild(el);
      return el;
    };

    this.W = 1920; this.H = 1080; this.HY = 748;
    this.uid = 'hb' + Math.floor(Math.random() * 1e9).toString(36);

    const num = (key, dflt, lo, hi) =&gt; {
      const v = parseFloat(this.prop(key));
      return isFinite(v) ? Math.min(hi, Math.max(lo, v)) : dflt;
    };
    this.leafBase   = num('leaves', 46, 6, 160);
    this.phaseSecs  = num('weather_secs', 26, 8, 300);
    this.rainAllowed = this.prop('rain') !== 'false';
    this.boltAllowed = this.prop('lightning') !== 'false';
    this.driftAllowed = this.prop('drift') !== 'false';
    // Leer = echte Uhr. Eine Zahl friert die Tageszeit ein — damit der
    // Entwerfer die Nacht sehen kann, ohne bis Mitternacht zu warten.
    const h = parseFloat(this.prop('hour'));
    this.hourForced = isFinite(h) ? ((h % 24) + 24) % 24 : null;

    // Die Arten. Die Formen liegen als &lt;defs&gt; in der Datei — hier steht nur,
    // wie haeufig eine faellt, wie gross sie wird und in welchen Toenen.
    this.species = [
      { id:'ahorn',    w:.22, min:34, max:62, tints:['#C4362A','#D45A25','#E07B2A','#AE2F33'] },
      { id:'buche',    w:.24, min:26, max:44, tints:['#C9772A','#D99433','#AE5E22','#E3B04A'] },
      { id:'eiche',    w:.18, min:32, max:52, tints:['#7B5326','#8F6B33','#63431F','#A07A38'] },
      { id:'kastanie', w:.10, min:40, max:68, tints:['#8E5A22','#A9711F','#7A4A1E','#B98B30'] },
      { id:'birke',    w:.14, min:20, max:33, tints:['#E2C13F','#D9AE2E','#EFD35C','#C9A32B'] },
      { id:'linde',    w:.12, min:29, max:47, tints:['#A7A83A','#C0B840','#8E9432','#D0C455'] }
    ];
    // Die Unterseite ist matter — deshalb sieht man ein taumelndes Blatt
    // blinken. Einmal gerechnet, nicht je Bild.
    for (const sp of this.species) {
      sp.backs = sp.tints.map((c) =&gt; this.blend(c, '#CFC3A8', .44));
      sp.cum = 0;
    }
    let sum = 0;
    for (const sp of this.species) { sum += sp.w; sp.cum = sum; }
    for (const sp of this.species) sp.cum /= sum;

    // Die Wetterlagen. Eine Runde faehrt sie der Reihe nach ab — sie ist
    // komponiert und nicht gewuerfelt: wer zehn Minuten zusieht, soll Stille,
    // Boe, Sturm, Regen und Gewitter gesehen haben.
    this.weathers = [
      { name:'Windstille',    wind: 18, gust:.18, rain:0,    sky:['#2C3B4C','#7F6A52','#C98B4B'] },
      { name:'Leichte Brise', wind: 76, gust:.45, rain:0,    sky:['#253141','#5E5748','#9C7247'] },
      { name:'Frischer Wind', wind:170, gust:.72, rain:.06,  sky:['#202A36','#474B4C','#7A6A55'] },
      { name:'Landregen',     wind:128, gust:.50, rain:.72,  sky:['#232A31','#3D444A','#6A6255'] },
      { name:'Sturm',         wind:382, gust:1.05,rain:.30,  sky:['#181D25','#33363F','#5A5347'] },
      { name:'Gewitterboeen', wind:490, gust:1.35,rain:1.00, sky:['#12151B','#252932','#3F4140'], bolt:true },
      { name:'Abflauen',      wind: 58, gust:.34, rain:.18,  sky:['#26313E','#59544B','#8E6D4C'] }
    ];

    this.layers = [
      { g:this.role('trees-far'),  base:736, mul:.42, ph:0.4 },
      { g:this.role('trees-mid'),  base:770, mul:.72, ph:2.1 },
      { g:this.role('trees-near'), base:800, mul:1.0, ph:4.3 }
    ].filter((l) =&gt; l.g);

    this.leafHost   = this.role('leaves');
    this.litterHost = this.role('litter');
    this.flashEl    = this.role('flash');
    this.hazeEl     = this.role('haze');
    this.driftEl    = this.role('drift');
    this.sunEl      = this.role('sun');
    this.villageEl  = this.role('village');
    this.lightsEl   = this.role('village-lights');
    this.starHost   = this.role('stars');
    this.moonHost   = this.role('moon');
    this.farEl      = this.role('trees-far');
    this.farBase    = parseFloat(this.farEl &amp;&amp; this.farEl.getAttribute('fill-opacity')) || 0.58;
    this.stops = [this.role('sky-top'), this.role('sky-mid'), this.role('sky-low')];
    // Der Boden gehoert zum selben Tag wie der Himmel. Stuende er fest, waere
    // er nachts ein hell leuchtendes Band unter einem dunklen Himmel — genau
    // das war am 12.09.2026 im Nachtbild zu sehen.
    this.gnd = [this.role('gnd-top'), this.role('gnd-low')];
    this.gndBase = [this.hexToRgb('#3B3127'), this.hexToRgb('#141110')];
    this.gndNow = [this.gndBase[0].slice(), this.gndBase[1].slice()];

    // ── DIE STEHENDEN BLAETTER ────────────────────────────────────────────
    //
    // Im Markup liegen ein paar Blaetter fest in der Luft. Sie sind fuer das
    // RUHENDE Bild da — die Kachel der Bibliothek zeichnet Qt-SVG, ohne
    // Skript, und ein leerer Himmel waere dort eine Luege ueber das, was der
    // Schoner tut.
    //
    // Sobald gerechnet wird, sind sie falsch: das Skript bewegt nur, was es
    // selbst erzeugt, und sie haengen unbewegt zwischen den fallenden. Genau
    // das war am 12.09.2026 auf der Zeichenflaeche zu sehen. Die Streu am
    // Boden bleibt — die soll liegen.
    while (this.leafHost &amp;&amp; this.leafHost.firstChild)
      this.leafHost.removeChild(this.leafHost.firstChild);

    this.buildRain();
    this.buildNight();

    this.leaves = []; this.litter = [];
    this.pile = new Float32Array(110);
    this.time = 0; this.scour = 0; this.raf = 0; this.running = false;
    this.wIndex = 2; this.wTime = 0; this.wDur = this.phaseSecs; this.dirSign = 1;
    this.wind = 150; this.windTarget = 170; this.gustAmp = .72; this.gustNow = 1;
    this.rain = .06; this.flash = 0; this.bolt = 3;
    this.sky = [this.hexToRgb('#202A36'), this.hexToRgb('#474B4C'), this.hexToRgb('#7A6A55')];
    this.skyAcc = 0;
    this.dayF = this.daylight();
    this.clear = 0.5;

    // VORGEWAERMT: sonst zeigt das erste Bild einen leeren Himmel, und der
    // Anwender sieht den Schoner in der Sekunde anlaufen, in der er ihn
    // braucht. Nur die Physik — gezeichnet wird erst im ersten echten Bild.
    for (let i = 0; i &lt; 320; i++) this.advance(1 / 50);

    // ── ER LAEUFT NUR, WENN ER ZU SEHEN IST ─────────────────────────────────
    //
    // Im Kompilat haengt das Bild VERSTECKT im Screen (`[data-ss-art]`) und
    // wird erst bei Untaetigkeit ins Overlay gehoben (`[data-ss-buehne]`,
    // screen-runtime.js). Ein &lt;script&gt; im SVG laeuft aber schon beim Parsen —
    // ohne diese Klammer rechnete ein Bedienpanel rund um die Uhr an einem
    // Bild, das niemand sieht. Ein halbes Herz je Sekunde kostet nichts.
    this.gate = setInterval(() =&gt; this.checkStage(), 500);
    this.onVisible = () =&gt; this.checkStage();
    document.addEventListener('visibilitychange', this.onVisible);
    this.checkStage();
  }

  onDestroy() {
    this.halt();
    if (this.gate) { clearInterval(this.gate); this.gate = 0; }
    if (this.onVisible) document.removeEventListener('visibilitychange', this.onVisible);
  }

  // ── Werkzeug ───────────────────────────────────────────────────────────────

  hexToRgb(h) {
    return [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
  }
  rgbToHex(c) {
    const p = (v) =&gt; ('0' + Math.max(0, Math.min(255, Math.round(v))).toString(16)).slice(-2);
    return '#' + p(c[0]) + p(c[1]) + p(c[2]);
  }
  blend(a, b, t) {
    const x = this.hexToRgb(a), y = this.hexToRgb(b);
    return this.rgbToHex([x[0] + (y[0] - x[0]) * t, x[1] + (y[1] - x[1]) * t, x[2] + (y[2] - x[2]) * t]);
  }
  rnd(a, b) { return a + Math.random() * (b - a); }
  clamp(v, a, b) { return v &lt; a ? a : (v &gt; b ? b : v); }

  // ── Regen: EIN Rechteck, ein wanderndes Muster ──────────────────────────────
  //
  // Tausend &lt;line&gt; je Bild waeren tausend Attributschreibungen; das Muster
  // kostet ZWEI, gleich wie dicht es regnet. Die wenigen Tropfen davor stehen
  // in EINEM &lt;path&gt; — auch das eine Schreibung.
  buildRain() {
    let defs = this.root.querySelector('defs');
    if (!defs) defs = this.mkEl('defs', {});
    this.pattern = this.mkEl('pattern', {
      id: this.uid + '-rain', width: 96, height: 170, patternUnits: 'userSpaceOnUse'
    }, defs);
    this.mkEl('path', {
      d: 'M18 -10L18 112M57 26L57 162M84 -30L84 62M39 74L39 168M71 -6L71 96',
      stroke: '#C6D8EA', 'stroke-width': 1.7, 'stroke-linecap': 'round',
      'stroke-opacity': .55, fill: 'none'
    }, this.pattern);

    const host = this.role('rain') || this.root;
    this.rainRect = this.mkEl('rect', {
      x: -700, y: -500, width: 3400, height: 2200,
      fill: 'url(#' + this.uid + '-rain)', 'fill-opacity': 0
    }, host);
    this.dropsPath = this.mkEl('path', {
      d: '', stroke: '#DCE8F4', 'stroke-width': 2.4, 'stroke-linecap': 'round',
      'stroke-opacity': 0, fill: 'none'
    }, host);
    this.splashPath = this.mkEl('path', {
      d: '', stroke: '#C6D8EA', 'stroke-width': 1.6, 'stroke-linecap': 'round',
      'stroke-opacity': 0, fill: 'none'
    }, host);
    this.patX = 0; this.patY = 0;
    this.drops = [];
    for (let i = 0; i &lt; 16; i++) this.drops.push({ x: this.rnd(0, this.W), y: this.rnd(-200, this.HY), z: this.rnd(.6, 1) });
    this.splashes = [];
  }

  // ── DIE TAGESZEIT ──────────────────────────────────────────────────────────
  //
  // 0 = tiefe Nacht, 0,5 = Sonnenauf-/-untergang, 1 = Mittag. Die Schwelle
  // liegt bei Ende Oktober in Deutschland: auf gegen 7:45, unter gegen 18:15,
  // Daemmerung gut eine Stunde. Genau bei rise und set ist der Wert 0,5 —
  // dort steht die goldene Stunde, und die ist die Farbtafel, die in der
  // Datei steht.
  daylight() {
    const d = new Date();
    const h = this.hourForced !== null
      ? this.hourForced
      : d.getHours() + d.getMinutes() / 60;
    const rise = 7.75, set = 18.25, tw = 1.3;
    const up   = this.smooth(rise - tw, rise + tw, h);
    const down = 1 - this.smooth(set - tw, set + tw, h);
    // Die STUNDE bleibt stehen — die Sonnenbahn braucht sie, und zweimal
    // dieselbe Uhr zu lesen hiesse, zwei Zeiten im selben Bild zu haben.
    this.hourNow = h;
    return Math.min(up, down);
  }

  // ── DIE SONNE WANDERT ───────────────────────────────────────────────────
  //
  // Sie stand fest bei (1512|326) und wurde nur auf- und abgeblendet: der
  // Horizont war damit zu jeder Tageszeit an derselben Stelle hell. Eine
  // Sonne, die sich nicht bewegt, nimmt dem Bild die Zeit — man sieht, DASS
  // es Tag ist, aber nicht WANN.
  //
  // Jetzt laeuft sie den Tag ab: Aufgang im Osten (links), Mittag hoch in der
  // Mitte, Untergang im Westen (rechts). Der Bogen ist ein Sinus ueber dem
  // Horizont — zur Daemmerung steht sie darauf, mittags am hoechsten.
  //
  // Der MOND laeuft gegenlaeufig auf derselben Bahn: er steht, wo die Sonne
  // nicht ist. Das ist astronomisch grob und optisch richtig — beide zugleich
  // am selben Fleck waere schlimmer als beide zu weit auseinander.
  sunArc(h, tag) {
    const rise = 7.75, set = 18.25;
    // 0 bei Aufgang, 1 bei Untergang; darueber hinaus laeuft sie weiter, damit
    // sie zur Daemmerung nicht springt.
    const t = (h - rise) / (set - rise);
    const x = -180 + t * (this.W + 360);
    // Die Hoehe: am Horizont zur Daemmerung, mittags bei einem Drittel der
    // Bildhoehe. `Math.sin` ueber [0,pi] gibt genau diesen Bogen.
    const y = this.HY - 40 - Math.sin(Math.max(0, Math.min(1, t)) * Math.PI) * (this.HY - 190);
    return { x, y };
  }
  smooth(a, b, x) {
    const t = this.clamp((x - a) / (b - a), 0, 1);
    return t * t * (3 - 2 * t);
  }

  // ── DER STERNENHIMMEL ──────────────────────────────────────────────────────
  //
  // Das Funkeln steht als SMIL an den Sternen selbst und nicht in der
  // Rechenschleife: es ist eine Bahn, die vorher feststeht, und genau dafuer
  // ist SMIL da. So kosten hundertfuenfzig Sterne je Bild NULL Schreibungen —
  // das Skript fasst nur die Deckung der GRUPPE an.
  buildNight() {
    if (this.starHost) {
      for (let i = 0; i &lt; 150; i++) {
        const x = this.rnd(0, this.W);
        const y = this.rnd(0, this.HY * 0.86);
        // Oben klarer als am Horizont — dort steht der Dunst.
        const hoch = 1 - y / (this.HY * 0.86);
        const r = this.rnd(0.7, 1.5) + (Math.random() &lt; 0.08 ? 1.1 : 0);
        const a = (0.25 + 0.7 * Math.random()) * (0.35 + 0.65 * hoch);
        const s = this.mkEl('circle', {
          cx: x.toFixed(1), cy: y.toFixed(1), r: r.toFixed(2),
          fill: Math.random() &lt; .18 ? '#CFE0FF' : '#FFF6E2',
          opacity: a.toFixed(3)
        }, this.starHost);
        if (Math.random() &lt; 0.45) {
          const an = this.mkEl('animate', {
            attributeName: 'opacity',
            values: (a * 0.35).toFixed(3) + ';' + a.toFixed(3) + ';' + (a * 0.35).toFixed(3),
            dur: this.rnd(2.6, 7.5).toFixed(1) + 's',
            begin: (-this.rnd(0, 7)).toFixed(1) + 's',
            repeatCount: 'indefinite'
          }, s);
          void an;
        }
      }
    }
    if (this.moonHost) {
      let defs = this.root.querySelector('defs');
      if (!defs) defs = this.mkEl('defs', {});
      const g = this.mkEl('radialGradient', { id: this.uid + '-moon' }, defs);
      this.mkEl('stop', { offset: '0', 'stop-color': '#DCE6F5', 'stop-opacity': '0.42' }, g);
      this.mkEl('stop', { offset: '0.28', 'stop-color': '#BFCEE4', 'stop-opacity': '0.14' }, g);
      this.mkEl('stop', { offset: '1', 'stop-color': '#BFCEE4', 'stop-opacity': '0' }, g);
      this.mkEl('circle', { cx: 408, cy: 232, r: 190, fill: 'url(#' + this.uid + '-moon)' }, this.moonHost);
      this.mkEl('circle', { cx: 408, cy: 232, r: 52, fill: '#E8EEF8' }, this.moonHost);
      // Maria — ohne sie ist es eine Lampe, kein Mond.
      this.mkEl('circle', { cx: 392, cy: 218, r: 15, fill: '#CBD6E6', opacity: '.55' }, this.moonHost);
      this.mkEl('circle', { cx: 424, cy: 246, r: 10, fill: '#CBD6E6', opacity: '.45' }, this.moonHost);
      this.mkEl('circle', { cx: 415, cy: 211, r: 7, fill: '#CBD6E6', opacity: '.4' }, this.moonHost);
    }
  }

  // ── Anlauf und Halt ────────────────────────────────────────────────────────

  checkStage() {
    const gated = this.root.hasAttribute('data-ss-art') || !!this.root.closest('[data-ss-art]');
    const shown = gated ? !!this.root.closest('[data-ss-buehne]') : true;
    if (shown &amp;&amp; !document.hidden) this.run(); else this.halt();
  }
  run() {
    if (this.running) return;
    this.running = true;
    this.last = (typeof performance !== 'undefined' ? performance.now() : Date.now());
    const tick = (now) =&gt; {
      if (!this.running) return;
      const dt = Math.min(.05, (now - this.last) / 1000);
      this.last = now;
      this.advance(dt);
      this.paint(dt);
      this.raf = requestAnimationFrame(tick);
    };
    this.raf = requestAnimationFrame(tick);
  }
  halt() {
    this.running = false;
    if (this.raf) { cancelAnimationFrame(this.raf); this.raf = 0; }
  }

  // ── Wind ───────────────────────────────────────────────────────────────────
  //
  // Eine Boe ist nicht ueberall gleich. Drei Sinus mit fremden Perioden ergeben
  // ein Feld, das sich nie wiederholt und trotzdem nichts kostet.
  turb(x, y, t) {
    return Math.sin(x * .0034 + t * .55) * .5
         + Math.sin(y * .0054 - t * .41 + 1.7) * .3
         + Math.sin((x + y) * .0025 + t * .83 + 4.2) * .2;
  }
  windAt(x, y) { return this.wind * this.gustNow * (1 + this.gustAmp * .55 * this.turb(x, y, this.time)); }
  windUp(x, y) { return this.wind * this.gustAmp * .30 * this.turb(y * 1.7 + 300, x * .8, this.time * .9); }

  groundAt(x) { return this.HY + 18 + 12 * Math.sin(x * .0042) + 6 * Math.sin(x * .0105 + 1.4); }
  bucketAt(x) { return this.clamp(Math.floor(x / this.W * 110), 0, 109); }
  restAt(x, z) { return this.groundAt(x) + 240 * z - this.pile[this.bucketAt(x)] * (.35 + .65 * z); }

  // ── Ein Blatt ──────────────────────────────────────────────────────────────

  pickSpecies() {
    const r = Math.random();
    for (const sp of this.species) if (r &lt;= sp.cum) return sp;
    return this.species[0];
  }

  spawn() {
    const sp = this.pickSpecies();
    const z = Math.pow(Math.random(), .8);
    const tint = Math.floor(Math.random() * sp.tints.length);
    const leaf = {
      sp: sp, tint: tint, side: 1,
      size: this.rnd(sp.min, sp.max) * (.42 + .78 * z),
      x: 0, y: 0, vx: 0, vy: 0,
      ang: this.rnd(-180, 180), spin: this.rnd(-95, 95),
      flip: this.rnd(0, 6.283), flipRate: this.rnd(1.4, 3.6) * (Math.random() &lt; .5 ? -1 : 1),
      phase: this.rnd(0, 6.283), phaseRate: this.rnd(2.2, 4.2),
      wet: this.rain * .6, z: z,
      el: null
    };
    const el = this.mkEl('use', {
      fill: sp.tints[tint], 'fill-opacity': (.45 + .55 * z).toFixed(2)
    }, this.leafHost);
    el.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', '#hb-leaf-' + sp.id);
    el.setAttribute('href', '#hb-leaf-' + sp.id);
    leaf.el = el;
    this.place(leaf);
    this.leaves.push(leaf);
    return leaf;
  }

  // Woher es kommt: bei Wind von der LUV-SEITE, sonst von oben. Ein Sturm, der
  // seine Blaetter nur von oben schneien laesst, sieht aus wie Schneefall.
  place(l) {
    if (Math.abs(this.wind) &gt; 175 &amp;&amp; Math.random() &lt; .55) {
      l.x = this.wind &gt; 0 ? -70 : this.W + 70;
      l.y = this.rnd(-50, this.HY + 20);
      l.vx = this.wind * this.rnd(.5, .9);
      l.vy = this.rnd(-25, 70);
    } else {
      l.x = this.rnd(-90, this.W + 90);
      l.y = this.rnd(-180, -30);
      l.vx = this.wind * this.rnd(.2, .6);
      l.vy = this.rnd(12, 60);
    }
  }

  // Gelandet: das &lt;use&gt; wandert in die Streu und wird nie wieder angefasst.
  // Es liegt da, kostet kein Bild mehr und ist trotzdem noch da.
  bed(l) {
    const b = this.bucketAt(l.x);
    this.pile[b] = Math.min(26, this.pile[b] + .30);
    const y = this.restAt(l.x, l.z);
    const k = l.size / 100;
    l.el.setAttribute('transform',
      'translate(' + l.x.toFixed(1) + ',' + y.toFixed(1) + ') rotate(' +
      this.rnd(-180, 180).toFixed(0) + ') scale(' +
      (k * this.rnd(.55, 1) * (Math.random() &lt; .5 ? -1 : 1)).toFixed(3) + ',' + k.toFixed(3) + ')');
    this.litterHost.appendChild(l.el);
    this.litter.push({ el: l.el, x: l.x });
    if (this.litter.length &gt; 200) {
      const old = this.litter.shift();
      if (old.el.parentNode) old.el.parentNode.removeChild(old.el);
    }
  }

  // Der Sturm fegt die Streu wieder auf — das ist der Teil, den man auf einem
  // Hof im Herbst tatsaechlich sieht.
  scourOne() {
    if (!this.litter.length) return;
    const i = Math.floor(Math.random() * this.litter.length);
    const p = this.litter.splice(i, 1)[0];
    if (p.el.parentNode) p.el.parentNode.removeChild(p.el);
    const b = this.bucketAt(p.x);
    this.pile[b] = Math.max(0, this.pile[b] - .30);
    const l = this.spawn();
    l.x = p.x; l.y = this.restAt(p.x, l.z) - 3;
    l.vx = this.wind * this.rnd(.35, .7);
    l.vy = -this.rnd(60, 240);
    l.spin = this.rnd(-240, 240);
  }

  // ── Eine Wetterlage ────────────────────────────────────────────────────────

  nextWeather() {
    this.wIndex = (this.wIndex + 1) % this.weathers.length;
    const w = this.weathers[this.wIndex];
    this.wTime = 0;
    this.wDur = this.phaseSecs * this.rnd(.8, 1.35);
    if (Math.random() &lt; .22) this.dirSign = -this.dirSign;
    this.windTarget = w.wind * this.dirSign;
    this.gustAmp = w.gust;
    this.bolt = this.rnd(1.5, 5);
  }

  // ── Rechnen ────────────────────────────────────────────────────────────────

  advance(dt) {
    this.time += dt;
    this.wTime += dt;
    if (this.wTime &gt; this.wDur) this.nextWeather();
    const w = this.weathers[this.wIndex];

    // Auffrischen geht schnell, Abflauen langsam — so ist es draussen auch.
    const rising = Math.abs(this.windTarget) &gt; Math.abs(this.wind);
    this.wind += (this.windTarget - this.wind) * (1 - Math.exp(-dt / (rising ? 3.2 : 7.5)));
    const rainWant = this.rainAllowed ? w.rain : 0;
    this.rain += (rainWant - this.rain) * (1 - Math.exp(-dt / 6));

    this.gustNow = Math.max(.15, 1 + this.gustAmp * (
      .62 * Math.sin(this.time * .27) +
      .38 * Math.sin(this.time * .71 + 2.1) +
      .22 * Math.sin(this.time * 1.9 + 4.4)));

    // ── WETTER UND TAGESZEIT AN DERSELBEN FARBTAFEL ────────────────────────
    //
    // Die Tafel in der Datei ist die GOLDENE STUNDE dieser Wetterlage. Von
    // dort geht es in beide Richtungen: zur Nacht hin in ein tiefes Blau, zum
    // Mittag hin ins Helle. Eine zweite Tafel je Tageszeit waere dieselbe
    // Sache an einer zweiten Stelle — und die zweite ist die, die beim
    // naechsten Wetter vergessen wird.
    this.dayF += (this.daylight() - this.dayF) * (1 - Math.exp(-dt / 4));
    // Wieviel Himmel ueberhaupt zu sehen ist: Regen und Boeen decken ihn zu.
    const offen = 1 - Math.min(1, w.rain * 1.3 + w.gust * 0.35);
    this.clear += (offen - this.clear) * (1 - Math.exp(-dt / 7));

    const want = w.sky;
    const k = 1 - Math.exp(-dt / 5);
    const NACHT = [7, 10, 18], TAG = [159, 182, 201];
    // Der Horizont bleibt am laengsten warm und wird am wenigsten blau.
    const nachtAnteil = [.86, .84, .78], tagAnteil = [.55, .42, .24];
    for (let i = 0; i &lt; 3; i++) {
      const basis = this.hexToRgb(want[i]);
      const to = [0, 0, 0];
      for (let c = 0; c &lt; 3; c++) {
        const nacht = basis[c] + (NACHT[c] - basis[c]) * nachtAnteil[i];
        const tag   = basis[c] + (TAG[c]   - basis[c]) * tagAnteil[i];
        to[c] = this.dayF &lt; .5
          ? nacht + (basis[c] - nacht) * (this.dayF * 2)
          : basis[c] + (tag - basis[c]) * ((this.dayF - .5) * 2);
      }
      for (let c = 0; c &lt; 3; c++) this.sky[i][c] += (to[c] - this.sky[i][c]) * k;
    }
    const ERDE_TAG = [110, 91, 68];
    const gndNacht = [.74, .58], gndTag = [.34, .20];
    for (let i = 0; i &lt; 2; i++) {
      const basis = this.gndBase[i];
      for (let c = 0; c &lt; 3; c++) {
        const nacht = basis[c] + (NACHT[c] - basis[c]) * gndNacht[i];
        const tag   = basis[c] + (ERDE_TAG[c] - basis[c]) * gndTag[i];
        const to = this.dayF &lt; .5
          ? nacht + (basis[c] - nacht) * (this.dayF * 2)
          : basis[c] + (tag - basis[c]) * ((this.dayF - .5) * 2);
        this.gndNow[i][c] += (to - this.gndNow[i][c]) * k;
      }
    }

    this.flash *= Math.exp(-dt * 5.5);
    if (w.bolt &amp;&amp; this.boltAllowed) {
      this.bolt -= dt;
      if (this.bolt &lt;= 0) { this.flash = this.rnd(.6, 1); this.bolt = this.rnd(2.2, 7.5); }
    }

    const target = Math.round(this.leafBase * (.55 + .85 * Math.min(1, Math.abs(this.wind) / 382)));
    if (this.leaves.length &lt; target) this.spawn();
    if (this.leaves.length &lt; target - 20) this.spawn();

    this.scour += Math.max(0, Math.abs(this.wind) * this.gustNow / 382 - .52) * 34 * dt;
    while (this.scour &gt;= 1) { this.scour -= 1; this.scourOne(); }

    const g = 340;
    for (let i = this.leaves.length - 1; i &gt;= 0; i--) {
      const l = this.leaves[i];
      const depth = .55 + .45 * l.z;
      const wx = this.windAt(l.x, l.y) * depth;
      const wy = this.windUp(l.x, l.y) * depth;

      // ── WARUM EIN BLATT TAUMELT ───────────────────────────────────────────
      //
      // Breitseits hat es viel Flaeche und faellt langsam; hochkant schneidet
      // es und faellt schnell. `flip` ist die Drehung um die eigene Laengsachse
      // — sie steuert BEIDES: den Luftwiderstand und, als Skalierung in x, wie
      // schmal man das Blatt sieht. Eine Groesse, zwei Wirkungen, so wie in der
      // Luft auch.
      const c = Math.cos(l.flip);
      const area = .34 + .66 * Math.abs(c);
      const drag = 2.35 * area;
      const mass = 1 + l.wet * .55;

      l.phase += l.phaseRate * dt * (.6 + Math.min(2, Math.abs(l.vy) * .009));
      // Nasses Laub taumelt nicht, es klatscht.
      const flutter = (1 - l.wet * .68) * 62 * Math.abs(c) * Math.sin(l.phase);

      l.vx += ((wx - l.vx) * drag + flutter) * dt;
      l.vy += (g * mass + (wy - l.vy) * drag) * dt;
      l.x += l.vx * dt;
      l.y += l.vy * dt;

      const rel = Math.hypot(l.vx - wx, l.vy - wy);
      l.flip += l.flipRate * (.4 + rel * .008) * dt;
      l.ang += (l.spin * (.3 + rel * .005) + l.vx * .09) * dt;
      l.wet += (this.rain - l.wet) * (1 - Math.exp(-dt / 3.5));

      const rest = this.restAt(l.x, l.z);
      if (l.y &gt;= rest) {
        // Bei Sturm bleibt nichts liegen — es huepft und schlittert weiter.
        if (Math.abs(this.wind) * this.gustNow &gt; 270 &amp;&amp; Math.random() &lt; .72) {
          l.y = rest - 2;
          l.vy = -Math.abs(l.vy) * .28 - this.rnd(15, 80);
          l.vx = l.vx * 1.15 + this.wind * .10;
        } else {
          this.bed(l);
          this.leaves.splice(i, 1);
          continue;
        }
      }
      if (l.x &lt; -190 || l.x &gt; this.W + 190 || l.y &lt; -520) {
        if (this.leaves.length &gt; target) {
          if (l.el.parentNode) l.el.parentNode.removeChild(l.el);
          this.leaves.splice(i, 1);
          continue;
        }
        this.place(l);
      }
    }

    // Die Tropfen davor
    if (this.rain &gt; .02) {
      for (const d of this.drops) {
        d.y += (900 + d.z * 700) * dt;
        d.x += this.wind * (.55 + d.z * .35) * dt;
        const floor = this.groundAt(d.x) + 40 * d.z;
        if (d.y &gt; floor) {
          if (this.splashes.length &lt; 26) this.splashes.push({ x: d.x, y: floor, r: 2, life: 1 });
          d.y = this.rnd(-260, -20); d.x = this.rnd(-200, this.W + 200); d.z = this.rnd(.6, 1);
        }
        if (d.x &lt; -300 || d.x &gt; this.W + 300) { d.x = this.wind &gt; 0 ? -200 : this.W + 200; }
      }
    }
    for (let i = this.splashes.length - 1; i &gt;= 0; i--) {
      const s = this.splashes[i];
      s.r += 34 * dt; s.life -= dt * 2.6;
      if (s.life &lt;= 0) this.splashes.splice(i, 1);
    }
  }

  // ── Zeichnen ───────────────────────────────────────────────────────────────

  paint(dt) {
    // Der Himmel wechselt langsam — vier Schreibungen je Sekunde genuegen,
    // sechzig waeren Arbeit fuer einen Unterschied, den niemand sieht.
    this.skyAcc += dt;
    if (this.skyAcc &gt; .25) {
      this.skyAcc = 0;
      for (let i = 0; i &lt; 3; i++)
        if (this.stops[i]) this.stops[i].setAttribute('stop-color', this.rgbToHex(this.sky[i]));
      if (this.hazeEl) this.hazeEl.setAttribute('fill-opacity', (.06 + this.rain * .40).toFixed(3));

      // Nacht = 1 unterhalb der Daemmerung. Sterne nur, soweit der Himmel
      // offen ist — im Gewitter sieht man keine.
      const nacht = this.clamp((0.30 - this.dayF) / 0.30, 0, 1);
      if (this.starHost) this.starHost.setAttribute('opacity', (nacht * this.clear).toFixed(3));
      if (this.moonHost) this.moonHost.setAttribute('opacity', (nacht * this.clear * .92).toFixed(3));
      if (this.sunEl) {
        this.sunEl.setAttribute('opacity', this.clamp(this.dayF * 1.6 - .2, 0, 1).toFixed(3));
        const b = this.sunArc(this.hourNow, this.dayF);
        this.sunEl.setAttribute('cx', b.x.toFixed(1));
        this.sunEl.setAttribute('cy', b.y.toFixed(1));
      }
      // Der Mond auf derselben Bahn, um zwoelf Stunden versetzt.
      if (this.moonHost) {
        const b = this.sunArc((this.hourNow + 12) % 24, 1 - this.dayF);
        this.moonHost.setAttribute('transform',
          'translate(' + (b.x - 1512).toFixed(1) + ',' + (b.y - 326).toFixed(1) + ')');
      }
      // ── DAS DORF ──────────────────────────────────────────────────────
      // Es steht in derselben Ferne wie die Waldkante und verhaelt sich auch
      // so: am Tag Dunst, nachts fast schwarz. Die FENSTER laufen gegen den
      // Tag — sie gehen an, wenn es dunkel wird.
      if (this.villageEl)
        this.villageEl.setAttribute('fill-opacity', (0.72 * (.46 + .54 * this.dayF)).toFixed(3));
      if (this.lightsEl)
        this.lightsEl.setAttribute('opacity', (nacht * this.clear * .85).toFixed(3));
      // Die ferne Waldkante ist am Tag Dunst und nachts fast schwarz.
      if (this.farEl)
        this.farEl.setAttribute('fill-opacity', (this.farBase * (.42 + .58 * this.dayF)).toFixed(3));
      for (let i = 0; i &lt; 2; i++)
        if (this.gnd[i]) this.gnd[i].setAttribute('stop-color', this.rgbToHex(this.gndNow[i]));
      // Laub im Mondlicht ist gedaempft, nicht bunt. Deckung an der GRUPPE:
      // sie wird EINMAL verrechnet, die Blaetter scheinen also nicht
      // durcheinander hindurch — und es kostet zwei Schreibungen, nicht 200.
      const laub = (.58 + .42 * this.dayF).toFixed(3);
      if (this.leafHost)   this.leafHost.setAttribute('opacity', laub);
      if (this.litterHost) this.litterHost.setAttribute('opacity', laub);
    }

    // ── EINBRENNSCHUTZ ─────────────────────────────────────────────────────
    //
    // Ein Bedienpanel zeigt diesen Schoner stundenlang, und der Himmel, die
    // Waldkante und der Boden stehen dabei still. Genau daran brennt ein
    // Panel ein. Also wandert das ganze Bild langsam — zwei Perioden, die
    // kein gemeinsames Vielfaches haben (53 s und 41 s), damit sich die Bahn
    // nicht wiederholt und kein Bildpunkt eine Vorzugsfarbe bekommt.
    //
    // Die Vergroesserung um 11 % ist kein Schmuck: sie schafft den Rand, in
    // den hinein gewandert wird. Ohne sie lugte bei jedem Ausschlag der
    // Hintergrund des Overlays hervor — ein Streifen, der auf einem Panel
    // nach einem Fehler aussieht.
    //
    // Blitz und Vignette liegen ausserhalb dieser Gruppe: sie gehoeren zum
    // Schirm, nicht zur Landschaft, und duerfen nicht mitwandern.
    if (this.driftEl &amp;&amp; this.driftAllowed) {
      const dx = 80 * Math.sin(this.time * 2 * Math.PI / 53);
      const dy = 44 * Math.sin(this.time * 2 * Math.PI / 41 + 1.1);
      const s = 1.11, cx = this.W / 2, cy = this.H / 2;
      this.driftEl.setAttribute('transform',
        'translate(' + (dx + cx - cx * s).toFixed(2) + ',' + (dy + cy - cy * s).toFixed(2) +
        ') scale(' + s + ')');
    }

    // Die Baumreihen neigen sich. Geschert um ihre eigene Fusslinie: dort ist
    // der Stamm im Boden und bewegt sich nicht, oben am meisten.
    for (const L of this.layers) {
      const k = (this.wind * .00022 + .006 * Math.sin(this.time * 1.25 + L.ph) * (1 + this.gustAmp)) * L.mul;
      L.g.setAttribute('transform', 'matrix(1,0,' + k.toFixed(5) + ',1,' + (-k * L.base).toFixed(2) + ',0)');
    }

    for (const l of this.leaves) {
      const c = Math.cos(l.flip);
      const sx = c &lt; 0 ? Math.min(c, -.09) : Math.max(c, .09);
      const k = l.size / 100;
      l.el.setAttribute('transform',
        'translate(' + l.x.toFixed(1) + ',' + l.y.toFixed(1) + ') rotate(' +
        l.ang.toFixed(1) + ') scale(' + (k * sx).toFixed(3) + ',' + k.toFixed(3) + ')');
      // Beim Kippen schlaegt die Unterseite um — nur DANN geschrieben.
      const side = sx &lt; 0 ? -1 : 1;
      if (side !== l.side) {
        l.side = side;
        l.el.setAttribute('fill', side &lt; 0 ? l.sp.backs[l.tint] : l.sp.tints[l.tint]);
      }
    }

    // Regen: das Muster wandert, das Rechteck bleibt.
    if (this.rain &gt; .005) {
      const fall = 1150;
      this.patX = (this.patX + this.wind * .75 * dt) % 96;
      this.patY = (this.patY + fall * dt) % 170;
      const slant = Math.atan2(this.wind * .75, fall) * 180 / Math.PI;
      this.pattern.setAttribute('patternTransform',
        'translate(' + this.patX.toFixed(1) + ',' + this.patY.toFixed(1) + ') skewX(' + (-slant).toFixed(2) + ')');
      this.rainRect.setAttribute('fill-opacity', (Math.pow(this.rain, 1.7) * .95).toFixed(3));

      let d = '';
      for (const p of this.drops) {
        const len = 40 + p.z * 66;
        const nx = Math.hypot(this.wind * .75, fall) || 1;
        d += 'M' + p.x.toFixed(1) + ' ' + p.y.toFixed(1)
           + 'L' + (p.x - this.wind * .75 / nx * len).toFixed(1) + ' ' + (p.y - fall / nx * len).toFixed(1);
      }
      this.dropsPath.setAttribute('d', d);
      this.dropsPath.setAttribute('stroke-opacity', (Math.pow(this.rain, 1.4) * .55).toFixed(3));

      let s = '';
      for (const q of this.splashes)
        s += 'M' + (q.x - q.r).toFixed(1) + ' ' + q.y.toFixed(1) + 'L' + (q.x + q.r).toFixed(1) + ' ' + q.y.toFixed(1);
      this.splashPath.setAttribute('d', s);
      this.splashPath.setAttribute('stroke-opacity', (Math.pow(this.rain, 1.4) * .5).toFixed(3));
    } else if (this.rainRect.getAttribute('fill-opacity') !== '0') {
      this.rainRect.setAttribute('fill-opacity', 0);
      this.dropsPath.setAttribute('stroke-opacity', 0);
      this.splashPath.setAttribute('stroke-opacity', 0);
    }

    if (this.flashEl) this.flashEl.setAttribute('fill-opacity', (this.flash * .42).toFixed(3));
  }
}</script>
</svg>
</symbol>



