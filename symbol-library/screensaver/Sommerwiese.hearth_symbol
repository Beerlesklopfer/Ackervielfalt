  <svg hearth:element="hearth-sommerwiese" hearth:format-version="1.0" hearth:visible="true" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg" xmlns:hearth="https://forgeiec.io/hearth/1.0">
