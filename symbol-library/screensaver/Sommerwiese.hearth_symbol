      <rect data-role="sky" fill="#9fd6f5" height="872" id="3da4c467-005a-4175-93b3-fef8a0445fec" stroke="none" width="2040" x="-60" y="-60"/>
      <rect data-role="ground" fill="#4fa83c" height="408" id="b8b706b8-e7b0-4f5f-b2ac-b6617fb69ca5" stroke="none" width="2040" x="-60" y="792"/>
