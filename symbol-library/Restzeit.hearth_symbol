  <script type="text/javascript">// Restzeit — wie lange DIESES Beet noch laeuft, als hh:mm:ss, plus eine Zeile
// mit den Wochentagen, an denen es bewaessert wird. Und ein Klick auf die
// Platte oeffnet die Zeit-Eingabe (Dialog aus dem Merkmal `opens`).
//
// ── DIE WOCHENTAGE (22.09.2026) ─────────────────────────────────────────────
//
// Der Eingang `days` ist ein BYTE als Bitmuster: Bit 0 = Montag … Bit 6 =
// Sonntag (Bit 7 frei). Je Bit faerbt sich das Kuerzel — gesetzt in der
// Timerfarbe (`dayoncolor`), frei in Grau (`dayoffcolor`); beide sind
// Eigenschaften, damit eine Anlage die Farben an EINER Stelle festlegt. Die
// Ruhefarbe steht auch in der Zeichnung (`fill=var(--dayoffcolor)`), damit die
// Kuerzel schon im Entwurf grau sind und die Eigenschaft nachweislich wirkt.
//
// UNANGESCHLOSSEN HEISST AUS. Ist `days` nicht verdrahtet, kommt nie ein
// `onAttr('days', …)`, und die Kuerzel bleiben ausgeblendet (in `onInit`
// versteckt) — genau wie die Restzeit bei `0` NICHTS zeigt. Ein Beet auf dem
// Handbildschirm, das keine Wochenschaltung hat, traegt so auch keine Tage.
// Ist `days` verdrahtet und der Wert 0, sind die Kuerzel SICHTBAR und alle
// grau: „angeschlossen, aber kein Tag" ist etwas anderes als „kein Plan".
//
// Die Kuerzel sind sprachabhaengig (de MDMDFSS, en MTWTFSS, es LMXJVSD, fr
// LMMJVSD). Sie stehen als Woerter Mo…So in der Uebersetzungstabelle; der
// Compiler setzt je Sprache den Einzelbuchstaben ein. Das Skript faerbt und
// blendet nur — es kennt die Buchstaben nicht.
//
// ── Die Restzeit-Einheit ist NANOSEKUNDEN ───────────────────────────────────
//
// So kommt TIME auf dem Draht an (crate-contract/codec). `0` zeigt NICHTS,
// nicht `00:00:00`. Daneben werden `9:05`, `1:09:05` und die IEC-Literale
// `T#1h2m30s` / `TIME#500ms` verstanden. Was sich keiner dieser Formen fuegt,
// wird UNVERAENDERT gezeigt — ein unbekannter Wert soll auffallen.
//
// ── LEER RAEUMEN GILT NUR AUF DER ANLAGE ────────────────────────────────────
//
// `this.designTime` unterscheidet Anlage und Zeichenflaeche: auf der Anlage
// bleibt ein Beet ohne Bindung leer (Restzeit und Kuerzel), im Entwurf bleiben
// die gezeichneten Ziffern und Kuerzel stehen, sonst arbeitet der Entwerfer an
// einem leeren Kasten.
//
// ── DER KLICK, UND WAS ER OEFFNET ───────────────────────────────────────────
//
// Ein Klick auf die Platte oeffnet den Dialog, den das Merkmal `opens` nennt
// (`wireDialog`); der Kontext (`bed`, jeder `hearth-param` der Platzierung)
// reist im `dataset` mit. Der frueher nach aussen gemeldete `taster`-Ausgang
// ist entfallen — er ist durch `opens` ersetzt. Der Druckrahmen (`druck`,
// Farbe `ledcolor`) bleibt als LOKALE Klick-Rueckmeldung: er kommt aus dem
// Druck auf die Platte (`wireMomentary` → internes Signal), nicht aus einem
// Port; ein zweiter Horcher waere derselbe Druck ein zweites Mal.
class extends HearthSymbol {
  static observed = ['remaining', 'days'];
  onInit() {
    // Leer/aus nur auf der ANLAGE — im Entwurf bleibt das Gezeichnete stehen.
    if (!this.designTime) {
      this.setText('remaining', '');
      for (let i = 0; i &lt; 7; i++) { const role = 'd' + i; this.setVisible(role, 0); }
    }
    this.setVisible('druck', 0);           // kein Rahmen, bis jemand drueckt
    this.wireMomentary('flaeche', 'taster'); // interner Druck → nur der Rahmen
    // Ein Klick oeffnet den Dialog, den `opens` nennt. Steht dort nichts,
    // geschieht nichts — dann ist es nur eine Anzeige.
    this.wireDialog('flaeche');
  }
  onAttr(name, val) {
    if (name === 'remaining') this.setText('remaining', this._remainingText(val));
    else if (name === 'days') this._applyDays(val);
  }
  /// Der Druck, den dieses Symbol meldet, IST der Rahmen, den es zeigt — ein
  /// Signal, ein Ort. `taster` ist kein Port mehr, nur der interne Druck.
  emit(name, value) {
    super.emit(name, value);
    if (name === 'taster') this.setVisible('druck', this.truthy(value));
  }

  /// Byte-Bitmuster → sieben Tage. Angeschlossen: die Kuerzel werden SICHTBAR
  /// und je Bit gefaerbt (gesetzt: Timerfarbe, frei: grau). Bit i gehoert zu
  /// Tag i (0 = Montag). Unbrauchbarer Wert: nichts anfassen.
  _applyDays(val) {
    const n = Number(String(val === null || val === undefined ? '' : val).trim());
    if (!isFinite(n)) return;
    const bits = Math.trunc(n) &amp; 0xff;
    for (let i = 0; i &lt; 7; i++) {
      const role = 'd' + i;
      const on = (bits >> i) &amp; 1;
      this.setVisible(role, 1);
      this.setColor(role, on, 'dayoncolor', 'dayoffcolor');
    }
  }

  /// Nanoseconds → hh:mm:ss. Nothing to do (0, empty) shows nothing.
  _remainingText(v) {
    const s = String(v === null || v === undefined ? '' : v).trim();
    if (s === '') return '';
    // Eine blosse Zahl IST hier eine Zeit — dieser Anschluss kennt keinen Rang.
    if (/^[+-]?\d+(?:\.\d+)?$/.test(s)) {
      const ns = Number(s);
      if (!isFinite(ns) || ns &lt;= 0) return '';   // nichts mehr vor: leer lassen
      return this._hms(ns / 1e9);
    }
    return this._clock(s);
  }
  /// Any time-ish notation → hh:mm:ss. Unknown text comes back unchanged.
  _clock(s) {
    const teile = s.split(':');
    if (teile.length >= 2 &amp;&amp; teile.every((t) => /^\d+$/.test(t.trim()))) {
      const z = teile.map((t) => Number(t));
      while (z.length &lt; 3) z.unshift(0);
      return this._hms(z[0] * 3600 + z[1] * 60 + z[2]);
    }
    // IEC-Literal: T#1h2m30s, TIME#500ms. `ms` steht vor `m`, sonst bliebe das
    // `s` stehen und die Millisekunden waeren Minuten.
    const iec = s.match(/^(?:TIME|T)#(.+)$/i);
    if (iec) {
      const faktor = { d: 86400, h: 3600, m: 60, s: 1, ms: 0.001 };
      let sek = 0, getroffen = false;
      for (const m of iec[1].matchAll(/(\d+(?:\.\d+)?)\s*(ms|d|h|m|s)/gi)) {
        sek += Number(m[1]) * faktor[m[2].toLowerCase()];
        getroffen = true;
      }
      if (getroffen) return this._hms(sek);
    }
    const n = Number(s);
    return isFinite(n) ? this._hms(n) : s;
  }
  /// Seconds → hh:mm:ss, two digits each.
  _hms(sekunden) {
    const g = Math.max(0, Math.round(Number(sekunden) || 0));
    const p = (x) => String(x).padStart(2, '0');
    return p(Math.floor(g / 3600)) + ':' + p(Math.floor(g / 60) % 60) + ':' + p(g % 60);
  }
}
