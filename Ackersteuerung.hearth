       <g xmlns="http://www.w3.org/2000/svg" id="39d6b0c9-571f-4f5d-99d6-e4776669e49c" hearth:layer="content" hearth:layer-name="Content" xmlns:hearth="https://forgeiec.io/hearth/1.0">
        <g xmlns="https://forgeiec.io/hearth/1.0" class="hearth-connector" id="065e1c15-2360-4359-b821-5d3adfaf947b" hearth:connector="out" hearth:dir="out" hearth:editor-only="true" xmlns:hearth="https://forgeiec.io/hearth/1.0">
         <line xmlns="https://forgeiec.io/hearth/1.0" stroke="#5a5a5a" stroke-width="1.5" x1="88" x2="72" y1="20" y2="20"/>
         <circle xmlns="https://forgeiec.io/hearth/1.0" cx="88" cy="20" fill="#e74c3c" r="3" stroke="#ffffff" stroke-width="1"/>
        </g>
        <rect xmlns="http://www.w3.org/2000/svg" data-role="body" fill="#f0e8e0" height="32" id="ded43ea2-7a67-4709-b310-cc4a77aec83b" stroke="#8a5a26" stroke-width="2" width="56" x="16" y="4"/>
        <text xmlns="http://www.w3.org/2000/svg" data-h="32" data-role="name" data-w="56" dominant-baseline="central" fill="#8a5a26" font-size="11" id="4c75dc69-d8dc-4e7e-84be-e3bf81b8bd24" text-anchor="middle" x="44" y="20">OnLeave</text>
       </g>
       <g xmlns="http://www.w3.org/2000/svg" id="2ff79185-476a-4f06-9e08-efb94734c464" hearth:layer="actions" hearth:layer-name="Actions" xmlns:hearth="https://forgeiec.io/hearth/1.0"/>
       <hearth-source><![CDATA[class extends HearthSymbol {
  // Fires when the screen/page is left (navigated away / hidden); pulses BOOL out.
  onInit() {
    this._fire = () => this.emit('out', 1);
    window.addEventListener('pagehide', this._fire);
    window.addEventListener('beforeunload', this._fire);
  }
}]]></hearth-source>
