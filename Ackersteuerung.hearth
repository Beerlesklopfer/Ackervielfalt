       <g xmlns="http://www.w3.org/2000/svg" id="522b3c14-d46e-4596-b52d-5042bb40ef70" hearth:layer="actions" hearth:layer-name="Actions" xmlns:hearth="https://forgeiec.io/hearth/1.0"/>
       <hearth-source><![CDATA[class extends HearthSymbol {
  // Fires once when the screen mounts (= screen load); drives its BOOL out true.
  onInit() { this.emit('out', 1); }
}]]></hearth-source>
