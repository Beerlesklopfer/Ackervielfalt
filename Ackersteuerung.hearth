offset = 1
size = 1
bit = 5
writable = true
description = "HMI-Startimpuls One-Shot-Schrittkette (Puls via Handshake). Steigende Flanke armt die selektierten Beete."

[[groups.fields]]
name = "bellows.gvl.Schrittkette.xStop"
source = "gvl"
iec_type = "BOOL"
iec_address = "%MX0.6"
offset = 1
size = 1
bit = 6
writable = true
description = "HMI-Stop One-Shot-Schrittkette (Puls via Handshake). Bricht den laufenden Lauf ab: alle Ventile zu, Schritte -> idle; neuer Start noetig."

[[groups.fields]]
name = "bellows.gvl.Schrittkette.xPause"
