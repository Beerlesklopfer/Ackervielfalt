    <var access="6" address="bellows.gvl.Betrieb.xManuell" bit="1" bridge="anvil_local" desc="Betriebsart Manuell (uMode 1): Taster am Beet oder HMI schalten das Ventil um, der Arbiter gibt frei; wartende Ventile blinken im Takt rBlinkHz. Genau eine der vier Betriebsarten darf gesetzt sein, sonst gilt Aus (uMode 0, alle Ventile zu). Von der HMI gesetzt, persistent." epoch="1782499931954" group="Betrieb" name="Betrieb.xManuell" offset="1" read="operator engineer admin automation" size="1" source="gvl" type="BOOL" uuid="d75f0f54-ddf5-4dc0-812f-62990b32886d" write="operator engineer admin automation"/>
    <var access="6" address="bellows.gvl.Betrieb.xOneShot" bit="2" bridge="anvil_local" desc="Betriebsart One-Shot (uMode 2): die in aValveJobs angewaehlten Beete laufen je einmal ihre Dauer; die Dauer zaehlt erst ab der Arbiter-Freigabe, kein Beet wird uebersprungen. Angewaehlte, noch wartende Beete blinken. Genau eine Betriebsart, persistent." epoch="1782499933237" group="Betrieb" name="Betrieb.xOneShot" offset="1" read="operator engineer admin automation" size="1" source="gvl" type="BOOL" uuid="1f17e1d0-fb06-4a53-bfdc-228ee869811a" write="operator engineer admin automation"/>
    <var access="6" address="bellows.gvl.Betrieb.xWiederkehrend" bit="3" bridge="anvil_local" desc="Betriebsart wiederkehrend (uMode 3): jedes angewaehlte Beet startet an den Wochentagen aus Zeitplan.bWeekMask zu seiner Startzeit aus aValveJobs und laeuft seine Dauer. Genau eine Betriebsart, persistent." epoch="1782499934557" group="Betrieb" name="Betrieb.xWiederkehrend" offset="1" read="operator engineer admin automation" size="1" source="gvl" type="BOOL" uuid="cfe844dc-bee2-4d44-9809-3aa46258ad2c" write="operator engineer admin automation"/>
    <var access="6" address="bellows.gvl.Betrieb.xAuto" bit="4" bridge="anvil_local" desc="Betriebsart Auto (uMode 4, Bedarf nach Kc/ET0): zurueckgestellt, weil Wetter- und Bodensensorik fehlen. Gewaehlt oeffnet sie kein Ventil. Genau eine Betriebsart, persistent." epoch="1782499930176" group="Betrieb" name="Betrieb.xAuto" offset="1" read="operator engineer admin automation" size="1" source="gvl" type="BOOL" uuid="202e3cb0-7d6b-45ca-a049-a33cd4272454" write="operator engineer admin automation"/>
    <var access="6" address="bellows.gvl.Betrieb.uMaxVentile" bridge="anvil_local" desc="Hoechstzahl gleichzeitig offener Ventile (Wasserdruck, Pumpenleistung). FB_VALVE_ARBITER begrenzt auf 1..24; weitere Anforderungen warten in Index-Reihenfolge, der Warterang steht in Schrittkette.auQueue. Startwert 24. Von der HMI gesetzt, persistent." epoch="1785368375714" group="Betrieb" name="Betrieb.uMaxVentile" offset="3" read="operator engineer admin automation" size="1" source="gvl" type="USINT" uuid="db1f89d9-48fc-4b39-9300-fbca38abea4c" write="operator engineer admin automation"/>
    <var access="6" address="bellows.gvl.Zeitplan.bWeekMask" bridge="anvil_local" desc="Wochentag-Freigabe fuer den wiederkehrenden Betrieb (Betriebsart 3): Bit 0 = Montag bis Bit 6 = Sonntag, ein gesetztes Bit gibt den Tag frei. Von der HMI gesetzt, persistent." epoch="1782500392581" group="Zeitplan" name="Zeitplan.bWeekMask" offset="265" read="operator engineer admin automation" size="1" source="gvl" type="BYTE" uuid="39013e2a-20fb-41d0-b384-05c2c935ebca" write="operator engineer admin automation"/>
    <var access="4" address="bellows.gvl.Betrieb.uModeActive" bridge="anvil_local" desc="Bestätigte Betriebsart (Spiegel von PLC_PRG.uMode One-Hot-Decode): 0=invalid/sicher, 1=Manuell, 2=One-Shot, 3=wiederkehrend, 4=Auto. Read-only Feedback an HMI (Bellows/Betrieb)." epoch="1781336329254" group="Betrieb" name="Betrieb.uModeActive" offset="2" read="operator engineer admin automation" size="1" source="gvl" type="USINT" uuid="4ccabb88-05f2-49d5-8cfd-ff62205058d1"/>
    <var access="6" address="bellows.gvl.Betrieb.rBlinkHz" bridge="anvil_local" desc="Blinkfrequenz der Status-LEDs wartender Ventile in den Betriebsarten Manuell, One-Shot und wiederkehrend, in Hz: angefordert, aber vom Arbiter noch nicht freigegeben. PLC_PRG begrenzt auf 0.01..10 Hz, ein Wert unter 0.01 gilt als 0.1. Startwert 0.1 Hz = 5 s an / 5 s aus. Von der HMI gesetzt, persistent." group="Betrieb" name="Betrieb.rBlinkHz" offset="4" read="operator engineer admin automation" size="4" source="gvl" type="REAL" uuid="98ec68a7-c512-45a9-b244-73866f0676c2" write="operator engineer admin automation"/>
   </persistent>
