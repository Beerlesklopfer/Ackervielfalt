   <asset name="screen.html.tera" type="tera" version="22d7df49"><![CDATA[{# Der GEWOEHNLICHE Screen: Rahmen, Flaeche und Einpassung kommen aus `frame`,
   die Navigationsleiste aus `base`. Hier steht nur noch, was diesen Seitentyp
   ausmacht — seine Laufzeit. Alles Vorherige (Container, viewBox, Hintergrund-
   Rechteck, Flex-Kette) stand hier ALS ABSCHRIFT und ist genau deshalb vom
   Splash abgewichen, als der Rahmen eine Projekteinstellung wurde. #}
{% extends "frame" %}

{# ── DER INHALT KOMMT AUS DEM KOMPILAT ────────────────────────────────────
   `screen_part(screen=slug, part="body")` liefert `assets/screen/<slug>.body.html`
   — Zeichnung, Gestalt und Verhalten dieses Screens, wie der Compiler sie aus
   den Platzierungen und der Registratur aufgeloest hat.
   ── Warum es diesen Weg braucht ──────────────────────────────────────────────
   Seit dem Umbau auf Verweise stehen die Platzierungen in
   `<hearth-placements>`; `ScreenDef` fuehrt aber nur `svg`. Der Rahmen setzte
   `screen.svg` ein — und das ist im neuen Format LEER. Der Screen kam als
   Rahmen ohne Inhalt, ohne dass irgendetwas fehlschlug.
   Bis zum 02.09.2026 las diese Vorlage den `body`-Teil nicht, und Studio
   lieferte ihn deshalb gar nicht aus („nichts ausliefern ohne Aufrufer" —
   `FMainWindow.cpp`). Beides zusammen ergab eine Kette, in der jedes Glied fuer
   sich richtig war.
   RUECKFALL AUF `screen.svg`: eine Datei im alten Zuschnitt traegt ihre
   Zeichnung dort, und ein Screen, dessen Kompilat fehlt, soll nicht leer
   bleiben, sondern zeigen, was die Datei hergibt.
   `splash` und `dashboard` ueberschreiben diesen Block NICHT — sie sind reine
   Vorlagen und zeichnen sich selbst. #}
{% block screen_body %}
{#- DEN SLUG ABLEITEN, wie navbar.html.tera es tut. Der Kontext liefert
    `screen`, KEINEN blanken `slug` — ein `screen_part(screen=slug, …)` ohne
    diese Zeile bricht mit „Variable `slug` not found in context" ab, und Tera
    meldet das erst beim RENDERN: jeder gewoehnliche Screen antwortete mit 500,
    waehrend Splash und Dashboard durchkamen (sie ueberschreiben diesen Block).
    `default(value="")` statt eines Fehlers: ein Screen ohne Slug ist ein
    Befund fuer den Compiler, nicht ein Grund, die Seite gar nicht zu zeigen. -#}
{#- UEBER DIE KENNUNG, NICHT UEBER DEN SLUG. Der Slug ist die ADRESSE und
    darf sich aendern; ein Verweis darauf stirbt beim ersten Umbenennen, und
    zwar lautlos — die Seite kommt, sie ist nur leer. -#}
{%- set kennung = screen.id | default(value="") -%}
{%- set kompilat = screen_part(screen=kennung, part="body") -%}
{%- if kompilat -%}{{ kompilat | safe }}{%- else -%}{{ screen.svg | safe }}{%- endif -%}
{% endblock %}

{% block extra_js %}
<!-- Client runtime served from /static. Studio deploys it per project at publish
     time (gRPC Deploy → STATIC_ASSETS_DIR), NOT at server-install time. Provides
     window.HearthScreen: hides any placed screensaver on load, maximizes it after
     its idle timeout. -->
{#- DIE DRAEHTE ALS EIGENE DATEI. `hearth-ctl compile` schreibt je Screen
    `<id>.wires.js` (window.HearthWires = {screen, wires}); Studio verschifft
    sie in die Klasse `screen`, und screen-runtime.js verbindet damit
    emit → setInput / emit → writeValue. VOR der Laufzeit laden. -#}
{%- set drahtkennung = screen.id | default(value="") -%}
{%- if drahtkennung -%}<script src="/static/screen/{{ drahtkennung }}.wires.js"></script>{%- endif %}
<script src="/static/js/screen-runtime.js"></script>
<script>
// Binding data (from server)
var bindings = {{ bindings_json | safe }};

// Track current values for toggle logic
var currentValues = {};

// Write a value to the PLC via WebSocket
function writeValue(address, value) {
  if (window._hearth_ws && window._hearth_ws.readyState === 1) {
    window._hearth_ws.send(JSON.stringify({
      type: 'write',
      address: address,
      value: value
    }));
  }
}

// Setup click handlers for writable bindings (toggle on click)
function setupWritables() {
  for (var i = 0; i < bindings.length; i++) {
    var b = bindings[i];
    if (!b.writable) continue;
    var el = document.getElementById(b.element_id);
    if (!el) continue;
    el.style.cursor = 'pointer';
    (function(binding) {
      el.addEventListener('click', function() {
        var cmd = binding.command || '';
        var t = (binding.write_address && binding.write_address.length)
          ? binding.write_address : binding.address;
        if (cmd === 'select') {
          // Kind::Selection (e.g. a mode): a SINGLE write 1. The server-side
          // handshake HOLDS req (the held level IS the selection) and one-hot
          // releases the siblings in the group. A pulse would be wrong here —
          // its trailing 0 would immediately deselect.
          writeValue(t, 1);
        } else if (cmd === 'deselect') {
          // e.g. "AUS": leave the active selection → write 0 to every
          // select-command target (the server releases whichever is held).
          for (var k = 0; k < bindings.length; k++) {
            var sb = bindings[k];
            if (sb.command === 'select' && sb.write_address && sb.write_address.length) {
              writeValue(sb.write_address, 0);
            }
          }
        } else if (cmd === 'pulse' || (binding.write_address && binding.write_address.length)) {
          // Leuchtdrucktaster on a JK-toggle PLC input (xT): emit a momentary
          // PULSE (rising edge 0→1, then release →0) — exactly like a physical
          // momentary button. The PLC ORs phys-%IX || HMI-xT and toggles on the
          // edge, so each click = one edge = one toggle (on/off/on…). A held
          // LEVEL would give only ONE rising edge → turns on but never off.
          writeValue(t, 1);
          setTimeout(function() { writeValue(t, 0); }, 150);
        } else {
          // Direct writable (e.g. a plain bit): level toggle on the displayed state.
          var cur = currentValues[binding.address] || 0;
          writeValue(binding.address, cur > 0 ? 0 : 1);
        }
      });
    })(b);
  }
}
document.addEventListener('DOMContentLoaded', setupWritables);

function onLiveUpdate(values) {
  for (var i = 0; i < bindings.length; i++) {
    var b = bindings[i];
    var lv = values[b.address];
    if (!lv) continue;
    var el = document.getElementById(b.element_id);
    if (!el) continue;
    // Vertrag C-1: der Wert wird ausgeliefert UND gekennzeichnet. `good`
    // faerbt nicht — sonst faellt die Ausnahme nicht mehr auf.
    if (window.setQuality) window.setQuality(el, lv);
    var val = parseFloat(lv.v);
    currentValues[b.address] = val;

    switch (b.bind_type) {
      case 'display_value':
        // Explicit per-binding format wins (author intent); otherwise fall
        // back to the SHARED type-cast fmtByType(lv.t, …) — the same helper
        // the dashboard uses, so BOOL→0/1, ints→integer, REAL→decimals are
        // consistent everywhere. The typecast lives only on the JS side.
        var text;
        if (b.format) {
          text = b.format.replace(/%\.(\d+)f/, function(_, d) { return val.toFixed(parseInt(d)); });
        } else if (typeof fmtByType === 'function') {
          text = fmtByType(lv.t, val);
        } else {
          text = String(val);
        }
        if (b.unit) text += ' ' + b.unit;
        el.textContent = text;
        break;
      case 'duration':
        // value = TIME int64 NANOSEKUNDEN (atRemaining-Countdown). ns/1e9 = s →
        // m:ss. 0 = aus/fertig (Strich). f64 hält ns exakt bis ~104 Tage.
        var secs = Math.max(0, Math.round(val / 1e9));
        el.textContent = secs > 0
          ? (Math.floor(secs / 60) + ':' + ('0' + (secs % 60)).slice(-2))
          : '–';
        break;
      case 'fill_level':
        var pct = Math.max(0, Math.min(100, (val - b.range_min) / (b.range_max - b.range_min) * 100));
        el.setAttribute('height', pct + '%');
        break;
      case 'state':
        for (var s = 0; s < (b.states || []).length; s++) {
          if (b.states[s].value == String(val) || b.states[s].value == String(Math.round(val))) {
            el.setAttribute('class', b.states[s].class);
            break;
          }
        }
        break;
      case 'rotation':
        el.setAttribute('transform',
          'rotate(' + val + ',' + (b.pivot_x||0) + ',' + (b.pivot_y||0) + ')');
        break;
      case 'flow_animation':
        el.classList.toggle('flow-active', val > 0);
        break;
    }
  }
}

// Schaltzeiten-Editor-Dialog (nur auf dem Schaltzeiten-Screen aktiv).
// Pro Zeile "Setzen" → Dialog mit Std/Min/Dauer-Steppern → OK schreibt die
// Bellows-RETAIN-Vars Zeitplan.J<n>.* (Ventil implizit = Zeile), Abbrechen schließt.
(function() {
  var dlg = document.getElementById('sz_dialog');
  if (!dlg) return;
  var job = null, draft = { h: 0, m: 0, d: 0 };
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function render() {
    document.getElementById('sz_dlg_title').textContent = '{{ t(key="valve") }} ' + job + ' · {{ t(key="switching-time") }}';
    document.getElementById('sz_dlg_h_val').textContent = draft.h;
    document.getElementById('sz_dlg_m_val').textContent = draft.m;
    document.getElementById('sz_dlg_d_val').textContent = draft.d;
  }
  function openJob(n) {
    job = n;
    draft.h = Math.round(currentValues['Zeitplan.J' + n + '.StartH'] || 0);
    draft.m = Math.round(currentValues['Zeitplan.J' + n + '.StartM'] || 0);
    // tDuration = TIME int64 NANOSEKUNDEN → Stepper rechnet in Minuten (ns / 60e9).
    draft.d = Math.round((currentValues['Zeitplan.J' + n + '.Dauer'] || 0) / 6e10);
    render();
    dlg.style.display = 'block';
  }
  function close() { dlg.style.display = 'none'; job = null; }
  for (var n = 1; n <= 24; n++) {
    (function(n) {
      var b = document.getElementById('sz_edit' + n);
      if (b) b.addEventListener('click', function() { openJob(n); });
    })(n);
  }
  // Stepper mit Long-Press-Auto-Repeat: kurzer Klick = 1 Schritt; gedrückt
  // halten zählt nach ~350ms automatisch weiter und beschleunigt (350→40ms).
  function step(id, field, delta, lo, hi) {
    var el = document.getElementById(id);
    if (!el) return;
    var timer = null;
    function doStep() { draft[field] = clamp(draft[field] + delta, lo, hi); render(); }
    function start(e) {
      e.preventDefault();
      doStep();
      var delay = 350;
      function repeat() { doStep(); delay = Math.max(40, delay * 0.85); timer = setTimeout(repeat, delay); }
      timer = setTimeout(repeat, delay);
    }
    function stop() { if (timer) { clearTimeout(timer); timer = null; } }
    el.addEventListener('mousedown', start);
    el.addEventListener('touchstart', start, { passive: false });
    el.addEventListener('mouseup', stop);
    el.addEventListener('mouseleave', stop);
    el.addEventListener('touchend', stop);
    el.addEventListener('touchcancel', stop);
  }
  step('sz_dlg_h_m', 'h', -1, 0, 23);  step('sz_dlg_h_p', 'h', 1, 0, 23);
  step('sz_dlg_m_m', 'm', -1, 0, 59);  step('sz_dlg_m_p', 'm', 1, 0, 59);
  step('sz_dlg_d_m', 'd', -5, 0, 1440); step('sz_dlg_d_p', 'd', 5, 0, 1440);
  document.getElementById('sz_dlg_cancel').addEventListener('click', close);
  document.getElementById('sz_dlg_ok').addEventListener('click', function() {
    if (job == null) return;
    writeValue('Zeitplan.J' + job + '.StartH', draft.h);
    writeValue('Zeitplan.J' + job + '.StartM', draft.m);
    // Minuten → TIME int64 ns. Dauer 0 = Job inaktiv → uValveIdx=0 (sonst Ventil=Zeile),
    // bWeekMask=0x7F (täglich), damit der Job in der PLC anläuft.
    writeValue('Zeitplan.J' + job + '.Dauer', draft.d * 6e10);
    writeValue('Zeitplan.J' + job + '.ValveIdx', draft.d > 0 ? job : 0);
    writeValue('Zeitplan.J' + job + '.WeekMask', 127);
    close();
  });
})();

// Settings: − N + Stepper für Settings.MaxVentile (nur auf dem Einstellungen-
// Screen aktiv). Jeder Klick schreibt SOFORT (Floor 1); die PLC-ST clampt die
// Obergrenze, der Read-Back füllt set_max_val (display_value-Binding).
(function() {
  var minus = document.getElementById('set_max_minus');
  var plus  = document.getElementById('set_max_plus');
  if (!minus || !plus) return;
  function cur() { return Math.round(currentValues['Settings.MaxVentile'] || 0); }
  minus.addEventListener('click', function() { writeValue('Settings.MaxVentile', Math.max(1, cur() - 1)); });
  plus.addEventListener('click',  function() { writeValue('Settings.MaxVentile', cur() + 1); });
})();
</script>
{% endblock %}
]]></asset>
   <asset name="screen-runtime.js" type="js" version="9ddbda75"><![CDATA[// screen-runtime.js — PROJECT / runtime JS.
//
// Belongs to the SCREEN (the deployed page), not to the Studio editor. Plain JS,
// no editor dependencies. Studio's editor (canvas-editor.js) only *initiates*
// these actions; the behaviour lives here so the deployed hearth screen runs the
// exact same code. Later this is also driven by a JS inactivity timer.
//
// Exposed as window.HearthScreen = { blankScreen, screensaver, ... }.

(function () {
  'use strict';

  // Embed the base webfont set on the DEPLOYED page — the fonts ship via the
  // unified deploy to /static, and this injects the matching @font-face so the
  // hearth screen renders text identically to the editor. Skipped in the Studio
  // editor (canvas:// scheme), which embeds the fonts from its own QRC.
  (function injectFonts() {
    if (location.protocol === 'canvas:') return;
    const fams = [['DejaVu Sans', 'DejaVuSans'], ['DejaVu Sans Condensed', 'DejaVuSansCondensed'],
                  ['DejaVu Sans Mono', 'DejaVuSansMono'], ['DejaVu Serif', 'DejaVuSerif']];
    const css = fams.map((f) =>
      "@font-face{font-family:'" + f[0] + "';src:url('/static/media/" + f[1] + ".woff2') format('woff2'),"
      + "url('/static/media/" + f[1] + ".woff') format('woff');}").join('');
    const st = document.createElement('style');
    st.textContent = css;
    (document.head || document.documentElement).appendChild(st);
  })();

  // Project fonts (per-project TTF/OTF/WOFF/WOFF2 uploads, ausgespielt von der
  // Studio-Publish-Pipeline als /static/project-fonts.css). Eine <link>-Datei
  // wuerde leichter im Browser-Cache landen als ein inline-<style>. Im Studio-
  // Editor (canvas://) ueberspringen, dort liefern die :/canvas/fonts-Resourcen
  // die Schriften.
  (function injectProjectFonts() {
    if (location.protocol === 'canvas:') return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    // Sie ist eine CSS-Datei und liegt deshalb bei den anderen. Der Pfad hinkte
    // nach dem Umbau nach: 404, und die Schriften erreichten die Seite nicht.
    link.href = '/static/css/project-fonts.css';
    (document.head || document.documentElement).appendChild(link);
  })();

  // Project custom CSS/JS: Multi-File-Inject. Studio publisht je einen Index
  // (project-custom-{css,js}.json) als Reihenfolge-Definition, dazu jede
  // Datei einzeln unter /static/<name>. Wir fetchen die Indizes parallel und
  // haengen die Dateien in der publizierten Reihenfolge an — so kann der
  // Operator Abhaengigkeiten (jquery vor app.js) ueber die Sortierung im
  // Custom-Code-Tool steuern. Fehlende Indizes (alte Deploys / leere
  // Projekte) werden ohne Console-Rauschen ignoriert.
  (function injectCustomCode() {
    if (location.protocol === 'canvas:') return;
    const fetchList = (path) => fetch(path, { cache: 'no-store' })
      .then(r => r.ok ? r.json() : [])
      .catch(() => []);
    fetchList('/static/project-custom-css.json').then((names) => {
      (names || []).forEach((n) => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/static/css/' + n;
        document.head.appendChild(link);
      });
    });
    fetchList('/static/project-custom-js.json').then((names) => {
      // Sequentiell anhaengen, sodass spaetere Files frueheren Globals
      // zugreifen koennen (jquery → app.js). async=false reicht nicht, weil
      // wir die Tags via JS einbauen — deshalb Promise-Kette.
      (names || []).reduce((chain, n) => chain.then(() => new Promise((resolve) => {
        const s = document.createElement('script');
        s.src = '/static/js/' + n;
        s.onload = s.onerror = resolve;
        document.head.appendChild(s);
      })), Promise.resolve());
    });
  })();

  // DER SCHIRM — die Flaeche, die der Screen tatsaechlich einnimmt.
  //
  // `#screen-surface` gibt es auf BEIDEN Seiten: im Editor als Zeichenflaeche
  // (canvas-editor.js), in der Anlage als der eingepasste Schacht im Rahmen
  // (frame.html.tera). Ein Bezeichner, eine Rechnung — was der Editor als „der
  // Screen" versteht, versteht die Anlage genauso.
  //
  // ── Warum der Fensterrueckfall nicht mehr genuegt ──────────────────────────
  //
  // Hier stand: „in hearth that's the whole page". Das war richtig, solange der
  // Screen die ganze Seite fuellte. Seit dem Rahmen sitzt er MITTIG IM PANEL,
  // und das Panel wird ins Fenster eingepasst — zwischen beiden bleibt Rand.
  // Der Rueckfall deckte diesen Rand mit, und zwar nicht erst fuer die
  // Formularebene: Bildschirmschoner und Abdunkeln legten sich schon darueber.
  //
  // Der Rueckfall BLEIBT, aber als das, was er ist: die Antwort fuer eine Seite
  // ohne Rahmen (Anmeldung, Verwaltung). Nicht als Regelfall.
  function screenRect() {
    const el = document.getElementById('screen-surface');
    if (el) {
      const r = el.getBoundingClientRect();
      return { left: r.left, top: r.top, width: r.width, height: r.height };
    }
    return { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
  }

  // ── DIE FORMULAREBENE ──────────────────────────────────────────────────────
  //
  // Ein Screen ist ein `<svg>`, und SVG kennt kein Eingabefeld. Darueber liegt
  // deshalb eine HTML-Ebene — kein Anmelde-Sonderweg, sondern das Fundament der
  // Formularfamilie (Eingabefeld, Passwortfeld, Schaltflaeche, spaeter Auswahl
  // und Dialog).
  //
  // ── Die eine Idee ──────────────────────────────────────────────────────────
  //
  // Die Ebene traegt EINE Transformation, ihre Kinder rechnen in
  // SCREEN-EINHEITEN — denselben Zahlen, die eine SVG-Platzierung traegt. Ein
  // Eingabefeld bei x=320,y=180 liegt damit in beiden Ebenen an derselben
  // Stelle, ohne dass irgendwo umgerechnet wird.
  //
  // Das ist dieselbe Regel wie im DOM-Baum: gespeichert wird nur das Lokale,
  // verkettet wird beim Zeichnen. Wer die Kinder einzeln skalierte, haette N
  // Rechnungen, die auseinanderlaufen koennen — hier ist es eine.
  //
  // ── Warum ResizeObserver und nicht window.resize ───────────────────────────
  //
  // Die Navigationsleiste kann umbrechen, ohne dass sich das Fenster aendert.
  // Beobachtet wird deshalb die FLAECHE selbst; sie weiss als Erste, dass sie
  // sich geaendert hat.
  function alignScreenLayer() {
    const layer = document.getElementById('screen-layer');
    const surf = document.getElementById('screen-surface');
    if (!layer || !surf) return;

    // Die Entwurfsbreite: aus dem viewBox, nicht aus der gezeichneten Groesse —
    // die gezeichnete IST das Ergebnis der Einpassung, die wir gerade messen.
    const vb = surf.viewBox && surf.viewBox.baseVal;
    const bw = (vb && vb.width)  || Number(surf.getAttribute('width'))  || 0;
    const bh = (vb && vb.height) || Number(surf.getAttribute('height')) || 0;
    if (!(bw > 0) || !(bh > 0)) return;

    const r = screenRect();
    layer.style.left = r.left + 'px';
    layer.style.top = r.top + 'px';
    // Groesse in SCREEN-Einheiten, danach als Ganzes skaliert: so ist die Box
    // der Ebene deckungsgleich mit dem Schacht, und die Kinder sehen die
    // Entwurfskoordinaten.
    layer.style.width = bw + 'px';
    layer.style.height = bh + 'px';
    layer.style.transformOrigin = '0 0';
    layer.style.transform = 'scale(' + (r.width / bw) + ')';
  }

  // ── HTML-KOERPER IN DIE EBENE MONTIEREN ────────────────────────────────────
  //
  // Gelesen wird der BAUM (`<hearth-placements>`), nicht der base64-Block.
  //
  // ── Warum hier zwei Wege stehen, und wann der zweite verschwindet ──────────
  //
  // SVG-Symbole montiert `symbolMount()` weiter aus dem Block. Zwei Quellen fuer
  // dieselbe Sache sind genau die Krankheit, gegen die v2 angetreten ist — das
  // ist hier eine UEBERGANGSSTELLE und keine Absicht.
  //
  // Sie steht so, weil der Baum ohnehin schon in der Seite liegt, alles traegt,
  // was gebraucht wird (Koerper, Matrix, Parameter), und weil der umgekehrte
  // Weg — die Formularelemente in den Block zu zwaengen — Exporter UND Modell
  // um ein Feld erweitert haette, das beim naechsten Schritt wieder entfaellt.
  //
  // ENDE DES UEBERGANGS: sobald `symbolMount()` seine Symbole ebenfalls aus dem
  // Baum montiert, faellt der Block (`hearth-screen-model`) — und mit ihm die
  // 2,7 MB, die er heute je Screen kostet.
  function mountFormLayer() {
    const layer = document.getElementById('screen-layer');
    if (!layer) return;
    // NUR EINMAL — aber an einer Marke, nicht an der Kinderzahl. Die zaehlte
    // auch, was die VORLAGE in die Ebene stellt (der Splash setzt dort seine
    // Angaben als HTML). Ein Screen mit Vorlageninhalt haette danach nie
    // Formularelemente bekommen, ohne dass irgendwo etwas meldete.
    if (layer.dataset.formMounted) return;
    layer.dataset.formMounted = '1';
    const wurzel = document.querySelector('hearth-placements');
    if (!wurzel) return;

    wurzel.querySelectorAll('hearth-placement').forEach((pl) => {
      const koerper = pl.querySelector(':scope > symbols > hearth-body');
      if (!koerper || koerper.getAttribute('layer') !== 'html') return;

      const host = document.createElement('div');
      host.setAttribute('data-placement', pl.getAttribute('id') || '');

      // Die MATRIX woertlich uebernehmen — dieselben sechs Zahlen wie im SVG.
      // Zerlegen (x, y, Massstab, Drehung) waeren fuenf Zahlen fuer sechs, und
      // die fehlende ist die Scherung: der Verlust faellt spaeter auf und sieht
      // dann nach einem Zeichenfehler aus.
      // SVG schreibt `matrix(1 0 0 1 320 180)` mit LEERZEICHEN, CSS verlangt
      // KOMMATA. CSS verwirft einen ungueltigen Wert stillschweigend — das
      // Element sass dann bei 0/0, ohne dass irgendwo etwas meldete. Gemessen,
      // nicht vermutet: das Feld stand bei 31/69 statt bei 350/253.
      const tf = pl.getAttribute('transform');
      if (tf) {
        host.style.transformOrigin = '0 0';
        host.style.transform = tf.replace(/\(([^)]*)\)/g,
          (_, zahlen) => '(' + zahlen.trim().split(/[\s,]+/).join(',') + ')');
      }

      // Groesse aus den Parametern der PLATZIERUNG, nicht aus dem Koerper: sie
      // gehoert zur Platzierung, so wie x und y.
      pl.querySelectorAll(':scope > hearth-param').forEach((p) => {
        const n = p.getAttribute('name'), v = p.getAttribute('value');
        if (n === 'width')  host.style.width  = v + 'px';
        if (n === 'height') host.style.height = v + 'px';
      });

      // Der Koerper steht im XHTML-Namensraum im SVG — dort wird er GEHALTEN,
      // aber nicht gezeichnet. Fuer die Ebene muss er als HTML neu entstehen;
      // ein `importNode` uebernaehme den Namensraum mitsamt seiner Wirkungslo-
      // sigkeit.
      host.innerHTML = koerper.innerHTML;
      layer.appendChild(host);
    });
  }

  (function watchScreenLayer() {
    if (typeof document === 'undefined') return;
    const start = () => {
      // ERST montieren, dann ausrichten: eine leere Ebene auszurichten und die
      // Kinder danach einzuhaengen hiesse, dass die erste Messung die falsche
      // Groesse sieht.
      mountFormLayer();
      alignScreenLayer();

      // ── WARUM NICHT NUR DER ResizeObserver AUF DER FLAECHE ─────────────────
      //
      // Gemessen, nicht vermutet: die Ebene lag 43 px zu hoch. Ausgerichtet
      // wurde bei `DOMContentLoaded`, als die Flex-Kette noch nicht sass — die
      // Flaeche stand da bei y=111, endgueltig bei y=155. Nachgezogen wurde nie,
      // denn `ResizeObserver` meldet GROESSEN, keine LAGEN, und die Groesse war
      // beide Male 590,6 px.
      //
      // Dieselbe Falle im Betrieb: bricht die Navigationsleiste auf einem
      // schmalen Panel um, WANDERT die Flaeche, ohne sich zu aendern.
      //
      // Deshalb wird der RAHMEN mitbeobachtet — seine Hoehe aendert sich, wenn
      // ueber ihm etwas waechst — und zusaetzlich nach `load` nachgezogen, wenn
      // Schriften und Bilder die Aufteilung ein letztes Mal verschieben.
      const surf = document.getElementById('screen-surface');
      const layer = document.getElementById('screen-layer');
      if (typeof ResizeObserver === 'function') {
        const ro = new ResizeObserver(alignScreenLayer);
        if (surf) ro.observe(surf);
        if (layer && layer.parentElement) ro.observe(layer.parentElement);
        ro.observe(document.documentElement);
      }
      // `position: fixed` misst gegen den Sichtbereich — beim Rollen wandert
      // das SVG darunter weg. Auf einem Panel rollt nichts, auf einem
      // Bueroschirm schon.
      window.addEventListener('scroll', alignScreenLayer, { passive: true });
      window.addEventListener('resize', alignScreenLayer, { passive: true });
      window.addEventListener('load', alignScreenLayer);
      // Ein Bild nach dem Zeichnen: die letzte Verschiebung der Aufteilung
      // faellt sonst genau zwischen die Ereignisse.
      if (typeof requestAnimationFrame === 'function')
        requestAnimationFrame(alignScreenLayer);
    };
    if (document.readyState !== 'loading') start();
    else document.addEventListener('DOMContentLoaded', start);
  })();

  // ── EIN OVERLAY, ZWEI ZUSTAENDE ───────────────────────────────────────────
  //
  // Festlegung des Anwenders vom 02.09.2026: „Der Screensaver ist im
  // wesentlichen ein JS-animiertes SVG. Es lebt in dem Overlay, welches on top
  // geschaltet wird. Blank ist dasselbe Overlay, aber nur mit schwarzer
  // Fuellung. Das SVG liegt darunter oder ist einfach hidden."
  //
  // ── Was hier vorher stand, und warum es nicht ging ─────────────────────────
  //
  // DREI Wege fuer zwei Zustaende:
  //
  //   blankScreen()          ein <div>-Overlay, schwarz
  //   playScreensaver()      ein <canvas>-Overlay mit Rauschflimmern
  //   maximizeScreensaver()  die PLATZIERTE Zeichnung, an Ort und Stelle
  //                          aufgezogen — und OHNE AUFRUFER
  //
  // Die dritte hatte niemand gerufen. Das damalige `hideScreensaver()` versteckte die
  // Zeichnung beim Laden, und gezeigt wurde sie nie wieder; der Timer startete
  // das Flimmern. Ihr eigener Kommentar behauptete, `playScreensaver()` ziehe
  // sie auf — das tat es nicht. Wer einen Schoner platzierte, sah ihn nie.
  //
  // Jetzt: EIN Overlay. Der Schoner zeigt die Zeichnung darin, das Abdunkeln
  // faerbt dasselbe Overlay schwarz und verbirgt sie.
  let overlay = null;

  /// Das eine Overlay — angelegt, wenn es fehlt, sonst geliefert.
  ///
  /// ── DAS GANZE FENSTER, NICHT DER SCHACHT ──────────────────────────────────
  ///
  /// Festlegung des Anwenders vom 02.09.2026: „das gesamte Fenster des
  /// Displays, sonst wuerde das Menu zu sehen sein."
  ///
  /// Hier stand `screenRect()` — der Schacht, in den der Rahmen den Screen
  /// einpasst. Damit blieb die Navigationsleiste ueber dem Schoner stehen, und
  /// beim Abdunkeln leuchtete sie als einziges weiter. Ein Bediengeraet, das
  /// nachts sein Menue anzeigt, ist nicht abgedunkelt.
  ///
  /// Fuer den EINBRENNSCHUTZ ist es sogar der wichtigere Teil: die Leiste steht
  /// immer an derselben Stelle und mit demselben Inhalt — sie brennt zuerst
  /// ein, nicht das Prozessbild darunter.
  ///
  /// `screenRect()` bleibt, wofuer es gedacht ist: die Formularebene, die sich
  /// mit dem Screen decken MUSS.
  function ensureOverlay() {
    if (overlay && overlay.isConnected) return overlay;
    overlay = document.createElement('div');
    overlay.setAttribute('data-hearth-overlay', '1');
    overlay.style.cssText = 'position:fixed; left:0; top:0; '
      + 'width:100vw; height:100vh; background:transparent; '
      + 'z-index:99999; cursor:none; overflow:hidden;';
    document.body.appendChild(overlay);
    return overlay;
  }

  /// Das Overlay wieder abraeumen — und alles, was darin lief.
  ///
  /// ── ZUERST DAS BILD ZURUECK ───────────────────────────────────────────────
  ///
  /// Das Schoner-Bild ist VERSCHOBEN, nicht geklont: es haengt im Overlay und
  /// gehoert in den Schirm. Wer das Overlay entfernte, ohne es
  /// zurueckzubringen, naehme es mit — beim zweiten Anlauf faende
  /// `screensaverArt()` nichts mehr, und der Schoner fiele stillschweigend auf
  /// das Flimmern zurueck. Ein Fehler, den man erst beim ZWEITEN Mal sieht.
  function clearOverlay() {
    stopShimmer();
    restoreScreensaverArt();
    if (overlay) { overlay.remove(); overlay = null; }
  }

  /// Beim naechsten Griff oder Tastendruck aufloesen.
  ///
  /// EINMAL registriert, nicht je Zustand: geht der Schoner in das Abdunkeln
  /// ueber, bleibt derselbe Zuhoerer stehen. Zwei Registrierungen ergaeben zwei
  /// Aufloesungen, und die zweite liefe ins Leere.
  let dismissArmed = false;
  function armDismiss() {
    if (dismissArmed) return;
    dismissArmed = true;
    const go = (e) => {
      if (e) e.preventDefault();
      window.removeEventListener('keydown', go, true);
      window.removeEventListener('pointerdown', go, true);
      dismissArmed = false;
      clearOverlay();
    };
    window.addEventListener('keydown', go, true);
    window.addEventListener('pointerdown', go, true);
  }

  // Anti-stick shimmer state — module-level so the deeper BLANK stage can stop it.
  let shimmerCanvas = null, shimmerRaf = 0;
  function stopShimmer() {
    if (shimmerRaf) { cancelAnimationFrame(shimmerRaf); shimmerRaf = 0; }
    if (shimmerCanvas) { shimmerCanvas.remove(); shimmerCanvas = null; }
  }

  // ABDUNKELN: dasselbe Overlay, schwarz — und die Zeichnung darin verborgen.
  //
  // Es ist die ZWEITE Stufe: laeuft der Schoner schon, wird sein Overlay
  // umgefaerbt statt eines zweiten angelegt. Genau das meint „dasselbe
  // Overlay".
  function blankScreen() {
    stopShimmer();
    const ov = ensureOverlay();
    ov.style.background = '#000';
    const art = ov.querySelector('[data-ss-art]');
    if (art) art.style.display = 'none';
    armDismiss();
  }

  // ── DAS BILD DES SCHONERS ─────────────────────────────────────────────────
  //
  // Es liegt FERTIG im Screen: der Deploy setzt es als Element ein
  // (`FXmlExporter::transformScreen`), versteckt, mit `data-ss-art`. Hier wird
  // es nur noch ins Overlay gehaengt.
  //
  // ── WARUM ES NICHT MEHR GEKLONT WIRD ──────────────────────────────────────
  //
  // Vorher war die QUELLE eine unsichtbare Platzierung im Screen, und diese
  // Funktion klonte sie. Seit dem 04.09.2026 ist der SCHIRM SELBST der Schoner
  // (Attribut `screensaver` am `<hearth-screen>`) — die Quelle waere damit die
  // Screen-Wurzel, und ein Klon davon legte den ganzen Schirm ueber sich
  // selbst. Also liefert der Compiler das Bild getrennt mit, als Element.
  //
  // VERSCHOBEN, nicht kopiert: `appendChild` haengt den Knoten um. Ein Klon
  // waere ein zweiter Baum fuer dieselbe Sache — und der zweite ist der, den
  // beim naechsten Mal jemand faelschlich findet.
  function screensaverArt() {
    return document.querySelector('[data-ss-art]');
  }

  /// Das Bild ins Overlay haengen, deckend.
  ///
  /// Gibt `false`, wenn es keines gibt — dann bleibt es beim Flimmern, und das
  /// ist eine Aussage und kein Fehlschlag.
  function maximizeScreensaver() {
    const kunst = screensaverArt();
    if (!kunst) return false;

    const ov = ensureOverlay();
    if (ov.querySelector('[data-ss-buehne]')) return true;          // laeuft schon

    // Die Buehne fuellt das Overlay, also das ganze Fenster — in Prozent und
    // nicht in gemessenen Pixeln: dreht jemand das Geraet oder bricht die
    // Leiste um, stimmt eine einmal gemessene Zahl nicht mehr, ein
    // Prozentwert schon.
    const buehne = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    buehne.setAttribute('data-ss-buehne', '1');
    // DECKEND, nicht eingepasst: ein Rand in der Hintergrundfarbe waere auf
    // einem Bedienpanel ein Streifen, der nach einem Fehler aussieht.
    buehne.setAttribute('preserveAspectRatio', 'xMidYMid slice');
    buehne.style.cssText =
      'position:absolute; left:0; top:0; width:100%; height:100%; display:block;';

    // DEN AUSSCHNITT VOM BILD SELBST, nicht gemessen: das eingesetzte SVG
    // bringt seine eigene viewBox mit. Sie zu messen hiesse, eine Zahl zu
    // erfinden, die schon dasteht.
    const inner = kunst.firstElementChild;
    const vb = inner && inner.getAttribute && inner.getAttribute('viewBox');
    if (vb) buehne.setAttribute('viewBox', vb);

    kunst.removeAttribute('visibility');    // im Screen versteckt, hier sichtbar
    buehne.appendChild(kunst);              // VERSCHOBEN, nicht geklont
    ov.appendChild(buehne);
    return true;
  }

  /// Das Bild zurueck in den Screen, versteckt wie zuvor.
  ///
  /// Es MUSS zurueck: beim naechsten Anlauf sucht `screensaverArt()` es dort.
  /// Wer es im Overlay liesse, faende beim zweiten Mal nichts mehr — und der
  /// Schoner fiele stillschweigend auf das Flimmern zurueck.
  function restoreScreensaverArt() {
    const buehne = document.querySelector('[data-ss-buehne]');
    if (!buehne) return;
    const kunst = buehne.querySelector('[data-ss-art]');
    const heim = document.querySelector('svg[data-screensaver]');
    if (kunst && heim) {
      kunst.setAttribute('visibility', 'hidden');
      heim.appendChild(kunst);
    }
    buehne.remove();
  }

  // ── DER SCHONER ───────────────────────────────────────────────────────────
  //
  // ZUERST DIE ZEICHNUNG. Ist ein Schoner platziert, wird SIE gezeigt — im
  // Overlay, deckend. Das ist der Fall, fuer den der Entwerfer ihn hingestellt
  // hat, und genau dieser Fall lief bis zum 02.09.2026 nie: das damalige
  // `hideScreensaver()` klappte die Zeichnung beim Laden ein, und niemand
  // klappte sie wieder auf. Seit dem 04.09. kommt das Bild versteckt aus dem
  // Deploy und wird hier nur noch ins Overlay gehaengt.
  //
  // OHNE ZEICHNUNG bleibt es beim FLIMMERN. Es ist kein Schmuck, sondern
  // Einbrennschutz: statt Inhalt zu VERSCHIEBEN (eine gleichmaessige Flaeche —
  // etwa der gruene Acker — auf sich selbst zu schieben aendert nichts) liegt
  // ein Rauschbild darueber, das jeden Farbkanal um ±5 je Bild wackeln laesst.
  // Der Screen bleibt darunter lesbar.
  //
  // Mit Zeichnung braucht es das nicht: sie deckt, und was gedeckt ist, brennt
  // nicht ein.
  function playScreensaver() {
    // True OS fullscreen on a kiosk/operator panel if the browser grants it; the
    // overlay covers the full screen regardless (so "fullscreen" holds either way).
    try { if (!document.fullscreenElement) document.documentElement.requestFullscreen(); }
    catch (e) { /* needs a gesture — overlay still covers the screen */ }

    if (maximizeScreensaver()) { armDismiss(); return; }

    if (shimmerCanvas) return;                                      // flimmert schon
    const ov = ensureOverlay();
    const cv = document.createElement('canvas');
    cv.setAttribute('data-ss-jitter', '1');
    // IM Overlay, nicht daneben: dann traegt EIN Knoten den Zustand, und das
    // Abdunkeln loescht ihn mit, statt ein zweites Overlay darueber zu legen.
    // Es deckt damit auch die LEISTE — die steht immer gleich da und brennt
    // zuerst ein.
    cv.style.cssText = 'position:absolute; left:0; top:0; '
      + 'width:100%; height:100%; cursor:none; mix-blend-mode:overlay;';
    // Coarse noise buffer (cheap), CSS-scaled to cover the screen. Per-channel
    // random around mid-grey (128 ±5); the `overlay` blend turns that into a
    // ±~5 drift of each underlying colour value → the shimmer.
    const NW = 640, NH = 360;
    cv.width = NW; cv.height = NH;
    ov.appendChild(cv);
    shimmerCanvas = cv;
    const ctx = cv.getContext('2d');
    const img = ctx.createImageData(NW, NH);
    const d = img.data;
    for (let i = 3; i < d.length; i += 4) d[i] = 255;             // opaque alpha
    let last = 0;
    const draw = (t) => {
      shimmerRaf = requestAnimationFrame(draw);
      if (t - last < 60) return;                                  // ~16 fps shimmer
      last = t;
      for (let i = 0; i < d.length; i += 4) {
        d[i]     = 123 + ((Math.random() * 11) | 0);              // R 128 ±5
        d[i + 1] = 123 + ((Math.random() * 11) | 0);              // G
        d[i + 2] = 123 + ((Math.random() * 11) | 0);              // B
      }
      ctx.putImageData(img, 0, 0);
    };
    shimmerRaf = requestAnimationFrame(draw);
    armDismiss();
  }

  // Two independent inactivity stages, both reset on input:
  //   • SCREENSAVER shimmer at the placed symbol's `data-ss-timeout`.
  //   • BLANK (black) at the SCREEN's `data-blank-timeout` (0 = disabled).
  // Constraint: blank ≥ screensaver — a smaller blank is clamped UP so it still
  // fires (otherwise it would precede the shimmer and the black would never make
  // sense). This is the runtime guard; the editor/MCP also clamp on save.
  let ssTimer = null, blankTimer = null;
  function ssSecs() {
    // AM SCHIRM, nicht am Bild: seit dem 04.09.2026 sagt der Schirm selbst,
    // dass er ein Schoner ist, und traegt die Zeit dazu. Vorher stand sie an
    // der platzierten Zeichnung — und war damit an derselben Stelle wie das
    // Bild, was beides zu verwechseln einlud.
    const root = document.querySelector('svg[data-screensaver]');
    return root
      ? Math.max(0, parseInt(root.getAttribute('data-ss-timeout') || '0', 10)) : 0;
  }
  function blankSecs() {
    const root = document.querySelector('svg[data-blank-timeout]');
    let b = root ? Math.max(0, parseInt(root.getAttribute('data-blank-timeout') || '0', 10)) : 0;
    const s = ssSecs();
    if (b > 0 && s > 0 && b < s) b = s;                            // clamp: blank ≥ screensaver
    return b;
  }
  function armIdleTimer() {
    const s = ssSecs(), b = blankSecs();
    if (!(s > 0) && !(b > 0)) return;                             // nothing configured
    const reset = () => {
      if (ssTimer) clearTimeout(ssTimer);
      if (blankTimer) clearTimeout(blankTimer);
      if (s > 0) ssTimer = setTimeout(playScreensaver, s * 1000);
      if (b > 0) blankTimer = setTimeout(blankScreen, b * 1000);
    };
    ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(
      (ev) => window.addEventListener(ev, reset, true));
    reset();
  }

  function onScreenLoad() {
    if (typeof window !== 'undefined' && window.Canvas) return;      // editor: keep visible
    // NICHTS MEHR EINZUKLAPPEN. Hier stand `hideScreensaver()`: es setzte die
    // platzierte Zeichnung auf `scale(0,0)`. Seit der Schirm selbst der Schoner
    // ist, waere das die Screen-Wurzel gewesen — es haette den ganzen Inhalt
    // eingeklappt. Das Bild kommt jetzt versteckt aus dem Deploy
    // (`visibility="hidden"` am `[data-ss-art]`).
    // Snapshot mode (?snapshot): a headless capture shows the screen, not the saver.
    if (/[?&]snapshot\b/.test(location.search || '')) return;
    armIdleTimer();
  }
  if (document.readyState !== 'loading') onScreenLoad();
  else document.addEventListener('DOMContentLoaded', onScreenLoad);

  // ── Screen-lifecycle writes (compiled OnScreenLoad / OnScreenLeave) ──────────
  // The logic compiler turns OnScreenLoad/Leave chains into `onload_write` /
  // `onleave_write` bindings: { bind_type, write_address, format }, where
  // `format` is a numeric JS expression over the live cache `currentValues`.
  // hearth has no per-screen trigger, so these run CLIENT-side: onload after the
  // WebSocket opens, onleave on pagehide. Writes go through window.writeValue
  // (the shared, ACL-checked path). Skipped in the Studio editor (canvas://).
  (function screenLifecycleWrites() {
    if (typeof window !== 'undefined' && window.Canvas) return;     // editor preview
    if (typeof location !== 'undefined' && location.protocol === 'canvas:') return;

    function evalExpr(expr) {
      try {
        return new Function('currentValues', 'return (' + expr + ');')(window.currentValues || {});
      } catch (e) { return 0; }
    }
    function eventWrites(kind) {
      var out = [];
      var b = window.bindings || [];
      for (var i = 0; i < b.length; i++)
        if (b[i] && b[i].bind_type === kind)
          out.push({ addr: b[i].write_address || b[i].address, expr: b[i].format });
      return out;
    }
    function runWrites(list) {
      for (var i = 0; i < list.length; i++)
        if (list[i].addr && typeof window.writeValue === 'function')
          window.writeValue(list[i].addr, evalExpr(list[i].expr));
    }

    // OnScreenLoad: fire once the WebSocket is actually open (a write before the
    // socket connects is silently dropped). Poll briefly, then give up.
    function onLoad() {
      var loads = eventWrites('onload_write');
      if (!loads.length) return;
      var tries = 0;
      (function waitWs() {
        var ws = window._hearth_ws;
        if (ws && ws.readyState === 1) { runWrites(loads); return; }
        if (++tries > 100) return;                                 // ~10 s cap
        setTimeout(waitWs, 100);
      })();
    }
    // OnScreenLeave: write on navigation away. pagehide is the reliable unload
    // signal (fires on tab close, reload, and back/forward).
    window.addEventListener('pagehide', function () { runWrites(eventWrites('onleave_write')); });

    if (document.readyState !== 'loading') onLoad();
    else document.addEventListener('DOMContentLoaded', onLoad);
  })();

  // ── Symbol mount + wiring (deployed page runs symbol control classes 1:1) ────
  //
  // Ein platziertes Bibliothekssymbol soll auf der Anlage TUN, was es im Editor
  // tut: Taster druecken, Lampe faerben, Gatter rechnen. Dafuer muss seine
  // Steuerklasse an die Gruppe gebunden werden, in der sie steht — von
  // DERSELBEN Laufzeit, die der Editor benutzt (`forge-symbol-runtime`).
  //
  // ── ZWEI QUELLEN, UND DAS FORMAT ENTSCHEIDET ───────────────────────────────
  //
  //   BAUM   Der Compiler loest die Platzierungen auf und liefert die Gruppen
  //          fertig gezeichnet aus. Jede traegt `data-symbol` und ihre
  //          `data-…`-Parameter; die Quelltexte stehen EINMAL je Screen in
  //          <script type="application/hearth-symbols+json">. Gebunden wird
  //          mit `attach()` — die Zeichnung ist schon da.
  //   BLOCK  Der alte Zuschnitt: `#hearth-screen-model`, base64, das ganze
  //          Modell. Den schreibt der Exporter nur noch in Screens mit eigenem
  //          <svg> — also in Dateien VOR dem Umbau auf Verweise.
  //
  // Das ist eine Migration, keine Doppelung: es entscheidet, WELCHES FORMAT
  // vorliegt. Der Blockweg faellt, sobald keine Anlage mehr eine Datei im alten
  // Zuschnitt ausliefert.
  //
  // ── WAS DER BAUMWEG NOCH NICHT TUT: DIE DRAEHTE ────────────────────────────
  //
  // Der Blockweg verbindet Konnektoren (variable→setInput, emit→writeValue,
  // emit→setInput). Der Baumweg tut das nicht: im neuen Format stehen die
  // Draehte als <wire source destination> mit KONNEKTOR-Kennungen, und die
  // Konnektoren wohnen in `elements` — das ist ein eigener Schritt und keine
  // Zeile hier. Gemessen am 02.09.2026: in keinem Screen dieses Bestands steht
  // ein einziger <wire>; der Schritt hat also noch keinen Anlass, aber er steht
  // aus, und deshalb steht er hier.
  (function symbolMount() {
    if (typeof window !== 'undefined' && window.Canvas) return;          // editor mounts itself
    if (typeof location !== 'undefined' && location.protocol === 'canvas:') return;

    const BEHAVIOUR_BLOCK = 'script[type="application/hearth-symbols+json"]';

    // Anschlusspunkte sind Entwurfssache. Der Compiler streift sie fuer die
    // Anlage ab; fuer alles aus dem alten Zuschnitt gilt die Regel weiter.
    function hideConnectors() {
      const st = document.createElement('style');
      st.textContent = '.hearth-connector{display:none !important}';
      (document.head || document.documentElement).appendChild(st);
    }

    function runtime() { return import('/static/js/forge-symbol-runtime.js'); }

    // ── DER BAUMWEG ──────────────────────────────────────────────────────────
    //
    // Gibt `true` zurueck, sobald der Verhaltensblock DA IST — auch wenn keine
    // einzige Gruppe gebunden wird. Auf den Blockweg zurueckzufallen hiesse
    // sonst, in einer Datei nach etwas zu suchen, das sie nicht mehr traegt,
    // und die Meldung von dort waere die falsche Spur.
    function fromTree() {
      const block = document.querySelector(BEHAVIOUR_BLOCK);
      if (!block) return false;
      let sources;
      try { sources = JSON.parse(block.textContent || '{}'); }
      catch (e) {
        console.warn('[screen] Verhaltensblock unlesbar — Symbole bleiben statisch:', e.message);
        return true;
      }
      const groups = document.querySelectorAll('g.hearth-symbol[data-symbol]');
      hideConnectors();
      runtime().then((rt) => {
        // Eine aeltere Laufzeit kennt nur `mount()`, und das ZEICHNET — sie
        // haenge die Symbole ein zweites Mal in die Seite. Lieber statisch.
        if (typeof rt.attach !== 'function') {
          console.warn('[screen] forge-symbol-runtime ohne attach() — Symbole bleiben statisch');
          return;
        }
        let bound = 0, withoutSource = 0;
        const insts = {};
        groups.forEach((g) => {
          const src = sources[g.getAttribute('data-symbol')];
          if (!src) { withoutSource++; return; }
          let inst;
          try {
            inst = rt.attach(g, { source: src, name: g.getAttribute('data-name') || g.id });
          } catch (e) {
            console.warn('[screen] Symbol', g.id, 'nicht gebunden:', e.message);
            return;
          }
          insts[g.id] = inst;
          bound++;
        });
        // Die Drahtdatei `<id>.wires.js` (window.HearthWires = {screen, wires})
        // bindet die Vorlage VOR dieser Laufzeit ein. Fehlt sie, ist das ein
        // Befund — und er wird gesagt, nicht geschluckt.
        let wires = [];
        const hw = (typeof window !== 'undefined') ? window.HearthWires : null;
        if (hw && Array.isArray(hw.wires)) wires = hw.wires;
        else console.warn('[screen] keine Drahtdatei (window.HearthWires) — Symbole bleiben unverbunden');
        const groupOf = (ref) => document.getElementById(ref);
        const paramOf = (ref, k) => { const g = groupOf(ref); const v = g && g.getAttribute('data-' + k); return v == null ? undefined : v; };
        // Ein Variablenknoten ist eine Entwurfshilfe MIT Adresse — Gatter und
        // Ereignisse sind Entwurfshilfen ohne.
        const isVarNode = (ref) => { const g = groupOf(ref); return !!(g && g.hasAttribute('data-logic') && g.hasAttribute('data-address')); };
        const varNodes = Array.from(groups).filter((g) => isVarNode(g.id)).map((g) => ({ instanceId: g.id }));
        wireUp({ wires, placements: varNodes, routes: {} }, insts, paramOf, isVarNode);
        window.HearthScreen = Object.assign(window.HearthScreen || {}, { wiresBound: wires.length });
        // GEZAEHLT, NICHT BEHAUPTET. „Kein Verhalten" und „nichts platziert"
        // sahen bisher gleich aus, und genau das hat den Fehler getragen.
        if (withoutSource)
          console.warn('[screen]', withoutSource,
                       'Gruppe(n) mit data-symbol, aber ohne Quelle im Verhaltensblock');
        window.HearthScreen = Object.assign(window.HearthScreen || {},
          { symbolsBound: bound, symbolsWithoutSource: withoutSource });
      }).catch((e) => console.warn('[screen] Symbollaufzeit nicht ladbar:', e.message));
      return true;
    }

    // ── DER BLOCKWEG ─────────────────────────────────────────────────────────
    //
    // Woertlich der bisherige Weg. Er montiert die Symbole SELBST, weil sie im
    // alten Zuschnitt gar nicht gezeichnet sind — und er verdrahtet sie.
    // ── DIE DRAEHTE, EINMAL ──────────────────────────────────────────────────
    //
    // Beide Wege — Baum und Block — verbinden hier: variable→setInput,
    // emit→writeValue, emit→setInput. `paramOf`/`isVarNode` sagen dem
    // Verdrahter, wie er eine Platzierung befragt; der Blockweg fragt sein
    // Modell, der Baumweg die `data-…`-Attribute der Gruppe.
    //
    // GEMESSEN am 10.09.2026: die ersten echten Draehte (Stachelbeere) standen
    // im Baum, und der Baumweg verdrahtete nichts — der Kommentar oben hatte es
    // angekuendigt. Jetzt ist es EINE Funktion fuer beide.
    // Der KANONISCHE Name einer Variablen — derselbe Schnitt wie
    // canonicalVarName() in Studio: `bellows.<quelle>.` faellt weg, der Rest ist
    // der Schluessel des LiveStore. GEMESSEN am 10.09.2026: der Baumweg schickte
    // `bellows.gvl.Stachelbeere.xT_3` und bekam „unknown variable"; die
    // Registratur kennt `Stachelbeere.xT_3`.
    function canonicalVar(key) {
      if (!key) return key;
      const parts = String(key).split('.');
      return (parts.length >= 3 && parts[0] === 'bellows') ? parts.slice(2).join('.') : key;
    }
    function wireUp(model, insts, paramOf, isVarNode) {
      const addrOf = (ref) => canonicalVar(paramOf(ref, 'address'));
      const routes = model.routes || {};
      // Write a (possibly command-routed) variable. The page only signals the
      // canonical INTENT (write <base>=1 on a truthy value — the native handshake
      // runs the pulse/selection slot-mapping). A falsy value writes 0 only for a
      // Selection (deselect); for a Pulse the FSM owns the release, so the
      // momentary taster's release-0 is ignored (no abort).
      //
      // Pre-cleanup the route entry also carried a `req` field and we wrote
      // <base>_req here — variable-acl-model.md §2.1+§2.2: the HMI uses
      // canonical names, the bridge owns the handshake-slot. A `r.req` field
      // surviving in an older deployed model is still honored for back-compat.
      const writeVar = (v, val) => {
        if (!v || !window.writeValue) return;
        const r = routes[v];
        const target = (r && r.req) ? r.req : v;
        if (r) {
          if (val) window.writeValue(target, 1);
          else if (r.sel) window.writeValue(target, 0);
        } else {
          window.writeValue(v, val ? 1 : 0);
        }
      };

      const deliver = (w, val) => {
        if (w.tgtType === 'variable') { writeVar(w.tgtRef, val); return; }
        if (isVarNode(w.tgtRef)) { writeVar(addrOf(w.tgtRef), val); return; }
        const inst = insts[w.tgtRef]; if (inst) inst.setInput(w.tgtPort, String(val));
      };

      // ── DAS ZIEL FUEHRT SEIN ELEMENT MIT (Vertrag C-1) ──────────────────
      //
      // Hier standen nur Rueckrufe. Beim Eintreffen eines Werts hatte die
      // Laufzeit deshalb KEIN Element mehr in der Hand — und ein noch nicht
      // abgeglichener oder getrennter Wert liess sich nicht kennzeichnen.
      // Das Element mitzufuehren ist die kleinere Aenderung als jedem
      // Rueckruf die Entscheidung darueber zu geben: so bleibt sie an EINER
      // Stelle.
      const liveTargets = {};                        // canonical var → [{cb, el}]
      const onVar = (v, cb, el) => {
          if (v) (liveTargets[v] = liveTargets[v] || []).push({ cb, el });
      };
      const rootOf = (ref) => (insts[ref] && insts[ref].root) || null;

      (model.wires || []).forEach((w) => {
        // Gekennzeichnet wird, was den Wert ZEIGT — also das ZIEL der
        // Leitung. Fuehrt sie auf eine Variable statt auf ein Symbol, gibt es
        // nichts Sichtbares und damit auch nichts zu faerben.
        if (w.srcType === 'variable') { onVar(w.srcRef, (val) => deliver(w, val), rootOf(w.tgtRef)); return; }
        if (isVarNode(w.srcRef)) { onVar(addrOf(w.srcRef), (val) => deliver(w, val), rootOf(w.tgtRef)); return; }
        const inst = insts[w.srcRef];
        if (inst) inst.on(w.srcPort, (val) => deliver(w, val));
      });
      // Variable nodes also drive their OWN visual from the live value.
      (model.placements || []).forEach((p) => {
        if (!isVarNode(p.instanceId)) return;
        const a = addrOf(p.instanceId), inst = insts[p.instanceId];
        if (a && inst) onVar(a, (val) => inst.setInput('value', String(val)), inst.root);
      });

      // Feed live values by wrapping the page's onLiveUpdate (bindings keep working).
      const prev = window.onLiveUpdate;
      window.onLiveUpdate = function (values) {
        if (typeof prev === 'function') { try { prev(values); } catch (e) {} }
        for (const k in values) {
          const arr = liveTargets[k]; if (!arr) continue;
          const lv = values[k], val = (lv && lv.v != null) ? lv.v : lv;
          for (let i = 0; i < arr.length; i++) {
            try { arr[i].cb(val); } catch (e) {}
            // EINE Umsetzung: `window.setQuality` wohnt in hearth-base.js,
            // das die ausgelieferte Schirmseite mitlaedt. In der
            // Studio-Vorschau (canvas/index.html) fehlt es — dort gibt es
            // keine Bruecke mit Anlauffenster, also auch nichts zu melden.
            // Lieber nichts faerben als eine zweite Vorstellung von Guete.
            if (arr[i].el && typeof window.setQuality === 'function') {
              try { window.setQuality(arr[i].el, lv); } catch (e) {}
            }
          }
        }
      };
    }

    function fromModelBlock() {
      const el = document.getElementById('hearth-screen-model');
      if (!el) return false;
      let model;
      try { model = JSON.parse(decodeURIComponent(escape(atob((el.textContent || '').trim())))); }
      catch (e) { try { model = JSON.parse(atob((el.textContent || '').trim())); } catch (e2) { return true; } }
      hideConnectors();

      runtime().then((rt) => {
        const svg = (el.closest && el.closest('svg')) || document.querySelector('.screen-svg');
        if (!svg || typeof rt.mount !== 'function') return;
        const insts = {}, place = {};
        (model.placements || []).forEach((p) => {
          let inst; try { inst = rt.mount(p.symbol, svg); } catch (e) { return; }
          const sy = (p.scaleY != null ? p.scaleY : p.scale);
          inst.root.setAttribute('transform',
            'translate(' + p.x + ',' + p.y + ') scale(' + p.scale + ',' + sy + ') rotate(' + (p.rotation || 0) + ')');
          // Logic helpers mount (their class computes for the client propagation)
          // but are never PAINTED in live — design-time chrome only.
          if (p.logic) inst.root.style.display = 'none';
          // Die Gruppe in den Baum stempeln. Die Anlage kann sie damit als
          // Einheit ansprechen — [data-group="g…"] trifft Bibliothekssymbole
          // (hier montiert) UND Inline-Elemente (vom Server komponiert)
          // gleichermassen. Ohne diesen Stempel kaeme sie zwar mit, laege aber
          // nur im Modell und waere im DOM nicht auffindbar.
          if (p.group) inst.root.setAttribute('data-group', p.group);
          insts[p.instanceId] = inst; place[p.instanceId] = p;
        });

        const paramOf = (ref, k) => { const p = place[ref]; return p && p.symbol && p.symbol.params ? p.symbol.params[k] : undefined; };
        const isVarNode = (ref) => { const p = place[ref]; return !!(p && p.symbol && /^Variable/.test(p.symbol.name || '')); };
        wireUp(model, insts, paramOf, isVarNode);
      }).catch(() => {});
      return true;
    }

    function start() {
      if (fromTree()) return;
      fromModelBlock();
    }
    if (document.readyState !== 'loading') start();
    else document.addEventListener('DOMContentLoaded', start);
  })();

  // ── EIN WERT MUSS IN SEINE KACHEL PASSEN ───────────────────────────────────
  //
  // Zahlen tun das von selbst; TEXTE nicht. Gemessen am 02.09.2026 auf der
  // Anlage: `awaiting_descriptor` lief ueber die Nachbarkachel hinweg,
  // `Ackersteuerung` stand halb ausserhalb des Blattes. Beides sah aus wie ein
  // Zeichenfehler und war einer: SVG bricht nicht um, und `<text>` wird nicht
  // beschnitten — es laeuft einfach weiter.
  //
  // Drei Stufen, in dieser Reihenfolge:
  //
  //   1. EINE Zeile in Entwurfsgroesse. Der Normalfall; jede Zahl bleibt, wie
  //      sie gedacht war.
  //   2. ZWEI Zeilen, umgebrochen an einer Stelle, die im Text schon steht
  //      (Leerzeichen, `_`, `-`, `.`, `/`). Zwei lesbare Zeilen sind besser als
  //      eine winzige.
  //   3. VERKLEINERN, bis es passt — Boden bei 30 % der Entwurfsgroesse.
  //
  // ABGESCHNITTEN WIRD NIE. Ein gekuerzter Wert ist ein anderer Wert, und auf
  // einem Dashboard sieht man ihm das nicht an — `Ackersteueru` und
  // `Ackersteuerung` sind aus zwei Metern derselbe Text.
  //
  // ── HIER UND NICHT ZWEIMAL ─────────────────────────────────────────────────
  //
  // Die Kacheln zeichnen ZWEI Stellen: `dashboard.html.tera` auf der Anlage und
  // `canvas-editor.js` im Entwurf. Diese Datei laedt in beiden (der Editor ueber
  // `canvas/index.html`), also steht die Rechnung EINMAL — sonst zeigte der
  // Entwurf einen Umbruch, den die Anlage nicht macht, und das faellt erst auf
  // der Anlage auf.
  const SVGNS_FIT = 'http://www.w3.org/2000/svg';

  function tileBreaks(t) {
    const out = [];
    for (let i = 1; i < t.length; i++)
      if (/[\s_\-.\/]/.test(t.charAt(i - 1))) out.push(i);
    return out;
  }
  function tileSplit(t) {
    const stellen = tileBreaks(t);
    // DIE STELLE, DIE BEIDE HAELFTEN AM GLEICHMAESSIGSTEN MACHT — nicht die
    // erste. Ohne Bruchstelle wird hart getrennt: haesslich und ehrlich; die
    // Alternative waere, etwas wegzulassen.
    if (!stellen.length) {
      const m = Math.ceil(t.length / 2);
      return [t.slice(0, m), t.slice(m)];
    }
    const mitte = t.length / 2;
    let beste = stellen[0];
    for (const st of stellen)
      if (Math.abs(st - mitte) < Math.abs(beste - mitte)) beste = st;
    return [t.slice(0, beste).replace(/\s+$/, ''), t.slice(beste)];
  }
  // MEHRZEILIG wandert die Grundlinie nach oben, damit der Block dort steht, wo
  // die eine Zeile stand — sonst rutschte er in die Beschriftung darunter.
  function tileLines(el, arr, fs, base) {
    while (el.firstChild) el.removeChild(el.firstChild);
    el.setAttribute('font-size', fs);
    const x = el.getAttribute('x'), lh = fs * 1.02;
    const y0 = base - (arr.length - 1) * lh / 2;
    arr.forEach((z, i) => {
      const ts = document.createElementNS(SVGNS_FIT, 'tspan');
      ts.setAttribute('x', x);
      ts.setAttribute('y', y0 + i * lh);
      ts.textContent = z;
      el.appendChild(ts);
    });
  }
  function tileWidest(el) {
    let m = 0;
    for (const k of el.childNodes) {
      const w = k.getComputedTextLength ? k.getComputedTextLength() : 0;
      if (w > m) m = w;
    }
    return m;
  }

  /// Einen Wert in seine Kachel einpassen.
  ///
  ///   el    das `<text>` der Kachel — es traegt schon `x` und `text-anchor`
  ///   text  der Wert, WOERTLICH; er wird nie gekuerzt
  ///   fs    die Entwurfsgroesse
  ///   maxw  die nutzbare Breite der Kachel
  ///   base  die Grundlinie bei EINER Zeile
  function fitTileText(el, text, fs, maxw, base) {
    if (!el) return;
    if (!(fs > 0) || !(maxw > 0)) { el.textContent = text; return; }
    tileLines(el, [text], fs, base);
    if (tileWidest(el) <= maxw) return;
    const zwei = tileSplit(text);
    tileLines(el, zwei, fs, base);
    if (tileWidest(el) <= maxw) return;
    let g = fs;
    while (g > fs * 0.3) {
      g *= 0.9;
      tileLines(el, zwei, g, base);
      if (tileWidest(el) <= maxw) return;
    }
  }

  window.HearthScreen = Object.assign(window.HearthScreen || {},
    { blankScreen, playScreensaver, screensaver: playScreensaver,
      // `hideScreensaver` ist entfallen — das Bild kommt versteckt aus dem
      // Deploy. `restoreScreensaverArt` bringt es dorthin zurueck.
      maximizeScreensaver, restoreScreensaverArt,
      // Die Kachel-Einpassung: EINE Rechnung fuer Anlage und Entwurf.
      fitTileText,
      // Fuer den Editor und fuer Nachmessungen: dieselbe Rechnung, kein
      // Nachbau. Zwei Rechnungen fuer die Lage der Ebene waeren die naechste
      // Stelle, an der Entwurf und Anlage auseinanderlaufen.
      screenRect, alignScreenLayer });
})();
]]></asset>
   <asset name="forge-symbol-runtime.js" type="js" version="a67a163a"><![CDATA[// forge-symbol-runtime — the in-page HOST runtime (JS).
//
// The host-side adapter of the Host↔Symbol interface (docs/runtime-interface.md).
// A screen (and the editor test) is ONE big SVG in the HTML body; this mounts a
// symbol as a `<g>` inside that SVG, binds its control class to the group, and
// exposes the host API. Plain DOM JS — engine-agnostic — embedded by the host in
// a Chromium web view (hearth-symbols: QWebEngineView; Studio/hearth: same/CEF).
//
//   symbol = { svg, source, params }
//     svg    — the symbol's inner SVG (elements carry data-role="…")
//     source — the generated control class "class extends HearthSymbol {…}"
//     params — optional { key: value } applied as data-<key> on the group

import { HearthSymbol, keepTextReadable, mirrorOf } from './HearthSymbol.js';
export { HearthSymbol, keepTextReadable, mirrorOf };

const SVGNS = 'http://www.w3.org/2000/svg';

/// Mount one symbol into `svgContainer` (an <svg> in the body). Returns Instance.
export function mount(symbol, svgContainer) {
  const g = document.createElementNS(SVGNS, 'g');
  g.setAttribute('class', 'hearth-symbol');
  for (const [k, v] of Object.entries(symbol.params || {})) g.setAttribute('data-' + k, v);
  g.innerHTML = symbol.svg;                       // the symbol drawing (with data-roles)
  svgContainer.appendChild(g);
  return attach(g, symbol);
}

/// ── BIND A CONTROL CLASS TO A GROUP THAT IS ALREADY DRAWN ───────────────────
///
/// `mount()` draws first and binds second; on the plant the drawing arrives
/// WITH the page — the compiler resolved the placements into `<g>` elements
/// long before the browser ran a line of JS. Only the binding is left.
///
/// This is the SAME binding, not a second one: `mount()` now ends here. Two
/// ways to attach a control class would be two answers to the question what
/// "the symbol runs" means, and the one nobody looks at goes stale.
///
///   root    the `<g>` in the document — it carries the drawing AND the
///           `data-…` parameters (the compiler writes what mount() would set)
///   symbol  `{ source, name }` — the drawing is already in `root`, so `svg`
///           is not read here
export function attach(root, symbol) {
  return new Instance(root, symbol);
}

class Instance {
  constructor(root, symbol) {
    this.root = root;
    this.symbol = symbol;
    this._instantiate();
  }
  _instantiate() {
    // ── EIN KAPUTTES SKRIPT DARF DAS SYMBOL NICHT VERSCHLUCKEN ─────────────
    //
    // Hier stand der Aufruf blank. Warf er, brach `mount()` ab — NACHDEM die
    // Gruppe schon im Baum hing. Zurueck blieb ein Gebilde, das aussieht wie
    // ein Symbol und keines ist: in keiner Instanzliste, ohne Klickgriff, in
    // keinem Modell. Auf dem Schirm ein Symbol, das sich nicht anwaehlen
    // laesst.
    //
    // Gemessen am 26.08.2026 an der Konstantpumpe: `SyntaxError: Unexpected
    // token 'const'`. Ihr Skript ist kein `class extends HearthSymbol {…}`,
    // sondern ein Anweisungsblock im aelteren Stil — so schreiben es 44 von 64
    // Bibliothekssymbolen.
    //
    // Der Rueckfall ist die LEERE Steuerklasse: das Symbol zeichnet seinen
    // statischen Koerper, laesst sich waehlen, verschieben und loeschen wie
    // jedes andere, und nur sein Eigenleben fehlt. Das ist ein sichtbarer
    // Mangel statt eines unsichtbaren.
    let Ctl;
    try {
      Ctl = new Function('HearthSymbol', `return (${this.symbol.source});`)(HearthSymbol);
      if (typeof Ctl !== 'function') throw new TypeError('source is not a class');
    } catch (e) {
      console.warn('[symbol] control class of', this.symbol.name || '(unnamed)',
                   'did not load — mounting statically:', e.message);
      this.sourceFailed = e;
      Ctl = class extends HearthSymbol {};
    }
    // ── JEDE EIGENSCHAFT WIRFT IHREN SCHATTEN ALS CSS-VARIABLE ────────────
    //
    // Eine Zeichnung darf `fill="var(--wegfarbe)"` schreiben — das ist der
    // Weg, auf dem eine Farbe EINE Quelle hat: sie steht am Element, und der
    // Wert kommt von aussen. `prop()` liest genau in dieser Reihenfolge
    // (`data-<key>`, dann `var(--<key>)`); geschrieben hat die Variable aber
    // NIEMAND.
    //
    // GEMESSEN am 03.09.2026 an der Ackersteuerung: die Beetgruppen tragen
    // `data-wegfarbe="#deddda"`, der `<style>` des Symbols setzt
    // `--wegfarbe: #7f9c6b` als Vorgabe — und genau die stand im Bild, am
    // Pixel nachgemessen (127, 156, 107). Zehn Platzierungen, alle mit dem
    // richtigen Wert in der Datei, keine mit dem richtigen Wert auf dem
    // Schirm, und nichts schlug fehl.
    //
    // DIE ANDERE KUR WAERE EINE ZWEITE QUELLE: die Steuerklasse malt per
    // `applyAttr` darueber. Der Pruefer des Editors weist das ausdruecklich
    // ab — „Set twice (element and control class): which one wins is not
    // visible" — und er hat recht: dann entschiede die Reihenfolge, und auf
    // der Zeichenflaeche wirkte es gar nicht.
    //
    // VOR der Steuerklasse, damit `onInit()` schon den geltenden Wert sieht.
    for (const a of Array.from(this.root.attributes)) {
      if (!a.name.startsWith('data-') || a.value === '') continue;
      this.root.style.setProperty('--' + a.name.slice(5), a.value);
    }

    this.ctl = new Ctl();
    this.ctl.root = this.root;
    // Dasselbe fuer den Anlauf: eine Klasse, die beim Start stolpert, nimmt
    // sonst dieselbe Gruppe mit in den Baum und laesst denselben Geist zurueck.
    if (typeof this.ctl.onInit === 'function') {
      try { this.ctl.onInit(); }
      catch (e) {
        console.warn('[symbol] onInit of', this.symbol.name || '(unnamed)',
                     'failed — mounted statically:', e.message);
        this.initFailed = e;
      }
    }
    this._applyRef();
    keepTextReadable(this.root);
  }

  // Reference designation (Betriebsmittelkennzeichen): the per-placement `ref`
  // param (data-ref) becomes the symbol's OWN label, so the SYMBOL itself shows
  // its identity — in the editor AND in deployed hearth. Uses an authored
  // data-role="ref" text if present, else auto-creates one above the symbol.
  _applyRef() {
    const ref = this.root.getAttribute('data-ref') || '';
    let el = this.root.querySelector('[data-role="ref"]');
    let leader = this.root.querySelector('[data-role="ref-leader"]');
    // No ref, or the label is hidden (identity kept in data-ref for export/wiring,
    // only the visible text + leader are removed): nothing to draw.
    const hidden = /^(1|true|yes)$/i.test(this.root.getAttribute('data-refhidden') || '');
    if (!ref || hidden) { if (el) el.remove(); if (leader) leader.remove(); return; }

    // Stable anchor point on the SYMBOL (computed once, before the label/leader
    // affect the bbox). The label hangs off this point; the leader connects them.
    let ax = parseFloat(this.root.getAttribute('data-refax'));
    let ay = parseFloat(this.root.getAttribute('data-refay'));
    if (!isFinite(ax) || !isFinite(ay)) {
      let bb; try { bb = this.root.getBBox(); } catch (e) { bb = { x: 0, y: 0, width: 100, height: 0 }; }
      ax = bb.x + bb.width / 2; ay = bb.y - 5;
      this.root.setAttribute('data-refax', ax);
      this.root.setAttribute('data-refay', ay);
    }
    // User-draggable offset (local coords). Label sits at anchor + (dx,dy).
    const dx = parseFloat(this.root.getAttribute('data-refdx')) || 0;
    const dy = parseFloat(this.root.getAttribute('data-refdy')) || 0;
    const lx = ax + dx, ly = ay + dy;

    // Leader line (Gummilinie) anchor→label, only when the label was moved away.
    const moved = (dx * dx + dy * dy) > 36;
    if (moved) {
      if (!leader) {
        leader = document.createElementNS(SVGNS, 'line');
        leader.setAttribute('data-role', 'ref-leader');
        leader.setAttribute('class', 'hearth-ref-leader');
        leader.setAttribute('stroke', '#8a8a8a');
        leader.setAttribute('stroke-width', '1');
        leader.setAttribute('stroke-dasharray', '4 3');
        if (el) this.root.insertBefore(leader, el); else this.root.appendChild(leader);
      }
      leader.setAttribute('x1', ax); leader.setAttribute('y1', ay);
      leader.setAttribute('x2', lx); leader.setAttribute('y2', ly);
    } else if (leader) { leader.remove(); }

    if (!el) {
      el = document.createElementNS(SVGNS, 'text');
      el.setAttribute('data-role', 'ref');
      el.setAttribute('class', 'hearth-ref');
      el.setAttribute('text-anchor', 'middle');
      el.setAttribute('font-size', '13');
      el.setAttribute('font-family', 'DejaVu Sans, sans-serif');
      el.setAttribute('font-weight', '700');
      el.setAttribute('fill', '#161616');
      el.setAttribute('paint-order', 'stroke');
      el.setAttribute('stroke', '#ffffff');
      el.setAttribute('stroke-width', '3');
      el.setAttribute('stroke-linejoin', 'round');
      el.style.cursor = 'move';
      this.root.appendChild(el);                 // text always on top
    }
    el.setAttribute('x', lx);
    el.setAttribute('y', ly);
    el.textContent = ref;
  }

  // ── HIER RECHNET NICHTS GEGEN DIE PLATZIERUNG ────────────────────────────
  //
  // An dieser Stelle standen drei Dinge: `_placementMatrix()` (die Lage der
  // Platzierung zerlegen), `_uprightRef()` (das Betriebsmittelkennzeichen
  // waagerecht und gleich gross halten) und `_unmirrorTexts()` (Text auf einem
  // gespiegelten oder gedrehten Symbol lesbar halten). Dazu `realignRef()` als
  // ihr gemeinsamer Aufrufer.
  //
  // Alle drei sind AEUSSERE Korrekturen: sie messen die Platzierung und rechnen
  // dagegen. Und alle drei haben nie gewirkt — sie lasen `rotate()` (Typ 4) und
  // `scale()` (Typ 3) aus der Transformationsliste, waehrend jede echte
  // Platzierung EIN `matrix(…)` traegt (Typ 1). Gemessen am 03.09.2026 an der
  // ausgelieferten Ackersteuerung: 52 von 52.
  //
  // Festlegung des Anwenders: das SYMBOL definiert seine Einheit, und die
  // Platzierung faktoriert sie mit scale x/y. Sonst nichts. Wer von aussen
  // dagegenrechnet, macht aus einer Angabe eine, die je nach Ort etwas anderes
  // bedeutet — und genau daran ist heute Nacht dreimal etwas gescheitert.
  //
  // Wer eine Beschriftung waagerecht braucht, zeichnet sie im Symbol
  // waagerecht. Das ist eine Entscheidung des Entwerfers, keine Rechnung der
  // Laufzeit.

  // host → symbol
  setInput(connector, value) { this.ctl.set(connector, value); }
  setParam(key, value) {
    this.root.setAttribute('data-' + key, value);   // visible after reload()
    if (key === 'ref' || key === 'refdx' || key === 'refdy' ||
        key === 'refrot' || key === 'refhidden')
      this._applyRef();                              // ref / position / rotation / visibility live
  }

  // symbol → host
  on(connector, cb) { this.root.addEventListener(connector, e => cb(e.detail)); }

  /// Parameter change → reload → visible: re-instantiate the control class
  /// against the same group, so onInit re-reads the (changed) parameters.
  reload() { this._instantiate(); }

  dispose() { this.root.remove(); }
}
