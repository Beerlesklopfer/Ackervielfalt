      <path d="M 0 0 L 199 0 L 199 480 L 0 480 L 0 0 M 6 6 L 6 474 L 193 474 L 193 6 Z" data-role="led_1" fill="var(--ledcolor)" id="4fc3a6f5-5079-49ab-add1-fbe88c5b0b76" stroke="none"/>
