   <asset name="about.svg" type="media"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Ueber diese Anwendung — Standardmedium der Anlagensoftware.
     Die Pfade sind WOERTLICH die aus navbar.html.tera; sie standen dort fest im
     Markup, und wer das Sinnbild tauschen wollte, musste die Vorlage
     ueberschreiben. Als Medium reist es in der .hearth und laesst sich
     ersetzen.
     `currentColor` bleibt: die Leiste faerbt es ueber ihre Textfarbe
     (CSS-Variable nav-text). KEIN doppelter Bindestrich in diesem
     Kommentar — XML verbietet ihn, und die Datei war damit nicht
     wohlgeformt: ein strenger Parser haette sie abgewiesen, und die
     Maske waere leer geblieben. Genau so verschwindet ein Sinnbild,
     ohne dass irgendwo ein Fehler steht. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round">
  <circle cx="12" cy="12" r="10"/>
  <line x1="12" y1="16" x2="12" y2="12"/>
  <line x1="12" y1="8" x2="12.01" y2="8"/>
</svg>
]]></asset>
   <asset name="help.svg" type="media"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Hilfe — Standardmedium der Anlagensoftware. Siehe about.svg. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round">
  <circle cx="12" cy="12" r="10"/>
  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
  <line x1="12" y1="17" x2="12.01" y2="17"/>
</svg>
]]></asset>
   <asset name="language.svg" type="media"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Sprache — Standardmedium der Anlagensoftware.
     Ein Globus, keine Flagge: die Flagge steht fuer ein LAND, nicht fuer eine
     Sprache, und Deutsch ist nicht Deutschland. Die Flaggen-Emoji der einzelnen
     Eintraege bleiben davon unberuehrt; dies ist das Zeichen des Umschalters. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="12" cy="12" r="9"/>
  <path d="M3 12h18"/>
  <path d="M12 3c2.7 3 4 5.9 4 9s-1.3 6-4 9c-2.7-3-4-5.9-4-9s1.3-6 4-9z"/>
</svg>
]]></asset>
   <asset name="login.svg" type="media"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Anmelden — Standardmedium der Anlagensoftware.
     Wie about.svg und help.svg: als Medium reist es in der .hearth und laesst
     sich ersetzen, ohne die Vorlage zu ueberschreiben.
     `currentColor` bleibt, damit der Knopf es ueber seine eigene Textfarbe
     einfaerbt. (Kein doppelter Bindestrich in diesem Kommentar: XML verbietet
     ihn, und die Datei waere nicht wohlgeformt.) -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
  <path d="M10 17l5-5-5-5"/>
  <path d="M15 12H3"/>
</svg>
]]></asset>
