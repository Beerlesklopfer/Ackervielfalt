       <g xmlns="http://www.w3.org/2000/svg" id="433806de-1f3c-4861-98c3-010a8092128f" hearth:layer="content" hearth:layer-name="Content" xmlns:hearth="https://forgeiec.io/hearth/1.0">
        <g xmlns="https://forgeiec.io/hearth/1.0" class="hearth-connector" id="cbc65af1-3920-4d6d-9994-20d1ecdb4baf" hearth:connector="out" hearth:dir="out" hearth:editor-only="true" xmlns:hearth="https://forgeiec.io/hearth/1.0">
         <line xmlns="https://forgeiec.io/hearth/1.0" stroke="#5a5a5a" stroke-width="1.5" x1="88" x2="72" y1="20" y2="20"/>
         <circle xmlns="https://forgeiec.io/hearth/1.0" cx="88" cy="20" fill="#e74c3c" r="3" stroke="#ffffff" stroke-width="1"/>
