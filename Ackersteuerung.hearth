     <script type="text/javascript">// Randbeet — die schraeg zulaufende Beerenflaeche am linken Feldrand.
//
// SIE IST KEIN SCHMUCK, SONDERN ANLAGE. Sie wird bewaessert wie jede
// Beetgruppe, also traegt sie dieselben Signale: EIN Ventil fuer die
// Flaeche (valve, herein), die Handtaste des Bedieners (taster, hinaus), die
// Anwahl (led, herein) und die Reihenfolge (order, herein). Vorher lag dort
// eine freie Zeichnung — sichtbar, aber ohne Anschluss; wer sie bewaessern
// wollte, hatte nichts, woran er es haette binden koennen.
//
// DIE SCHRAEGE KANTE ist der Grund fuer ein eigenes Symbol. Das Feld endet
// links am Randband, und das Band laeuft schraeg; eine rechteckige Beetgruppe
// liesse dort einen Keil frei oder ragte darueber.
//
// DIE BEWAESSERUNG IST EINE EIGENE, HALBDURCHSICHTIGE LAGE ueber der Flaeche,
// kein Farbtausch — wie bei der Beetgruppe, und aus demselben Grund: nur so
// schimmert das Beet noch durch, und der Bediener sieht, was unter dem Wasser
// liegt.
//
// DIE DECKUNG STEHT IN PROZENT als Eigenschaft `alpha`, nicht als achte und
// neunte Stelle im Fuellwert. Qt-SVG kennt `#RRGGBBAA` nicht und malte die
// Flaeche schwarz — dieselbe Datei zeigte im Browser Blau und in der Kachel
// der Bibliothek einen Klotz.
//
// ── DER RAHMEN ERSCHEINT NUR BEI ANWAHL ─────────────────────────────────────
//
// `led` (herein) sagt, ob dieses Beet ANGEWAEHLT ist; `taster` (hinaus) ist
// der Kontakt darunter — zusammen der Leuchtdrucktaster des Beets.
//
// Zwischendurch stand der Rahmen FEST und wechselte bei Anwahl die Farbe. Zu
// viel Bild fuer eine Aussage, die meistens „nein" heisst; Festlegung des
// Anwenders am 11.09.2026: „Nur wenn gewaehlt, dann das outline."
//
// ── DIE RAHMEN SIND TRAPEZE, KEINE RECHTECKE ────────────────────────────────
//
// Sie zeichnen die beiden Bloecke selbst nach, jeden mit SEINER Kante: der
// obere laeuft von x=102 auf x=56, der untere von x=46 auf x=0. Ein
// aufrechtes Rechteck laege quer ueber genau die schraege Kante, derentwegen
// es dieses Symbol gibt.
//
// Jeder Rahmen ist EIN Pfad aus zwei Zuegen — der aeussere im Uhrzeigersinn,
// der innere GEGEN ihn, 6 Einheiten nach innen versetzt. Die Vorgabe `nonzero`
// laesst die Mitte dann offen, ohne dass ein `fill-rule` danebenstehen muss;
// beide Zeichner, Browser wie Qt-SVG, verstehen es gleich. Der Versatz der
// schraegen Kante ist senkrecht zu IHR gerechnet, nicht waagerecht, sonst
// waere das Band an der Schraege schmaler als oben und unten.
//
// Die Farbe hat EINE Quelle: die CSS-Variable am Element. Die Klasse faerbt
// nicht nach, sie blendet nur ein und aus.
//
// ── DIE ZAHL OBEN RECHTS: DIE REIHENFOLGE ───────────────────────────────────
//
// `order` (herein) sagt, als wievieltes dieses Beet geschaltet wird. Sie steht
// oben rechts im oberen Block, rechtsbuendig, damit mehrstellige Werte nach
// links wachsen.
//
// FORMAT NACH DEM WERT: eine ganze Zahl ist die Reihenfolge und wird gezeigt,
// wie sie kommt; alles andere ist eine ZEIT und wird `hh:mm:ss`. Das ist die
// Vorbereitung auf die Zeit-Betriebsarten — derselbe Anschluss, dieselbe Stelle
// im Bild, und die Anlage entscheidet, was sie dort hinschreibt.
//
// `_orderText`/`_clock`/`_hms` stehen gleichlautend auch in Beetgruppe und
// Beetgruppe-4x5. Ihr Platz ist `HearthSymbol.js`, sobald die
// Zeit-Betriebsarten festliegen — bis dahin eine bekannte Schuld.
//
// ── DER DRUCK WIRD AN EINER STELLE GELESEN ──────────────────────────────────
//
// Der Rahmen erscheint schon beim Druck, ohne auf die Antwort der Anlage zu
// warten. Ein zweiter `pointerdown`-Horcher auf der Trefferflaeche laese
// denselben Druck ein zweites Mal, und die beiden Lesungen laufen auseinander,
// sobald die Trefferflaechen anders geschnitten werden.
//
// Deshalb kommt der Druck aus dem Signal, das das Symbol OHNEHIN meldet:
// `emit()` ist das eine Tor, durch das jeder Ausgangs-Konnektor geht, und
// `wireMomentary()` ruft es beim Druecken und beim Loslassen.
class extends HearthSymbol {
  onInit() {
    this.applyPercent('wasser', 'fill-opacity', 'alpha');
    this.setVisible('wasser', 0);            // trocken, bis das Ventil etwas sagt
    this.lit = false;                        // last value of the `led` connector
    this.pressed = false;                    // finger down on the hit area
    this.showLamp();                         // no frame until one of the two speaks
    this.setText('order', '');               // und keine Zahl, bis eine kommt
    this.wireMomentary('flaeche', 'taster'); // Trefferflaeche ueber der GANZEN Flaeche
  }
  onAttr(name, val) {
    if (name === 'valve') this.setVisible('wasser', val);
    if (name === 'led') { this.lit = this.truthy(val); this.showLamp(); }
    if (name === 'order') this.setText('order', this._orderText(val));
    // Die Deckung darf sich auch NACH dem Anlauf aendern — sonst wirkte eine
    // Aenderung im Inspektor erst beim naechsten Laden.
    if (name === 'alpha') this.applyPercent('wasser', 'fill-opacity', 'alpha');
  }
  /// The contact this symbol reports IS the press it echoes — one signal, one
  /// place. Everything else passing through emit() is handed straight on.
  emit(name, value) {
    super.emit(name, value);
    if (name === 'taster') { this.pressed = this.truthy(value); this.showLamp(); }
  }
  /// Selected by the plant, or held under the finger.
  showLamp() {
    this.setVisible('led', this.lit || this.pressed);
  }

  // ── Reihenfolge oder Zeit ─────────────────────────────────────────────────

  /// A whole number stays a number; everything else becomes hh:mm:ss.
  _orderText(v) {
    const s = String(v === null || v === undefined ? '' : v).trim();
    if (s === '') return '';
    if (/^[+-]?\d+$/.test(s)) return s;
    return this._clock(s);
  }
  /// Any time-ish notation → hh:mm:ss. Unknown text comes back unchanged.
  _clock(s) {
    const teile = s.split(':');
    if (teile.length >= 2 &amp;&amp; teile.every((t) => /^\d+$/.test(t.trim()))) {
      const z = teile.map((t) => Number(t));
      while (z.length &lt; 3) z.unshift(0);
      return this._hms(z[0] * 3600 + z[1] * 60 + z[2]);
    }
    // IEC-Literal: T#1h2m30s, TIME#500ms. `ms` steht vor `m`, sonst bliebe das
    // `s` stehen und die Millisekunden waeren Minuten.
    const iec = s.match(/^(?:TIME|T)#(.+)$/i);
    if (iec) {
      const faktor = { d: 86400, h: 3600, m: 60, s: 1, ms: 0.001 };
      let sek = 0, getroffen = false;
      for (const m of iec[1].matchAll(/(\d+(?:\.\d+)?)\s*(ms|d|h|m|s)/gi)) {
        sek += Number(m[1]) * faktor[m[2].toLowerCase()];
        getroffen = true;
      }
      if (getroffen) return this._hms(sek);
    }
    const n = Number(s);
    return isFinite(n) ? this._hms(n) : s;
  }
  /// Seconds → hh:mm:ss, two digits each.
  _hms(sekunden) {
    const g = Math.max(0, Math.round(Number(sekunden) || 0));
    const p = (x) => String(x).padStart(2, '0');
    return p(Math.floor(g / 3600)) + ':' + p(Math.floor(g / 60) % 60) + ':' + p(g % 60);
  }
}</script>
    </svg>
   </symbol>
