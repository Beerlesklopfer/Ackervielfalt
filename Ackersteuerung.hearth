     <hearth-placement id="f94d4cf4-ad6c-4933-ac9f-6f852491c231" logic="true" transform="matrix(1 0 0 1 1730 1020)">
      <symbol family="Logik" name="Gatter">
       <g xmlns="http://www.w3.org/2000/svg" id="0ae7b867-bcbb-4e37-867b-93330f8e7a1c" hearth:layer="background" hearth:layer-name="Background" hearth:locked="true" xmlns:hearth="https://forgeiec.io/hearth/1.0"/>
       <g xmlns="http://www.w3.org/2000/svg" id="f2fd06a0-1226-40d1-bab5-be0f4c5cd7da" hearth:layer="content" hearth:layer-name="Content" xmlns:hearth="https://forgeiec.io/hearth/1.0"/>
       <g xmlns="http://www.w3.org/2000/svg" id="08cc3fef-3799-4fdb-9a6a-e318ed574efd" hearth:layer="actions" hearth:layer-name="Actions" xmlns:hearth="https://forgeiec.io/hearth/1.0">
        <g xmlns="https://forgeiec.io/hearth/1.0" class="hearth-connector" id="c38901b6-ba1a-4c09-9fc3-17e256a77d18" hearth:connector="in0" hearth:dir="in" hearth:editor-only="true" xmlns:hearth="https://forgeiec.io/hearth/1.0">
         <line xmlns="https://forgeiec.io/hearth/1.0" stroke="#5a5a5a" stroke-width="1.5" x1="0" x2="14" y1="16" y2="16"/>
         <circle xmlns="https://forgeiec.io/hearth/1.0" cx="0" cy="16" fill="#3498db" r="3" stroke="#ffffff" stroke-width="1"/>
        </g>
        <g xmlns="https://forgeiec.io/hearth/1.0" class="hearth-connector" id="26a11b4f-8299-4fd1-bc72-0531a6e6dcd6" hearth:connector="in1" hearth:dir="in" hearth:editor-only="true" xmlns:hearth="https://forgeiec.io/hearth/1.0">
         <line xmlns="https://forgeiec.io/hearth/1.0" stroke="#5a5a5a" stroke-width="1.5" x1="0" x2="14" y1="32" y2="32"/>
         <circle xmlns="https://forgeiec.io/hearth/1.0" cx="0" cy="32" fill="#3498db" r="3" stroke="#ffffff" stroke-width="1"/>
        </g>
        <g xmlns="https://forgeiec.io/hearth/1.0" class="hearth-connector" id="9bfadaba-1db5-4903-a1bd-88f8a47f07cc" hearth:connector="out" hearth:dir="out" hearth:editor-only="true" xmlns:hearth="https://forgeiec.io/hearth/1.0">
         <line xmlns="https://forgeiec.io/hearth/1.0" stroke="#5a5a5a" stroke-width="1.5" x1="82" x2="68" y1="24" y2="24"/>
         <circle xmlns="https://forgeiec.io/hearth/1.0" cx="82" cy="24" fill="#e74c3c" r="3" stroke="#ffffff" stroke-width="1"/>
        </g>
        <rect xmlns="http://www.w3.org/2000/svg" data-role="body" fill="#eef2f7" height="40" id="2cf5a07b-952d-4e79-9f77-240b61cd7217" stroke="#34495e" stroke-width="2" width="54" x="14" y="4"/>
        <text xmlns="http://www.w3.org/2000/svg" data-h="40" data-role="op" data-w="54" dominant-baseline="central" fill="#34495e" font-size="18" id="43af3a0d-0a4d-4518-b5a6-8972641d45b4" text-anchor="middle" x="41" y="24">&amp;</text>
       </g>
       <hearth-source><![CDATA[class extends HearthSymbol {
  onInit() { this._v = {}; this._build(); }

  // Fully JS-built geometry so the gate grows with each input pin.
  _build() {
    const n = Math.max(1, parseInt(this.prop('inputs') || '2', 10) || 2);
    const op = this.prop('gate_op') || 'and';
    const bx = 14, bw = 54, top = 4, pinLen = 14, pitch = 16;
    const bh = Math.max(40, n * pitch + 8);

    let body = this.role('body');
    if (!body) body = this.make('rect', { 'data-role': 'body' });
    body.setAttribute('x', bx); body.setAttribute('y', top);
    body.setAttribute('width', bw); body.setAttribute('height', bh);
    body.setAttribute('fill', '#eef2f7'); body.setAttribute('stroke', '#34495e');
    body.setAttribute('stroke-width', 2); body.setAttribute('rx', 2);
    // KEIN eigenes contextmenu auf dem Koerper mehr. Es hielt das Ereignis an
    // und zeigte nur die Gatter-Punkte — Gruppieren, Sperren, Ausrichten und
    // Loeschen waren fuer Gatter damit unerreichbar. Die eigenen Punkte
    // liefert jetzt menuItems() an das Menue der Zeichenflaeche.

    let opEl = this.role('op');
    if (!opEl) opEl = this.make('text', { 'data-role': 'op' });
    opEl.setAttribute('x', bx + bw / 2); opEl.setAttribute('y', top + bh / 2);
    opEl.setAttribute('text-anchor', 'middle');
    opEl.setAttribute('dominant-baseline', 'central');
    opEl.setAttribute('fill', '#34495e'); opEl.setAttribute('font-size', 18);
    opEl.setAttribute('pointer-events', 'none');
    const AND = String.fromCharCode(38);
    const G = { or: String.fromCharCode(8805) + '1', xor: '=1', not: '1' };
    opEl.textContent = G[op] || AND;

    // rebuild connectors + bubbles from scratch
    this.root.querySelectorAll('.hearth-connector, [data-role="inv"]').forEach(e => e.remove());
    const cy0 = top + (bh - (n - 1) * pitch) / 2;
    for (let i = 0; i < n; i++) { const y = cy0 + i * pitch; this._pin('in' + i, 'in', 0, y, bx, y); }
    const oy = top + bh / 2;
    this._pin('out', 'out', bx + bw + pinLen, oy, bx + bw, oy);

    this._renderBubbles();
    this._bindPins();
    this._compute();
    this.refresh();   // host re-scans the (now changed) connectors + rewires
  }

  _pin(name, dir, px, py, ex, ey) {
    const g = this.make('g', { class: 'hearth-connector', 'hearth:connector': name,
      'hearth:dir': dir, 'hearth:editor-only': 'true' });
    this.make('line', { x1: px, y1: py, x2: ex, y2: ey, stroke: '#5a5a5a', 'stroke-width': 1.5 }, g);
    this.make('circle', { cx: px, cy: py, r: 3,
      fill: dir === 'out' ? '#e74c3c' : '#3498db', stroke: '#fff', 'stroke-width': 1 }, g);
  }

  _conns() { return Array.from(this.root.querySelectorAll('.hearth-connector')); }
  _isOut(g) { return (g.getAttribute('hearth:dir') || 'in').indexOf('out') === 0; }
  _name(g) { return g.getAttribute('hearth:connector'); }
  _ins() { return this._conns().filter(g => !this._isOut(g)).map(g => this._name(g)); }
  // per-pin negation: each connector owns its 'inverted' state (data-inv_<name>);
  // the DeMorgan bubble is just its visualisation.
  _inv(name) { const v = this.prop('inv_' + name); return v === '1' || v === 'true'; }

  _renderBubbles() {
    this.root.querySelectorAll('[data-role="inv"]').forEach(e => e.remove());
    this._conns().forEach(g => {
      if (!this._inv(this._name(g))) return;
      const line = g.querySelector('line'), dot = g.querySelector('circle');
      if (!line) return;
      const bx = parseFloat(line.getAttribute('x2')), by = parseFloat(line.getAttribute('y2'));
      const px = dot ? parseFloat(dot.getAttribute('cx')) : bx;
      const py = dot ? parseFloat(dot.getAttribute('cy')) : by;
      const d = Math.hypot(px - bx, py - by) || 1;
      this.make('circle', { cx: bx + (px - bx) / d * 4, cy: by + (py - by) / d * 4,
        r: 4, fill: '#fff', stroke: '#34495e', 'stroke-width': 1.5, 'data-role': 'inv' });
    });
  }

  // Pin interaction (symbol-side): hover scales the pin; Ctrl+Click toggles its
  // 'inverted' property (setProp persists via the host); right-click opens the
  // context menu. Plain left-drag is left to the host for wiring.
  _bindPins() {
    this._conns().forEach(g => {
      const dot = g.querySelector('circle');
      if (!dot || dot.__pin) return;
      dot.__pin = true;
      const r0 = dot.getAttribute('r') || '3';
      g.style.cursor = 'pointer';
      g.addEventListener('mouseenter', () => dot.setAttribute('r', '5.5'));
      g.addEventListener('mouseleave', () => dot.setAttribute('r', r0));
      g.addEventListener('click', (ev) => {
        if (!ev.ctrlKey) return;
        ev.preventDefault(); ev.stopPropagation();
        const name = this._name(g);
        this.setProp('inv_' + name, this._inv(name) ? '0' : '1');
        this._renderBubbles(); this._compute();
      });
      // RECHTSKLICK AUF DEN ANSCHLUSS SCHALTET DIE NEGATION — an Ein- wie
      // Ausgaengen. Vorher lag das auf Strg+Klick, und der Rechtsklick oeffnete
      // hier dasselbe Menue wie ueberall: eine Handlung, die genau EINEN Punkt
      // betrifft, hinter zwei Tasten und einem Menue.
      g.addEventListener('contextmenu', (ev) => {
        ev.preventDefault(); ev.stopPropagation();
        const name = this._name(g);
        this.setProp('inv_' + name, this._inv(name) ? '0' : '1');
        this._renderBubbles(); this._compute();
      });
    });
  }

  // Was dieses Symbol dem Menue der Zeichenflaeche beisteuert.
  //
  // Kein eigenes Menue mehr: die Zeichenflaeche setzt diese Punkte oben in ihr
  // eigenes und haengt Gruppieren, Sperren, Ausrichten, Loeschen darunter.
  menuItems(ctx) {
    // Zeigt der Bediener auf einen ANSCHLUSS, ist das Genauere gemeint: die
    // Negation dieses einen Pins. Sie stand vorher hinter Strg+Klick — eine
    // Handlung, die genau einen Punkt betrifft, hinter einer zweiten Taste.
    if (ctx && ctx.connector) {
      const name = ctx.connector;
      return [{ label: this._inv(name) ? 'Negation aufheben (' + name + ')'
                                       : 'Negation setzen (' + name + ')',
                fn: () => { this.setProp('inv_' + name, this._inv(name) ? '0' : '1');
                            this._renderBubbles(); this._compute(); } }];
    }
    const n = Math.max(1, parseInt(this.prop('inputs') || '2', 10) || 2);
    const op = this.prop('gate_op') || 'and';
    const items = [
      { label: 'Eingang +', fn: () => { this.setProp('inputs', n + 1); this._build(); } },
    ];
    if (n > 1)
      items.push({ label: 'Eingang -', fn: () => { this.setProp('inputs', n - 1); this._build(); } });
    items.push({ sep: true });
    [['and', 'AND'], ['or', 'OR'], ['xor', 'XOR'], ['not', 'NOT']].forEach(o =>
      items.push({ label: 'Operation: ' + o[1], on: op === o[0],
                   fn: () => { this.setProp('gate_op', o[0]); this._build(); } }));
    return items;
  }

  // JS context menu (right-click): input count +/- and the operation.
  _menu(x, y) {
    this._closeMenu();
    const m = document.createElement('div');
    m.style.cssText = 'position:fixed;left:' + x + 'px;top:' + y + 'px;z-index:99999;'
      + 'background:#fff;border:1px solid #999;box-shadow:0 2px 10px rgba(0,0,0,.3);'
      + 'font:12px sans-serif;color:#222;min-width:160px;padding:3px 0';
    const item = (label, fn, on) => {
      const d = document.createElement('div');
      d.textContent = label;
      d.style.cssText = 'padding:5px 14px;cursor:pointer;white-space:nowrap';
      if (on) d.style.fontWeight = 'bold';
      d.onmouseenter = () => d.style.background = '#e8f0fe';
      d.onmouseleave = () => d.style.background = '';
      d.onmousedown = (e) => { e.preventDefault(); e.stopPropagation(); };
      d.onclick = () => { this._closeMenu(); fn(); };
      m.appendChild(d);
    };
    const sep = () => { const s = document.createElement('div');
      s.style.cssText = 'border-top:1px solid #ddd;margin:3px 0'; m.appendChild(s); };
    const n = Math.max(1, parseInt(this.prop('inputs') || '2', 10) || 2);
    const op = this.prop('gate_op') || 'and';
    item('Eingang +', () => { this.setProp('inputs', n + 1); this._build(); });
    if (n > 1) item('Eingang -', () => { this.setProp('inputs', n - 1); this._build(); });
    sep();
    [['and', 'AND'], ['or', 'OR'], ['xor', 'XOR'], ['not', 'NOT']]
      .forEach(o => item('Operation: ' + o[1], () => { this.setProp('gate_op', o[0]); this._build(); }, op === o[0]));
    document.body.appendChild(m);
    this._m = m;
    const close = (e) => { if (this._m && !this._m.contains(e.target)) this._closeMenu(); };
    setTimeout(() => document.addEventListener('pointerdown', close, { once: true }), 0);
  }
  _closeMenu() { if (this._m) { this._m.remove(); this._m = null; } }

  _compute() {
    const op = this.prop('gate_op') || 'and';
    const ins = this._ins().map(n => this._inv(n) ? !this._v[n] : !!this._v[n]);
    let r = op === 'or'  ? ins.some(Boolean)
          : op === 'xor' ? (ins.filter(Boolean).length % 2 === 1)
          : op === 'not' ? !ins[0]
          :                ins.every(Boolean);
    if (this._inv('out')) r = !r;
    this.emit('out', r ? 1 : 0);
  }

  onAttr(name, val) { this._v[name] = this.truthy(val); this._compute(); }
}]]></hearth-source>
