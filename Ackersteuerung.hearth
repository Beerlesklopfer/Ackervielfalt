      <path d="M 33.22 430.18 C 33.255 430.787 33.61 432.645 33.43 433.82 C 33.25 434.995 32.63 436.432 32.14 437.23 C 31.65 438.028 30.955 437.808 30.49 438.61 C 30.025 439.412 30.155 441.302 29.35 442.04 C 28.545 442.778 26.9083 442.938 25.66 443.04 C 24.4117 443.142 22.9983 443.373 21.86 442.65 C 20.7217 441.927 19.85 439.898 18.83 438.7 C 17.81 437.502 16.3317 436.563 15.74 435.46 C 15.1483 434.357 15.23 433.198 15.28 432.08 C 15.33 430.962 15.3817 429.593 16.04 428.75 C 16.6983 427.907 18.4983 427.622 19.23 427.02 C 19.9617 426.418 19.5883 425.652 20.43 425.14 C 21.2717 424.628 22.9767 424.028 24.28 423.95 C 25.5833 423.872 27.1583 424.162 28.25 424.67 C 29.3417 425.178 30.4 426.612 30.83 427 Z" data-role="laub" fill="none" id="f7cb1692-5b75-44f8-b93b-91fed922daf9" stroke="#8fbc45" stroke-width="0.9"/>
     </g>
     <script type="text/javascript">// Baumreihe — ein Band ueber die Breite EINER SPALTE.
//
// DER NAME STEHT IM BAND. Bis zum 31.08.2026 stand hier das Gegenteil: „DIE
// REIHE TRAEGT KEINEN NAMEN. Den fuehrt die Legende." Der Plan sagt es anders —
// jedes Band traegt seine Sorte laengs eingeschrieben, und der Bediener liest
// sie dort, nicht in einer Legende am Rand.
//
// ALLES, WAS DEN NAMEN AUSMACHT, IST EIGENSCHAFT: Text, Farbe, Schrift, Groesse.
// Fest eingetragen waere jedes davon ein zweiter Ort fuer dieselbe Aussage —
// und der laesst sich in Studio nicht mehr aendern.
//
// `color` faerbt die KONTUR, nicht eine Fuellung: die Kronen sind Umrisse
// (fill="none"), so wie auf dem Plan. Ein applyAttr auf `fill` liefe hier ins
// Leere und saehe aus, als tue die Eigenschaft nichts.
//
// `roleAll` trifft BEIDE Kronen und beide Laubformen — deshalb steht je Rolle
// nur eine Zeile, nicht eine je Element.
//
// KEIN ANSCHLUSS. Die Reihe zeigt nichts an, was die Anlage misst oder
// schaltet. Ein Port ohne Aufrufer waere eine Zusage, die niemand einloest.
class extends HearthSymbol {
  onInit() {
    this.applyAttr('krone', 'stroke', 'color');
    this.applyAttr('laub',  'stroke', 'color');
    this.applyAttr('art', 'fill', 'textcolor');
    this.applyAttr('art', 'font-family', 'font');
    this.applyAttr('art', 'font-size', 'fontsize');
    this.setText('art', this.prop('art'));
  }
}</script>
    </svg>
   </symbol>
