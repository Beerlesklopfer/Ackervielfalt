     <g hearth:layer="edit" hearth:layer-name="Bedienung" id="6fd91dca-096b-48f7-893d-b224f9ecf092">
      <rect data-role="flaeche_2" fill="#000000" fill-opacity="0" height="480" id="91aed069-edba-4308-a3ec-9cad4b343907" stroke="#26a269" stroke-width="1" width="199" x="0" y="1810"/>
      <rect data-role="flaeche_2" fill="#000000" fill-opacity="0" height="480" id="a285d922-41a4-467c-83d1-8c042d3c2e08" stroke="#26a269" stroke-width="1" width="199" x="0" y="1230"/>
      <rect data-role="flaeche_1" fill="#000000" fill-opacity="0" height="480" id="81eef00d-0388-4cdf-84fc-25af6aab6f1e" stroke="#26a269" stroke-width="1" width="199" x="0" y="580"/>
      <rect data-role="flaeche_1" fill="#000000" fill-opacity="0" height="480" id="bef5c64d-7297-4165-8024-fae74bd6ba27" stroke="#26a269" stroke-width="1" width="199" x="0" y="0"/>
     </g>
     <script type="text/javascript">// Beetgruppe-4x5 — VIER Bloecke uebereinander, je 5 Beete + Bluehstreifen.
//
// DIESELBE STEUERUNG WIE DIE BEETGRUPPE. Sie hatte bis zum 02.09.2026 GAR KEINE
// Steuerklasse — obwohl sie dieselben Anschluesse fuehrt. Ergebnis: die
// Anschluesse waren da, der Bediener konnte druecken, und nichts geschah; die
// Wasserlage stand sichtbar, gleich was das Ventil meldete. Ein Symbol, das
// aussieht wie sein Geschwister und sich nicht so verhaelt, ist schlimmer als
// eines, dem man den Unterschied ansieht.
//
// ZWEI VENTILE, ZWEI HAELFTEN (seit 10.09.2026, Anwender: „das lange Symbol
// mit vier Pins"). Die obere Haelfte (Bloecke D und C, y 0…1060) haengt an
// `valve_1`/`taster_1`, die untere (B und A, y 1230…2290) an
// `valve_2`/`taster_2`. Der Bediener drueckt auf die Haelfte, die er meint
// (`flaeche_1`/`flaeche_2`), das jeweilige Ventil meldet seinen Zustand
// zurueck, und nur dessen Wasserlage (`wasser_1`/`wasser_2`) erscheint.
// Vorher: EIN Ventil fuer die ganze Gruppe, vier Bloecke an einem Hahn.
//
// DIE ROLLEN STEHEN AUSGESCHRIEBEN, nicht als 'wasser_' + h in einer Schleife:
// der Pruefer des Editors liest die Rollennamen als Literale aus dem Skript
// und meldet sonst „Kein Element traegt: wasser_" — und wer das Symbol liest,
// sieht so auf einen Blick, welche Rolle an welchem Anschluss haengt.
//
// DIE BEWAESSERUNG IST EINE EIGENE, HALBDURCHSICHTIGE LAGE ueber den Beeten,
// kein Farbtausch — nur so schimmert das gruene Beet noch durch.
//
// ── DIE DECKUNG IST EINE EIGENSCHAFT ────────────────────────────────────────
//
// Sie stand als achte und neunte Stelle im Fuellwert (`#2f7fbf80`). Das war
// nicht einstellbar und nicht ueberall lesbar: Qt-SVG kennt `#RRGGBBAA` nicht
// und malt die Flaeche SCHWARZ — der Browser zeigte Blau, die Kachel der
// Bibliothek einen schwarzen Klotz.
//
// Jetzt sechsstellig, und die Deckung steht als Eigenschaft `alpha` in PROZENT.
// `applyPercent` rechnet 0…100 auf 0…1 um, einmal in der gemeinsamen Laufzeit.
//
// ── DIE FARBEN HABEN EINE QUELLE: DAS ELEMENT ───────────────────────────────
//
// Die drei Wege und die vier Rahmen tragen ihre Fuellung als CSS-Variable am
// Element selbst. Die Klasse faerbt sie NICHT nach — zwei Quellen fuer dieselbe
// Farbe, und welche gewinnt, sieht man dem Symbol nicht an; der Pruefer weist
// das zu Recht ab (`color-single-source`). Sie blendet die Rahmen nur ein und
// aus.
//
// GEMESSEN am 03.09.2026 an der Ackersteuerung: die Platzierungen tragen
// `#deddda`, im Bild stand `#7f9c6b` — die Vorgabe aus dem `&lt;style>`, am Pixel
// nachgemessen (127, 156, 107). Die Variable loeste immer auf, nur nie auf den
// Wert der Platzierung: geschrieben hat sie niemand. Den Instanzwert traegt
// jetzt die Laufzeit ein, VOR dem Anlauf der Klasse.
//
// ── DIE RAHMEN ERSCHEINEN NUR BEI ANWAHL ────────────────────────────────────
//
// `led_1`/`led_2` (herein) sagen, ob die jeweilige HAELFTE angewaehlt ist;
// `taster_1`/`taster_2` (hinaus) sind die Kontakte darunter. Die Anzeige reicht
// damit genau so weit wie das Ventil und die Trefferflaeche daneben.
//
// Zwischendurch stand der Rahmen FEST und wechselte bei Anwahl die Farbe. Zu
// viel Bild fuer eine Aussage, die meistens „nein" heisst; Festlegung des
// Anwenders am 11.09.2026: „Nur wenn gewaehlt, dann das outline."
//
// Jeder Rahmen ist ein GEFUELLTER RING aus EINEM Pfad mit zwei Zuegen: der
// aeussere im Uhrzeigersinn, der innere GEGEN ihn. Die Vorgabe `nonzero` laesst
// die Mitte dann offen, ohne `fill-rule`; beide Zeichner verstehen es gleich.
//
// ── DIE ZAHL OBEN RECHTS: DIE REIHENFOLGE ───────────────────────────────────
//
// `order_1`/`order_2` (herein) sagen, als wievieltes die jeweilige Haelfte
// geschaltet wird. Sie stehen oben rechts im ersten Block ihrer Haelfte,
// rechtsbuendig, damit mehrstellige Werte nach links wachsen.
//
// FORMAT NACH DEM WERT: eine ganze Zahl ist die Reihenfolge und wird gezeigt,
// wie sie kommt; alles andere ist eine ZEIT und wird `hh:mm:ss`. Das ist die
// Vorbereitung auf die Zeit-Betriebsarten — derselbe Anschluss, dieselbe Stelle
// im Bild, und die Anlage entscheidet, was sie dort hinschreibt.
//
// `_orderText`/`_clock`/`_hms` stehen gleichlautend auch in Beetgruppe und
// Randbeet. Ihr Platz ist `HearthSymbol.js`, sobald die Zeit-Betriebsarten
// festliegen — bis dahin eine bekannte Schuld.
//
// ── DER DRUCK WIRD AN EINER STELLE GELESEN ──────────────────────────────────
//
// Der Rahmen erscheint schon beim Druck, ohne auf die Antwort der Anlage zu
// warten. Ein zweiter `pointerdown`-Horcher auf der Trefferflaeche laese
// denselben Druck ein zweites Mal, und die beiden Lesungen laufen auseinander,
// sobald die Trefferflaechen anders geschnitten werden — genau das ist hier
// passiert, als aus einer Trefferflaeche eine je Haelfte wurde.
//
// Deshalb kommt der Druck aus dem Signal, das das Symbol OHNEHIN meldet:
// `emit()` ist das eine Tor, durch das jeder Ausgangs-Konnektor geht, und
// `wireMomentary()` ruft es beim Druecken und beim Loslassen.
class extends HearthSymbol {
  onInit() {
    this.applyPercent('wasser_1', 'fill-opacity', 'alpha');
    this.applyPercent('wasser_2', 'fill-opacity', 'alpha');
    this.setVisible('wasser_1', 0);              // trocken, bis das Ventil etwas sagt
    this.setVisible('wasser_2', 0);
    this.lit1 = false; this.pressed1 = false;    // upper half: plant, and finger
    this.lit2 = false; this.pressed2 = false;    // lower half
    this.showLamps();                            // no frame until one speaks
    this.setText('order_1', '');                 // und keine Zahl, bis eine kommt
    this.setText('order_2', '');
    this.wireMomentary('flaeche_1', 'taster_1'); // Trefferflaeche der oberen Haelfte
    this.wireMomentary('flaeche_2', 'taster_2'); // … der unteren
  }
  onAttr(name, val) {
    if (name === 'valve_1') this.setVisible('wasser_1', val);
    if (name === 'valve_2') this.setVisible('wasser_2', val);
    if (name === 'led_1') { this.lit1 = this.truthy(val); this.showLamps(); }
    if (name === 'led_2') { this.lit2 = this.truthy(val); this.showLamps(); }
    if (name === 'order_1') this.setText('order_1', this._orderText(val));
    if (name === 'order_2') this.setText('order_2', this._orderText(val));
    // Die Deckung darf sich auch NACH dem Anlauf aendern — sonst wirkte eine
    // Aenderung im Inspektor erst beim naechsten Laden.
    if (name === 'alpha') {
      this.applyPercent('wasser_1', 'fill-opacity', 'alpha');
      this.applyPercent('wasser_2', 'fill-opacity', 'alpha');
    }
  }
  /// The contact this symbol reports IS the press it echoes — one signal, one
  /// place. Everything else passing through emit() is handed straight on.
  emit(name, value) {
    super.emit(name, value);
    if (name === 'taster_1') { this.pressed1 = this.truthy(value); this.showLamps(); }
    if (name === 'taster_2') { this.pressed2 = this.truthy(value); this.showLamps(); }
  }
  /// Selected by the plant, or held under the finger — per half.
  showLamps() {
    this.setVisible('led_1', this.lit1 || this.pressed1);
    this.setVisible('led_2', this.lit2 || this.pressed2);
  }

  // ── Reihenfolge oder Zeit ─────────────────────────────────────────────────

  /// A whole number stays a number; everything else becomes hh:mm:ss.
  _orderText(v) {
    const s = String(v === null || v === undefined ? '' : v).trim();
    if (s === '') return '';
    if (/^[+-]?\d+$/.test(s)) return s;
    return this._clock(s);
  }
  /// Any time-ish notation → hh:mm:ss. Unknown text comes back unchanged.
  _clock(s) {
    const teile = s.split(':');
    if (teile.length >= 2 &amp;&amp; teile.every((t) => /^\d+$/.test(t.trim()))) {
      const z = teile.map((t) => Number(t));
      while (z.length &lt; 3) z.unshift(0);
      return this._hms(z[0] * 3600 + z[1] * 60 + z[2]);
    }
    // IEC-Literal: T#1h2m30s, TIME#500ms. `ms` steht vor `m`, sonst bliebe das
    // `s` stehen und die Millisekunden waeren Minuten.
    const iec = s.match(/^(?:TIME|T)#(.+)$/i);
    if (iec) {
      const faktor = { d: 86400, h: 3600, m: 60, s: 1, ms: 0.001 };
      let sek = 0, getroffen = false;
      for (const m of iec[1].matchAll(/(\d+(?:\.\d+)?)\s*(ms|d|h|m|s)/gi)) {
        sek += Number(m[1]) * faktor[m[2].toLowerCase()];
        getroffen = true;
      }
      if (getroffen) return this._hms(sek);
    }
    const n = Number(s);
    return isFinite(n) ? this._hms(n) : s;
  }
  /// Seconds → hh:mm:ss, two digits each.
  _hms(sekunden) {
    const g = Math.max(0, Math.round(Number(sekunden) || 0));
    const p = (x) => String(x).padStart(2, '0');
    return p(Math.floor(g / 3600)) + ':' + p(Math.floor(g / 60) % 60) + ':' + p(g % 60);
  }
}</script>
