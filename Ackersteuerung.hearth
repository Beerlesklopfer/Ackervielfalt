source = "gvl"
iec_type = "TIME"
iec_address = "%MD7#1"
offset = 27
size = 8
description = "Live-Restzeit je Ventil (1..24) = tDuration - TON.ET aus FB_MANUAL_SEQUENCE, von PLC_PRG (Mode 2) geschrieben. NICHT-retained (jeden Zyklus neu berechnet). HMI-Countdown der One-Shot-Bewaesserung; tDuration bleibt der Preset."

