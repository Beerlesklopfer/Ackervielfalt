  <types>
    <dataTypes>
      <dataType name="ST_BedCfg">
        <baseType>
          <struct>
            <variable name="xSelected">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="FALSE"/>
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Wird dieses Beet bei der bewässerung berücksichtigt?</xhtml>
              </documentation>
            </variable>
            <variable name="uStartHour">
              <type>
                <BYTE/>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Startzeit Stunde (Ortszeit)</xhtml>
              </documentation>
            </variable>
            <variable name="uStartMin">
              <type>
                <BYTE/>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Startzeit Minute</xhtml>
              </documentation>
            </variable>
            <variable name="tDuration">
              <type>
                <TIME/>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bewaesserungsdauer dieses Ventils</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">Konfiguration eines Beets (eines Ventils) fuer One-Shot und wiederkehrend: Anwahl, Startzeit in Ortszeit und Bewaesserungsdauer. Element der Job-Liste Bellows.Zeitplan.aValveJobs[1..24].</xhtml>
        </documentation>
      </dataType>
    </dataTypes>
    <pous/>
  </types>
