     <script type="text/javascript">// Strauchreihe — ein Band ueber die Breite EINER SPALTE.
//
// Bau und Verhalten sind von der Baumreihe uebernommen; nur die Form ist eine
// andere. Statt der Kronen stehen stilisierte Straeucher: ein Umriss und ein
// Astwerk, das AUS DER MITTE NACH ALLEN SEITEN strahlt. Der Plan ist eine
// Draufsicht — Triebe, die aus einem Fusspunkt nach oben steigen, waeren eine
// Seitenansicht und mischten zwei Blickrichtungen in einem Bild.
//
// B=30 gegen B=50 der Baumreihe. Ein Strauch braucht weniger Platz als ein
// Obstbaum, und der Unterschied traegt dieselbe Aussage noch einmal.
//
// ── EINE FARBE, ZWEI ROLLEN ─────────────────────────────────────────────────
//
// `color` setzt den HINTERGRUND — das Band. Der Strauch darauf ist dieselbe
// Farbe, nur heller: Farbton und Saettigung bleiben, die HELLIGKEIT steigt auf
// einen festen Zielwert.
//
// Der Umweg ueber HSL ist noetig, weil die naheliegende Rechnung nicht traegt:
// „zu Weiss mischen" hellt zwar auf, zieht dabei aber die Saettigung mit heraus
// — aus dem dunklen Rot #301019 wuerde ein Grau, kein helles Rot. Gemessen:
// zu 62 % zu Weiss ergibt #b0a4a8, ueber HSL dagegen #d4657c, und nur das
// zweite sieht aus wie derselbe Strauch bei mehr Licht.
//
// Zwei Eintraege waeren die Alternative gewesen — Band und Strauch getrennt.
// Dann muesste der Anwender bei jeder Aenderung an zwei Stellen denken, und
// die zweite wird vergessen: das Band waere gruen und der Strauch noch rot.
//
// DER NAME STEHT IM BAND, laengs und ZENTRIERT — nicht in einer Legende.
// Text, Farbe, Schrift, Groesse sind Eigenschaften; fest eingetragen waere
// jedes davon ein zweiter Ort fuer dieselbe Aussage.
//
// KEIN ANSCHLUSS. Die Reihe zeigt nichts an, was die Anlage misst oder
// schaltet. Ein Port ohne Aufrufer waere eine Zusage, die niemand einloest.
class extends HearthSymbol {
  static ZIEL_HELLIGKEIT = 0.62;   ///&lt; Helligkeit der Kontur, 0..1

  onInit() {
    this.applyAttr('reihe', 'fill', 'color');

    const kontur = this._aufhellen(this.prop('color') || '#301019',
                                   this.constructor.ZIEL_HELLIGKEIT);
    for (const rolle of ['busch', 'laub', 'zweig'])
      for (const el of this.roleAll(rolle)) el.setAttribute('stroke', kontur);

    this.applyAttr('art', 'fill', 'textcolor');
    this.applyAttr('art', 'font-family', 'font');
    this.applyAttr('art', 'font-size', 'fontsize');
    this.setText('art', this.prop('art'));
  }

  /// Dieselbe Farbe bei mehr Licht: Farbton und Saettigung bleiben, die
  /// Helligkeit wird auf `zielL` (0..1) gesetzt. Unlesbares gibt es zurueck
  /// wie es kam — eine halb geratene Farbe waere schlimmer als die alte.
  _aufhellen(hex, zielL) {
    let h = String(hex || '').trim().replace('#', '');
    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
    if (!/^[0-9a-fA-F]{6}$/.test(h)) return hex;

    const r = parseInt(h.slice(0, 2), 16) / 255,
          g = parseInt(h.slice(2, 4), 16) / 255,
          b = parseInt(h.slice(4, 6), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;

    let ton = 0;
    if (d !== 0) {
      if (max === r)      ton = ((g - b) / d) % 6;
      else if (max === g) ton = (b - r) / d + 2;
      else                ton = (r - g) / d + 4;
      ton *= 60; if (ton &lt; 0) ton += 360;
    }
    const alt = (max + min) / 2;
    const saettigung = d === 0 ? 0 : d / (1 - Math.abs(2 * alt - 1));

    // HSL zurueck nach RGB
    const c = (1 - Math.abs(2 * zielL - 1)) * saettigung;
    const x = c * (1 - Math.abs(((ton / 60) % 2) - 1));
    const m = zielL - c / 2;
    const s = ton &lt; 60  ? [c, x, 0] : ton &lt; 120 ? [x, c, 0] :
              ton &lt; 180 ? [0, c, x] : ton &lt; 240 ? [0, x, c] :
              ton &lt; 300 ? [x, 0, c] : [c, 0, x];
    const zwei = v => Math.round((v + m) * 255).toString(16).padStart(2, '0');
    return '#' + zwei(s[0]) + zwei(s[1]) + zwei(s[2]);
  }
}</script>
    </svg>
