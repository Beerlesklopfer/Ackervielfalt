      <path d="M 140 9 C 140 13.9706 144.029 18 149 18 C 153.971 18 158 13.9706 158 9 C 158 4.02944 153.971 3.04359e-16 149 0 C 144.029 -3.04359e-16 140 4.02944 140 9 M 140 44.5 C 140 49.4706 144.029 53.5 149 53.5 C 153.971 53.5 158 49.4706 158 44.5 C 158 39.5294 153.971 35.5 149 35.5 C 144.029 35.5 140 39.5294 140 44.5 M 140 80.1 C 140 85.0706 144.029 89.1 149 89.1 C 153.971 89.1 158 85.0706 158 80.1 C 158 75.1294 153.971 71.1 149 71.1 C 144.029 71.1 140 75.1294 140 80.1 M 140 115.6 C 140 120.571 144.029 124.6 149 124.6 C 153.971 124.6 158 120.571 158 115.6 C 158 110.629 153.971 106.6 149 106.6 C 144.029 106.6 140 110.629 140 115.6 M 140 151.2 C 140 156.171 144.029 160.2 149 160.2 C 153.971 160.2 158 156.171 158 151.2 C 158 146.229 153.971 142.2 149 142.2 C 144.029 142.2 140 146.229 140 151.2 M 140 186.7 C 140 191.671 144.029 195.7 149 195.7 C 153.971 195.7 158 191.671 158 186.7 C 158 181.729 153.971 177.7 149 177.7 C 144.029 177.7 140 181.729 140 186.7 M 140 222.2 C 140 227.171 144.029 231.2 149 231.2 C 153.971 231.2 158 227.171 158 222.2 C 158 217.229 153.971 213.2 149 213.2 C 144.029 213.2 140 217.229 140 222.2 M 140 257.8 C 140 262.771 144.029 266.8 149 266.8 C 153.971 266.8 158 262.771 158 257.8 C 158 252.829 153.971 248.8 149 248.8 C 144.029 248.8 140 252.829 140 257.8 M 140 293.3 C 140 298.271 144.029 302.3 149 302.3 C 153.971 302.3 158 298.271 158 293.3 C 158 288.329 153.971 284.3 149 284.3 C 144.029 284.3 140 288.329 140 293.3 M 140 328.8 C 140 333.771 144.029 337.8 149 337.8 C 153.971 337.8 158 333.771 158 328.8 C 158 323.829 153.971 319.8 149 319.8 C 144.029 319.8 140 323.829 140 328.8 M 140 364.4 C 140 369.371 144.029 373.4 149 373.4 C 153.971 373.4 158 369.371 158 364.4 C 158 359.429 153.971 355.4 149 355.4 C 144.029 355.4 140 359.429 140 364.4 M 140 399.9 C 140 404.871 144.029 408.9 149 408.9 C 153.971 408.9 158 404.871 158 399.9 C 158 394.929 153.971 390.9 149 390.9 C 144.029 390.9 140 394.929 140 399.9 M 140 435.5 C 140 440.471 144.029 444.5 149 444