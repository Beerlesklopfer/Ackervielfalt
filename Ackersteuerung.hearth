   <asset name="HearthSymbol.js" type="js" version="1c98e275"><![CDATA[// HearthSymbol — the JS interface + GLOBAL behaviour library every symbol uses.
//
// Two layers (keep them apart):
//   • HearthSymbol.js  = GLOBAL methods — the reusable behaviour primitives
//     shared by ALL symbols (colour swap, text readout, analog mapping, a
//     momentary contact …). The behaviour lives HERE, once, in JS.
//   • the per-symbol "Symbol JS" (generated control class) = the SYMBOL DYNAMICS
//     — a thin subclass that only declares which connectors this symbol has and
//     wires each to a global method. It contains NO behaviour logic itself:
//
//         class extends HearthSymbol {
//           static observed = ['open', 'ontime'];        // in-connectors
//           onInit() { this.wireMomentary('button', 'contact', 'contact_type'); }
//           onAttr(name, v) {
//             if (name === 'open')   this.setColor('valve', v, 'color_on', 'color_off');
//             if (name === 'ontime') this.setText('ontime', v, { hideZero: 'ontime_hide_zero' });
//           }
//         }
//
// Model: a screen (and the editor test) is ONE big SVG in the HTML body; each
// placed symbol is a `<g>`. A control class is a plain JS object bound to that
// group's root; it manipulates the group's elements BY `data-role`. This file is
// the SYMBOL-SIDE adapter of the runtime interface (docs/runtime-interface.md) —
// plain JS, the single canonical definition shared 1:1 by every host via
// `forge-symbol-runtime`.
//
// The host drives a symbol only through the protocol:
//   in-connector  → inst.setInput(name, value) → set(name, v) → onAttr(name, v)
//   out-connector → emit(name, v)              → CustomEvent on the root (bubbles)
//   parameter     → data-<key> / var(--key)    → prop(key)
//   lifecycle     → onInit() once after mount
//
// VALUES ARRIVE AS STRINGS. Parameters too. The global methods coerce per the
// data type (bool: '1'/'true' → true; number: Number(v); string: as-is), so the
// per-symbol dynamics never coerce by hand.

// ── TEXT IS NEVER MIRRORED ───────────────────────────────────────────────────
//
// A mirrored placement (negative scale on the group transform — editor form
// `scale(-1,1)`, panel form `matrix(-0.4 0 0 0.4 …)`) mirrors everything in it,
// letters included. Nobody reads a label back to front — measured 10.09.2026
// on the Stachelbeere I/O nodes, flipped to face their symbol: „Ƨ_Vx".
//
// ONE rule, here: every <text> inside a mirrored group gets a counter-mirror
// around its own anchor (x,y), composed with whatever transform the text
// carried before (a rotated label keeps its rotation). Idempotent — the
// original transform is remembered in `data-own-transform` on first touch.
// Called on mount/attach (runtime), after a transform change (editor) and
// for every text a control class creates (make()).
export function linearPartOf(root) {
  // The linear 2x2 part of the group transform — from `matrix(a b c d e f)`
  // or from the editor form `translate(..) scale(sx,sy) rotate(r ..)`.
  const t = (root && typeof root.getAttribute === 'function' && root.getAttribute('transform')) || '';
  const m = /matrix\(\s*([-+\d.eE]+)[\s,]+([-+\d.eE]+)[\s,]+([-+\d.eE]+)[\s,]+([-+\d.eE]+)/.exec(t);
  if (m) return { a: +m[1], b: +m[2], c: +m[3], d: +m[4] };
  let a = 1, b = 0, c = 0, d = 1;
  const sc = /scale\(\s*([-+\d.eE]+)(?:[\s,]+([-+\d.eE]+))?/.exec(t);
  if (sc) { const sx = +sc[1], sy = sc[2] != null ? +sc[2] : sx; a = sx; d = sy; }
  const ro = /rotate\(\s*([-+\d.eE]+)/.exec(t);
  if (ro) {
    const r = (+ro[1]) * Math.PI / 180, cs = Math.cos(r), sn = Math.sin(r);
    // scale then rotate (editor order): M = R * S
    const na = cs * a - sn * c, nb = sn * a + cs * c, nc = cs * b - sn * d, nd = sn * b + cs * d;
    // (with c=b=0: [cs*a, sn*a, -sn*d, cs*d])
    a = na; b = nb; c = nc; d = nd;
  }
  return { a, b, c, d };
}
export function mirrorOf(root) {
  const { a, d } = linearPartOf(root);
  return { fx: a < 0 ? -1 : 1, fy: d < 0 ? -1 : 1 };
}
// ── FREE TEXT IS THE DRAWING ─────────────────────────────────────────────────
//
// A placement whose whole body is text (the canvas text tool: one <text>,
// nothing else) is not a label ON something — it IS the thing. Turning it is
// the designer's intent: a name written along a bed, a caption set on its
// side. Measured 10.09.2026: with the rule below applied to it, the rotation
// knob turned the group and the letters turned straight back — free text
// could not be rotated at all. The rule stays ONE rule: letters are never
// mirrored. Free text keeps its rotation and loses only the mirror; a label
// inside a symbol loses both.
//
// The editor adds its own gear INTO the group — a transparent hit rect
// (`canvas-hit`, inserted as the FIRST child), handles, connector pins.
// None of it is drawing; it is skipped here. Measured 10.09.2026: with the
// hit rect counted, a free text on the canvas was never "all text", and the
// first fix did nothing on the screen while its test was green.
export function isFreeText(root) {
  const kids = (root && root.children) ? Array.from(root.children) : [];
  const drawing = kids.filter((k) => {
    const cls = String((typeof k.getAttribute === 'function' && k.getAttribute('class')) || '');
    return !/(^|\s)(canvas-[\w-]+|hearth-connector)(\s|$)/.test(cls);
  });
  if (!drawing.length) return false;
  return drawing.every((k) => String(k.tagName || k.nodeName || '').toLowerCase() === 'text');
}
export function keepTextReadable(root, onlyEl) {
  if (!root) return;
  // TEXT STAYS UPRIGHT: mirror AND rotation of the placement are undone for
  // the letters, the size is kept. Take the linear part, strip its scale
  // magnitude, invert what is left (a rotation, a mirror, or both).
  const { a, b, c, d } = linearPartOf(root);
  const det = a * d - b * c;
  const s = Math.sqrt(Math.abs(det)) || 1;
  const na = a / s, nb = b / s, nc = c / s, nd = d / s;      // det = ±1
  const ndet = na * nd - nb * nc;
  const upright = Math.abs(na - 1) < 1e-6 && Math.abs(nb) < 1e-6 && Math.abs(nc) < 1e-6 && Math.abs(nd - 1) < 1e-6;
  // inverse of N: (1/ndet) * [nd, -nb, -nc, na]
  let ia = nd / ndet, ib = -nb / ndet, ic = -nc / ndet, id = na / ndet;
  let touch = !upright;
  if (isFreeText(root)) {
    // Only the mirror is undone (det < 0): a reflection across the text's
    // own vertical axis. The rotation is the designer's and stays.
    touch = ndet < 0;
    ia = -1; ib = 0; ic = 0; id = 1;
  }
  const fmt = (v) => (Math.abs(v) < 1e-9 ? '0' : String(Math.round(v * 1e6) / 1e6));
  const texts = onlyEl ? [onlyEl]
    : (typeof root.querySelectorAll === 'function' ? Array.from(root.querySelectorAll('text')) : []);
  for (const el of texts) {
    if (!el.hasAttribute('data-own-transform'))
      el.setAttribute('data-own-transform', el.getAttribute('transform') || '');
    const own = el.getAttribute('data-own-transform');
    if (touch) {
      const x = parseFloat(el.getAttribute('x') || '0') || 0;
      const y = parseFloat(el.getAttribute('y') || '0') || 0;
      const fix = `translate(${x},${y}) matrix(${fmt(ia)} ${fmt(ib)} ${fmt(ic)} ${fmt(id)} 0 0) translate(${-x},${-y})`;
      el.setAttribute('transform', own ? `${fix} ${own}` : fix);
    } else if (own) {
      el.setAttribute('transform', own);
    } else {
      el.removeAttribute('transform');
    }
  }
}

export class HearthSymbol {

  // ── Protocol (the host↔symbol seam) ──────────────────────────────────────

  /// The runtime assigns `this.root` (the symbol's SVG group) before onInit().

  /// The element tagged data-role="r" WITHIN this symbol's group (instance-safe:
  /// querySelector is scoped to this.root, so identical roles in sibling
  /// instances never collide).
  role(r) {
    return this.root ? this.root.querySelector(`[data-role="${r}"]`) : null;
  }

  /// ALLE Elemente mit dieser Rolle — eine Rolle benennt ein TEIL, und ein
  /// Teil darf aus mehreren Formen bestehen.
  ///
  /// Ein Beet einer Beetgruppe ist zwanzigmal dasselbe Teil; sie einzeln
  /// durchzunummerieren hiesse, zwanzig Namen fuer eine einzige Funktion zu
  /// pflegen. role() liefert weiterhin das erste — richtig fuer Text und
  /// Trefferflaechen, von denen es je genau eine gibt.
  roleAll(r) {
    return this.root ? Array.from(this.root.querySelectorAll(`[data-role="${r}"]`)) : [];
  }

  // ── SVG-building framework (used by dynamic symbols that reshape themselves
  //    from props at runtime — e.g. a logic gate that grows with each pin, or
  //    any symbol that adds/removes geometry). Generic, reusable by all symbols.

  /// Create an SVG <tag> with `attrs` (use key "text" for textContent) and
  /// append it to `parent` (default this.root). Returns the new element.
  make(tag, attrs, parent) {
    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
    if (attrs) for (const k in attrs) {
      if (k === 'text') el.textContent = attrs[k];
      else el.setAttribute(k, attrs[k]);
    }
    (parent || this.root).appendChild(el);
    // A rebuilt label (a variable node redraws on every prop change) must obey
    // the mirror rule at once — the same rule the runtime applies on mount.
    if (tag === 'text' && this.root) keepTextReadable(this.root, el);
    return el;
  }

  /// Empty a role element so it can be rebuilt; returns the (now empty) element.
  clearRole(r) {
    const g = this.role(r);
    if (g) while (g.firstChild) g.removeChild(g.firstChild);
    return g;
  }

  /// Announce that the symbol rebuilt its geometry (e.g. added/removed
  /// .hearth-connector pins). The host re-scans connectors, redraws their
  /// handles and re-routes wires — this is what makes DYNAMIC connectors work.
  refresh() {
    if (this.root)
      this.root.dispatchEvent(new CustomEvent('hearth-geometry', { bubbles: true }));
  }

  /// A parameter value: the data-<key> attribute on the root wins, else the CSS
  /// var(--key). Always a string (or '' if unset). This is how per-instance
  /// configuration ("symbol properties" set by the host/Studio) reaches the
  /// dynamics — e.g. this.prop('color_on'), this.prop('ontime_hide_zero').
  prop(key) {
    const a = this.root && this.root.getAttribute('data-' + key);
    if (a !== null && a !== undefined) return a;
    const v = this.root ? getComputedStyle(this.root).getPropertyValue('--' + key) : '';
    return v ? v.trim() : '';
  }

  /// Report an out-connector to the host. Dispatches a CustomEvent(name) on the
  /// root; it bubbles up the SVG to the body where the host listens.
  emit(name, value) {
    this.root.dispatchEvent(new CustomEvent(name, { detail: value, bubbles: true }));
  }

  /// host → symbol: deliver an in-connector value (the runtime calls this).
  set(name, value) {
    // ZUERST die Sichtbarkeitsregeln, dann die Steuerklasse. Wer beides
    // umgekehrt macht, sieht im `onAttr` einen Zustand, der noch der alte ist.
    this.applyVisibilityRules(name, value);
    if (typeof this.onAttr === 'function') this.onAttr(name, value);
  }

  /// DIE §2b-SICHTBARKEITSREGELN — Portwert wird Zustandsklasse.
  ///
  /// ── Warum das hier steht und nicht in der Steuerklasse ────────────────────
  ///
  /// Weil es DEKLARIERT ist. Der Symbolautor schreibt „mode = 2 heisst
  /// oneshot", der Exporter macht daraus CSS (`.state-oneshot #<layer>`), und
  /// hier wird nur noch die Klasse gesetzt. Dieselbe Umschaltung von Hand in
  /// jeder Steuerklasse waere eine zweite Wahrheit neben der Regeltabelle — und
  /// die laeuft auseinander, ohne sich zu melden.
  ///
  /// ── Woher die Regeln kommen ───────────────────────────────────────────────
  ///
  /// Aus `data-hearth-rules` an der Symbolwurzel, nicht aus `<metadata>`: das
  /// wird auf dem Weg zur Anlage abgestreift (`sliceInnerSvg`,
  /// `pruneEditorNodes`), ein Attribut nicht.
  ///
  /// OHNE REGELN KOSTET ES NICHTS: einmal nachsehen, dann `null` merken.
  applyVisibilityRules(port, value) {
    if (this._rules === undefined) {
      let raw = null;
      try { raw = this.root ? this.root.getAttribute('data-hearth-rules') : null; }
      catch (e) { raw = null; }
      try { this._rules = raw ? JSON.parse(raw) : null; }
      catch (e) { this._rules = null; }   // kaputt = keine, nicht halb
    }
    if (!this._rules || !this._rules.length || !this.root) return;

    const fuerDiesenPort = this._rules.filter((r) => r && r.port === port);
    if (!fuerDiesenPort.length) return;

    // NACH PRIORITAET, und `else` immer zuletzt: es ist der Rueckfall, kein
    // Treffer. Stuende es vorn, gaebe es nie einen anderen Zustand.
    const geordnet = fuerDiesenPort.slice().sort((a, b) => {
      const ea = a.match === 'else' ? 1 : 0, eb = b.match === 'else' ? 1 : 0;
      if (ea !== eb) return ea - eb;
      return (a.priority || 0) - (b.priority || 0);
    });

    const v = Number(value);
    let zustand = null;
    for (const r of geordnet) {
      if (this.ruleMatches(r, v)) { zustand = r.state; break; }
    }
    // KEIN TREFFER heisst: keine Zustandsklasse. Die letzte stehenzulassen
    // zeigte einen Zustand, den die Anlage nicht mehr meldet.
    this.setState(zustand);
  }

  /// Trifft diese Regel auf den Wert zu?
  ruleMatches(r, v) {
    switch (r.match) {
      case 'else':   return true;
      case 'equals': return Number.isFinite(v) && v === Number(r.value);
      case 'range':  return Number.isFinite(v) && v >= Number(r.lo) && v <= Number(r.hi);
      // BITSET: trifft, wenn IRGENDEIN Bit der Maske gesetzt ist. Eine leere
      // Maske trifft nie — sonst waere sie ein verkapptes `else`.
      case 'bitset': return Number.isFinite(v) && (v & Number(r.value)) !== 0;
      default:       return false;   // unbekannte Art: lieber nichts als falsch
    }
  }

  /// Die Zustandsklasse an der Wurzel setzen — `null` entfernt sie.
  ///
  /// Nur die eigenen `state-*` werden angefasst; was der Wirt sonst an Klassen
  /// gesetzt hat, bleibt. Ein `className = ...` wischte es weg.
  setState(name) {
    if (!this.root || !this.root.classList) return;
    for (const c of Array.from(this.root.classList))
      if (c.indexOf('state-') === 0) this.root.classList.remove(c);
    if (name) this.root.classList.add('state-' + name);
  }

  /// symbol → host: PERSIST a per-instance property the symbol changed itself
  /// (e.g. an operator right-clicking a pin to invert it). Sets data-<key> live
  /// so prop(key) reflects it immediately, AND dispatches 'hearth-prop'
  /// {key,value} so the host stores it on the placement — surviving reload and
  /// deploy. This is the write-back counterpart of prop() (the read side).
  setProp(key, value) {
    if (this.root) this.root.setAttribute('data-' + key, value);
    this.emit('hearth-prop', { key: key, value: value });
  }

  // ── Global behaviour methods (the reusable dynamics primitives) ───────────
  // The generated per-symbol class calls these; it never re-implements them.

  /// Coerce a delivered value (a string, number or boolean) to a real boolean.
  /// '1' | 'true' | 1 | true → true; everything else (incl. '0') → false.
  truthy(v) {
    return v === true || v === 1 || v === '1' || v === 'true';
  }

  /// BOOL → colour swap. Set the role element's fill to the ON colour when the
  /// value is truthy, else the OFF colour. The colours come from PROPERTIES
  /// (pass their keys), so they are configurable per instance.
  /// @param role   data-role of the element to recolour (e.g. 'valve', 'lens')
  /// @param v      the connector value (string)
  /// @param onKey  property key holding the ON colour (e.g. 'color_on')
  /// @param offKey property key holding the OFF colour (e.g. 'color_off')
  setColor(role, v, onKey, offKey) {
    const c = this.truthy(v) ? this.prop(onKey) : this.prop(offKey);
    for (const el of this.roleAll(role)) el.setAttribute('fill', c);
  }

  /// ── DIE SCHRIFTGROESSE SKALIERT MIT ──────────────────────────────────────
  ///
  /// `applyFontSize('art', 'fontsize')` setzt die Groesse, die die Eigenschaft
  /// nennt — in den Koordinaten DES SYMBOLS, unveraendert. Skaliert der
  /// Bediener die Platzierung, skaliert die Schrift mit, wie jede andere Linie
  /// des Symbols auch.
  ///
  /// ── Warum hier NICHT gerechnet wird ───────────────────────────────────────
  ///
  /// Hier stand `n / s.y`: die Angabe sollte SCHIRMPIXEL meinen, also unabhaengig
  /// von der Platzierung immer gleich gross erscheinen. Das dreht die Wirkung
  /// um — je kleiner das Symbol gesetzt wird, desto groesser wird seine
  /// Beschriftung im Verhaeltnis zu ihm.
  ///
  /// Gemessen am 03.09.2026 an der ausgelieferten Ackersteuerung: die
  /// Strauchreihe steht auf Skala 0,40 und ist 50 Einheiten breit. Aus
  /// `font-size 13` wurde `32.5` — ein Glyph, der zwei Drittel der Bandbreite
  /// fuellt. Auf dem Schirm sah es aus, als sei die Schrift verzerrt; sie war
  /// nur masslos.
  ///
  /// Festlegung des Anwenders: die Groesse im Symbol IST die Groesse. Dort
  /// passt sie, dort wurde sie entworfen. Beim Skalieren skaliert sie mit.
  /// Wem eine Beschriftung zu klein wird, der entwirft sie groesser oder setzt
  /// das Symbol groesser — beides ist eine Entscheidung, keine Rechnung.
  ///
  /// UNGESETZT HEISST UNBERUEHRT — wie ueberall: dann gilt, was in der
  /// Zeichnung steht.
  applyFontSize(role, key) {
    const roh = this.prop(key);
    if (roh === '' || roh === null || roh === undefined) return;
    const n = parseFloat(roh);
    if (!isFinite(n) || n <= 0) return;
    for (const el of this.roleAll(role)) el.setAttribute('font-size', String(n));
  }

  /// ── DIE ERKLAERTEN BINDUNGEN ANWENDEN ─────────────────────────────────────
  ///
  /// `<hearth:binding property="fontsize" role="art" attribute="font-size"/>`
  ///
  /// ── Warum es das gibt ─────────────────────────────────────────────────────
  ///
  /// Die Zuordnung „Eigenschaft → Rolle/Attribut" stand bis zum 02.09.2026 NUR
  /// im JavaScript, als `this.applyAttr('art','font-size','fontsize')`. Wer
  /// kein JavaScript ausfuehrt, konnte sie nicht anwenden — und das ist nicht
  /// der Ausnahmefall: die Vorschau in Studio rastert mit Qt-SVG, und der
  /// Schnappschuss ebenso.
  ///
  /// Gemessen an der Strauchreihe: im SVG steht `font-size="13"`, die
  /// Eigenschaft `fontsize` gibt 22 vor. Der Browser zeigte 22, die Vorschau
  /// 13 — dasselbe Symbol in zwei Groessen, und keine Meldung dazwischen.
  /// Dasselbe traf `art`, `color`, `textcolor` und `font`.
  ///
  /// Als DATEN kann beides dieselbe Tabelle lesen. Das Skript behaelt, was
  /// wirklich Rechnung ist — Farben aufhellen, Zustaende schalten.
  ///
  /// ── Die drei Arten ────────────────────────────────────────────────────────
  ///
  ///   attribute="…"                 woertlich kopieren      (wie applyAttr)
  ///   attribute="…" unit="percent"  0…100 → 0…1             (wie applyPercent)
  ///   target="text"                 als Textinhalt setzen   (wie setText)
  ///
  /// VOR `onInit()` angewandt, nicht danach: was die Klasse rechnet, ist die
  /// spaetere Aussage und muss die erklaerte ueberschreiben duerfen.
  ///
  /// UNGESETZT HEISST UNBERUEHRT — durchgehend dieselbe Regel: dann gilt, was
  /// in der Zeichnung steht.
  applyBindings(bindings) {
    if (!Array.isArray(bindings)) return 0;
    let n = 0;
    for (const b of bindings) {
      if (!b || !b.property || !b.role) continue;
      if (b.target === 'text') {
        const v = this.prop(b.property);
        if (v === '' || v === null || v === undefined) continue;
        this.setText(b.role, v);
        ++n;
        continue;
      }
      if (!b.attribute) continue;
      if (b.unit === 'percent')        this.applyPercent(b.role, b.attribute, b.property);
      // `unit="screen-px"`: die Angabe meint SCHIRMPIXEL und wird gegen die
      // Platzierungsskala gerechnet — siehe applyFontSize().
      else if (b.unit === 'screen-px') this.applyFontSize(b.role, b.property);
      else                             this.applyAttr(b.role, b.attribute, b.property);
      ++n;
    }
    return n;
  }

  /// STATIC PROPERTY → element attribute. Apply a per-instance symbol property
  /// (set by the host/Studio as data-<key> / var(--key)) onto a role element's
  /// attribute at init — e.g. this.applyAttr('tag','fill','color'). Skipped when
  /// the property is unset, so the authored default stays. This is how the JS
  /// "sets the properties" rather than relying on var() in presentation attrs.
  applyAttr(role, attr, key) {
    const v = this.prop(key);
    if (!v) return;
    for (const el of this.roleAll(role)) el.setAttribute(attr, v);
  }

  /// ── PROZENT-EIGENSCHAFT → ATTRIBUT ────────────────────────────────────────
  ///
  /// Eine Eigenschaft in PROZENT (0…100) auf ein Attribut legen, das 0…1
  /// erwartet — `fill-opacity`, `stroke-opacity`, `opacity`.
  ///
  /// ── Warum nicht `applyAttr` ───────────────────────────────────────────────
  ///
  /// Das kopiert woertlich. Eine Eigenschaft „50" ergaebe `fill-opacity="50"`;
  /// SVG klemmt das auf 1, und die Flaeche waere voll deckend — also genau das
  /// Gegenteil dessen, was der Entwerfer eingestellt hat, und ohne Meldung.
  ///
  /// ── Warum PROZENT und nicht 0…1 ───────────────────────────────────────────
  ///
  /// Weil ein Mensch es einstellt. „50" ist eine Angabe, die man im Inspektor
  /// eintippt; „0.5" ist eine, bei der man ueberlegt, ob der Punkt richtig
  /// steht. Die Umrechnung ist die Aufgabe des Programms, nicht des Bedieners.
  ///
  /// ── Warum hier und nicht in der Steuerklasse ──────────────────────────────
  ///
  /// Weil die naechste Klasse dieselbe Rechnung braeuchte. Eine Umrechnung, die
  /// in jedem Symbol noch einmal steht, steht irgendwann in zweien verschieden.
  ///
  /// UNGESETZT HEISST UNBERUEHRT — wie bei `applyAttr`: dann gilt, was in der
  /// Zeichnung steht. Ein unlesbarer Wert ebenso; er waere sonst stillschweigend
  /// eine 0, und die Flaeche verschwaende.
  applyPercent(role, attr, key) {
    const roh = this.prop(key);
    if (roh === '' || roh === null || roh === undefined) return;
    const n = parseFloat(roh);
    if (!isFinite(n)) return;
    const anteil = Math.max(0, Math.min(100, n)) / 100;
    for (const el of this.roleAll(role)) el.setAttribute(attr, String(anteil));
  }

  /// BOOL → visibility. Show the role element when truthy, else hide it.
  setVisible(role, v) {
    const d = this.truthy(v) ? '' : 'none';
    for (const el of this.roleAll(role)) el.style.display = d;
  }

  /// DISPLAY VALUE → set the role element's text. Hidden when the value is
  /// null/undefined/empty ("sichtbar != null"). Formatting is the host's job —
  /// it delivers the already-formatted string.
  /// @param opts.hideZero  OPTIONAL property key (a bool property). When that
  ///        property is 'true', a numeric 0 ALSO hides the field. This is a
  ///        SYMBOL PROPERTY — the symbol declares & sets it; the value flows
  ///        through the symbol, it is never hard-coded.
  setText(role, v, opts = {}) {
    const el = this.role(role);
    if (!el) return;
    const hideZero = opts.hideZero && this.prop(opts.hideZero) === 'true';
    const empty = (v === null || v === undefined || v === '' || (hideZero && Number(v) === 0));
    el.style.display = empty ? 'none' : '';
    if (!empty) {
      el.textContent = String(v);
      // ── IN DIE KISTE, ABER NUR WENN ES NOETIG IST ────────────────────────
      //
      // `data-w` ist die gezeichnete Breite des Feldes. Ein langer Name — der
      // Punktname einer Variablen etwa — soll nicht ueber das Symbol
      // hinauslaufen.
      //
      // Hier stand `textLength` OHNE Bedingung. Das zwingt die Zeichenkette auf
      // GENAU diese Breite: nicht nur, wenn sie zu lang ist, sondern auch, wenn
      // sie zu kurz ist. Mit `spacingAndGlyphs` werden dafuer die Glyphen
      // verformt.
      //
      // Gemessen am 03.09.2026 an der ausgelieferten Ackersteuerung: das
      // Beetschild traegt `data-w="480"`, „Maibeere" ist bei Schriftgroesse 22
      // rund 100 Einheiten lang — und stand 4,8-fach in die Breite gezogen da.
      // Es sah aus, als sei die Schrift falsch skaliert; sie war gestreckt.
      //
      // GEMESSEN, NICHT GERATEN: `getComputedTextLength()` sagt, wie lang sie
      // wirklich ist. Passt sie, bleibt sie unberuehrt. Wo es die Messung nicht
      // gibt, wird NICHT gestreckt — ein Name, der ueber den Rand ragt, ist
      // sichtbar; ein verformter sieht aus wie Absicht.
      const w = parseFloat(el.getAttribute('data-w'));
      el.removeAttribute('textLength');
      el.removeAttribute('lengthAdjust');
      if (isFinite(w) && w > 0 && typeof el.getComputedTextLength === 'function') {
        let natuerlich = 0;
        try { natuerlich = el.getComputedTextLength(); } catch (e) { natuerlich = 0; }
        if (natuerlich > w) {
          el.setAttribute('textLength', w);
          el.setAttribute('lengthAdjust', 'spacingAndGlyphs');
        }
      }
    }
  }

  /// ANALOG (real/int) → geometry. Clamp v into an input range, lerp to an
  /// output range, and apply it to the role element. Optionally colour it by
  /// thresholds (green/amber/red).
  /// @param opts.map    'rotate' (needle, degrees) | 'fill-y' (bar, % via scale)
  ///                    | anything else → data-value
  /// @param opts.range  [min, max] of the INPUT. Each entry is a number OR a
  ///                    property KEY (string) read at runtime — so the operator
  ///                    can scale per instance (e.g. ['range_min','range_max']).
  /// @param opts.out    [outMin, outMax] of the OUTPUT (degrees / percent).
  /// @param opts.level  OPTIONAL [warnKey, alarmKey] property keys; the element
  ///                    turns #2ecc40 / #f39c12 / #e74c3c as v crosses them.
  setAnalog(role, v, opts) {
    const el = this.role(role);
    if (!el) return;
    const n = (x) => (typeof x === 'string' ? Number(this.prop(x)) : x);
    const lo = n(opts.range[0]), hi = n(opts.range[1]);
    const t = Math.max(0, Math.min(1, (Number(v) - lo) / (hi - lo)));
    const o = opts.out[0] + t * (opts.out[1] - opts.out[0]);
    if (opts.map === 'rotate')      el.setAttribute('transform', 'rotate(' + o + ')');
    else if (opts.map === 'fill-y') {
      // Fill from the element's BOTTOM up: scale(1,t) alone pivots on the SVG
      // origin (0,0), which slides the bar toward the canvas top instead of
      // draining it at its own base. Anchor the scale on the element's bottom
      // edge so 0% = empty at the bottom, 100% = full.
      const b = el.getBBox(), yb = b.y + b.height;
      el.setAttribute('transform',
        'translate(0 ' + yb + ') scale(1,' + (o / 100) + ') translate(0 ' + (-yb) + ')');
    }
    else                            el.setAttribute('data-value', o);
    if (opts.level) {
      const w = Number(this.prop(opts.level[0])), a = Number(this.prop(opts.level[1]));
      el.setAttribute('fill', Number(v) >= a ? '#e74c3c' : Number(v) >= w ? '#f39c12' : '#2ecc40');
    }
  }

  /// MOMENTARY CONTACT → wire pointer press/release on the role element to emit
  /// an out-connector. Emits 1 on press, 0 on release; inverted (NC) when the
  /// type property equals 'NC'. Emits the idle value once at mount.
  /// @param role     data-role of the pressable element (e.g. 'button')
  /// @param name     out-connector name to emit (e.g. 'contact')
  /// @param typeKey  OPTIONAL property key for NO/NC (e.g. 'contact_type').
  wireMomentary(role, name, typeKey) {
    // ── ALLE FORMEN DER ROLLE, NICHT DIE ERSTE ────────────────────────────
    //
    // Hier stand `this.role(role)` — die erste. Dieselbe Lehre wie bei
    // `setVisible`: eine Rolle ist der Name eines TEILS, nicht der einer
    // einzelnen Form.
    //
    // Anlass, 02.09.2026: die Trefferflaeche der Beetgruppe lag als EIN
    // Rechteck ueber dem ganzen Symbol — also auch ueber dem WEG. Wer den Weg
    // anklickte, schaltete das Ventil. Zerlegt man sie in eine Flaeche je
    // Beetblock, waere mit `role()` nur der erste Block noch bedienbar
    // gewesen, und die anderen taeten still nichts.
    const els = this.roleAll(role);
    if (!els.length) return;
    const send = (pressed) => {
      const nc = typeKey && this.prop(typeKey) === 'NC';
      this.emit(name, nc ? (pressed ? 0 : 1) : (pressed ? 1 : 0));
    };
    for (const r of els) {
      r.style.cursor = 'pointer';
      r.onpointerdown = () => send(true);
      r.onpointerup   = () => send(false);
    }
    // EINMAL, nicht je Flaeche: der Anfangszustand ist eine Aussage ueber den
    // TASTER, nicht ueber jede einzelne Trefferflaeche. Viermal gesendet
    // saehe fuer die Anlage wie viermal losgelassen aus.
    send(false);
  }
}
]]></asset>
   <asset name="clock.svg" type="media" version="31200f18"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!-- Uhr — Standardmedium der Anlagensoftware. Siehe about.svg.
     Zeiger auf zehn nach zehn, wie jede Uhr im Schaufenster: der Winkel laesst
     Ziffernblatt und beide Zeiger auch bei 18 px auseinanderhalten. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round">
  <circle cx="12" cy="12" r="10"/>
  <polyline points="12 6 12 12 16 14"/>
</svg>
]]></asset>
   <asset name="settings_dialog.html.tera" type="tera" version="b60f8133"><![CDATA[{# EINSTELLUNGEN — der Aufklappdialog der Verwaltung, auf JEDER Seite.

   Bis zum 11.09.2026 war die Verwaltung eine eigene Seite (/admin) mit vier
   Karten. Anwender: „das sind die ALTEN settings, die muessen wir auf einen
   tabbed dialog umstellen" — und dann: „Kein popup dialog." Wie Profil und
   Ueber: ein Dialog ueber dem Schirm, der Bediener bleibt, wo er ist.

   Dieselben Reiter wie „Projekt → Eigenschaften" in Studio, in derselben
   Reihenfolge: Anlage · Kontakt · Sicherheit · Sprache · Darstellung — dazu
   Status und Benutzer, die nur die Anlage kennt.

   ── Was hier GESCHRIEBEN wird, und was nicht ─────────────────────────────────

   Studio schreibt in die QUELLDATEI; die Anlage hat davon eine veröffentlichte
   Kopie. Editierbar ist deshalb nur, was die Anlage ehrlich besitzt:

     * die ANLAGENWERTE (uMaxVentile, Bewässerungszeit) — über die Live-Leitung
       an die Steuerung, wie jeder Tastendruck auf dem Schirm
     * die BENUTZER — sie leben auf der Anlage (`/api/users`)
     * das AUSSEHEN — als ABWEICHUNG. Das Thema lag als `state/theme`, und
       dorthin schrieben ZWEI: der Deploy (Beilage `theme` aus der .hearth) und
       diese Seite. Jedes Veröffentlichen warf die Einstellung des Bedieners
       weg. Deshalb zwei Schichten: das Projekt liefert die Grundlage, der
       Bediener legt seine Abweichungen darüber (`state/theme.local`), der
       Deploy ersetzt nur die Grundlage. Gespeichert wird, was vom Projektwert
       ABWEICHT — ein nie angefasster Wert folgt weiter dem Projekt.

   Alles andere steht als AUSKUNFT: dieselben Felder wie in Studio, gesperrt,
   mit dem Hinweis, wo es geändert wird.

   Eingebunden aus base.html.tera; /admin öffnet ihn nur. Die Werte kommen erst
   beim Öffnen (Benutzerliste, Thema) — die Endpunkte sind admin-gated. #}
{% set p = project() %}
{% set pw = p.password_policy | default(value=false) %}
{% set tm = theme_meta() %}

<div class="help-modal" id="settings-modal">
  <div class="help-modal__box help-modal__box--wide">
    <div class="help-modal__head">
      <span class="help-modal__title">{{ t(key="settings") }}</span>
      <button class="help-modal__close" data-dialog-close type="button" aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body settings-body">
  <div class="dlg-tabs" role="tablist">
    <button class="dlg-tab is-active" data-tab="tab-status"   role="tab" type="button">{{ t(key="status") }}</button>
    <button class="dlg-tab"           data-tab="tab-plant"    role="tab" type="button">{{ t(key="plant") }}</button>
    <button class="dlg-tab"           data-tab="tab-security" role="tab" type="button">{{ t(key="security") }}</button>
    <button class="dlg-tab"           data-tab="tab-look"     role="tab" type="button">{{ t(key="appearance") }}</button>
    <button class="dlg-tab"           data-tab="tab-users"    role="tab" type="button">{{ t(key="user-management") }}</button>
  </div>

  {# ── STATUS — von base.html.tera's WS-Handler live gefüllt ──────────────── #}
  <div class="dlg-page is-active" id="tab-status" role="tabpanel">
    <dl class="set-grid">
      <dt>{{ t(key="live-connection") }}</dt><dd><span id="plc-status">—</span></dd>
      <dt>{{ t(key="heartbeat-last-value") }}</dt><dd><span class="nav__hb" id="hb-indicator">♥ –</span></dd>
    </dl>
  </div>

  {# ── ANLAGE — Auskunft aus dem Projekt, dazu die schreibbaren Anlagenwerte ── #}
  <div class="dlg-page" id="tab-plant" role="tabpanel">
    <dl class="set-grid">
      <dt>{{ t(key="name") }}</dt><dd>{{ p.name | default(value="—") }}</dd>
      <dt>{{ t(key="description") }}</dt><dd>{{ p.description | default(value="—") }}</dd>
      <dt>{{ t(key="panel") }}</dt>
      <dd>{% if p.panel_width %}{{ p.panel_width }} × {{ p.panel_height }}{% else %}—{% endif %}</dd>
      <dt>{{ t(key="surround") }}</dt>
      <dd><span class="set-swatch" style="background: {{ p.surround | default(value='#101014') }}"></span>
          {{ p.surround | default(value="—") }}</dd>
      {% if p.logo %}<dt>{{ t(key="logo") }}</dt>
      <dd><img class="set-logo" src="{{ p.logo }}" alt=""></dd>{% endif %}
    </dl>
    <p class="set-hint">{{ t(key="settings-source-hint") }}</p>

    <div class="card__title">{{ t(key="plant-settings") }}</div>
    <p class="set-hint">{{ t(key="plant-settings-hint") }}</p>
    {# Die Zeilen baut das Skript aus /api/settings: alle persistenten
       Variablen des Programms, je Draht eine Zeile, die Dokumentation als
       Beschreibung. Keine Liste in der Vorlage — sie bliebe stehen, wenn das
       Programm eine Variable dazubekommt. #}
    <div class="banner" id="settings-banner"></div>
    <div class="settings" id="settings-rows"><span class="muted">{{ t(key="loading") }}…</span></div>
  </div>

  {# ── SICHERHEIT ─────────────────────────────────────────────────────────── #}
  <div class="dlg-page" id="tab-security" role="tabpanel">
    {% if pw %}
    <dl class="set-grid">
      <dt>{{ t(key="pw-min-length") }}</dt><dd>{{ pw.min_length | default(value="—") }}</dd>
      <dt>{{ t(key="pw-max-length") }}</dt><dd>{{ pw.max_length | default(value="—") }}</dd>
      <dt>{{ t(key="require") }}</dt>
      <dd>
        {% if pw.require_upper %}A {% endif %}{% if pw.require_lower %}a {% endif %}
        {% if pw.require_digit %}1 {% endif %}{% if pw.require_symbol %}! {% endif %}
        {% if not pw.require_upper and not pw.require_lower and not pw.require_digit and not pw.require_symbol %}—{% endif %}
      </dd>
      <dt>{{ t(key="pw-min-classes") }}</dt><dd>{{ pw.min_classes | default(value="—") }} / 4</dd>
      <dt>{{ t(key="pw-allow-username") }}</dt>
      <dd>{% if pw.allow_username %}{{ t(key="yes") }}{% else %}{{ t(key="no") }}{% endif %}</dd>
      <dt>{{ t(key="pw-history") }}</dt><dd>{{ pw.history | default(value="—") }}</dd>
      <dt>{{ t(key="pw-max-age") }}</dt>
      {% set alter = pw.max_age_days | default(value=0) %}
      <dd>{% if alter > 0 %}{{ alter }}{% else %}—{% endif %}</dd>
    </dl>
    {% endif %}
    <p class="set-hint">{{ t(key="settings-source-hint") }}</p>
  </div>

  {# ── DARSTELLUNG — die Abweichungen des Bedieners ────────────────────────
     Der Katalog kommt aus theme_meta(), also aus FTheme::keys() in Studio;
     eine Liste in dieser Vorlage wäre die zweite Aufzählung, und die ist schon
     einmal bei acht von 37 stehengeblieben. Der Farbknopf öffnet den eigenen
     Wähler — kein <input type=color>: das öffnet den Wähler des
     Betriebssystems, und auf einem Bedienpanel im Vollbild gibt es den nicht.
     Das Skript füllt die Werte aus /api/theme (project/local/effective) und
     markiert, welche vom Bediener stammen. #}
  <div class="dlg-page" id="tab-look" role="tabpanel">
    <div class="banner" id="theme-banner"></div>
    <p class="set-hint">{{ t(key="theme-layers-hint") }}</p>
    {% if tm %}
    <div class="set-theme">
      {% for m in tm %}
      <div class="set-theme__row" id="thr-{{ m.key }}">
        <label class="set-theme__label" for="thv-{{ m.key }}">{{ m.label }}</label>
        {% if m.is_color %}
        <button type="button" class="set-swatch set-swatch--btn"
                data-colour-for="thv-{{ m.key }}" title="{{ m.label }}"></button>
        <input class="inp set-theme__val" id="thv-{{ m.key }}" data-theme-key="{{ m.key }}"
               data-default="{{ m.default | default(value='') }}" autocomplete="off" spellcheck="false">
        {% else %}
        <span></span>
        <input class="inp set-theme__val" id="thv-{{ m.key }}" data-theme-key="{{ m.key }}"
               data-default="{{ m.default | default(value='') }}" list="th-fonts" autocomplete="off" spellcheck="false">
        {% endif %}
        <span class="set-theme__origin" data-origin-for="{{ m.key }}"></span>
      </div>
      {% endfor %}
    </div>
    <datalist id="th-fonts">
      <option value="'Inter', 'Segoe UI', system-ui, sans-serif">
      <option value="'Segoe UI', system-ui, sans-serif">
      <option value="Roboto, system-ui, sans-serif">
      <option value="Arial, Helvetica, sans-serif">
      <option value="'DejaVu Sans', sans-serif">
      <option value="ui-monospace, 'Cascadia Code', monospace">
    </datalist>
    <div class="dlg-actions">
      <button class="btn btn--ghost" id="th-reset" type="button">{{ t(key="reset-to-project") }}</button>
      <button class="btn" id="th-save" type="button">{{ t(key="save") }}</button>
    </div>
    {% else %}
    <p class="set-hint">{{ t(key="settings-source-hint") }}</p>
    {% endif %}
  </div>

  {# ── BENUTZER ───────────────────────────────────────────────────────────── #}
  <div class="dlg-page" id="tab-users" role="tabpanel">
    <div class="banner" id="user-banner"></div>
    <table>
      <thead><tr><th>{{ t(key="username") }}</th><th>{{ t(key="roles") }}</th><th class="user-actions">{{ t(key="action") }}</th></tr></thead>
      <tbody id="user-rows"><tr><td colspan="3" class="muted">{{ t(key="loading") }}…</td></tr></tbody>
    </table>
    <div class="dlg-actions">
      <button class="btn" id="btn-new" type="button">+ {{ t(key="new-user") }}</button>
    </div>
  </div>
  </div>
  </div>
</div>

{# ── DER FARBWÄHLER — ein eigener Dialog über denselben Mechanismus wie die
   anderen (HearthDialog). Er trägt die Farben, die das Thema SCHON benutzt —
   wer eine Anlage einfärbt, greift meist eine vorhandene Nuance wieder auf. #}
<div class="help-modal" id="colour-modal">
  <div class="help-modal__box help-modal__box--narrow">
    <div class="help-modal__head">
      <span class="help-modal__title" id="colour-title">{{ t(key="colour") }}</span>
      <button class="help-modal__close" data-dialog-close type="button" aria-label="{{ t(key="close") }}">×</button>
    </div>
    <div class="help-modal__body colour-body">
      <div class="colour-preview" id="colour-preview"></div>
      <label for="colour-hex">{{ t(key="colour-value") }}</label>
      <input id="colour-hex" class="inp" autocomplete="off" spellcheck="false" maxlength="9">
      <div class="colour-palette" id="colour-palette"></div>
      <div class="dlg-actions">
        <button class="btn" id="colour-apply" type="button">{{ t(key="apply") }}</button>
      </div>
    </div>
  </div>
</div>

{# ── Benutzer anlegen / bearbeiten ─────────────────────────────────────────── #}
<div class="modal-backdrop" id="user-modal">
  <div class="modal">
    <div class="modal__title" id="modal-title">{{ t(key="create-user") }}</div>
    <label for="m-name">{{ t(key="username") }}</label>
    <input class="inp" id="m-name" type="text" autocomplete="off">
    <label for="m-pw">{{ t(key="password") }}</label>
    <input class="inp" id="m-pw" type="password" autocomplete="new-password" placeholder="{{ t(key='required') }}">
    <label>{{ t(key="roles") }}</label>
    <div class="role-pick" id="m-roles"><span class="muted">—</span></div>
    <div class="modal__err" id="m-err"></div>
    <div class="modal__actions">
      <button class="btn btn--ghost" id="m-cancel" type="button">{{ t(key="cancel") }}</button>
      <button class="btn" id="m-save" type="button">{{ t(key="save") }}</button>
    </div>
  </div>
</div>

<script>(function() {
if (!document.getElementById('settings-modal')) return;

// ── Anlagenwerte: alle persistenten Variablen, aus /api/settings ────────────
//
// Je Draht eine Zeile: Label (Name, bei Feldern das Glied), Beschreibung aus
// der Dokumentation, Livewert, Eingabe nach Typ, Setzen ueber die Live-Leitung
// (window.writeValue aus base) — derselbe Weg wie ein Tastendruck.
function settingsRender(rows) {
  var box = document.getElementById('settings-rows');
  box.innerHTML = '';
  if (!rows || !rows.length) {
    box.innerHTML = '<span class="muted">{{ t(key="plant-settings-none") }}</span>';
    return;
  }
  var lastVar = '';
  rows.forEach(function(r) {
    var t = String(r.iec_type || '').toUpperCase();
    var isBool = t === 'BOOL', isTime = t === 'TIME';
    var kopf = r.list + '.' + r.name;
    var label = document.createElement('div');
    label.className = 's-label';
    label.textContent = r.leaf ? (kopf === lastVar ? '· ' + r.leaf : r.name + ' · ' + r.leaf) : r.name;
    if (kopf !== lastVar) {
      var small = document.createElement('small');
      small.textContent = r.list + (r.description ? ' — ' + r.description : '');
      label.appendChild(small);
    }
    lastVar = kopf;
    var cur = document.createElement('div');
    cur.className = 's-cur'; cur.setAttribute('data-live', r.short);
    if (isTime) cur.setAttribute('data-fmt', 'min');
    cur.textContent = '–';
    var unit = document.createElement('span');
    unit.className = 's-unit'; unit.textContent = isTime ? 'min' : '';
    var inp;
    if (isBool) {
      inp = document.createElement('select');
      inp.className = 'inp s-input';
      ['false', 'true'].forEach(function(v) { var o = document.createElement('option'); o.value = v; o.textContent = v; inp.appendChild(o); });
    } else {
      inp = document.createElement('input');
      inp.className = 'inp s-input'; inp.type = 'number'; inp.step = '1';
      inp.placeholder = isTime ? '{{ t(key="minutes") }}' : t;
    }
    var btn = document.createElement('button');
    btn.className = 'btn'; btn.type = 'button'; btn.textContent = '{{ t(key="set") }}';
    btn.disabled = !r.writable;
    btn.addEventListener('click', function() {
      var v;
      if (isBool) v = inp.value === 'true' ? 1 : 0;
      else {
        var n = parseFloat(inp.value);
        if (isNaN(n)) { showToast('✖ ' + r.short + ': {{ t(key="user-input-invalid") }}', 'err'); return; }
        v = isTime ? Math.round(n * 60000) : n;   // IEC TIME ist Millisekunden auf der Leitung
      }
      writeValue(r.short, v);
    });
    box.appendChild(label); box.appendChild(cur); box.appendChild(unit); box.appendChild(inp); box.appendChild(btn);
  });
}
function settingsLoad() {
  fetch('/api/settings', { credentials: 'same-origin' })
    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function(d) {
      if (d && d.descriptor === false) bannerIn('settings-banner', '{{ t(key="plant-settings-no-descriptor") }}', false);
      settingsRender((d && d.rows) || []);
    })
    .catch(function(e) {
      document.getElementById('settings-rows').innerHTML = '<span class="muted">{{ t(key="user-list-unavailable") }} (' + e + ').</span>';
    });
}

// Live-Rücklesen über das Ereignis der Leitung — NICHT über onLiveUpdate: das
// gehört der Seite darunter (dem Schirm), und dieser Dialog liegt auf jeder.
// Abgleich über den blanken HMI-Namen, tolerant gegen bellows.gvl. / Bellows.
document.addEventListener('hearth:live', function(ev) {
  var values = ev.detail && ev.detail.values;
  if (!values) return;
  document.querySelectorAll('[data-live]').forEach(function(el) {
    var tag = el.getAttribute('data-live');
    var v = values[tag];
    if (v === undefined) v = values['bellows.gvl.' + tag];
    if (v === undefined) v = values['Bellows.' + tag];
    if (v === undefined) return;
    // Vertrag C-1 — dieselbe EINE Umsetzung wie auf dem Schirm.
    if (window.setQuality) window.setQuality(el, v);
    var raw = (v && typeof v === 'object') ? (v.v !== undefined ? v.v : v.value) : v;
    var num = parseFloat(raw);
    if (isNaN(num)) { el.textContent = String(raw); return; }
    if (el.getAttribute('data-fmt') === 'min') num = Math.round(num / 60000);
    el.textContent = String(num);
  });
});

// ── Benutzerverwaltung ──────────────────────────────────────────────────────
var ALL_ROLES = [];
function esc(s) { return String(s).replace(/[&<>"]/g, function(c) {
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

function bannerIn(id, msg, ok) {
  var b = document.getElementById(id);
  b.style.display = 'block';
  b.textContent = msg;
  b.className = 'banner ' + (ok ? 'banner--ok' : 'banner--err');
}
function banner(msg, ok) { bannerIn('user-banner', msg, ok); }

// Der Standard-Admin (aus /api/users: `protected`) bekommt keinen
// Loeschknopf — die Anlage lehnte ihn ohnehin mit 409 ab, aber ein Knopf,
// der nie geht, ist eine Behauptung.
var PROTECTED = '';
function renderUsers(list) {
  var tb = document.getElementById('user-rows');
  if (!list || !list.length) { tb.innerHTML = '<tr><td colspan="3" class="muted">{{ t(key="no-users") }}</td></tr>'; return; }
  tb.innerHTML = list.map(function(u) {
    var roles = (u.roles || []).join(' ');
    var fest = u.name === PROTECTED;
    return '<tr><td>' + esc(u.name) + (fest ? ' <span class="muted" title="{{ t(key="default-admin-protected") }}">🔒</span>' : '') +
      '</td><td class="muted">' + esc((u.roles||[]).join(', ')) + '</td>' +
      '<td class="user-actions">' +
      '<button class="btn btn--ghost" type="button" data-edit="' + esc(u.name) + '" data-roles="' + esc(roles) + '">{{ t(key="edit") }}</button>' +
      (fest ? '' : '<button class="btn btn--danger" type="button" data-del="' + esc(u.name) + '">{{ t(key="delete") }}</button>') +
      '</td></tr>';
  }).join('');
  tb.querySelectorAll('[data-del]').forEach(function(b) {
    b.addEventListener('click', function() { deleteUser(b.getAttribute('data-del')); });
  });
  tb.querySelectorAll('[data-edit]').forEach(function(b) {
    b.addEventListener('click', function() {
      openModal(b.getAttribute('data-edit'), (b.getAttribute('data-roles') || '').split(' ').filter(Boolean));
    });
  });
}

function loadUsers() {
  fetch('/api/users', { credentials: 'same-origin' })
    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function(d) {
      ALL_ROLES = (d.roles || []).map(function(r) { return r.name; });
      PROTECTED = d.protected || '';
      renderUsers(d.users || []);
    })
    .catch(function(e) {
      document.getElementById('user-rows').innerHTML =
        '<tr><td colspan="3" class="muted">{{ t(key="user-list-unavailable") }} (' + e + ').</td></tr>';
    });
}

var modal = document.getElementById('user-modal');
function openModal(name, roles) {
  var editing = !!name;
  document.getElementById('modal-title').textContent = editing ? '{{ t(key="edit-user") }}' : '{{ t(key="create-user") }}';
  var nameEl = document.getElementById('m-name');
  nameEl.value = name || '';
  nameEl.disabled = editing;                       // der Name ist die Identität
  var pw = document.getElementById('m-pw');
  pw.value = '';
  pw.placeholder = editing ? '{{ t(key="empty-means-unchanged") }}' : '{{ t(key="required") }}';
  var have = roles || [];
  var box = document.getElementById('m-roles');
  box.innerHTML = ALL_ROLES.length ? ALL_ROLES.map(function(r) {
    var on = have.indexOf(r) !== -1 ? ' checked' : '';
    // Der Standard-Admin behaelt seine Admin-Rolle: das Kaestchen ist fest.
    var fest = (editing && name === PROTECTED && r === 'admin') ? ' checked disabled' : on;
    return '<label><input type="checkbox" value="' + esc(r) + '"' + fest + '>' + esc(r) + '</label>';
  }).join('') : '<span class="muted">{{ t(key="no-roles-declared") }}</span>';
  document.getElementById('m-err').textContent = '';
  modal.classList.add('open');
  (editing ? pw : nameEl).focus();
}
function closeModal() { modal.classList.remove('open'); }
document.getElementById('btn-new').addEventListener('click', function() { openModal(null, []); });
document.getElementById('m-cancel').addEventListener('click', closeModal);
modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

document.getElementById('m-save').addEventListener('click', function() {
  var name = document.getElementById('m-name').value.trim();
  var pw = document.getElementById('m-pw').value;
  var roles = [];
  document.querySelectorAll('#m-roles input:checked').forEach(function(c) { roles.push(c.value); });
  var errEl = document.getElementById('m-err');
  if (!name) { errEl.textContent = '{{ t(key="username-missing") }}'; return; }
  fetch('/api/users', {
    method: 'POST', credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name, password: pw, roles: roles })
  }).then(function(r) {
    if (r.ok) { closeModal(); banner('{{ t(key="saved") }}: ' + name, true); loadUsers(); }
    else if (r.status === 409) errEl.textContent = '{{ t(key="last-admin-keeps-role") }}';
    else if (r.status === 400) errEl.textContent = '{{ t(key="user-input-invalid") }}';
    else r.text().then(function(t) { errEl.textContent = '{{ t(key="error") }} (' + r.status + ') ' + t; });
  }).catch(function(e) { errEl.textContent = '{{ t(key="network-error") }}: ' + e; });
});

function deleteUser(name) {
  if (!confirm('{{ t(key="delete-user-confirm") }}\n\n' + name)) return;
  fetch('/api/users/' + encodeURIComponent(name), { method: 'DELETE', credentials: 'same-origin' })
    .then(function(r) {
      if (r.ok) { banner('{{ t(key="deleted") }}: ' + name, true); loadUsers(); }
      else if (r.status === 409) banner('{{ t(key="last-admin-not-deletable") }}', false);
      else banner('{{ t(key="delete-failed") }} (' + r.status + ').', false);
    }).catch(function(e) { banner('{{ t(key="network-error") }}: ' + e, false); });
}



// ── Darstellung: zwei Schichten ─────────────────────────────────────────────
//
// /api/theme liefert project (Grundlage aus der .hearth), local (Abweichungen
// des Bedieners) und effective. Gespeichert wird NUR, was vom Projektwert
// abweicht: ein Wert, den der Bediener nie angefasst hat, folgt weiter dem
// Projekt — auch nach dem naechsten Veroeffentlichen.
var thProject = {}, thLocal = {};
function thInputs() { return document.querySelectorAll('[data-theme-key]'); }
function thBase(k, el) {
  var v = thProject[k];
  return (v === undefined || v === null || v === '') ? (el.getAttribute('data-default') || '') : String(v);
}
function thMarkOrigin(el) {
  var k = el.getAttribute('data-theme-key');
  var mark = document.querySelector('[data-origin-for="' + k + '"]');
  var eigen = el.value.trim() !== thBase(k, el);
  if (mark) mark.textContent = eigen ? '{{ t(key="set-by-operator") }}' : '';
  var row = document.getElementById('thr-' + k);
  if (row) row.classList.toggle('is-local', eigen);
  var sw = document.querySelector('[data-colour-for="' + el.id + '"]');
  if (sw) sw.style.background = el.value.trim();
}
function thFill() {
  thInputs().forEach(function(el) {
    var k = el.getAttribute('data-theme-key');
    var v = thLocal[k];
    el.value = (v === undefined || v === null || v === '') ? thBase(k, el) : String(v);
    thMarkOrigin(el);
  });
}
function thDiff() {
  var out = {};
  thInputs().forEach(function(el) {
    var k = el.getAttribute('data-theme-key'), v = el.value.trim();
    if (v !== '' && v !== thBase(k, el)) out[k] = v;
  });
  return out;
}
thInputs().forEach(function(el) { el.addEventListener('input', function() { thMarkOrigin(el); }); });
document.getElementById('th-reset').addEventListener('click', function() {
  thInputs().forEach(function(el) { el.value = thBase(el.getAttribute('data-theme-key'), el); thMarkOrigin(el); });
});
document.getElementById('th-save').addEventListener('click', function() {
  var diff = thDiff();
  fetch('/api/theme', { method: 'POST', credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(diff) })
   .then(function(r) {
     if (r.ok) { thLocal = diff; bannerIn('theme-banner', '{{ t(key="theme-saved") }}', true); }
     else bannerIn('theme-banner', '{{ t(key="save-failed") }} (' + r.status + ').', false);
   }).catch(function(e) { bannerIn('theme-banner', '{{ t(key="network-error") }}: ' + e, false); });
});
// EIN ALTER SERVER (vor den zwei Schichten) antwortet mit der flachen Karte
// und schriebe einen Abweichungs-POST als GANZES Thema — die Grundlage waere
// weg. Dann wird hier nicht gespeichert, und die Seite sagt warum.
function thLoad() {
fetch('/api/theme', { credentials: 'same-origin' })
  .then(function(r) { return r.ok ? r.json() : {}; })
  .then(function(d) {
    if (!d || d.project === undefined) {
      thProject = d || {}; thLocal = {};
      thFill();
      ['th-save', 'th-reset'].forEach(function(id) { document.getElementById(id).disabled = true; });
      thInputs().forEach(function(el) { el.disabled = true; });
      bannerIn('theme-banner', '{{ t(key="server-too-old") }}', false);
      return;
    }
    thProject = d.project || {}; thLocal = d.local || {}; thFill();
  })
  .catch(function() { thFill(); });
}

// ── Der Farbwähler ──────────────────────────────────────────────────────────
var colourTarget = null;
function isHex(s) { return /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(s); }
function colourShow(v) {
  document.getElementById('colour-hex').value = v;
  document.getElementById('colour-preview').style.background = isHex(v) ? v : 'transparent';
}
document.addEventListener('click', function(e) {
  var sw = e.target.closest && e.target.closest('[data-colour-for]');
  if (!sw) return;
  colourTarget = document.getElementById(sw.getAttribute('data-colour-for'));
  if (!colourTarget) return;
  document.getElementById('colour-title').textContent = sw.getAttribute('title') || '{{ t(key="colour") }}';
  var seen = {}, pal = document.getElementById('colour-palette');
  pal.innerHTML = '';
  ['#000000', '#ffffff'].concat(
    Array.prototype.map.call(thInputs(), function(el) { return el.value.trim(); })
  ).forEach(function(v) {
    if (!isHex(v) || seen[v]) return;
    seen[v] = true;
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'colour-chip'; b.title = v; b.style.background = v;
    b.addEventListener('click', function() { colourShow(v); });
    pal.appendChild(b);
  });
  colourShow(colourTarget.value.trim());
  window.HearthDialog.open('colour-modal');
});
document.getElementById('colour-hex').addEventListener('input', function() { colourShow(this.value.trim()); });
document.getElementById('colour-apply').addEventListener('click', function() {
  var v = document.getElementById('colour-hex').value.trim();
  if (!colourTarget || !isHex(v)) return;
  colourTarget.value = v;
  colourTarget.dispatchEvent(new Event('input', { bubbles: true }));
  window.HearthDialog.close('colour-modal');
});

// ── ERST BEIM OEFFNEN LADEN ─────────────────────────────────────────────────
//
// Der Dialog liegt auf jeder Seite; die Benutzerliste und das Thema holt er
// erst, wenn jemand ihn oeffnet — sonst fragte jeder Schirmaufruf zwei
// Admin-Endpunkte ab, die einem Bediener 401 antworten.
var geladen = false;
function init() {
  if (geladen) return;
  geladen = true;
  loadUsers();
  settingsLoad();
  thLoad();
}
document.addEventListener('click', function(e) {
  var t = e.target.closest && e.target.closest('[data-dialog="settings-modal"]');
  if (t) init();
});
window.HearthSettings = {
  open: function() { init(); window.HearthDialog.open('settings-modal'); }
};
})();
</script>
]]></asset>
